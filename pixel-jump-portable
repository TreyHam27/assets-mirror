        tiles: [
            { speed: 0.25, h: 1500, seed: 21, drift: 0.12, paint: paintAurora, steps: auroraSteps },
            { speed: 0.6, h: 1600, seed: 22, drift: -0.06, paint: paintClouds(5, '255, 120, 240', 0.05, 90) }
        ]
    },
    "Low Orbit": {
        sky: ['#01061a', '#041a3e', '#0a3b6e'], stars: 1, fixed: FIXED_PLANET,
        tiles: [
            { speed: 0.15, h: 2000, seed: 31, column: true, paint: paintMoon },
            { speed: 0.6, h: 1700, seed: 32, column: true, paint: paintSatellites }
