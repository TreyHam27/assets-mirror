.save-move-input {
    text-transform: uppercase;
}
.save-move {
    display: flex;
    flex-direction: column;
    gap: 8px;
}
.save-move .btn {
    width: 100%;
}
.lb-ok {
    color: var(--teal);
}
.lb-ok .ico {
    width: 11px;
    height: 11px;
    vertical-align: -1px;
}
.lb-review {
    margin-left: 4px;
