// player's other bonuses already reach GEM_MULT_MAX, so one more adds
// nothing (the Gem Frenzy button, the GEMS x2 run perk card). Nothing else
// mentions the cap: it only matters at that moment.
const GEM_MULT_FULL_NOTE = 'Adds nothing: gems are ' + GEM_MULT_MAX + 'x';
