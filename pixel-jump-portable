// The perks a Pixel actually grants, in PERKS order, each with its value.
function skinPerks(ability) {
    if (!ability) return [];
    return PERKS
        .filter(p => p.active(ability[p.key]))
        .map(p => ({ perk: p, value: ability[p.key] }));
}

// The downsides a Pixel's abilities carry, in PERKS order.
function skinDownsides(ability) {
    if (!ability) return [];
    return PERKS
        .filter(p => p.downside)
        .map(p => p.downside(ability[p.key]))
        .filter(Boolean);
}

const POWERS = {
    DOUBLE: { id: 1, name: "DOUBLE JUMP", color: "#00ccff", time: 600 },
    SUPER: { id: 2, name: "SUPER JUMP", color: "#ffaa00", time: 400 },
    SAFETY: { id: 3, name: "SAFETY NET", color: "#cc00ff", time: 800 },
    MAGNET: { id: 4, name: "MAGNET", color: "#ffff00", time: 500 },
    ROCKET: { id: 5, name: "JETPACK", color: "#ff3300", time: 250 },
    SHIELD: { id: 6, name: "HARD SHIELD", color: "#00ffaa", time: 600 },
    TIME_WARP: { id: 7, name: "TIME WARP", color: "#ffffff", time: 500 }
};
// The powers in POWERS order (ids go over the wire).
const POWER_LIST = Object.values(POWERS);

// The six feats. `desc` is the exact wording; `progress(state)` (0..1) feeds
// the bar where progress is measurable (distance, gems held) and is left out
// for one-shot feats.
// Achievements: each pays `reward` gems once (GameMeta.payAchievementRewards;
// the six from before 1.37.0 are paid once to players who already have
// them). condition(state, player, game) is checked four times a second in a
// run and after it; progress(state, game) fills the bar in Records.
// Height achievements count solo runs (Freeplay included) only: a party run's
// height is unchecked, so the score Worker never pays for it (ADR-0015).
const runMetersOf = (state) => state.multiplayer ? 0 : state.score / 10 - (state.startMeters || 0);
const biomeAchievement = (id, name, reward) => {
    const b = BIOMES.find(x => x.name === name);
    return { id, name: 'Reach ' + name, desc: 'Reach ' + name + ' (' + b.threshold.toLocaleString('en-US') + 'm)', reward,
        condition: (state) => state.bestHeight >= b.threshold, progress: (state) => state.bestHeight / b.threshold };
};
const countAchievement = (id, name, desc, reward, target, value) => ({ id, name, desc, reward,
    condition: (state, player, game) => value(state, game) >= target, progress: (state, game) => value(state, game) / target });
const statOf = key => (state, game) => (game && game.stats && game.stats[key]) || 0;
const ownedOf = (state, game) => (game && game.ownedSkins ? game.ownedSkins.length : 0);
const streakOf = (state, game) => (game && game.streakToday ? game.streakToday().count : 0);
const ACHIEVEMENTS = [
    { id: '1km', name: 'Kilometer Club', desc: 'Reach 1,000m in one run', reward: 100,
      condition: (state) => runMetersOf(state) >= 1000,
      progress: (state) => state.bestHeight / 1000 },
    { id: '5km', name: 'Stratosphere', desc: 'Reach 5,000m in one run', reward: 1000,
      condition: (state) => runMetersOf(state) >= 5000,
      progress: (state) => state.bestHeight / 5000 },
    { id: 'magnet', name: 'Attractive', desc: 'Pick up a MAGNET power-up', reward: 100,
      condition: (state, player) => player.hasPower(POWERS.MAGNET) },
    { id: 'pacifist', name: 'No Power-Ups Needed', desc: 'Reach 5,000m without collecting a power-up', reward: 2500,
      condition: (state) => runMetersOf(state) >= 5000 && state.powersCollected === 0 },
    { id: 'boss', name: 'Titan Slayer', desc: 'Beat a boss', reward: 300,
      condition: (state) => state.loops >= 1 },
    { id: 'rich', name: 'Data Hoarder', desc: 'Hold 10,000 gems', reward: 1000,
      condition: (state) => state.gems >= 10000,
      progress: (state) => state.gems / 10000 },
    { id: '10km', name: 'Ten Thousand', desc: 'Reach 10,000m in one run', reward: 3000,
      condition: (state) => runMetersOf(state) >= 10000,
      progress: (state) => state.bestHeight / 10000 },
    biomeAchievement('b_ionosphere', 'Ionosphere', 100),
    biomeAchievement('b_loworbit', 'Low Orbit', 200),
    biomeAchievement('b_deepspace', 'Deep Space', 400),
    biomeAchievement('b_rift', 'The Rift', 700),
    biomeAchievement('b_neongrid', 'Neon Grid', 1000),
    biomeAchievement('b_static', 'Static Field', 1500),
    biomeAchievement('b_void', 'The Void', 2500),
    countAchievement('boss5', 'Boss Hunter', 'Beat 5 bosses', 1000, 5, state => state.loops || 0),
    countAchievement('boss25', 'Boss Breaker', 'Beat 25 bosses', 3000, 25, state => state.loops || 0),
    countAchievement('boss100', 'Titan Legend', 'Beat 100 bosses', 5000, 100, state => state.loops || 0),
    countAchievement('own1', 'First Buy', 'Own a Pixel you bought', 100, 1, ownedOf),
    countAchievement('own5', 'Collector', 'Own 5 bought Pixels', 1000, 5, ownedOf),
    countAchievement('own10', 'Full Hangar', 'Own 10 bought Pixels', 5000, 10, ownedOf),
    countAchievement('runs10', 'Getting Started', 'Finish 10 runs', 100, 10, statOf('runs')),
    countAchievement('runs100', 'Regular', 'Finish 100 runs', 1000, 100, statOf('runs')),
    countAchievement('runs500', 'Devoted', 'Finish 500 runs', 3000, 500, statOf('runs')),
    countAchievement('climb100k', 'Long Haul', 'Climb 100,000m in total', 2000, 100000, statOf('meters')),
    countAchievement('streak3', 'Three in a Row', 'Keep a 3-day Streak', 300, 3, streakOf),
    countAchievement('streak7', 'Week Strong', 'Keep a 7-day Streak', 1500, 7, streakOf),
    countAchievement('streak30', 'Habit', 'Keep a 30-day Streak', 5000, 30, streakOf),
    countAchievement('coop1', 'Party Time', 'Finish a co-op run', 200, 1, statOf('coopRuns')),
    countAchievement('coop10', 'Squad', 'Finish 10 co-op runs', 1000, 10, statOf('coopRuns')),
    countAchievement('coopboss', 'Team Takedown', 'Beat a boss in co-op', 500, 1, statOf('coopBosses'))
];

