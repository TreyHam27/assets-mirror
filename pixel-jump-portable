    display: flex;
    flex-direction: column;
    gap: 8px;
}
.mission-row {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 9px 11px;
    border-radius: var(--radius-row);
    background: rgba(255, 255, 255, 0.04);
    text-align: left;
}
.mission-row.is-done {
    background: rgba(var(--teal-rgb), 0.1);
}
.mission-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
}
.mission-name {
    font-family: var(--font-display);
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.6px;
    color: var(--text);
}
.mission-reward {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-family: var(--font-display);
    font-size: 11px;
    font-weight: 800;
    color: var(--gem);
}
.mission-row.is-done .mission-reward {
    color: var(--teal);
}
.mission-desc {
    font-family: var(--font-text);
    font-size: 12px;
    color: var(--muted);
}
.mission-foot {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: 2px;
}
.mission-bar {
    flex: 1 1 auto;
    height: 6px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.09);
    overflow: hidden;
}
.mission-bar > i {
    display: block;
    height: 100%;
    border-radius: inherit;
