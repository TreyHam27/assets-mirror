// no player id; Settings > SEND ANONYMOUS STATS). At most ERROR_REPORTS_MAX
// error reports a session, each message once. Frame rates are sent as the
// nearest of FPS_BUCKETS.
const ERROR_REPORTS_MAX = 5;
const FPS_BUCKETS = [15, 30, 45, 60, 75, 90, 120, 144, 165, 240];
// Vibration (where the device has it, and the Settings switch is on): a hit
