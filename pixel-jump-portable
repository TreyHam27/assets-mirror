        try { rec = await readRecord(); } catch (e) { return null; }
        if (!rec || rec.version !== version || typeof rec.html !== 'string' ||
            declaredVersion(rec.html) !== version || !await verify(rec)) {
            await purge();
            return null;
        }
        return { version, html: rec.html };
    }

    const ready = run().catch(() => null);

    // Opens the verified build full-viewport. False means nothing was mounted
    // and the caller boots the embedded game.
    function mount(build) {
        let frame = null;
        try {
            if (!build) return false;
            const prior = parseBooting(lsGet(BOOTING));
            const young = prior && prior.version === build.version && Date.now() - prior.at < BOOT_WINDOW_MS;
            if (!young && !lsSet(BOOTING, build.version + '@' + Date.now())) return false;
            frame = document.createElement('iframe');
            frame.setAttribute('allow', 'fullscreen; autoplay; gamepad');
            frame.setAttribute('allowfullscreen', '');
            frame.setAttribute('title', 'Pixel Jump');
            frame.style.cssText = 'position:fixed;inset:0;width:100vw;height:100vh;height:100dvh;border:0;margin:0;padding:0;background:#050505;z-index:2147483647';
            frame.srcdoc = build.html;
            frame.addEventListener('load', () => { try { frame.focus(); } catch (e) { /* no focus */ } });
