// Limited-time modes (LTMs): rule twists on a normal climb, one on offer at a
// time, rotating every LTM_SLOT_HOURS on the local clock (like the Rental).
// Played from their own menu button; their climbs never touch the daily
// layout's records (best height, Online board, Personal board): each
// mode keeps its own best (lp_ltm_best). LTM_ENABLED is the one switch: false
// hides every part of it and the game plays exactly as before.
// Rules: gravity (a multiplier on the Pixel's gravity), bossEvery (metres
// between bosses), ice (a floor for the ice dose), gemMult (gem pickups),
// oneHeart (one heart, no bought or found hearts).
const LTM_ENABLED = true;
const LTM_SLOT_HOURS = 3;
const LTMS = [
    { id: 'lowgrav', name: 'Low Gravity', note: 'Floaty jumps, long falls', rules: { gravity: 0.6 } },
    { id: 'bossrush', name: 'Boss Rush', note: 'A Titan every 600m', rules: { bossEvery: 600 } },
    { id: 'iceall', name: 'Ice Everywhere', note: 'Every platform is slippery', rules: { ice: 1 } },
    { id: 'frenzy', name: 'Gem Frenzy', note: 'Gems pay double', rules: { gemMult: 2 } },
    { id: 'oneheart', name: 'One Heart', note: 'No second chances', rules: { oneHeart: true } }
];
// The mode on offer at `now` (null with LTM_ENABLED off). Every mode comes
// round, in an order that shifts each day.
function ltmAt(now = Date.now()) {
    if (!LTM_ENABLED) return null;
    const d = new Date(now);
    const day = Math.floor(Date.UTC(d.getFullYear(), d.getMonth(), d.getDate()) / 86400000);
    const slotsPerDay = Math.floor(24 / LTM_SLOT_HOURS);
    return LTMS[(day * slotsPerDay + Math.floor(d.getHours() / LTM_SLOT_HOURS)) % LTMS.length];
}
// When it changes: the next slot boundary on the local clock.
function nextLtmAt(now = Date.now()) {
    const d = new Date(now);
    const h = (Math.floor(d.getHours() / LTM_SLOT_HOURS) + 1) * LTM_SLOT_HOURS;
    return new Date(d.getFullYear(), d.getMonth(), d.getDate(), h).getTime();
}
const ltmById = (id) => LTMS.find(m => m.id === id) || null;
// The local calendar day before a YYYYMMDD day, as YYYYMMDD.
function dayBefore(day) {
    const d = new Date(Math.floor(day / 10000), Math.floor(day / 100) % 100 - 1, day % 100 - 1);
    return d.getFullYear() * 10000 + (d.getMonth() + 1) * 100 + d.getDate();
}

