    bindEvents() {
        this.bindMetaEvents();
        const onTap = (el, fn) => { if (el) el.onclick = (e) => { if (e && e.stopPropagation) e.stopPropagation(); fn(e); }; };
        onTap(this.ui.pixelsOpenBtn, () => this.openPixels('all'));
        onTap(this.ui.shopPixelsBtn, () => this.openPixels('shop'));
        onTap(this.ui.pixelsBackBtn, () => this.setMenuPanel('sp'));
        onTap(this.ui.buyConfirmYes, () => this.confirmBuyPixel());
        onTap(this.ui.buyConfirmNo, () => this.closeBuyConfirm());
        if (this.ui.buyConfirm) this.ui.buyConfirm.onclick = (e) => { if (e.target === this.ui.buyConfirm) this.closeBuyConfirm(); };
        if (this.ui.pixelTabs && this.ui.pixelTabs.querySelectorAll) {
            this.ui.pixelTabs.querySelectorAll('.pixel-tab').forEach(b => onTap(b, () => this.setPixelTab(b.dataset.tab)));
        }
        if (this.ui.pixelGrid) {
            const pick = (e) => {
                const card = e.target.closest && e.target.closest('.pixel-card');
                if (!card || e.target.closest('.perk-tag')) return;
                this.pickPixel(parseInt(card.dataset.index, 10), card);
            };
            this.ui.pixelGrid.onclick = pick;
            this.ui.pixelGrid.onkeydown = (e) => {
                if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); pick(e); }
            };
        }

        if (this.ui.shopLifeBtn) {
            this.ui.shopLifeBtn.onclick = (e) => {
                e.stopPropagation();
                this.buyHeart();
            };
        }

        // Shop screen open/close (slides up on its own vertical axis, see CSS)
        if (this.ui.shopOpenBtn) {
            this.ui.shopOpenBtn.onclick = (e) => {
                e.stopPropagation();
                this.setMenuPanel('shop');
            };
            this.ui.shopBackBtn.onclick = (e) => {
                e.stopPropagation();
                this.setMenuPanel('sp');
            };
        }

        // Perk tags: hover shows the full stats via CSS; tapping one toggles it
        // (touch has no hover) and closes any other open tag. Delegated, since
        // the menu and shop re-render their tags on every change.
        if (this.ui.menusWrapper) {
            this.ui.menusWrapper.addEventListener('click', (e) => {
                const tag = e.target.closest('.perk-tag');
                this.ui.menusWrapper.querySelectorAll('.perk-tag.open').forEach(t => {
                    if (t !== tag) t.classList.remove('open');
                });
                if (tag) {
                    e.stopPropagation();
                    tag.classList.toggle('open');
                }
            }, true);
        }

        // The picker only ever holds unlocked Pixels, so a click anywhere else
        // on the menu always starts a run.
        this.ui.menu.onclick = (e) => {
            if (e.target.closest('button, input, a, #skin-container')) return;
            this.requestSoloStart();
        };
        this.ui.startBtn.onclick = (e) => {
            if (e && e.stopPropagation) e.stopPropagation();
            this.requestSoloStart();
        };

        // Keyboard on the solo menu: Space / Enter / Up / W start a run (same as clicking the menu).
        window.addEventListener('keydown', (e) => {
            if (this.runCardOpen) {
                this.handleRunCardKey(e);
                return;
            }
            if (!this.canQuickStart(e)) return;
            const role = InputHandler.eventRole(e);
            if (role === 'jump' || e.code === 'Enter' || e.code === 'NumpadEnter') {
                e.preventDefault();
                this.requestSoloStart();
            }
        });

        this.bindCoopEvents();
    }

    // Pause, settings, records and the run card.
    bindMetaEvents() {
        const on = (el, fn) => { if (el) el.onclick = (e) => { if (e && e.stopPropagation) e.stopPropagation(); fn(); }; };
        on(this.ui.pauseBtn, () => this.pauseGame());
        on(this.ui.pauseResumeBtn, () => this.resumeGame());
        on(this.ui.pauseSettingsBtn, () => this.openSettings());
        on(this.ui.pauseQuitBtn, () => this.quitRun());
        on(this.ui.settingsOpenBtn, () => this.openSettings());
        on(this.ui.settingsCloseBtn, () => this.closeSettings());
        on(this.ui.recordsOpenBtn, () => { this.renderRecords(); this.refreshLeaderboard(); this.setMenuPanel('records'); });
        on(this.ui.recordsBackBtn, () => this.setMenuPanel('sp'));
        on(this.ui.recordsToggle, () => this.toggleAchievements());
        on(this.ui.runAgainBtn, () => this.runCardPlayAgain());
        on(this.ui.runMenuBtn, () => this.closeRunCard());
        // Tapping beside the card closes it, like MENU. A short grace period
        // stops a tap still landing from the run from dismissing it unseen.
        if (this.ui.runCard) this.ui.runCard.onclick = (e) => {
            if (!e || e.target !== this.ui.runCard) return;
            if (performance.now() - (this.runCardOpenedAt || 0) < RUN_CARD_TAP_GRACE_MS) return;
            this.closeRunCard();
        };

        const setting = (el, key, read) => {
            if (!el || !el.addEventListener) return;
            el.addEventListener('input', () => {
                this.settings[key] = read(el);
                this.saveSettings();
                this.applySettings();
            });
        };
        setting(this.ui.setVolume, 'volume', el => Number(el.value) / 100);
        setting(this.ui.setMuted, 'muted', el => el.checked);
        setting(this.ui.setGhost, 'showGhost', el => el.checked);
        setting(this.ui.setMotion, 'reducedMotion', el => el.checked);
        setting(this.ui.setTouch, 'touchControls', el => el.checked);
        setting(this.ui.setTips, 'showTips', el => el.checked);
        on(this.ui.runShareBtn, () => this.shareRun());
        on(this.ui.runBoostBtn, () => this.watchGemBoost());
        on(this.ui.gemBoost, () => this.watchGemBoost());

        // Leaving the tab or window pauses a solo run.
        document.addEventListener('visibilitychange', () => { if (document.hidden) { this.saveBest(); this.autoPause(); } });
        window.addEventListener('blur', () => this.autoPause());

        // Esc / P: close the topmost thing, or pause the run.
        window.addEventListener('keydown', (e) => {
            if (e.code !== 'Escape' && e.code !== 'KeyP') return;
            if (e.target && e.target.closest && e.target.closest('input')) return;
            const esc = e.code === 'Escape';
            if (this.settingsOpen) { if (esc) this.closeSettings(); return; }
            if (this.state.running) { e.preventDefault(); this.togglePause(); return; }
            if (this.runCardOpen) { if (esc) this.closeRunCard(); return; }
            if (esc && (this.activeMenuPanel === 'shop' || this.activeMenuPanel === 'records')) this.setMenuPanel('sp');
        });
    }

    // ---------------------------------------------------------------- pause
    // A solo run freezes under the pause screen. A co-op run can't stop for
    // one player, so there it's just a menu over the live game.
    pauseGame() {
        // Not mid-shatter either: the run card is a second away.
        if (!this.state.running || this.state.dying || this.pauseMenuOpen) return;
        this.pauseMenuOpen = true;
        this.state.paused = !this.state.multiplayer;
        if (this.state.paused) this.pauseStartedAt = performance.now();
        this.input.resetInput();
        this.ui.pauseNote.hidden = !this.state.multiplayer;
        this.ui.pauseQuitBtn.innerText = this.state.multiplayer ? "LEAVE PARTY" : "QUIT RUN";
        this.ui.pauseOverlay.hidden = false;
        this.updateTouchControls();
    }

    resumeGame() {
        if (!this.pauseMenuOpen) return;
        this.closePauseUI();
        this.blurFocus();
        // Restart the frame clock so the paused time isn't one giant step.
        this.lastTime = 0;
    }

    closePauseUI() {
        if (this.state.paused && this.pauseStartedAt) {
            this.state.pausedMs = (this.state.pausedMs || 0) + (performance.now() - this.pauseStartedAt);
        }
        this.pauseStartedAt = 0;
        this.pauseMenuOpen = false;
        this.state.paused = false;
        this.ui.pauseOverlay.hidden = true;
        this.closeSettings();
        this.updateTouchControls();
    }

    togglePause() {
        if (this.pauseMenuOpen) this.resumeGame();
        else this.pauseGame();
    }

    autoPause() {
        if (this.state.running && !this.state.multiplayer) this.pauseGame();
    }

    // Ends the run from the pause menu: straight to game over (no revive).
    // In co-op that means leaving the party.
    quitRun() {
        if (!this.state.running) return;
        this.closePauseUI();
        if (this.state.multiplayer) {
            this.endPartyRun();
            this.leaveParty("LEFT THE PARTY");
            return;
        }
        this.state.running = false;
        this.gameOver();
    }

    // ------------------------------------------------------------- settings
    loadSettings() {
        const prefersReduced = typeof window.matchMedia === 'function' &&
            window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        const saved = loadJSON('lp_settings', {}, isPlainObject);
        return {
            volume: Number.isFinite(saved.volume) ? Math.max(0, Math.min(1, saved.volume)) : 0.8,
            muted: saved.muted === true,
            showGhost: saved.showGhost !== false,
            reducedMotion: typeof saved.reducedMotion === 'boolean' ? saved.reducedMotion : prefersReduced,
            touchControls: saved.touchControls !== false,
            showTips: saved.showTips !== false
        };
    }

    saveSettings() {
        saveItem('lp_settings', JSON.stringify(this.settings));
    }

    applySettings() {
        sounds.setVolume(this.settings.volume);
        sounds.setMuted(this.settings.muted || portal.muteAudio || this.ads.playing);
        if (document.body && document.body.classList) document.body.classList.toggle('reduce-motion', this.settings.reducedMotion);
        this.particles.scale = this.settings.reducedMotion ? 0.35 : 1;
        this.updateTouchControls();
    }

    openSettings() {
        const s = this.settings;
        this.ui.setVolume.value = Math.round(s.volume * 100);
        this.ui.setMuted.checked = s.muted;
        this.ui.setGhost.checked = s.showGhost;
        this.ui.setMotion.checked = s.reducedMotion;
        if (this.ui.setTouch) this.ui.setTouch.checked = s.touchControls;
        if (this.ui.setTips) this.ui.setTips.checked = s.showTips;
        this.updateTouchSettingRow();
        if (this.ui.setVersion) this.ui.setVersion.textContent = GAME_VERSION;
        if (typeof SaveBackupUI !== 'undefined') SaveBackupUI.reset();
        this.ui.settingsOverlay.hidden = false;
        this.settingsOpen = true;
    }

    // The menu's start prompt (the same word for a click and a tap).
    updateStartPrompt() {
        this.ui.startBtn.innerHTML = icon('play') + ' PLAY';
    }

    // TOUCH BUTTONS only means anything on a touch screen.
    updateTouchSettingRow() {
        if (this.ui.setTouchRow) this.ui.setTouchRow.hidden = !this.coarsePointer;
    }

    closeSettings() {
        this.ui.settingsOverlay.hidden = true;
        this.settingsOpen = false;
        // A slider or checkbox left focused must not swallow the run's keys.
        if (this.state.running) this.blurFocus();
    }

    // ---------------------------------------------------------------- stats
    loadStats() {
        const saved = loadJSON('lp_stats', {}, isPlainObject);
        const stats = { ...STAT_DEFAULTS };
        for (const k of Object.keys(STAT_DEFAULTS)) {
            if (Number.isFinite(saved[k]) && saved[k] >= 0) stats[k] = saved[k];
        }
        return stats;
    }

    recordRunStats(runMeters) {
        const st = this.stats;
        st.runs += 1;
        st.meters += runMeters;
        st.gems += this.state.runGems || 0;
        st.powerups += this.state.powersCollected || 0;
        st.livesLost += this.state.runDeaths || 0;
        st.seconds += this.runSeconds();
        saveItem('lp_stats', JSON.stringify(st));
    }

    // -------------------------------------------------------------- run card
    showRunCard(finalScore) {
        const s = this.state;
        const secs = Math.round(this.runSeconds());
        const stats = [
            [counted(fmtNum(s.runGems || 0), 'gem'), 'GEMS', true],
            [fmtNum(s.powersCollected || 0), 'POWER-UPS'],
            [this.renderer.currentBiome.name.toUpperCase(), 'REACHED'],
            [Math.floor(secs / 60) + ':' + String(secs % 60).padStart(2, '0'), 'TIME']
        ];
        if (s.runLoops) stats.push([fmtNum(s.runLoops), s.runLoops === 1 ? 'BOSS BEATEN' : 'BOSSES BEATEN']);

        this.ui.runCardTitle.innerText = s.multiplayer ? "PARTY DOWN" : "RUN OVER";
        this.ui.runCardDistance.innerText = fmtNum(finalScore) + "m";
        this.ui.runCardBest.hidden = !s.isNewBest;
        this.ui.runCardStats.innerHTML = this.statTilesHTML(stats);
        this.ui.runCardUnlocks.innerHTML = (s.runUnlocks || []).map(u => `<div>${this.escapeHtml(u)}</div>`).join('');
        this.updateRunCardActions();
        this.ui.runCard.hidden = false;
        this.runCardOpen = true;
        this.runCardOpenedAt = performance.now();
        this.updateAdButtons();
    }

    // PLAY AGAIN and the note under it, kept in step with the party while
    // the card is up: in co-op only a leader with someone to play with can
    // restart, a guest waits for the leader, and once the party is gone the
    // card says why instead of waiting forever.
    updateRunCardActions() {
        let note = '';
        if (this.state.multiplayer) {
            if (!this.inParty()) note = this.partyEndNote || "THE PARTY HAS ENDED";
            else if (!this.state.isHost) note = "WAITING FOR THE LEADER...";
            else if (this.party.length < 2) note = "WAITING FOR PLAYERS...";
        }
        const canRestart = !this.state.multiplayer || (this.state.isHost && this.party.length >= 2);
        this.ui.runAgainBtn.hidden = !canRestart;
        this.ui.runCardWait.innerText = note;
        this.ui.runCardWait.hidden = !note;
    }

    // [value, LABEL] pairs as the stat tiles of the run card and Records.
    // A third `true` marks a value that is already markup (a count with
    // its icon).
    statTilesHTML(rows) {
        return rows.map(([value, label, markup]) =>
            `<div class="run-stat"><span class="run-stat-value">${markup ? value : this.escapeHtml(value)}</span>` +
            `<span class="run-stat-label">${label}</span></div>`).join('');
    }

    // Space/Enter on the end-of-run card: PLAY AGAIN, unless a button has
    // keyboard focus (tabbing to MENU and pressing Enter means MENU), and
    // never from a key still held from the run (that arrives as a repeat).
    handleRunCardKey(e) {
        const confirm = e.code === 'Space' || e.code === 'Enter' || e.code === 'NumpadEnter';
        if (!confirm || e.repeat || this.settingsOpen || this.ui.runAgainBtn.hidden) return false;
        if (e.target && e.target.closest && e.target.closest('button')) return false;
        if (this.input && this.input.isTyping(e)) return false; // the top-10 name box
        e.preventDefault();
        this.runCardPlayAgain();
        return true;
    }

    // Seconds of actual play in this run (time spent paused doesn't count).
    runSeconds() {
        let paused = this.state.pausedMs || 0;
        if (this.state.paused && this.pauseStartedAt) paused += performance.now() - this.pauseStartedAt;
        return Math.max(0, (performance.now() - this.state.runStartTime - paused) / 1000);
    }

    closeRunCard() {
        this.ui.runCard.hidden = true;
        this.runCardOpen = false;
        this.showLeftover = false; // back to the menu's own scene
        this.setMenuOpen(true);
        this.updateAdButtons();
    }

    runCardPlayAgain() {
        this.closeRunCard();
        if (this.state.multiplayer) {
            if (this.state.isHost) this.ui.mpStartBtn.onclick();
        } else {
            this.requestSoloStart();
        }
    }

    // Keyboard shortcuts only apply on the solo menu itself: never mid-run,
    // never from a held (auto-repeating) key left over from the last run,
    // never while typing, and never under the revive prompt.
    canQuickStart(e) {
        return this.canMenuKey(e, 'sp');
    }

    // The same rules for any menu panel's keys (the solo menu, the shop).
    canMenuKey(e, panel) {
        if (e.repeat || this.state.running || this.ads.playing) return false;
        if (this.activeMenuPanel !== panel || this.runCardOpen || this.settingsOpen || this.hourlyOpen || this.buyConfirmOpen) return false;
        const revive = this.ads && this.ads.reviveOverlay;
        if (revive && revive.style.display === 'flex') return false;
        const t = e.target;
        if (t && t.closest && t.closest('input, textarea, select, a')) return false;
        return true;
    }

    // A solo start from the menu (click, tap or key). While in a co-op party
    // the party screen is the place to be, so go back there instead.
    requestSoloStart() {
        if (this.state.running) return;
        if (this.inParty()) {
            this.ui.toMpBtn.onclick();
            return;
        }
        this.enterFullscreen();
        this.startGame();
    }

    // Shows one top-level menu panel ('sp' | 'mp' | 'shop'). The others are
    // made inert, so Tab and screen readers can't wander into off-screen
    // pages (focusing one also scrolled the clipped wrapper).
    setMenuPanel(panel) {
        this.activeMenuPanel = panel;
        const sp = this.ui.menu, mp = this.ui.menuLayer2, shop = this.ui.shopLayer, records = this.ui.recordsLayer, pixels = this.ui.pixelsLayer;
        if (pixels) pixels.style.transform = panel === 'pixels' ? 'translateY(0)' : 'translateY(100%)';
        if (pixels) pixels.inert = panel !== 'pixels';
        if (sp) sp.style.transform = panel === 'mp' ? 'translateX(-100%)' : 'translateX(0)';
        if (mp) mp.style.transform = panel === 'mp' ? 'translateX(0)' : 'translateX(100%)';
        if (shop) shop.style.transform = panel === 'shop' ? 'translateY(0)' : 'translateY(100%)';
        if (records) records.style.transform = panel === 'records' ? 'translateY(0)' : 'translateY(100%)';
        if (sp) sp.inert = panel !== 'sp';
        if (mp) mp.inert = panel !== 'mp';
        if (shop) shop.inert = panel !== 'shop';
        if (records) records.inert = panel !== 'records';
        // The relay note is menu-only context: restore it whenever the co-op
        // page opens (the fetch may have failed before it was ever shown).
        if (panel === 'mp') this.renderRelayNote();
    }

    escapeHtml(str) {
        return String(str).replace(/[&<>"']/g, c => ({
            '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;'
        }[c]));
    }

    // Share of the local player's power-up time left (0-1). Measured
    // against the stretched duration, or long-lasting power Pixels would
    // start with an overflowing bar.
    powerFraction(perks) {
        const power = this.player.activePower;
        if (!power) return 0;
        const fullTime = power.time * (perks.powerDurationMult || 1);
        return Math.max(0, Math.min(1, this.player.powerTimer / fullTime));
    }

    // The power-up bar: your own, or while you're down in co-op, the
    // teammate you're spectating (a dead player's own power is frozen).
    updatePowerHud(perks) {
        let power = this.player.activePower;
        let frac = this.powerFraction(perks);
        let owner = '';
        if (this.state.multiplayer && this.player.isDead) {
            const rp = this.spectatingPlayer;
            power = rp ? rp.activePower : null;
            frac = rp ? rp.powerFrac || 0 : 0;
            owner = rp ? (rp.name || 'PLAYER') + ': ' : '';
        }
        // Written only on a change: this runs every frame.
        const hud = this.powerHud || (this.powerHud = {});
        const label = power ? owner + power.name : null;
        if (label !== hud.label) {
            hud.label = label;
            this.ui.power.style.opacity = power ? 1 : 0;
            if (power) {
                this.ui.powerText.innerText = label;
                this.ui.powerText.style.color = power.color;
                this.ui.powerFill.style.backgroundColor = power.color;
            }
        }
        const width = power ? Math.round(frac * 200) / 2 : -1; // to half a percent
        if (power && width !== hud.width) this.ui.powerFill.style.width = width + "%";
        hud.width = width;
    }

    // Spends one banked heart. Returns false when the bank is empty.
    consumeHeart() {
        if (this.state.hearts <= 0) return false;
        this.setHearts(this.state.hearts - 1);
        return true;
    }

    // The equipped Pixel's heart cap (heartCapFor).
    heartCap() {
        return heartCapFor(SKINS[this.viewParams.skinIndex] || SKINS[0]);
    }

    // In a run `hearts` is the hearts you have; between runs it is the hearts
    // bought for the next one (lp_hearts), so only the latter is saved.
    setHearts(n) {
        this.state.hearts = Math.max(0, Math.min(this.heartCap(), n));
        if (!this.state.running) saveItem('lp_hearts', this.state.hearts);
        this.updateHeartUI();
    }

    // "Can't do that" feedback on the control that was pressed.
    shakeUI(el) {
        if (!el || !el.classList) return;
        el.classList.remove('shake');
        void el.offsetWidth; // restart the animation
        el.classList.add('shake');
        if (el.addEventListener) el.addEventListener('animationend', () => el.classList.remove('shake'), { once: true });
    }

    // Centralized system alert popup (run status, revive countdowns, boss rewards, etc).
    // Auto-hides 4s after the *last* call, so it always reads as fresh
    // information rather than stale text left on screen — a countdown that
    // calls this every second just keeps resetting the timer, so it stays up
    // continuously and disappears 4s after the final update.
    // `icon` (markup, e.g. from pixelPreviewHTML) replaces the type's emoji.
    showAlert(text, type = 'info', { icon: custom = null } = {}) {
        const icons = { info: 'gear', success: 'check', warning: 'clock', danger: 'alert', reward: 'trophy', pulse: 'clock', unlock: 'medal', life: 'heart', heart: 'heart' };
        const el = this.ui.alert;
        el.classList.remove('alert-info', 'alert-success', 'alert-warning', 'alert-danger', 'alert-reward', 'alert-pulse', 'alert-unlock', 'alert-life', 'alert-heart');
        el.classList.add('alert-' + type, 'alert-visible');
        if (custom) {
            this.ui.alertIcon.innerHTML = custom;
        } else {
            this.ui.alertIcon.innerHTML = icon(icons[type] || icons.info);
        }
        this.ui.alertText.innerText = text;

        if (this.alertHideTimer) clearTimeout(this.alertHideTimer);
        this.alertHideTimer = setTimeout(() => this.hideAlert(), 4000);
    }

    // One-shot notices (biome changes, unlocks, rewards) take turns in the
    // alert box instead of overwriting each other: a secret Pixel unlocks on
    // the very frame its biome is entered.
    notify(text, type = 'info', opts = {}) {
        this.noticeQueue.push({ text, type, opts });
        if (!this.noticeTimer) this.showNextNotice();
    }

    showNextNotice() {
        const next = this.noticeQueue.shift();
        if (!next) { this.noticeTimer = null; return; }
        this.showAlert(next.text, next.type, next.opts);
        this.noticeTimer = setTimeout(() => this.showNextNotice(), 2200);
    }

    clearNotices() {
        this.noticeQueue = [];
        if (this.noticeTimer) clearTimeout(this.noticeTimer);
        this.noticeTimer = null;
        this.hideBiomeBanner();
    }

    // Entering a biome: its name sweeps in across the playfield in the
    // biome's colour, with what's new there underneath, then fades.
    showBiomeBanner(biome) {
        const el = this.ui.biomeBanner;
        if (!el) return;
        this.ui.biomeName.innerText = biome.name.toUpperCase();
        this.ui.biomeNote.innerText = biome.note || '';
        this.paintBiomeBanner(biome);
        el.classList.remove('show');
        void el.offsetWidth; // restart the entrance if one is still up
        el.classList.add('show');
        clearTimeout(this.biomeBannerTimer);
        this.biomeBannerTimer = setTimeout(() => this.hideBiomeBanner(), 3200);
    }

    // The banner is three pictures, drawn here once: the name (glowing, on
    // a dark band), the two lines it sits between, and the note under it.
    // The CSS then only moves and fades them. As page text, the name's glow
    // was blurred afresh on every frame it was up, and cost frames.
    paintBiomeBanner(biome) {
        const { biomeBand: band, biomeLines: lines, biomeTag: tag, biomeBanner: box } = this.ui;
        if (!band || !band.getContext || !lines || !tag) return;
        const W = Math.max(200, Math.round((this.renderer.cssScale || 1) * CONFIG.WIDTH));
        const dpr = Math.max(1, Math.min(window.devicePixelRatio || 1, 2));
        const color = biome.platform, name = biome.name.toUpperCase(), note = (biome.note || '').toUpperCase();
        const size = Math.max(20, Math.min(48, W * 0.085)), small = Math.max(13, Math.min(17, W * 0.03));
        const pad = 34;                        // room for the glow
        const bandH = Math.round(size * 1.25) + 24, tagH = Math.round(small * 1.4) + 6;
        const fit = (c, top, h) => {
            c.width = Math.round(W * dpr);
            c.height = Math.round(h * dpr);
            c.style.width = W + 'px';
            c.style.height = h + 'px';
            c.style.top = top + 'px';
            const ctx = c.getContext('2d');
            ctx.scale(dpr, dpr);
            return ctx;
        };
        // Letters drawn one by one, to space them out.
        const spaced = (ctx, text, y, gap) => {
            const chars = [...text], widths = chars.map(ch => ctx.measureText(ch).width);
            let x = W / 2 - (widths.reduce((a, b) => a + b, 0) + gap * (chars.length - 1)) / 2;
            chars.forEach((ch, i) => { ctx.fillText(ch, x, y); x += widths[i] + gap; });
        };
        const across = (ctx, stops) => {
            const grad = ctx.createLinearGradient(0, 0, W, 0);
            stops.forEach(([at, c]) => grad.addColorStop(at, c));
            return grad;
        };

        let ctx = fit(band, -pad, bandH + pad * 2);
        ctx.fillStyle = across(ctx, [[0, 'rgba(2, 4, 10, 0)'], [0.25, 'rgba(2, 4, 10, 0.55)'], [0.75, 'rgba(2, 4, 10, 0.55)'], [1, 'rgba(2, 4, 10, 0)']]);
        ctx.fillRect(0, pad, W, bandH);
        ctx.font = '900 ' + size + 'px Orbitron, "Courier New", monospace';
        ctx.textBaseline = 'middle';
        ctx.textAlign = 'left';
        ctx.fillStyle = '#fff';
        // The glow, back to front, then the letters clean on top.
        for (const [blur, dy, shade] of [[0, 2, 'rgba(0, 0, 0, 0.6)'], [28, 0, color], [10, 0, color], [0, 0, null]]) {
            ctx.shadowColor = shade || 'rgba(0, 0, 0, 0)';
            ctx.shadowBlur = blur * dpr;
            ctx.shadowOffsetY = dy * dpr;
            spaced(ctx, name, pad + bandH / 2 + 1, size * 0.26);
        }

        ctx = fit(lines, -pad, bandH + pad * 2);
        ctx.fillStyle = across(ctx, [[0, 'rgba(0, 0, 0, 0)'], [0.3, color], [0.5, '#fff'], [0.7, color], [1, 'rgba(0, 0, 0, 0)']]);
        ctx.shadowColor = color;
        ctx.shadowBlur = 10 * dpr;
        ctx.fillRect(0, pad, W, 2);
        ctx.fillRect(0, pad + bandH - 2, W, 2);

        ctx = fit(tag, bandH + 10, tagH);
        if (note) {
            ctx.font = '700 ' + small + 'px "Chakra Petch", Orbitron, sans-serif';
            ctx.textBaseline = 'middle';
            ctx.textAlign = 'left';
            const gap = small * 0.14;
            const wide = [...note].reduce((sum, ch) => sum + ctx.measureText(ch).width + gap, 0) + 24;
            ctx.fillStyle = 'rgba(2, 4, 10, 0.6)';
            ctx.beginPath();
            addRoundRect(ctx, (W - wide) / 2, 0, wide, tagH, tagH / 2);
            ctx.fill();
            ctx.fillStyle = color;
            spaced(ctx, note, tagH / 2 + 1, gap);
        }
        if (box && box.style) box.style.height = (bandH + 10 + tagH) + 'px';
    }

    hideBiomeBanner() {
        clearTimeout(this.biomeBannerTimer);
        this.biomeBannerTimer = null;
        if (this.ui.biomeBanner) this.ui.biomeBanner.classList.remove('show');
    }

    hideAlert() {
        if (this.alertHideTimer) {
            clearTimeout(this.alertHideTimer);
            this.alertHideTimer = null;
        }
        this.ui.alert.classList.remove('alert-visible');
    }

    getDailySeed() {
        const d = new Date();
        return d.getFullYear() * 10000 + (d.getMonth() + 1) * 100 + d.getDate();
    }

    seededRandom() {
        this.state.seed = (this.state.seed * 9301 + 49297) % 233280;
        return this.state.seed / 233280;
    }

    // Visual state for the SAFETY NET trampoline drawn across the bottom of the
    // screen. `deploy` eases the net in and out with the power-up; `impact`,
    // `impactX` and `phase` drive the decaying wobble after each bounce.
    makeSafetyNetState() {
        return { deploy: 0, impact: 0, impactX: CONFIG.WIDTH / 2, phase: 0, expiring: false, rescue: false };
    }

    updateSafetyNet(dt) {
        const net = this.safetyNet;
        const power = this.player.activePower === POWERS.SAFETY;
        if (this.state.rescueNetT > 0) this.state.rescueNetT = Math.max(0, this.state.rescueNetT - dt);
        // The power's own (purple) net takes over from a red rescue net.
        if (power) net.rescue = false;
        const active = power || this.state.rescueNetT > 0;

        net.deploy = active
            ? Math.min(1, net.deploy + 0.08 * dt)
            : Math.max(0, net.deploy - 0.06 * dt);
        // Warn over the last ~2.5 seconds. A fixed window rather than a fraction
        // of the timer, since skin abilities can stretch the power's duration.
        net.expiring = power && this.player.powerTimer < 150;

        if (net.impact > 0) {
            net.phase += 0.5 * dt;
            net.impact *= Math.pow(0.94, dt);
            if (net.impact < 0.01) { net.impact = 0; net.phase = 0; }
        }
    }

    // The run's score in meters: real height climbed plus any SCORE x2 bonus.
    runScore() {
        return Math.floor((this.state.score + (this.state.bonusScore || 0)) / 10);
    }

    // EMP perk: every N seconds, wipe every drone on screen (regular, shooter
    // and laser drones) and every bullet in flight. The boss and the biome's
    // meteors are immune. Solo only: in co-op the host owns every enemy and
    // guests only draw mirrors of them, so a guest's pulse would just hide
    // drones that are still there for everyone else.
    updateDronePulse(dt, perks) {
        if (!perks.dronePulseSec || this.state.multiplayer) return;
        this.state.pulseTimer = (this.state.pulseTimer || 0) + dt;
        if (this.state.pulseTimer < perks.dronePulseSec * 60) return;
        this.state.pulseTimer = 0;

        let hits = 0;
        this.enemies.forEach(e => {
            if (!(e instanceof Drone || e instanceof LaserDrone) || e.hidden) return;
            if (e.y + e.h < 0 || e.y > CONFIG.HEIGHT) return;
            e.markedForDeletion = true;
            this.particles.spawn(e.x + e.w / 2, e.y + e.h / 2, "#00ff99", 15, "blast");
            hits++;
        });
        this.projectiles.forEach(p => { if (p instanceof Projectile) p.markedForDeletion = true; });
        if (hits) sounds.play('reward');
    }

    // The player the boss hovers over: the lowest one still alive (the one the
    // camera follows), so in co-op it never parks over someone's corpse.
    bossFocus() {
        let focus = this.player.isDead ? null : this.player;
        this.remotePlayers.forEach(rp => {
            if (!rp.isDead && !this.remoteAway(rp) && (!focus || rp.y > focus.y)) focus = rp;
        });
        return focus || this.player;
    }

    // Touching the boss. Landing on top of it (falling, feet near its top edge,
    // or feet above it last frame so a fast fall can't tunnel through) deals a
    // hit (unless it is mid-flash) and launches you like a spring platform.
    // Otherwise a jetpack or HARD SHIELD absorbs the
    // crash (the boss survives: it can't be rammed to death), and while it's
    // exposed at your level a side bump only knocks you back. Anything else
    // is fatal.
    resolveBossContact(boss) {
        const p = this.player;
        const feet = p.y + p.h;
        const onTop = p.vy > 0 && (feet < boss.y + 40 || (p.prevBottom !== undefined && p.prevBottom <= boss.y + 12));
        if (onTop) {
            p.y = boss.y - p.h;
            // Damaging or not, a stomp always throws you up like a spring.
            let shake = false;
            if (!this.isAuthority()) {
                // Co-op guest: the host owns the boss's health. Report the
                // stomp, but not again during its flash.
                if (!(boss.invuln > 0 || boss.localInvuln > 0)) {
                    boss.localInvuln = BOSS.HIT_INVULN;
                    window.network.send({ type: 'stomp', nid: boss.nid });
                    this.particles.spawn(boss.x + boss.w / 2, boss.y + boss.h / 2, "#fff", 30, "blast");
                    shake = true;
                }
            } else {
                shake = boss.takeDamage(this.particles);
            }
            p.springLaunch();
            sounds.play('spring');
            if (shake) this.addShake(8);
            return;
        }
        if (p.activePower === POWERS.ROCKET || p.activePower === POWERS.SHIELD) {
            const color = p.activePower.color;
            p.activePower = null;
            p.powerTimer = 0;
            p.invuln = 45;
            this.knockBackFrom(boss);
            this.particles.spawn(p.x, p.y, color, 20, "blast");
            sounds.play('reward');
            return;
        }
        if (boss.isExposed()) {
            p.invuln = 30;
            this.knockBackFrom(boss);
            this.addShake(6);
            sounds.play('hit');
            return;
        }
        this.die(true);
    }

    // A jetpack or HARD SHIELD takes a drone, laser or bullet out in place
    // of the player: the power is spent, and a short grace period (like the
    // one after bumping the boss) stops the next shot of the same volley
    // from killing them a frame later. True if the hit was absorbed.
    absorbHit(obj) {
        const p = this.player;
        const power = p.activePower;
        if (power !== POWERS.ROCKET && power !== POWERS.SHIELD) return false;
        p.activePower = null;
        p.powerTimer = 0;
        p.invuln = ABSORB_INVULN_FRAMES;
        this.destroyHostile(obj);
        this.addShake(7);
        this.particles.spawn(p.x, p.y, power.color, 20, "blast");
        sounds.play('reward');
        return true;
    }

    // SMASH: a drone or bot that touches the Pixel dies instead of hurting it.
    // Lasers, meteors, projectiles and the boss are not drones. In co-op a
    // guest's kill goes to the host as a `hit` (see destroyHostile).
    smashHit(e) {
        if (!(this.player.skin.ability || {}).smash || !(e instanceof Drone)) return false;
        this.destroyHostile(e);
        this.addShake(4);
        this.particles.spawn(e.x + e.w / 2, e.y + e.h / 2, '#ff6b35', 15, "blast");
        sounds.play('reward');
        return true;
    }

    knockBackFrom(boss) {
        const p = this.player;
        p.vx = (p.x + p.w / 2 < boss.x + boss.w / 2) ? -9 : 9;
        p.vy = -6;
    }

    // Boss down: bonus distance on the scoreboard (not the camera, so
    // biomes don't skip and co-op stays aligned), a gem bounty, and the next
    // boss a full loop further on.
    onBossDefeated() {
        this.state.bossActive = false;
        this.state.runLoops = (this.state.runLoops || 0) + 1;
        this.state.loops = (this.state.loops || 0) + 1;
        saveItem('lp_loops', this.state.loops);
        this.state.bonusScore += BOSS_BONUS_METERS * 10;
        this.addGems(BOSS_GEM_BOUNTY);
        this.setHearts(this.heartCap());
        this.state.nextBossAt = Math.floor(this.state.score / 10) + CONFIG.BOSS_LOOP_DISTANCE;
        this.notify(`TITAN DOWN  +${BOSS_BONUS_METERS}m  +${BOSS_GEM_BOUNTY} GEMS  HEARTS FULL`, 'reward');
        sounds.play('reward');
        portal.happytime();
    }

    // Banks gems and pops the counter.
    addGems(n) {
        this.state.gems += n;
        if (this.state.running) this.state.runGems = (this.state.runGems || 0) + n;
        saveItem('lp_gems', this.state.gems);
        if (this.ui.gemDisplay) {
            this.ui.gemDisplay.innerHTML = counted(fmtNum(this.state.gems), 'gem');
            this.ui.gemDisplay.classList.remove('gem-pop');
            void this.ui.gemDisplay.offsetWidth; // restart animation on rapid pickups
            this.ui.gemDisplay.classList.add('gem-pop');
        }
    }

    // A spent life or revive: a red rescue net springs up for a second and
    // bounces the player back in from the bottom of the screen.
    deployRescueNet() {
        this.state.rescueNetT = RESCUE_NET_FRAMES;
        this.safetyNet.rescue = true;
        this.player.y = CONFIG.HEIGHT - 60;
        this.player.launch(CONFIG.BOUNCE_FORCE);
        this.bounceSafetyNet();
    }

    // A fall onto a deployed net (the SAFETY NET power, or a rescue net still
    // up) bounces instead of killing. Enemy hits aren't caught. True if caught.
    catchWithNet(forceDie) {
        if (forceDie || !(this.player.activePower === POWERS.SAFETY || this.state.rescueNetT > 0)) return false;
        this.player.y = CONFIG.HEIGHT - 60;
        this.player.vy = CONFIG.BOUNCE_FORCE;
        this.bounceSafetyNet();
        this.particles.spawn(this.player.x, CONFIG.HEIGHT, this.safetyNet.rescue ? RESCUE_NET_COLOR : POWERS.SAFETY.color, 30);
        return true;
    }

    // Kick the trampoline into its bounce wobble, centred on where the player
    // hit it.
    bounceSafetyNet() {
        this.safetyNet.deploy = 1;
        this.safetyNet.impactX = this.player.x + 13;
        this.safetyNet.impact = 1;
        this.safetyNet.phase = 0;
        sounds.play('jump');
    }

    reset(seed = null) {
        this.state.score = 0;
        this.state.dying = 0; // a run ended mid-shatter must not carry it over
        // The Void's exclusive ability lets equipped runs start already at The
        // Rift, skipping the early game — single-player only, never in co-op.
        const equippedAbility = (SKINS[this.viewParams.skinIndex] && SKINS[this.viewParams.skinIndex].ability) || {};
        if (seed === null && equippedAbility.startAtScore) {
            this.state.score = equippedAbility.startAtScore;
        }
        this.state.bonusScore = 0;
        this.state.pulseTimer = 0;
        this.state.bossActive = false;
        this.state.time = 0;
        // Spawn/animation clocks in 60fps-frame units of game time (see
        // tick()), so pacing is the same at 60, 120 or 144Hz.
        this.state.timers = { drone: 0, laser: 0, meteor: 0, trail: 0, sync: 0, snap: 0 };
        this.state.revived = false;
        // Multiplayer passes an explicit shared seed so host/guest generate
        // identical platform layouts; single-player falls back to the daily seed.
        this.state.seed = seed !== null ? seed : this.getDailySeed();
        // state.seed is the running RNG state from here on; these two are
        // what identify the layout (for the ghost).
        this.state.runSeed = this.state.seed;
        this.state.startMeters = Math.floor(this.state.score / 10);
        // Bosses beaten this run (drives drone difficulty) and where the next
        // one appears. Measured from the start height, so a checkpoint start
        // (The Void, 5000m) doesn't open straight into a boss.
        this.state.runLoops = 0;
        this.state.nextBossAt = this.state.startMeters + CONFIG.BOSS_LOOP_DISTANCE;
        this.state.powersCollected = 0;
        this.state.isNewBest = false;
        this.state.paused = false;
        // Run summary counters (end-of-run card and lifetime stats).
        this.state.runGems = 0;
        this.state.runDeaths = 0;
        this.state.runUnlocks = [];
        // Solo runs race (and record) a ghost of your previous run on this
        // exact layout (see saveGhost); co-op has none.
        this.ghostRec = this.state.multiplayer ? null : { nextT: 0, pts: [] };
        this.ghostPlayback = this.state.multiplayer ? null : this.loadGhost();

        const startDisplayScore = Math.floor(this.state.score / 10);
        this.renderer.updateBiome(startDisplayScore);
        this.lastBiomeName = this.renderer.currentBiome.name;

        this.lastTime = performance.now();

        // Standing on the launch pad, where the menu showed it waiting.
        this.player = new Player(CONFIG.WIDTH / 2, CONFIG.HEIGHT - 40 - 26, this.viewParams.skinIndex);

        saveItem('lp_skin', SKINS[this.viewParams.skinIndex].id);

        this.enemies = [];
        this.projectiles = [];
        this.state.nextMilestone = nextMilestone(this.state.startMeters);
        this.state.heartBlockWY = null;
        this.state.rescueNetT = 0;
        // The high score before this run, marked in the level so you can see
        // yourself pass it (highScore itself climbs along with you).
        this.state.bestMarkerScore = this.state.highScore || 0;
        // Beginner tips are painted onto the starting screen (world space), so
        // they scroll away as you climb past them.
        this.shownScore = this.shownBest = null; // the HUD numbers are rewritten
        this.state.tipAnchorWY = -this.state.score;
        this.startLevel();
        this.particles = new ParticleSystem();
        this.particles.scale = this.settings.reducedMotion ? 0.35 : 1;
        this.clearFx();
        this.safetyNet = this.makeSafetyNetState();
        this.remotePlayers = new Map();
        // Co-op enemies: the host numbers everything it spawns; guests keep
        // mirrored copies by that number, plus tombstones for their own kills.
        this.nextNid = 0;
        this.netEnemies = new Map();
        this.tombstones = new Map();
        this.state.diveTurn = 0;
        this.spectating = null;
        this.spectatingPlayer = null;

        this.ui.power.style.opacity = 0;
        this.powerHud = null;
        this.clearNotices();
        this.hideAlert();
    }

    // ------------------------------------------------------------ menu scene
    // Behind the menu: the first screen of your next solo run, exactly as
    // the run will begin, with your Pixel waiting on the launch pad. Pressing
    // start carries straight on from it. It is a preview (previewFirstScreen):
    // nothing of the game's own state is touched. Shown until a run starts,
    // and again once its run card is closed.
    menuSceneShown() {
        return !this.state.running && !this.showLeftover;
    }

    // With the menu open the scenery fills the window; a run brings the
    // column's borders in (the CSS slides them, see .menu-open).
    setMenuOpen(open) {
        const container = this.renderer.canvas.parentElement;
        if (container && container.classList) container.classList.toggle('menu-open', open);
    }

    makeMenuScene() {
        const floorY = CONFIG.HEIGHT - 40;
        this.menuScene = {
            floorY,
            level: this.previewFirstScreen(),
            pixel: new Player(CONFIG.WIDTH / 2, floorY - 26, this.viewParams.skinIndex),
            hopIn: 90
        };
        this.menuScene.pixel.grounded = true;
    }

    updateMenuScene(dt) {
        const m = this.menuScene, p = m.pixel;
        const skin = SKINS[this.viewParams.skinIndex] || SKINS[0];
        if (p.skin !== skin) p.setSkin(this.viewParams.skinIndex);
        // A new day, or a Pixel that starts somewhere else: a new first screen.
        if (m.level.key !== this.getDailySeed() + ':' + this.soloStartScore()) m.level = this.previewFirstScreen();
        m.hopIn -= dt;
        if (p.grounded && m.hopIn <= 0 && !this.settings.reducedMotion) {
            // A little hop on the spot, glancing left or right.
            p.vy = -4.5 - Math.random() * 2;
            p.vx = [-1, 0, 1][Math.floor(Math.random() * 3)];
            p.grounded = false;
            p.bump(0.14);
            m.hopIn = 80 + Math.random() * 160;
        }
        if (!p.grounded) {
            p.vy += CONFIG.GRAVITY * dt;
            p.y += p.vy * dt;
            if (p.y >= m.floorY - 26) {
                p.y = m.floorY - 26;
                p.bump(-Math.min(0.28, 0.06 + p.vy * 0.015));
                this.particles.dust(p.x + 13, p.y + 26, biomeAt(m.level.score / 10).platform, 5);
                p.vy = 0;
                p.grounded = true;
            }
        }
        p.animate(dt);
        this.particles.update(dt);
    }

    drawMenuScene(ctx) {
        const t = this.sceneClock, m = this.menuScene, level = m.level;
        const biome = biomeAt(level.score / 10), biomeIndex = BIOMES.indexOf(biome);
        this.renderer.clear(this.state.bgOffset, t, level.score, m.floorY);
        this.renderer.drawGrid(this.state.bgOffset);
        level.platforms.forEach(p => {
            if (p.y > CONFIG.HEIGHT || p.y + p.h + 20 < this.renderer.viewTop) return;
            drawPlatform(ctx, p, p.y, biome, biomeIndex, t);
            if (p.type) drawPlatformType(ctx, p, p.y, t);
        });
        const hearts = this.state.hearts < this.heartCap();
        this.drawPickups(level.powerups.filter(p => hearts || !p.isHeart), t);
        m.pixel.draw(ctx);
        this.particles.draw(ctx);
    }

    // Short-lived effects drawn over the level, none of which touch the
    // game itself: floating pickup text, burst rings, the Pixel's
    // afterimages and the screen shake.
    clearFx() {
        this.floaters = [];
        this.rings = [];
        this.afterimages = [];
        this.shake = 0;
    }

    // Shakes the screen (px), unless reduced motion is on.
    addShake(px) {
        if (this.settings.reducedMotion) return;
        this.shake = Math.max(this.shake || 0, px);
    }

    // "+5" rising from a pickup, inside a ring bursting outwards.
    popPickup(x, y, color, text = null) {
        if (!this.settings.reducedMotion) this.rings.push({ x, y, color, life: 16, maxLife: 16 });
        if (text) this.floaters.push({ x, y: y - 10, color, text, life: 42, maxLife: 42 });
    }

    updateFx(dt) {
        if (this.shake > 0) {
            this.shake *= Math.pow(0.82, dt);
            if (this.shake < 0.3) this.shake = 0;
        }
        const age = (list, move) => {
            for (let i = list.length - 1; i >= 0; i--) {
                list[i].life -= dt;
                if (list[i].life <= 0) list.splice(i, 1);
                else if (move) move(list[i]);
            }
        };
        age(this.floaters, f => { f.y -= 0.9 * dt; });
        age(this.rings);
        age(this.afterimages);
    }

    // The Pixel touched down: dust in the platform's colour, a soft thud
    // and a dip in the platform, all scaled by how hard it landed.
    onLanded(impact) {
        const p = this.player;
        if (impact < 3) return;
        this.particles.dust(p.x + 13, p.y + 26, this.renderer.currentBiome.platform, impact > 9 ? 8 : 5);
        if (p.standOn && p.standOn.h < 30) p.standOn.dip = Math.min(4, impact * 0.3);
        sounds.play('land');
    }

    drawFx(ctx) {
        for (const r of this.rings) {
            const t = 1 - r.life / r.maxLife;
            ctx.globalAlpha = (1 - t) * 0.8;
            ctx.strokeStyle = r.color;
            ctx.lineWidth = 3 * (1 - t) + 1;
            ctx.beginPath();
            ctx.arc(r.x, r.y, 6 + t * 26, 0, Math.PI * 2);
            ctx.stroke();
        }
        ctx.save();
        ctx.textBaseline = 'middle';
        for (const f of this.floaters) {
            ctx.globalAlpha = Math.min(1, f.life / (f.maxLife * 0.4));
            this.renderer.drawText(f.text, f.x, f.y, 'bold 15px Orbitron, "Courier New", monospace', f.color);
        }
        ctx.restore();
        ctx.globalAlpha = 1;
    }

    // Fading copies of the Pixel's body left behind at speed.
    drawAfterimages(ctx) {
        if (!this.afterimages.length) return;
        ctx.fillStyle = this.player.color;
        for (const a of this.afterimages) {
            ctx.globalAlpha = 0.28 * (a.life / a.maxLife);
            ctx.beginPath();
            addRoundRect(ctx, a.x, a.y, 26, 26, PIXEL_CORNER_RADIUS);
            ctx.fill();
        }
        ctx.globalAlpha = 1;
    }

    // The start of a level at the current seed and height: the launch floor
    // and the first screen of platforms above it.
    startLevel() {
        // Pickups are cleared *before* the first screen of platforms is built,
        // or the gems and power-ups spawned on it would be thrown away.
        this.powerups = [];
        this.platforms = [{ x: 0, y: CONFIG.HEIGHT - 40, w: CONFIG.WIDTH, h: 40 }];
        // World y of the next platform to generate (screen y = wy + score).
        // An integer counter, so every co-op client derives identical heights.
        this.state.nextPlatWY = (CONFIG.HEIGHT - 140) - this.state.score;
        this.state.prevPlat = null;
        this.state.lastCrumble = false;
        this.state.lastHeartWY = null;
        this.fillPlatforms();
    }

    // The height a solo run with the equipped Pixel starts at (px): 0, or The
    // Void's checkpoint.
    soloStartScore() {
        const skin = SKINS[this.viewParams.skinIndex];
        return (skin && skin.ability && skin.ability.startAtScore) || 0;
    }

    // What the next solo run's first screen will be, for the menu to show:
    // { key, score, platforms, powerups }. It runs the real generator on
    // today's seed, then puts back everything the generator touched, so
    // the game's own state is left exactly as it was.
    previewFirstScreen() {
        const s = this.state;
        const keep = {
            seed: s.seed, score: s.score, nextPlatWY: s.nextPlatWY, lastHeartWY: s.lastHeartWY,
            prevPlat: s.prevPlat, lastCrumble: s.lastCrumble, platforms: this.platforms, powerups: this.powerups
        };
        s.seed = this.getDailySeed();
        s.score = this.soloStartScore();
        const key = s.seed + ':' + s.score;
        this.startLevel();
        const out = { key, score: s.score, platforms: this.platforms, powerups: this.powerups };
        this.platforms = keep.platforms;
        this.powerups = keep.powerups;
        delete keep.platforms;
        delete keep.powerups;
        Object.assign(s, keep);
        return out;
    }

    // Level generation. Everything a platform (and its pickup) gets is decided
    // by its own world height `wy` (screen y minus score; more negative is
    // higher) plus the seeded RNG, never by the camera. Co-op clients whose
    // cameras lag each other therefore still build identical levels.
    // seededRandom() is reserved for this: any other draw would desync them.
    spawnPlatform(wy) {
        const y = wy + this.state.score;
        let rand = this.seededRandom();
        let w = 100 + rand * 80;
        let x = this.seededRandom() * (CONFIG.WIDTH - w);
        let scoreMeters = Math.max(0, Math.floor(-wy / 10));
        let hazards = biomeAt(scoreMeters).hazards;

        // A spring, or a crumbling platform (never two of those in a row:
        // generation runs in height order, so every client agrees).
        let type = null;
        if (scoreMeters >= SPRING_START_METERS && this.seededRandom() < SPRING_CHANCE) {
            type = 'spring';
        } else if (scoreMeters >= CRUMBLE_START_METERS && !this.state.lastCrumble
            && this.seededRandom() < CRUMBLE_CHANCE) {
            type = 'crumble';
        }
        this.state.lastCrumble = type === 'crumble';

        let vx = 0;
        if (scoreMeters >= MOVING_START_METERS && type !== 'crumble') {
            // From MOVING_START_METERS they are few and slow, growing to
            // the old share and speed by the height they used to start at.
            const movingChance = Math.min(0.4, 0.06 + (scoreMeters - MOVING_START_METERS) / 2450 * 0.34);
            if (this.seededRandom() < movingChance) {
                const pace = 0.55 + 0.45 * Math.min(1, scoreMeters / 1800);
                vx = (this.seededRandom() > 0.5 ? 1 : -1) * (0.5 + this.seededRandom() * 1.5) * pace;
                w = Math.max(70, w - 30);
            }
        }

        const plat = { x, y, w, h: 18, vx, wy };
        if (type) plat.type = type;
        this.platforms.push(plat);

        // Power-ups are common early and level off from POWERUP_PLATEAU_METERS.
        if (this.seededRandom() < powerUpChanceAt(scoreMeters)) {
            this.powerups.push({
                x: x + w / 2 - 12,
                y: y - 40,
                startY: y - 40,
                w: 24, h: 24,
                isGem: false,
                wy,
                markedForDeletion: false
            });
        } else if (this.heartAllowedAt(wy, scoreMeters)) {
            // Always generated (so every client builds the same level), but
            // only shown to a player below their Pixel's heart cap.
            this.state.lastHeartWY = wy;
            this.powerups.push({
                x: x + w / 2 - 14,
                y: y - 40,
                startY: y - 40,
                w: 28, h: 28,
                isGem: false,
                isHeart: true,
                wy,
                markedForDeletion: false
            });
        } else if (this.seededRandom() < GEM_CHANCE) {
            // Worth more the higher the biome (by the platform's own height,
            // so every client agrees).
            const tier = biomeIndexAt(scoreMeters);
            this.powerups.push({
                x: x + w / 2 - 8,
                y: y - 30,
                startY: y - 30,
                w: 16, h: 16,
                isGem: true,
                gemValue: BIOMES[tier].gem.value,
                tier,
                wy,
                markedForDeletion: false
            });
        }

        // A trail of small gems arcing up from the platform below to this
        // one, when both stand still and aren't too far apart. Each gem's
        // `wy` is its own (the platform's plus 1, 2...): co-op tells
        // pickups apart by it.
        const prev = this.state.prevPlat;
        this.state.prevPlat = { cx: x + w / 2, wy, still: !vx };
        if (scoreMeters >= GEM_TRAIL_START_METERS && this.seededRandom() < GEM_TRAIL_CHANCE) {
            const count = 3 + Math.floor(this.seededRandom() * 3);
            const cx = x + w / 2;
            if (prev && prev.still && !vx && Math.abs(cx - prev.cx) <= 260) {
                const tier = biomeIndexAt(scoreMeters);
                for (let i = 0; i < count; i++) {
                    const t = (i + 1) / (count + 1);
                    const gx = prev.cx + (cx - prev.cx) * t;
                    const gy = prev.wy + (wy - prev.wy) * t - 34 - 26 * Math.sin(Math.PI * t) + this.state.score;
                    this.powerups.push({
                        x: gx - 6, y: gy, startY: gy,
                        w: 12, h: 12,
                        isGem: true, small: true,
                        gemValue: Math.max(1, Math.round(BIOMES[tier].gem.value / 5)),
                        tier,
                        wy: wy + i + 1,
                        markedForDeletion: false
                    });
                }
            }
        }
    }

    // Rolls for a heart on the platform at `wy`: never within HEART_MIN_GAP
    // of the last one (generation runs in height order, so this is the same
    // on every client), and rarer the higher it is.
    heartAllowedAt(wy, meters) {
        const last = this.state.lastHeartWY;
        if (last !== null && last !== undefined && last - wy < HEART_MIN_GAP) return false;
        const ramp = Math.min(1, meters / HEART_RAMP_METERS);
        return this.seededRandom() < HEART_CHANCE_START + (HEART_CHANCE_END - HEART_CHANCE_START) * ramp;
    }

    // Keeps platforms generated up to PLATFORM_LOOKAHEAD above the screen, so
    // none ever pops into view, in strict height order.
    fillPlatforms() {
        while (this.state.nextPlatWY + this.state.score > -PLATFORM_LOOKAHEAD) {
            this.spawnPlatform(this.state.nextPlatWY);
            this.state.nextPlatWY -= CONFIG.PLATFORM_BASE_GAP;
        }
    }

    // How many drones may be out at once at this height.
    droneCap(meters) {
        return Math.min(CONFIG.DRONE_CAP_MAX, CONFIG.DRONE_CAP_BASE + Math.floor(meters / CONFIG.DRONE_CAP_STEP));
    }

    // Live enemies of a class (subclasses count: a ShooterDrone is a Drone),
    // including drones waiting off-screen to swing back in.
    countEnemies(cls) {
        let n = 0;
        for (const e of this.enemies) if (e instanceof cls && !e.markedForDeletion) n++;
        return n;
    }

    // Game-time interval timer: true once per `every` frames' worth of dt
    // (60fps units) regardless of refresh rate. A long frame fires it once,
    // never as a burst of catch-up spawns.
    // New bests are kept in state while climbing and written about every two
    // seconds, on game over and when the tab hides: a synchronous
    // localStorage write per metre is main-thread I/O in the update loop.
    saveBest() {
        if (!this.bestDirty) return;
        this.bestDirty = false;
        saveItem('lp_best_height', this.state.bestHeight);
        saveItem('lp_best', this.state.highScore);
    }

    tick(name, dt, every) {
        const t = this.state.timers || (this.state.timers = {});
        t[name] = (t[name] || 0) + dt;
        if (t[name] < every) return false;
        t[name] = Math.min(t[name] - every, every);
        return true;
    }

    // Today's ghost for this exact layout, or null. A ghost recorded on
    // another day, from another start height or by an older level generator
    // would just wander through thin air.
    loadGhost() {
        const g = loadJSON('lp_ghost', null);
        if (!g || g.v !== 2 || g.gen !== PLATFORM_GEN_VERSION) return null;
        if (g.seed !== this.state.runSeed || g.start !== this.state.startMeters) return null;
        if (!Array.isArray(g.pts) || !(g.step > 0)) return null;
        return g;
    }

    // Samples the player on a fixed game-time cadence (every GHOST_STEP
    // frames of dt), so playback speed doesn't depend on the refresh rate.
    recordGhost() {
        const rec = this.ghostRec;
        if (!rec) return;
        while (this.state.time >= rec.nextT && rec.pts.length < GHOST_MAX_POINTS * 2) {
            rec.pts.push(Math.round(this.player.x), Math.round(this.player.y - this.state.score));
            rec.nextT += GHOST_STEP;
        }
    }

    // Keeps the latest solo run on today's layout, so the ghost is always
    // your previous run (loadGhost drops it once the day's seed changes).
    saveGhost(finalScore) {
        const rec = this.ghostRec;
        if (!rec || this.state.multiplayer || rec.pts.length < 4) return;
        const ghost = {
            v: 2, gen: PLATFORM_GEN_VERSION, seed: this.state.runSeed, start: this.state.startMeters,
            score: finalScore, step: GHOST_STEP, pts: rec.pts,
            skin: (SKINS[this.viewParams.skinIndex] || SKINS[0]).id
        };
        saveItem('lp_ghost', JSON.stringify(ghost)); // storage full: the old one stays
    }

    // The ghost is the recorded Pixel, dimmed, following a smooth curve
    // (Catmull-Rom) through the samples rather than straight lines, so jump
    // arcs stay round. It snaps across a screen wrap.
    drawGhost() {
        const g = this.ghostPlayback;
        if (!g) return;
        const f = this.state.time / g.step;
        const i = Math.floor(f);
        if (i * 2 + 3 >= g.pts.length) return; // the recorded run is over
        const pt = (k) => {
            const j = Math.max(0, Math.min(k, g.pts.length / 2 - 1));
            return [g.pts[j * 2], g.pts[j * 2 + 1]];
        };
        const p0 = pt(i - 1), p1 = pt(i), p2 = pt(i + 1), p3 = pt(i + 2);
        const t = f - i;
        let x = p1[0], y = p1[1];
        const wraps = [p0, p1, p2, p3].some((p, k, a) => k > 0 && Math.abs(p[0] - a[k - 1][0]) >= 300);
        if (!wraps) {
            const cr = (a, b, c, d) => 0.5 * (2 * b + (c - a) * t + (2 * a - 5 * b + 4 * c - d) * t * t + (3 * b - a - 3 * c + d) * t * t * t);
            x = cr(p0[0], p1[0], p2[0], p3[0]);
            y = cr(p0[1], p1[1], p2[1], p3[1]);
        } else if (Math.abs(p2[0] - p1[0]) < 300) {
            x += (p2[0] - p1[0]) * t;
            y += (p2[1] - p1[1]) * t;
        }
        const screenY = y + this.state.score;
        if (screenY > this.renderer.viewTop - 50 && screenY < CONFIG.HEIGHT + 50) {
            const skin = SKINS[skinIndexById(g.skin)] || SKINS[0];
            const dx = p2[0] - p1[0];
            const look = Math.abs(dx) >= 300 ? 0 : (dx > 3 ? 4 : (dx < -3 ? -4 : 0));
            const ctx = this.renderer.ctx;
            ctx.globalAlpha = 0.4;
            drawPixel(ctx, x, screenY, skin, look);
            if (x > CONFIG.WIDTH - 26) drawPixel(ctx, x - CONFIG.WIDTH, screenY, skin, look);
            ctx.globalAlpha = 1;
        }
    }

    // The beginner tips, fixed to the run's starting screen: how to move and
    // jump just above the first platform, and the screen wrap a little
    // higher. Every run shows them (SHOW TIPS in Settings turns them off).
    // Drawn under the platforms, like signs painted on the background.
    // The controls are pictures: key caps (or the touch pads) that press
    // themselves in turn, each with one word.
    drawTips() {
        const touch = this.coarsePointer;
        if (touch && !this.settings.touchControls) return this.drawTextTips();
        const ctx = this.renderer.ctx;
        const base = this.state.tipAnchorWY + this.state.score; // screen y of the run's start
        const t = this.sceneClock;
        // Labels at least TIP_MIN_SCREEN_PX tall on screen, however small
        // the playfield is shown (CrazyGames' 800x450 window shows it at ~56%).
        const k = Math.min(1.5, Math.max(1, TIP_MIN_SCREEN_PX / (15 * (this.renderer.cssScale || 1))));
        const cap = Math.round(32 * k), font = `bold ${Math.round(15 * k)}px Orbitron, "Courier New", monospace`;
        const beat = Math.floor(t / 28) % 4;
        const items = touch
            ? [{ cap: '◀', on: beat === 0 }, { cap: '▶', on: beat === 2 }, { text: 'MOVE' }, { gap: 1 },
               { cap: '▲', on: beat % 2 === 1 }, { text: 'JUMP' }]
            : [{ cap: '←', on: beat === 0 }, { cap: '→', on: beat === 2 }, { text: 'MOVE' }, { gap: 1 },
               { cap: 'SPACE', wide: 3.4, on: beat % 2 === 1 }, { text: 'JUMP' }];
        if (!touch && k <= 1.15) items.push({ gap: 1 }, { cap: 'P', on: false }, { text: 'PAUSE' });
        ctx.save();
        ctx.font = font;
        ctx.textBaseline = 'middle';
        const pad = Math.round(8 * k);
        items.forEach(it => {
            it.w = it.cap ? Math.round(cap * (it.wide || 1)) : it.text ? (ctx.measureText(it.text).width || it.text.length * 11 * k) : pad * 2;
        });
        const total = items.reduce((sum, it) => sum + it.w + pad, -pad);
        const y = base + CONFIG.HEIGHT - 188, h = cap + 26;
        if (y + h > this.renderer.viewTop && y - h < CONFIG.HEIGHT) {
            ctx.globalAlpha = 0.45;
            ctx.fillStyle = '#000';
            ctx.fillRect(0, y - h / 2, CONFIG.WIDTH, h);
            let x = (CONFIG.WIDTH - total) / 2;
            for (const it of items) {
                if (it.cap) {
                    // A key: an outlined cap that sinks and fills when pressed.
                    const top = y - cap / 2 + (it.on ? 3 : 0);
                    ctx.globalAlpha = 0.9;
                    ctx.fillStyle = it.on ? '#00ffcc' : 'rgba(0, 255, 204, 0.12)';
                    ctx.beginPath();
                    addRoundRect(ctx, x, top, it.w, cap, 6);
                    ctx.fill();
                    ctx.strokeStyle = '#00ffcc';
                    ctx.lineWidth = 2;
                    ctx.stroke();
                    if (!it.on) {
                        ctx.fillStyle = 'rgba(0, 255, 204, 0.5)';
                        ctx.fillRect(x + 4, top + cap, it.w - 8, 3);
                    }
                    const ink = it.on ? '#02211b' : '#00ffcc';
                    const dir = { '←': -1, '◀': -1, '→': 1, '▶': 1 }[it.cap];
                    if (dir || it.cap === '▲') {
                        // Arrows are drawn: the font has no glyphs for them.
                        const cx = x + it.w / 2, cy = top + cap / 2, r = cap * 0.24;
                        ctx.fillStyle = ink;
                        ctx.beginPath();
                        if (dir) {
                            ctx.moveTo(cx + dir * r, cy);
                            ctx.lineTo(cx - dir * r * 0.6, cy - r);
                            ctx.lineTo(cx - dir * r * 0.6, cy + r);
                        } else {
                            ctx.moveTo(cx, cy - r);
                            ctx.lineTo(cx - r, cy + r * 0.6);
                            ctx.lineTo(cx + r, cy + r * 0.6);
                        }
                        ctx.closePath();
                        ctx.fill();
                    } else {
                        this.renderer.drawText(it.cap, x + it.w / 2, top + cap / 2 + 1, font, ink);
                    }
                } else if (it.text) {
                    ctx.globalAlpha = 0.9;
                    this.renderer.drawText(it.text, x, y + 1, font, '#00ffcc', 'left');
                }
                x += it.w + pad;
            }
        }
        // The screen wrap, between two platforms higher up.
        const px = Math.round(Math.min(26, Math.max(15, TIP_MIN_SCREEN_PX / (this.renderer.cssScale || 1))));
        const wy = base + CONFIG.HEIGHT - 300, wh = Math.round(px * 1.45) + 14;
        if (wy + wh > this.renderer.viewTop && wy - wh < CONFIG.HEIGHT) {
            ctx.globalAlpha = 0.45;
            ctx.fillStyle = '#000';
            ctx.fillRect(0, wy - wh / 2, CONFIG.WIDTH, wh);
            ctx.globalAlpha = 0.9;
            this.renderer.drawText('THE SIDES WRAP AROUND', CONFIG.WIDTH / 2, wy, `bold ${px}px Orbitron, "Courier New", monospace`, '#00ffcc');
            // The arrows slide outwards, towards the edges they point at.
            const slide = (t * 0.4) % 12;
            this.renderer.drawText('◀', 22 - slide, wy, 'bold 20px sans-serif', '#00ffcc');
            this.renderer.drawText('▶', CONFIG.WIDTH - 22 + slide, wy, 'bold 20px sans-serif', '#00ffcc');
        }
        ctx.restore();
    }

    // The tips as lines of text: for touch players without the on-screen
    // buttons (there's no pad to picture), and the lab's "old" switch.
    drawTextTips() {
        const ctx = this.renderer.ctx;
        const base = this.state.tipAnchorWY + this.state.score; // screen y of the run's start
        const touch = this.coarsePointer;
        const tips = [
            { y: base + CONFIG.HEIGHT - 190, lines: touch
                ? (this.settings.touchControls
                    ? ['HOLD OR SLIDE ◀ ▶ TO MOVE', 'TAP ▲ TO JUMP']
                    : ['HOLD ◀ ▶ TO MOVE', 'TAP THE RIGHT HALF TO JUMP'])
                : ['← → / A D TO MOVE', 'SPACE / ↑ / W TO JUMP', 'ESC / P TO PAUSE'] },
            { y: base + CONFIG.HEIGHT - 360, lines: ['THE SIDES WRAP AROUND'], edges: true }
        ];
        // At least TIP_MIN_SCREEN_PX tall on screen, however small the
        // playfield is shown (CrazyGames' 800x450 window shows it at ~56%).
        const px = Math.round(Math.min(26, Math.max(15, TIP_MIN_SCREEN_PX / (this.renderer.cssScale || 1))));
        const lineH = Math.round(px * 1.45);
        for (const tip of tips) {
            const h = tip.lines.length * lineH + 14;
            if (tip.y + h < this.renderer.viewTop || tip.y - h > CONFIG.HEIGHT) continue;
            ctx.save();
            ctx.globalAlpha = 0.45;
            ctx.fillStyle = '#000';
            ctx.fillRect(0, tip.y - h / 2, CONFIG.WIDTH, h);
            ctx.globalAlpha = 0.9;
            ctx.textBaseline = 'middle';
            tip.lines.forEach((line, k) => {
                const ly = tip.y - (tip.lines.length - 1) * lineH / 2 + k * lineH;
                this.renderer.drawText(line, CONFIG.WIDTH / 2, ly, `bold ${px}px Orbitron, "Courier New", monospace`, '#00ffcc');
            });
            if (tip.edges) {
                this.renderer.drawText('◀', 16, tip.y, 'bold 20px sans-serif', '#00ffcc');
                this.renderer.drawText('▶', CONFIG.WIDTH - 16, tip.y, 'bold 20px sans-serif', '#00ffcc');
            }
            ctx.restore();
        }
    }

    // Moves the camera up by `diff` px: everything on screen shifts down,
    // anything that fell far below is culled, and new platforms are generated.
    scrollCamera(diff, perks = this.player.skin.ability || {}) {
        this.player.y += diff;
        this.remotePlayers.forEach(rp => { rp.y += diff; });

        this.state.score += diff;
        // SCORE x2 perk: state.score is the camera's real height (it drives
        // biomes, spawns and boss fights), so the extra distance is banked
        // separately and only added to the score the player sees.
        this.state.bonusScore += diff * ((perks.scoreMult || 1) - 1);
        this.state.bgOffset += diff * 0.5;

        this.platforms.forEach(p => p.y += diff);
        this.powerups.forEach(p => { p.y += diff; p.startY += diff; });
        this.enemies.forEach(e => { if (e.shiftY) e.shiftY(diff); else e.y += diff; });
        this.projectiles.forEach(p => p.y += diff);
        this.particles.particles.forEach(p => p.y += diff);
        this.floaters.forEach(f => f.y += diff);
        this.rings.forEach(r => r.y += diff);
        this.afterimages.forEach(a => a.y += diff);

        this.platforms = this.platforms.filter(p => p.y < CONFIG.HEIGHT + 100);
        this.powerups = this.powerups.filter(p => p.y < CONFIG.HEIGHT + 100);
        // Forget teammates' pickups once they're below the screen.
        if (this.state.multiplayer) {
            this.remotePlayers.forEach(rp => {
                if (rp.picked) rp.picked.forEach(wy => { if (wy + this.state.score > CONFIG.HEIGHT + 100) rp.picked.delete(wy); });
            });
        }
        // Drones circle back instead of leaving, so cull the ones left below.
        this.enemies = this.enemies.filter(e => {
            if (e instanceof BossDrone || e.y < CONFIG.HEIGHT + 100) return true;
            // A guest forgets its mirror as well, so a later snapshot builds
            // a fresh one instead of updating a copy that's no longer drawn.
            if (e.nid !== undefined && this.netEnemies) this.netEnemies.delete(e.nid);
            return false;
        });

        this.fillPlatforms();
    }

    // Drops focus from whatever menu control has it, so it can't catch the
    // game's keys (buttons activate on Space/Enter keyup).
    blurFocus() {
        if (typeof document !== 'undefined' && document.activeElement && document.activeElement.blur) {
            document.activeElement.blur();
        }
    }

    // iPhone and iPad browser tabs get install steps instead of the game
    // (installGated). Android tabs get the same card as a suggestion
    // (installSuggested): PLAY IN BROWSER closes it for INSTALL_SNOOZE_MS.
    applyInstallGate() {
        const nav = typeof navigator !== 'undefined' ? navigator : null;
        const tab = needsHomeScreenInstall(nav, typeof window !== 'undefined' ? window : null);
        const android = tab && installIsOptional(nav);
        this.installGated = tab && !android;
        this.installSuggested = android;
        if (!tab || !this.ui.installGate) return;
        this.ui.installGateIOS.hidden = android;
        this.ui.installGateAndroid.hidden = !android;
        this.ui.installGateSafari.hidden = android || !isIOSNonSafari(nav.userAgent);
        this.ui.installGateChrome.hidden = !android || !isAndroidInAppBrowser(nav.userAgent);
        if (!android) {
            this.setInstallCard(true);
            return;
        }

        const later = loadJSON('lp_install_later', 0, Number.isFinite);
        const snoozed = later > 0 && Date.now() - later < INSTALL_SNOOZE_MS;
        this.setInstallCard(!snoozed);
        this.ui.installGatePlay.onclick = () => this.closeInstallSuggestion();
        this.ui.installLink.hidden = false;
        this.ui.installLink.onclick = (e) => {
            if (e && e.preventDefault) e.preventDefault();
            this.openInstallSuggestion();
        };

        // The one-tap button appears once the browser says it can install.
        const showButton = () => { this.ui.installGateBtn.hidden = !installPrompt.event; };
        installPrompt.onReady = showButton;
        installPrompt.onInstalled = () => {
            this.ui.installGateBtn.hidden = true;
            this.ui.installGateDone.hidden = false;
        };
        this.ui.installGateBtn.onclick = async () => {
            const e = installPrompt.event;
            if (!e) return;
            installPrompt.event = null;
            e.prompt();
            let accepted = false;
            try { accepted = (await e.userChoice).outcome === 'accepted'; } catch (err) { /* treat as dismissed */ }
            if (accepted) installPrompt.onInstalled();
            else showButton();
        };
        showButton();
    }

    // The install card covers the game, which can't be reached behind it.
    setInstallCard(open) {
        this.ui.installGate.hidden = !open;
        const container = document.getElementById('game-container');
        if (container) container.inert = open;
    }

    // PLAY IN BROWSER (Android): the card goes away for a week.
    closeInstallSuggestion() {
        if (!this.installSuggested) return;
        saveItem('lp_install_later', Date.now());
        this.setInstallCard(false);
        this.enterFullscreen();
    }

    // INSTALL APP in the menu links brings the card back whenever it's wanted.
    openInstallSuggestion() {
        if (!this.installSuggested || this.state.running) return;
        this.setInstallCard(true);
    }

    // An Android tab plays full screen where the browser allows it. It has
    // to be asked for from a tap, and a refusal just leaves the game in the tab.
    enterFullscreen() {
        if (!this.installSuggested || typeof document === 'undefined') return;
        const el = document.documentElement;
        if (document.fullscreenElement || !el || typeof el.requestFullscreen !== 'function') return;
        try {
            const asked = el.requestFullscreen({ navigationUI: 'hide' });
            if (asked && asked.catch) asked.catch(() => {});
        } catch (e) { /* not allowed here: play in the tab */ }
    }

    startGame(isMp = false, mpSeed = null) {
        if (this.installGated) return;
        // A Pixel of the Hour whose hour ended a moment ago comes off first.
        const worn = SKINS[this.viewParams.skinIndex];
        if (worn && worn.hourly && this.isSkinLocked()) this.updateSkinUI();
        this.closeHourly();
        // Whatever menu button had focus must not catch the Space/Enter that
        // follows, and keys held in the menu shouldn't carry into the run.
        this.blurFocus();
        this.input.resetInput();
        this.closeRunCard();
        this.closeSettings();
        this.showLeftover = true;
        this.setMenuOpen(false);
        this.state.running = true;
        this.state.multiplayer = isMp;
        this.state.deathCount = 0;
        this.runSerial = (this.runSerial || 0) + 1;
        this.reset(isMp ? mpSeed : null);
        // Every run starts with the free heart plus the hearts bought for it;
        // the bought count is spent into the run, so it resets.
        const bought = this.state.hearts;
        saveItem('lp_hearts', 0);
        this.setHearts(1 + bought);

        this.ui.menu.style.opacity = 0;
        if (this.ui.menusWrapper) this.ui.menusWrapper.style.opacity = 0;

        // Hidden once the fade ends. gameOver() cancels this, or a run that
        // ends inside the fade (a guest whose party closes right after the
        // start) would hide the menu it just brought back.
        clearTimeout(this.menuHideTimer);
        this.menuHideTimer = setTimeout(() => {
            this.menuHideTimer = null;
            this.ui.menu.style.display = 'none';
            if (this.ui.menusWrapper) this.ui.menusWrapper.style.display = 'none';
        }, 300);
        this.ui.hud.style.opacity = 1;

        this.state.gamesPlayedThisSession++;
        this.state.runStartTime = performance.now();
        this.state.pausedMs = 0;
        this.pauseStartedAt = 0;
        this.updateTouchControls();
        this.updateAdButtons();
        this.startChallenge();
    }

    // ------------------------------------------------------- touch controls
    // Lays the (visual-only) pads over the canvas, which is letterboxed
    // inside the screen.
    layoutTouchControls() {
        const tc = this.ui.touchControls;
        const canvas = this.renderer.canvas;
        if (!tc || !canvas || !canvas.getBoundingClientRect || !canvas.parentElement) return;
        const c = canvas.getBoundingClientRect();
        const box = canvas.parentElement.getBoundingClientRect();
        tc.style.left = (c.left - box.left) + 'px';
        tc.style.top = (c.top - box.top) + 'px';
        tc.style.width = c.width + 'px';
        tc.style.height = c.height + 'px';
    }

    // Pads show on touch screens during a live, unpaused run (unless turned
    // off in Settings; the invisible zones keep working either way).
    updateTouchControls() {
        if (!this.ui.touchControls) return;
        const show = this.coarsePointer && this.settings.touchControls && this.state.running && !this.pauseMenuOpen;
        this.ui.touchControls.hidden = !show;
        this.touchPadsShown = show;
    }

    // Lights up the pads being pressed.
    updateTouchPadStates() {
        if (!this.touchPadsShown) return;
        const keys = this.input.keys;
        const want = { left: keys.left, right: keys.right, jump: keys.buffer > 0 };
        const last = this.touchPadLast || (this.touchPadLast = {});
        for (const k of ['left', 'right', 'jump']) {
            const pad = this.touchPads[k];
            if (pad && last[k] !== want[k]) {
                pad.classList.toggle('is-active', want[k]);
                last[k] = want[k];
            }
        }
    }

    // ------------------------------------------------------ pickup sprites
    // A pickup emoji, drawn once (with its glow) into an offscreen canvas at
    // screen density. Drawing emoji text with shadowBlur every frame was the
    // most expensive thing on the screen for phones.
    // The heart pickup: the same blocky heart as the HUD's icon (7x6
    // cells), drawn once with its glow.
    makeHeartSprite() {
        const size = 62, cell = 4;
        const dpr = this.renderer.dpr || 1;
        const c = document.createElement('canvas');
        c.width = size * dpr;
        c.height = size * dpr;
        const ctx = c.getContext && c.getContext('2d');
        if (!ctx) return null;
        if (ctx.scale) ctx.scale(dpr, dpr);
        const x = (size - 7 * cell) / 2, y = (size - 6 * cell) / 2;
        // [first cell, cells] for each row under the two bumps of the top one.
        const rows = [[0, 7], [0, 7], [1, 5], [2, 3], [3, 1]];
        ctx.shadowBlur = 12;
        ctx.shadowColor = '#ff3366';
        ctx.fillStyle = '#ff3366';
        ctx.beginPath();
        // Two bumps on the top row, then each row narrower than the last.
        ctx.rect(x + cell, y, cell * 2, cell);
        ctx.rect(x + cell * 4, y, cell * 2, cell);
        rows.forEach(([from, n], i) => ctx.rect(x + from * cell, y + (i + 1) * cell, n * cell, cell));
        ctx.fill();
        ctx.shadowBlur = 0;
        ctx.fillStyle = 'rgba(255, 255, 255, 0.65)';
        ctx.fillRect(x + cell, y + cell, cell, cell);
        return { canvas: c, size };
    }

    // A gem in its biome's colour: a cut diamond (flat crown, pointed
    // base) with a lighter crown and a glint, drawn once with its glow.
    makeGemSprite(color) {
        const size = 40;
        const dpr = this.renderer.dpr || 1;
        const c = document.createElement('canvas');
        c.width = size * dpr;
        c.height = size * dpr;
        const ctx = c.getContext && c.getContext('2d');
        if (!ctx || !ctx.beginPath) return null;
        if (ctx.scale) ctx.scale(dpr, dpr);
        const x = size / 2 - 10, y = size / 2 - 9;
        const shape = (pts) => {
            ctx.beginPath();
            pts.forEach(([px, py], i) => i ? ctx.lineTo(x + px, y + py) : ctx.moveTo(x + px, y + py));
            ctx.closePath();
            ctx.fill();
        };
        ctx.shadowBlur = 12;
        ctx.shadowColor = color;
        ctx.fillStyle = color;
        shape([[4, 0], [16, 0], [20, 6], [10, 18], [0, 6]]);
        ctx.shadowBlur = 0;
        ctx.fillStyle = 'rgba(255, 255, 255, 0.45)';
        shape([[4, 0], [16, 0], [20, 6], [0, 6]]);
        ctx.fillStyle = 'rgba(0, 0, 0, 0.18)';
        shape([[10, 6], [20, 6], [10, 18]]);
        ctx.fillStyle = '#fff';
        shape([[5, 1], [8, 1], [6, 5], [3, 5]]);
        return { canvas: c, size };
    }

    makePickupSprites() {
        this.gemSprites = BIOMES.map(b => this.makeGemSprite(b.gem.color));
        this.heartSprite = this.makeHeartSprite();
        this.capsuleSprites = []; // filled as each colour comes round (drawPowerCapsule)
    }

    // Draws a pre-rendered pickup sprite centred on pickup `p`.
    // Draws pickups bobbing in place: hearts, gems (small ones in a trail
    // ripple along it) and power-up orbs. `t` is the clock they move to.
    drawPickups(list, t) {
        const ctx = this.renderer.ctx;
        list.forEach(p => {
            p.y = p.startY + Math.sin(t * 0.1 + (p.small ? p.x * 0.05 : 0)) * (p.small ? 3 : 5);
            if (p.isHeart) {
                this.drawSprite(this.heartSprite, p, 0.85 + 0.15 * Math.sin(t * 0.15));
            } else if (p.isGem) {
                // Pre-rendered in the gem's biome colour, with its glow; the
                // pulse is just the sprite's opacity.
                const sprite = this.gemSprites && this.gemSprites[p.tier || 0];
                if (!sprite) return;
                const size = sprite.size * (p.small ? 0.6 : 1);
                ctx.globalAlpha = 0.8 + 0.2 * Math.sin(t * 0.3);
                ctx.drawImage(sprite.canvas, p.x + p.w / 2 - size / 2, p.y + p.h / 2 - size / 2, size, size);
                ctx.globalAlpha = 1;
            } else {
                drawPowerCapsule(ctx, p, t, this.capsuleSprites, this.renderer.dpr || 1);
            }
        });
    }

    drawSprite(sprite, p, alpha) {
        if (!sprite) return;
        const ctx = this.renderer.ctx;
        ctx.globalAlpha = alpha;
        ctx.drawImage(sprite.canvas, p.x + p.w / 2 - sprite.size / 2, p.y + p.h / 2 - sprite.size / 2, sprite.size, sprite.size);
        ctx.globalAlpha = 1;
    }

    // The pickups this player can see and collect. Hearts are part of every
    // client's level, but only exist for a player with room to bank one
    // (fewer than the Pixel's heart cap): filling up hides the rest, and spending a
    // life brings them back (except any near where it was spent: see
    // useSpareLife).
    // In co-op, pickups you took stay in the level (flagged `mine`) so a
    // spectating view can still show them for a teammate who hasn't.
    visiblePickups() {
        const hearts = this.state.hearts < this.heartCap();
        const block = this.state.heartBlockWY;
        const blocked = p => block !== null && block !== undefined && p.wy >= block;
        return this.powerups.filter(p => !p.mine && (!p.isHeart || (hearts && !blocked(p))));
    }

    collectHeart(event) {
        if (this.state.hearts < this.heartCap()) this.setHearts(this.state.hearts + 1);
        this.particles.spawn(event.x + 14, event.y + 14, "#ff3366", 20);
        sounds.play('heart');
        this.notify("HEART +1", 'heart');
    }

    // A dashed gold line at the height where the displayed score reaches
    // the target (the player crosses it at the camera line).
    // Screen y where the displayed score reaches `meters`: the line meets
    // the player exactly as the score passes it.
    scoreLineY(meters) {
        return CONFIG.HEIGHT * CONFIG.SCROLL_THRESHOLD - (meters * 10 - (this.state.score + (this.state.bonusScore || 0)));
    }

    // A dashed line across the level at your high score from before this run.
    // It stays put as you climb (it slides toward you only when score comes
    // without height: SCORE x2, a boss bonus), meets your Pixel exactly as
    // you set a new high score, then scrolls away below. Not shown on a first
    // run or from a checkpoint start already above it.
    // The co-op ceiling applies while you're up and a teammate is still
    // playing (see update()).
    teamLimitActive() {
        return !!(this.state.multiplayer && !this.player.isDead && this.anyRemoteActive());
    }

    // Makes the co-op ceiling visible. It's always the top of the 800-tall
    // frame: the edge of the screen on a 3:4 view, but partway down a tall
    // phone's, whose extra sky above it is dimmed and labelled. Drawing only.
    drawTeamLimit() {
        if (!this.state.running || !this.teamLimitActive()) return;
        const ctx = this.renderer.ctx;
        const top = this.renderer.viewTop;
        const flash = Math.max(0, this.state.ceilingFlash || 0) / CEILING_FLASH_FRAMES;
        ctx.save();
        if (top < 0) {
            ctx.globalAlpha = 0.55;
            ctx.fillStyle = '#000';
            ctx.fillRect(0, top, CONFIG.WIDTH, -top);
        }
        ctx.globalAlpha = 0.55 + 0.45 * flash;
        ctx.fillStyle = '#ff00ff';
        ctx.shadowColor = '#ff00ff';
        ctx.shadowBlur = 8 + 12 * flash;
        ctx.fillRect(0, 0, CONFIG.WIDTH, 3);
        ctx.restore();
        if (top < -30) {
            this.renderer.drawText('TEAM LIMIT', CONFIG.WIDTH / 2, -10, 'bold 14px Orbitron, sans-serif', '#ff66ff');
        }
    }

    drawBestLine() {
        const best = this.state.bestMarkerScore;
        if (!(best > 0) || best <= (this.state.startMeters || 0)) return;
        const y = this.scoreLineY(best);
        if (y < this.renderer.viewTop - 20 || y > CONFIG.HEIGHT + 20) return;
        const ctx = this.renderer.ctx;
        ctx.save();
        ctx.strokeStyle = '#ff3366';
        ctx.globalAlpha = 0.8;
        ctx.lineWidth = 2;
        if (ctx.setLineDash) ctx.setLineDash([6, 6]);
        ctx.beginPath();
        ctx.moveTo(0, y);
        ctx.lineTo(CONFIG.WIDTH, y);
        ctx.stroke();
        // The label sits on a dark tab so platforms behind it can't swallow it.
        const label = 'HIGH SCORE ' + fmtNum(best) + 'm';
        const font = 'bold 15px Orbitron, sans-serif';
        ctx.font = font;
        const w = (ctx.measureText ? ctx.measureText(label).width : label.length * 10) + 16;
        ctx.globalAlpha = 0.85;
        ctx.fillStyle = '#0a0a0e';
        ctx.fillRect(4, y - 24, w, 22);
        ctx.globalAlpha = 1;
        ctx.fillStyle = '#ff3366';
        ctx.fillRect(4, y - 24, 3, 22);
        ctx.restore();
        this.renderer.drawText(label, 12, y - 8, font, '#ff3366', 'left');
    }

    die(forceDie = false) {
        // Two hits in the same frame after the last life is spent must not
        // end the run twice (double Hall of Fame entry, two interstitials).
        if (!this.state.running || this.state.dying) return;
        // Down in co-op already (spectating): there's nothing left to lose.
        if (this.state.multiplayer && this.player.isDead) return;

        // Solo and co-op alike: a net catches a fall, then a heart saves you.
        if (this.catchWithNet(forceDie)) return;
        this.state.runDeaths = (this.state.runDeaths || 0) + 1;
        if (this.useSpareLife()) return;

        sounds.play('death');
        this.shatterPixel(this.player);
        this.addShake(12);

        if (this.state.multiplayer) {
            this.handleMultiplayerDeath();
            return;
        }

        // Solo: the run ends once the shatter has played out in slow motion
        // (updateDying), so you can see what got you.
        this.state.dying = this.settings.reducedMotion ? DEATH_ANIM_FRAMES_REDUCED : DEATH_ANIM_FRAMES;
    }

    // Breaks a Pixel (you or a teammate) into flying chunks. One lost off the
    // bottom shatters at the bottom edge, with the chunks thrown back up.
    shatterPixel(p) {
        const fell = p.y > CONFIG.HEIGHT - p.h;
        const y = Math.min(p.y, CONFIG.HEIGHT - p.h);
        this.particles.shatter(p.x, y, p.color, p.skin.eye, fell);
        this.particles.spawn(p.x + 13, y + 13, p.color, 16, "blast");
    }

    // The slow-motion beat between a run-ending death and the run card: only
    // the shatter and any bullets still in flight move, at DEATH_SLOWMO.
    updateDying(dt) {
        const slow = dt * DEATH_SLOWMO;
        this.particles.update(slow);
        this.updateFx(dt);
        for (let i = this.projectiles.length - 1; i >= 0; i--) {
            this.projectiles[i].update(slow);
            if (this.projectiles[i].markedForDeletion) this.projectiles.splice(i, 1);
        }
        this.state.dying -= dt;
        if (this.state.dying <= 0) this.endRun();
    }

    endRun() {
        this.state.dying = 0;
        this.state.running = false;
        this.updateTouchControls(); // not over a revive prompt

        if (this.canOfferRevive()) this.offerRevive();
        else this.gameOver();
    }

    // CONTINUE? for an ad: solo only, once a run, only after a real climb,
    // and only every few minutes, since CrazyGames forbids offering it on
    // every death. Hearts are the way to keep going without ads.
    canOfferRevive() {
        const s = this.state;
        if (s.multiplayer || s.revived) return false;
        if (Math.floor(s.score / 10) - (s.startMeters || 0) < REVIVE_MIN_METERS) return false;
        if (this.lastReviveOfferAt !== undefined && performance.now() - this.lastReviveOfferAt < REVIVE_OFFER_COOLDOWN_MS) return false;
        return this.ads.rewardedAvailable();
    }

    offerRevive() {
        this.lastReviveOfferAt = performance.now();
        const ads = this.ads;
        const run = this.runSerial;
        const stillThisRun = () => run === this.runSerial && !this.state.running;
        const close = () => {
            ads.reviveOverlay.style.display = 'none';
            ads.reviveBtn.onclick = null;
            ads.reviveSkip.onclick = null;
            this.updateAdButtons();
        };
        ads.reviveOverlay.style.display = 'flex';
        this.updateAdButtons();
        ads.reviveBtn.onclick = (e) => {
            if (e && e.stopPropagation) e.stopPropagation();
            close();
            ads.showRewarded('revive',
                () => { if (stillThisRun()) this.revive(); },
                (why) => {
                    if (!stillThisRun()) return;
                    this.gameOver();
                    if (why !== 'skipped') this.notify("NO AD RIGHT NOW", 'warning');
                });
        };
        ads.reviveSkip.onclick = (e) => {
            if (e && e.stopPropagation) e.stopPropagation();
            close();
            this.gameOver();
        };
    }

    // A fall or hit that would end the run (solo) or knock you out (co-op)
    // spends a heart instead, if there is one. Returns true if the player was
    // saved.
    useSpareLife() {
        const wasFull = this.state.hearts >= this.heartCap();
        if (this.consumeHeart()) {
            // Hearts are hidden at full hearts, so one already on screen would
            // appear now and could be grabbed on the rebound. Hide any heart
            // from this screen and the next one up. (With room to bank one
            // they were showing already, and stay.)
            if (wasFull) this.state.heartBlockWY = -this.state.score - CONFIG.HEIGHT;
            this.rescuePlayer("#ff3366", "HEART SPENT — " + this.state.hearts + " LEFT");
            return true;
        }
        return false;
    }

    // Bounces the player back in on a red rescue net, behind a fresh HARD
    // SHIELD, with a red notice (a life is gone).
    rescuePlayer(color, text) {
        this.deployRescueNet();
        this.addShake(9);
        this.player.grantPower(POWERS.SHIELD);
        sounds.play('heart_lost');
        this.particles.spawn(this.player.x + 13, this.player.y + 13, color, 30, "blast");
        this.showAlert(text, 'life');
    }

    revive() {
        this.state.revived = true;
        this.state.running = true;
        // Keys pressed on the revive prompt (Space on WATCH AD, mashing)
        // must not turn into a jump that overrides the revive bounce.
        this.input.resetInput();
        this.lastTime = performance.now();

        this.deployRescueNet();
        this.player.grantPower(POWERS.SHIELD);

        this.showAlert("LIFE RESTORED", 'success');
    }

    gameOver() {
        this.state.dying = 0;
        this.saveBest();
        let finalScore = this.runScore();
        this.closePauseUI();
        this.recordRunStats(Math.max(0, Math.floor(this.state.score / 10) - (this.state.startMeters || 0)));

        // Don't leave a half-retracted net hanging over the menu.
        this.safetyNet = this.makeSafetyNetState();

        this.saveGhost(finalScore);
        if (!this.state.multiplayer) {
            this.updateFame(finalScore);
        }

        clearTimeout(this.menuHideTimer);
        this.menuHideTimer = null;
        this.ui.menu.style.display = 'flex';
        this.ui.menu.style.opacity = 1;
        if (this.ui.menusWrapper) {
            this.ui.menusWrapper.style.display = 'block';
            this.ui.menusWrapper.style.opacity = 1;
        }

        if (this.state.multiplayer) {
            if (this.state.isHost) {
                this.ui.mpStartBtn.innerText = "PLAY AGAIN";
                this.updateMpStartBtn();
                if (this.party.length >= 2) this.setMpStatus("READY TO START", 'success');
                else this.setMpStatus("WAITING FOR PLAYERS...", 'success');
            } else if (this.inParty()) {
                this.setMpStatus("WAITING FOR LEADER TO RESTART...", 'pending');
            }
        }

        this.ui.hud.style.opacity = 0;
        this.ui.power.style.opacity = 0;
        this.powerHud = null;
        this.clearNotices();
        this.hideAlert();

        this.ui.menuLast.innerText = "LAST RUN: " + fmtNum(finalScore) + "m";
        this.ui.menuLast.hidden = false;
        this.ui.menuScore.innerText = "HIGH SCORE: " + fmtNum(this.state.highScore) + "m";
        this.updateFameUI();
        this.updateSkinUI();
        this.renderGemShop();
        // Leftover hearts are gone; the meter now counts hearts bought for the next run.
        this.state.hearts = 0;
        this.updateHeartUI();
        const skin = SKINS[this.viewParams.skinIndex] || SKINS[0];
        // A solo run's seed is the day it was played (YYYYMMDD). A co-op
        // seed has a random offset added, so it isn't a date at all.
        const seed = String(this.state.runSeed);
        const daily = !this.state.multiplayer && /^\d{8}$/.test(seed);
        this.lastRun = {
            score: finalScore,
            newBest: !!this.state.isNewBest,
            multiplayer: this.state.multiplayer,
            seed: this.state.runSeed,
            start: this.state.startMeters || 0,
            biome: this.renderer.currentBiome.name,
            skinName: skin.name, color: skin.color, eye: skin.eye, color2: skin.color2, pattern: skin.pattern,
            date: daily ? `${seed.slice(0, 4)}-${seed.slice(4, 6)}-${seed.slice(6)}` : fmtDate(new Date())
        };
        if (this.ui.shareToast) this.ui.shareToast.hidden = true;
        this.updateTouchControls();
        if (this.ui.challengeHud) this.ui.challengeHud.hidden = true;
        if (this.ui.spectateHud) this.ui.spectateHud.hidden = true;
        this.spectating = null;
        this.spectatingPlayer = null;
        if (this.state.isNewBest && !this.state.multiplayer) portal.happytime();
        // Between rounds the party can take new friends again.
        if (this.state.multiplayer) this.syncPortalRoom();
        this.showRunCard(finalScore);
        this.offerLeaderboard();
    }

    update(dt) {
        if (!this.state.running || this.state.paused) return;
        if (this.state.dying) { this.updateDying(dt); return; }

        this.state.time += dt;

        if (!this.player.isDead) {
            this.input.update(dt);
        }

        this.renderer.updateBiome(this.state.score / 10);
        // Four times a second is plenty, and it is a list of checks.
        if (this.tick('achieve', dt, 15)) this.checkAchievements();

        const scoreMeters = Math.floor(this.state.score / 10);
        const hazards = this.renderer.currentBiome.hazards;
        const perks = this.player.skin.ability || {};
        // SHIELDED perk: the biome's environmental forces (ice, gravity
        // pulses, control glitches) pass the player by. Physical obstacles —
        // meteors, lasers, moving platforms — still count.
        const envImmune = !!perks.biomeImmune;

        if (this.renderer.currentBiome.name !== this.lastBiomeName) {
            if (this.lastBiomeName) { // skip the callout on the very first frame of a run
                this.showBiomeBanner(this.renderer.currentBiome);
            }
            this.lastBiomeName = this.renderer.currentBiome.name;
        }

        this.recordGhost();

        // Boss fights: one every BOSS_LOOP_DISTANCE metres of this run. It
        // drops in from above the screen.
        const authority = this.isAuthority();
        if (authority && !this.state.bossActive && scoreMeters >= this.state.nextBossAt) {
            this.state.bossActive = true;
            this.enemies.push(new BossDrone(-120, bossHpFor(this.state.runLoops)));
        }

        // Spawn Enemies (only if Boss isn't active). The spawn clock keeps
        // ticking at the cap; only the spawn itself is skipped.
        const droneEvery = Math.max(CONFIG.DRONE_MIN_SPAWN_RATE, Math.floor(CONFIG.DRONE_SPAWN_RATE - scoreMeters / 50));
        if (authority && !this.state.bossActive && scoreMeters > DRONE_START_METERS && this.tick('drone', dt, droneEvery)
            && this.countEnemies(Drone) < this.droneCap(scoreMeters)) {
            const difficulty = 1 + (scoreMeters / 2000) + (this.state.runLoops || 0);

            // Spawned relative to the camera's player (the lowest living one
            // in co-op), so everyone sees them arrive.
            const spawnY = this.bossFocus().y - 500;
            if (scoreMeters > 300 && Math.random() < Math.min(0.5, (scoreMeters - 300) / 2400)) {
                this.enemies.push(new ShooterDrone(spawnY, difficulty));
            } else {
                this.enemies.push(new Drone(spawnY, difficulty));
            }
        }

        if (authority && !this.state.bossActive && hazards.includes('laser') && this.tick('laser', dt, 240)
            && this.countEnemies(LaserDrone) < CONFIG.LASER_CAP) {
            this.enemies.push(new LaserDrone(this.bossFocus().y - 500));
        }

        // Glitch hazard: briefly invert left/right for this frame's input read only
        // (swap-and-restore around the call, no permanent state mutation).
        const glitching = !envImmune && hazards.includes('glitch') && (this.state.time % 480) < 24;
        if (glitching) {
            const tmp = this.input.keys.left;
            this.input.keys.left = this.input.keys.right;
            this.input.keys.right = tmp;
        }

        this.player.prevBottom = this.player.y + this.player.h;
        // Ice hazard: platforms are slippery (see Player.update()).
        this.player.icy = !envImmune && hazards.includes('ice');
        // A dead co-op player's body is gone until they respawn: no physics,
        // no landing on platforms, no pickups.
        let event = this.player.isDead ? null : this.player.update(dt, this.input, this.platforms, this.visiblePickups());
        if (this.player.justLanded) {
            this.onLanded(this.player.justLanded);
            this.player.justLanded = 0;
        }
        // Ice spray at the feet of a sliding Pixel (drawing only).
        if (this.player.icy && !this.player.isDead && this.player.grounded && Math.abs(this.player.vx) > 1.5
            && this.player.standOn && this.player.standOn.h < 30 && this.tick('iceSpray', dt, 5)) {
            this.particles.dust(this.player.x + 13, this.player.y + 26, '#dff6ff', 2);
        }
        this.player.animate(dt);
        if (this.state.multiplayer && this.player.isDead && this.spectatingPlayer) this.pullForSpectated(this.spectatingPlayer, dt);

        if (glitching) {
            const tmp = this.input.keys.left;
            this.input.keys.left = this.input.keys.right;
            this.input.keys.right = tmp;
        }

        // Co-op ceiling at the top of the 800-tall frame, so the leader can't
        // leave the party behind. drawTeamLimit() shows it; bumping it flashes.
        if (this.state.ceilingFlash > 0) this.state.ceilingFlash -= dt;
        if (this.teamLimitActive()) {
            if (this.player.y < 0) {
                this.player.y = 0;
                if (this.player.vy < 0) {
                    this.player.vy = 0; // head bump
                    this.state.ceilingFlash = CEILING_FLASH_FRAMES;
                }
            }
        }

        // Environmental Hazards (cumulative per-biome, see BIOMES[].hazards)
        if (hazards.includes('gravityPulse') && !envImmune) {
            let pulse = Math.sin(this.state.time * 0.05) * 0.3;
            this.player.vy += pulse * dt;
        }
        if (authority && hazards.includes('meteor') && this.tick('meteor', dt, 90)) {
            let startX = Math.random() * CONFIG.WIDTH;
            let vx = (Math.random() - 0.5) * 4;
            let vy = 4 + Math.random() * 5;
            this.projectiles.push(new Meteor(startX, this.bossFocus().y - 800, vx, vy));
        }

        // Platform Update
        this.platforms.forEach(p => {
            if (p.vx) {
                p.x += p.vx * dt;
                if (p.x < 0) { p.x = 0; p.vx *= -1; }
                if (p.x + p.w > CONFIG.WIDTH) { p.x = CONFIG.WIDTH - p.w; p.vx *= -1; }
            }
            if (p.sprung) p.sprung = Math.max(0, p.sprung - dt);
            // A crumbling platform breaks a moment after it's landed on,
            // and reforms later.
            if (p.crumbleT > 0) {
                p.crumbleT -= dt;
                if (p.crumbleT <= 0) {
                    p.crumbleT = 0;
                    p.gone = CRUMBLE_REFORM_FRAMES;
                    if (p.y < CONFIG.HEIGHT) {
                        for (let cx = p.x + 10; cx < p.x + p.w; cx += 22) this.particles.spawn(cx, p.y + 9, '#ff8a3d', 3);
                        sounds.play('crumble');
                    }
                }
            } else if (p.gone > 0) {
                p.gone = Math.max(0, p.gone - dt);
            }
            // The dip from a landing springs back (drawing only).
            if (p.dip) {
                p.dip *= Math.pow(0.78, dt);
                if (p.dip < 0.2) p.dip = 0;
            }
        });

        if (event === "jump") {
            this.particles.spawn(this.player.x + 13, this.player.y + 26, "#fff");
            sounds.play('jump');
        } else if (event === "spring") {
            this.particles.spawn(this.player.x + 13, this.player.y + 26, "#ffe600", 12);
            sounds.play('spring');
        } else if (event === "double_jump") {
            this.particles.spawn(this.player.x + 13, this.player.y + 26, POWERS.DOUBLE.color);
            sounds.play('jump');
        } else if (event === "trail") {
            const fast = Math.abs(this.player.vy) > 7 || Math.abs(this.player.vx) > 5;
            if (!this.settings.reducedMotion) {
                if (fast && this.tick('trail', dt, 3))
                    this.afterimages.push({ x: this.player.x, y: this.player.y, life: 12, maxLife: 12 });
            } else if (this.tick('trail', dt, 2))
                this.particles.spawn(this.player.x + 13, this.player.y + 13, this.player.color, 1, "trail");
        } else if (event === "thrust") {
            this.particles.spawn(this.player.x + 13, this.player.y + 26, "#ff3300", 2, "blast");
        } else if (event && event.event === "gem") {
            const gained = this.gemPickupValue(event.value, perks);
            this.addGems(gained);
            this.particles.spawn(event.x + 8, event.y + 8, event.color || "#00ffff", 10);
            this.popPickup(event.x + 6, event.y + 6, event.color || "#00ffff", '+' + gained);
            sounds.play('reward');
        } else if (event && event.event === "heart") {
            this.collectHeart(event);
        } else if (event && event.event === "powerup") {
            this.state.powersCollected++;
            this.particles.spawn(event.x + 12, event.y + 12, this.player.activePower.color, 20);
            this.popPickup(event.x + 12, event.y + 12, this.player.activePower.color);
            sounds.play('powerup');
        }

        this.updateDronePulse(dt, perks);

        let enemyDt = dt;
        if (this.partyTimeWarp()) enemyDt *= 0.3;

        if (this.state.multiplayer) this.remotePlayers.forEach(rp => { this.followRemote(rp, dt); rp.animate(dt); });

        // Enemy Update
        for (let i = this.enemies.length - 1; i >= 0; i--) {
            let e = this.enemies[i];

            if (!authority) {
                this.followNetEnemy(e, enemyDt);
            } else if (e instanceof ShooterDrone) {
                e.update(enemyDt, this.nearestPlayer(e), this.projectiles);
            } else if (e instanceof BossDrone) {
                e.update(enemyDt, this.bossFocus(), this.projectiles, this.state.multiplayer ? () => this.nextDiveTarget() : undefined);
            } else {
                e.update(enemyDt);
            }

            if (e.markedForDeletion) {
                if (e instanceof BossDrone) {
                    if (authority) {
                        this.onBossDefeated();
                        if (this.state.multiplayer) window.network.send({ type: 'boss_down' });
                    } else {
                        this.state.bossActive = false;
                    }
                }
                this.enemies.splice(i, 1);
                continue;
            }
            if (e.hidden || this.player.invuln > 0 || this.player.isDead) continue;
            if (rectsIntersect(this.player, e)) {
                if (e instanceof BossDrone) {
                    this.resolveBossContact(e);
                    continue;
                }
                if (this.smashHit(e) || this.absorbHit(e)) continue;
                this.die(true);
            }
        }
        // A death above may have ended the run (or started its slow-motion
        // shatter): nothing below may touch the score, saves or HUD after that.
        if (!this.state.running || this.state.dying) return;

        // Projectile Update
        if (authority && this.state.multiplayer) this.announceProjectiles();
        for (let i = this.projectiles.length - 1; i >= 0; i--) {
            let p = this.projectiles[i];
            p.update(enemyDt);
            if (p.markedForDeletion) {
                this.projectiles.splice(i, 1);
                continue;
            }
            if (this.player.invuln > 0 || this.player.isDead) continue;
            if (rectsIntersect(this.player, p)) {
                if (this.absorbHit(p)) continue;
                this.die(true); // Projectiles are deadly
            }
        }
        if (!this.state.running || this.state.dying) return;

        this.particles.update(dt);
        this.updateFx(dt);
        this.updateSafetyNet(dt);
        if (this.state.multiplayer) {
            if (authority) this.broadcastEnemies(dt);
            this.updateSpectateHud();
        }

        // Position sync at 30Hz of game time (not per rendered frame, which
        // would be 2.4x the traffic on a 144Hz screen).
        if (this.state.multiplayer && !this.player.isDead && this.tick('sync', dt, 2)) {
            const r = v => Math.round(v * 10) / 10;
            window.network.send({
                type: 'sync',
                pid: window.network.myId,
                x: r(this.player.x),
                y: r(this.player.y - this.state.score),
                vx: r(this.player.vx),
                vy: r(this.player.vy),
                skinIndex: this.viewParams.skinIndex,
                activePowerId: this.player.activePower ? this.player.activePower.id : null,
                pf: Math.round(this.powerFraction(perks) * 100) / 100,
                hl: this.state.hearts
            });
        }

        // Camera follows the lowest living player in multiplayer (so nobody is
        // scrolled off the bottom); a dead player's view rides along with them.
        let threshold = CONFIG.HEIGHT * CONFIG.SCROLL_THRESHOLD;
        let targetY = this.player.isDead ? threshold + 1 : this.player.y;

        if (this.state.multiplayer) {
            const aliveYs = [];
            if (!this.player.isDead) aliveYs.push(this.player.y);
            this.remotePlayers.forEach(rp => { if (!rp.isDead && !this.remoteAway(rp)) aliveYs.push(rp.y); });
            targetY = aliveYs.length ? Math.max(...aliveYs) : threshold + 1; // everyone dead: no scroll
        }

        if (targetY < threshold) this.scrollCamera(threshold - targetY, perks);

        if (!this.player.isDead && this.player.y > CONFIG.HEIGHT) {
            this.die();
            if (!this.state.running || this.state.dying) return;
        }

        const heightMeters = Math.floor(this.state.score / 10);
        if (heightMeters >= this.state.nextMilestone) {
            this.notify(fmtNum(this.state.nextMilestone) + "m!", 'reward');
            this.state.nextMilestone = nextMilestone(heightMeters);
        }
        if (heightMeters > this.state.bestHeight) {
            this.state.bestHeight = heightMeters;
            this.bestDirty = true;
        }

        // Dead and waiting to respawn while the rest of the party went quiet:
        // end the run rather than wait forever.
        if (this.state.multiplayer && this.player.isDead && !this.anyRemoteAlive()) {
            this.checkAllDead();
            if (!this.state.running) return;
        }

        let displayScore = this.runScore();
        if (!this.state.challengeBeaten && this.challengeActive() && displayScore >= this.challenge.meters) {
            this.state.challengeBeaten = true;
            this.notify("TARGET BEATEN!", 'reward');
            if (this.ui.challengeHud) {
                this.ui.challengeHud.innerText = 'TARGET ' + fmtNum(this.challenge.meters) + 'm ✓';
                this.ui.challengeHud.classList.add('beaten');
            }
        }
        this.updateTouchPadStates();
        if (this.bestDirty && this.tick('bestsave', dt, 120)) this.saveBest();
        if (displayScore > this.state.highScore) {
            this.state.highScore = displayScore;
            this.bestDirty = true;
            this.state.isNewBest = true;
        }

        // (Compared as numbers first: building the text every frame was
        // work for nothing.)
        if (displayScore !== this.shownScore) {
            this.shownScore = displayScore;
            setText(this.ui.score, fmtNum(displayScore) + "m");
        }
        if (this.state.highScore !== this.shownBest) {
            this.shownBest = this.state.highScore;
            setText(this.ui.best, "BEST: " + fmtNum(this.state.highScore) + "m");
        }

        this.updatePowerHud(perks);

        if (this.state.multiplayer) {
            // Co-op: a pickup you took is only gone for you (see
            // visiblePickups); the party hears so spectators see it go.
            this.powerups.forEach(p => {
                if (!p.markedForDeletion) return;
                p.markedForDeletion = false;
                if (p.mine) return;
                p.mine = true;
                if (window.network && Number.isInteger(p.wy)) window.network.send({ type: 'pick', pid: window.network.myId, wy: p.wy });
            });
        } else {
            this.powerups = this.powerups.filter(p => !p.markedForDeletion);
        }
    }

    draw() {
        const ctx = this.renderer.ctx;
        if (this.menuSceneShown()) {
            this.drawMenuScene(ctx);
            return;
        }
        const floor = this.platforms.find(p => p.h >= 30);
        this.renderer.clear(this.state.bgOffset, this.sceneClock, this.state.score, floor ? floor.y : null);
        // A hit shakes everything drawn from here on (not the sky behind).
        const shaking = this.shake > 0;
        if (shaking) {
            ctx.save();
            ctx.translate((Math.random() - 0.5) * this.shake, (Math.random() - 0.5) * this.shake);
        }
        this.renderer.drawGrid(this.state.bgOffset);
        if (this.state.running && this.settings.showTips) this.drawTips();

        const biome = this.renderer.currentBiome, biomeIndex = BIOMES.indexOf(biome);
        this.platforms.forEach(p => {
            let y = p.y + (p.dip || 0);
            if (y > CONFIG.HEIGHT || y + p.h + 20 < this.renderer.viewTop) return;
            // Crumbled away: a faint outline, filling back in as it reforms.
            if (p.gone > 0) {
                ctx.globalAlpha = p.gone < 30 ? 0.15 + 0.6 * (1 - p.gone / 30) : 0.15;
            } else if (p.crumbleT > 0) {
                y += Math.sin(this.state.time * 2.3) * 1.5; // about to go
            }
            drawPlatform(ctx, p, y, biome, biomeIndex, this.sceneClock);
            if (p.type) drawPlatformType(ctx, p, y, this.sceneClock);
            ctx.globalAlpha = 1;
        });

        const shownPickups = this.state.multiplayer && this.player.isDead && this.spectatingPlayer
            ? this.spectatePickups(this.spectatingPlayer)
            : this.visiblePickups();
        this.drawPickups(shownPickups, this.state.time);

        this.enemies.forEach(e => this.drawFadingIn(e));
        this.projectiles.forEach(p => this.drawFadingIn(p));

        if (this.state.running && this.settings.showGhost) this.drawGhost();
        if (this.state.running) this.drawBestLine();
        if (this.state.running) this.drawChallengeLine();

        this.renderer.drawSafetyNet(this.safetyNet, this.safetyNet.rescue ? RESCUE_NET_COLOR : POWERS.SAFETY.color, this.state.time);
        const shown = !this.player.isDead && !this.state.dying; // not shattered
        if (this.state.running && shown) this.renderer.drawWrapEdges(this.player.x, this.player.w);

        if (shown) {
            this.drawAfterimages(ctx);
            this.player.draw(this.renderer.ctx);
        }

        if (this.state.multiplayer && this.remotePlayers.size > 0) {
            // Name tags in each player's party-slot colour.
            this.remotePlayers.forEach(rp => {
                if (rp.isDead) return;
                const away = this.remoteAway(rp);
                if (away) this.renderer.ctx.globalAlpha = 0.35;
                rp.draw(this.renderer.ctx);
                this.renderer.drawText(nameTag(rp.name) + (away ? ' (AWAY)' : ''), rp.x + 13, rp.y - 10, "10px Courier New", PARTY_COLORS[rp.slot] || "#00ffcc");
                this.renderer.ctx.globalAlpha = 1;
            });
            if (!this.player.isDead) {
                const me = this.party.find(m => m.pid === window.network.myId);
                this.renderer.drawText(this.getMpName(), this.player.x + 13, this.player.y - 10, "10px Courier New", me ? PARTY_COLORS[me.slot] : "#fff");
            }
        }

        this.drawTeamLimit(); // over everything in the sky above it
        this.particles.draw(this.renderer.ctx);
        this.drawFx(ctx);
        if (shaking) ctx.restore();
    }

    // Spawns aimed just off the top of the 800-tall frame (meteors, the boss,
    // drones) can land inside the extra sky of a tall view. Anything that
    // first shows up there fades in over SPAWN_FADE_FRAMES instead of popping
    // into existence. Purely cosmetic: spawn timing is the same everywhere.
    drawFadingIn(e) {
        const ctx = this.renderer.ctx;
        if (e.shownAt === undefined) {
            const inSky = e.y < 0 && e.y + (e.h || 0) > this.renderer.viewTop;
            e.shownAt = inSky ? this.state.time : -Infinity;
        }
        const a = (this.state.time - e.shownAt) / SPAWN_FADE_FRAMES;
        if (a >= 1) { e.draw(ctx); return; }
        ctx.globalAlpha = Math.max(0, a);
        e.draw(ctx);
        ctx.globalAlpha = 1;
    }

    // For the ?perf meter: what was on screen during a late frame.
    frameNote() {
        const s = this.state, ui = this.ui, has = (el, c) => el && el.classList && el.classList.contains(c);
        return Math.round(s.score / 10) + 'm' +
            (s.running ? '' : ' menu') +
            (has(ui.biomeBanner, 'show') ? ' banner' : '') +
            (has(ui.alert, 'alert-visible') ? ' notice' : '') +
            (ui.achievement.style.display === 'block' ? ' badge' : '') +
            (this.player.activePower ? ' power' : '') +
            ' scenes' + this.renderer.background.scenes.size +
            ' enemies' + this.enemies.length + ' particles' + this.particles.particles.length;
    }

    loop(timestamp) {
        // Book the next frame first: an error in this one must not stop the
        // game for good.
        requestAnimationFrame(this.loop);
        if (!this.lastTime || this.state.paused) this.lastTime = timestamp;
        const deltaTime = timestamp - this.lastTime;
        this.lastTime = timestamp;

        // performance.now() (reset on revive) and the rAF timestamp can
        // disagree by a hair, so clamp at 0 as well as capping long frames.
        let dt = Math.max(0, deltaTime) / (1000 / 60);
        if (dt > 4) dt = 4;

        if (!this.state.paused) this.sceneClock += dt;
        const t0 = this.meter.on ? performance.now() : 0;
        if (this.menuSceneShown()) this.updateMenuScene(dt);
        this.update(dt);
        this.draw();
        this.meter.frame(deltaTime, this.meter.on ? performance.now() - t0 : 0, this.frameNote);
        // The portal wants to know when someone is actually playing: not in
        // a menu, the pause menu or the run-over screens.
        portal.setGameplay(this.state.running && !this.pauseMenuOpen);
    }
}

// Game's co-op, shop, sharing, Pixel of the Hour and leaderboard methods live
// in js/coop.js, js/shop.js, js/share.js, js/hourly.js and js/leaderboard.js
// (loaded before this file). They're written as classes so they
// run in strict mode like the rest of Game, and copied onto it here exactly
// as if they were written in the class above.
for (const part of [GameCoop, GameShop, GameShare, GameHourly, GameLeaderboard]) {
    for (const name of Object.getOwnPropertyNames(part.prototype)) {
        if (name === 'constructor') continue;
        if (Object.prototype.hasOwnProperty.call(Game.prototype, name)) throw new Error('Game.' + name + ' is defined twice');
        Object.defineProperty(Game.prototype, name, Object.getOwnPropertyDescriptor(part.prototype, name));
    }
}

// Page start, run on load (below). A named function so tests can run it.
async function bootGame() {
    // Before Game reads any save: leave the old host, or unpack saves that
    // just arrived from it. Only this site ever had an old host.
    const transfer = PLATFORM === 'web' ? runSaveTransfer() : null;
    if (transfer === 'redirect') return null;
    // A copy on someone else's site gets a pointer to the real one instead.
    if (!siteAllowed(location.hostname)) {
        showSitelock();
        return null;
    }
    // The portal SDK has to be up before the game asks it anything (it
    // gives up after a few seconds and the game runs without it).
    await portal.init();
    portal.loading(true);
    const game = new Game();
    portal.loading(false);
    if (transfer === 'imported') game.notify('PROGRESS TRANSFERRED', 'success');
    SaveBackupUI.mount();

    // Installable / offline play. Only on the live https site (or a local
    // server opened with ?sw), so local development never serves stale
    // cached files. Never inside a portal, whose page isn't ours to cache.
    const wantSW = PLATFORM === 'web' &&
        (location.protocol === 'https:' || new URLSearchParams(location.search).has('sw'));
    if (wantSW && 'serviceWorker' in navigator) {
        navigator.serviceWorker.register('sw.js').catch(err => console.warn('Service worker not registered:', err));
    }
    return game;
}

// What a sitelocked copy shows: no game, just where to play it.
function showSitelock() {
    const note = document.createElement('div');
    note.id = 'sitelock';
    note.style.cssText = 'position:fixed;inset:0;display:flex;flex-direction:column;align-items:center;' +
        'justify-content:center;gap:16px;background:#050505;color:#fff;font:bold 18px Orbitron,sans-serif;' +
        'text-align:center;padding:24px;z-index:99999';
    const title = document.createElement('div');
    title.textContent = 'PIXEL JUMP';
    title.style.cssText = 'font-size:40px;color:#c04dff;text-shadow:0 0 12px #a020f0';
    const text = document.createElement('div');
    text.textContent = "This copy of Pixel Jump isn't allowed on this site.";
    const link = document.createElement('a');
    link.href = SITE_URL;
    link.target = '_top';
    link.rel = 'noopener';
    link.textContent = 'PLAY IT AT ' + SITE_URL.replace(/^https:\/\//, '').replace(/\/$/, '').toUpperCase();
    link.style.cssText = 'color:#00ffcc';
    [title, text, link].forEach(el => note.appendChild(el));
    document.body.innerHTML = '';
    document.body.appendChild(note);
}

window.onload = bootGame;

</script>
<script>/* ---- js/portable.js ---- */
// Portable build only. tools/build-portable.mjs inlines this file last, after
// app.js; index.html never loads it and no other build carries it. That is the
// deliberate exception to the four-places rule for source files: it must not
// reach the web or CrazyGames builds, and it has no callers outside this file.
//
// What it adds to a downloaded copy:
//  - an update check about 2 s after boot, at most once per UPDATE_CHECK_MS,
//    plus a manual check in Settings (automatic updates are not optional);
//  - a menu chip linking to PORTABLE_PAGE_URL when a newer version exists;
//  - BACK UP SAVE / RESTORE SAVE. The displayed code is an encrypted envelope
//    around the shared save format (js/saves.js); see SAVE_CODE_PREFIX below
//    for the honesty note about what that does and does not protect.
//
// Failure is always silent: offline, CORS (file://), a challenge page or
// blocked storage must leave solo play exactly as it was. Nothing here runs
// during a run or touches the game loop.

const PORTABLE_SEEN_KEY = 'lp_update_seen';
const PORTABLE_CHECKED_KEY = 'lp_update_checked';
// Retired opt-out; cleared at boot so a stale value cannot linger.
const PORTABLE_OFF_KEY = 'lp_update_off';
// Pointer to the version cached in IndexedDB; js/portable-loader.js reads it at
// launch. The build itself lives in IndexedDB db PORTABLE_IDB_NAME, store
// PORTABLE_IDB_STORE, key PORTABLE_IDB_RECORD, as {version, protocol, html, sig}.
// `sig` is the detached signature, kept so the loader can re-verify the cached
// build at every launch.
const PORTABLE_READY_KEY = 'lp_update_ready';
const PORTABLE_IDB_NAME = 'pixel-jump-portable';
const PORTABLE_IDB_STORE = 'builds';
const PORTABLE_IDB_RECORD = 'latest';
const PORTABLE_BUILD_FILE = 'pixel-jump-portable';
// A download that failed or was deferred (a run is active) is retried this
// often, at most PORTABLE_RETRY_MAX times a session; the next launch tries
// again regardless, because a failed attempt never moves the 24 h throttle.
const PORTABLE_RETRY_MS = 120000;
const PORTABLE_RETRY_MAX = 10;

function portableRead(key) {
    try { return localStorage.getItem(key); } catch (e) { return null; }
}
function portableStore(key, value) {
    try { localStorage.setItem(key, value); return true; } catch (e) { return false; }
}
function portableRemove(key) {
    try { localStorage.removeItem(key); } catch (e) { /* blocked storage */ }
}
// Restart. Inside a handoff iframe the whole page must reload, so the loader
// runs again and picks the newest build; reloading the srcdoc would not.
function portableReload() {
    try {
        const top = typeof window !== 'undefined' && window.parent && window.parent !== window ? window.parent : null;
        if (top && top.location && typeof top.location.reload === 'function') { top.location.reload(); return; }
    } catch (e) { /* fall through */ }
    if (typeof location !== 'undefined' && typeof location.reload === 'function') location.reload();
}
function portableNoUpdate(search) {
    return typeof search === 'string' && /(?:^\?|&)noupdate(?:&|=|$)/.test(search);
}
function portableSearch() {
    return typeof location !== 'undefined' && typeof location.search === 'string' ? location.search : '';
}

// "1.25.0" -> [1, 25, 0], or null for anything else.
function parseVersion(version) {
    const m = typeof version === 'string' ? version.match(/^(\d+)\.(\d+)\.(\d+)$/) : null;
    return m ? [Number(m[1]), Number(m[2]), Number(m[3])] : null;
}

// -1 / 0 / 1, or null when either side isn't x.y.z. Never offers a downgrade.
function compareVersions(a, b) {
    const pa = parseVersion(a), pb = parseVersion(b);
    if (!pa || !pb) return null;
    for (let i = 0; i < 3; i++) {
        if (pa[i] !== pb[i]) return pa[i] < pb[i] ? -1 : 1;
    }
    return 0;
}

// Trusted fields: version, protocol, and (for downloads) bytes, sha256, sig.
// No URL is ever taken from it: the page link is hardcoded (PORTABLE_PAGE_URL)
// and download URLs are derived from the version (portableBuildUrl).
function parsePortableManifest(text) {
    let data;
    try { data = JSON.parse(text); } catch (e) { return null; }
    if (!data || typeof data !== 'object' || Array.isArray(data)) return null;
    if (typeof data.version !== 'string' || !parseVersion(data.version)) return null;
    if (typeof data.protocol !== 'number' || !Number.isFinite(data.protocol)) return null;
    const out = { version: data.version, protocol: data.protocol };
    if (Number.isInteger(data.bytes) && data.bytes > 0) out.bytes = data.bytes;
    if (typeof data.sha256 === 'string' && /^[0-9a-f]{64}$/.test(data.sha256)) out.sha256 = data.sha256;
    if (typeof data.sig === 'string' && data.sig.length > 0 && data.sig.length < 512) out.sig = data.sig;
    return out;
}

// Per-tag, immutable feed URL for a version already validated by parseVersion.
function portableBuildUrl(version) {
    return PORTABLE_FEED_BASE + version + '/' + PORTABLE_BUILD_FILE;
}

function portableHex(buffer) {
    let out = '';
    const bytes = new Uint8Array(buffer);
    for (let i = 0; i < bytes.length; i++) out += (bytes[i] < 16 ? '0' : '') + bytes[i].toString(16);
    return out;
}

// The version a build's own config declares ("const GAME_VERSION = 'x.y.z'").
function portableDeclaredVersion(html) {
    const m = /^const GAME_VERSION = '(\d+\.\d+\.\d+)';/m.exec(html);
    return m ? m[1] : null;
}

// Resolves to the build's HTML only if length, SHA-256, ECDSA signature and
// declared version all match the manifest; otherwise rejects.
async function portableVerifyBuild(manifest, bytes, sigText) {
    const c = saveCodeCrypto();
    if (!c) throw new Error('no webcrypto');
    if (!manifest.bytes || !manifest.sha256 || !manifest.sig) throw new Error('unsigned manifest');
    if (bytes.byteLength !== manifest.bytes) throw new Error('wrong size');
    if (portableHex(await c.subtle.digest('SHA-256', bytes)) !== manifest.sha256) throw new Error('wrong hash');
    const key = await c.subtle.importKey('spki', base64UrlToBytes(PORTABLE_SIGNING_PUBKEY),
        { name: 'ECDSA', namedCurve: 'P-256' }, false, ['verify']);
    const sig = base64UrlToBytes(String(sigText).trim());
    if (!await c.subtle.verify({ name: 'ECDSA', hash: 'SHA-256' }, key, sig, bytes)) throw new Error('bad signature');
    const html = new TextDecoder().decode(bytes);
    if (portableDeclaredVersion(html) !== manifest.version) throw new Error('wrong declared version');
    return html;
}

function portableOpenDb() {
    return new Promise((resolve, reject) => {
        if (typeof indexedDB === 'undefined' || !indexedDB) { reject(new Error('no indexedDB')); return; }
        let req;
        try { req = indexedDB.open(PORTABLE_IDB_NAME, 1); } catch (e) { reject(e); return; }
        req.onupgradeneeded = () => {
            if (!req.result.objectStoreNames.contains(PORTABLE_IDB_STORE)) req.result.createObjectStore(PORTABLE_IDB_STORE);
        };
        req.onsuccess = () => resolve(req.result);
        req.onerror = () => reject(req.error || new Error('indexedDB blocked'));
        req.onblocked = () => reject(new Error('indexedDB blocked'));
    });
}

// Replaces the single cached record. Resolves once the transaction commits.
async function portableStoreBuild(record) {
    const db = await portableOpenDb();
    try {
        await new Promise((resolve, reject) => {
            const tx = db.transaction(PORTABLE_IDB_STORE, 'readwrite');
            tx.oncomplete = () => resolve();
            tx.onerror = () => reject(tx.error || new Error('store failed'));
            tx.onabort = () => reject(tx.error || new Error('store aborted'));
            tx.objectStore(PORTABLE_IDB_STORE).put(record, PORTABLE_IDB_RECORD);
        });
    } finally {
        if (typeof db.close === 'function') db.close();
    }
}

// The cached record, or null when missing or the database is unavailable.
async function portableReadBuild() {
    let db;
    try { db = await portableOpenDb(); } catch (e) { return null; }
    try {
        return await new Promise((resolve, reject) => {
            const tx = db.transaction(PORTABLE_IDB_STORE, 'readonly');
            const req = tx.objectStore(PORTABLE_IDB_STORE).get(PORTABLE_IDB_RECORD);
            req.onsuccess = () => resolve(req.result || null);
            req.onerror = () => reject(req.error || new Error('read failed'));
        });
    } catch (e) {
        return null;
    } finally {
        if (typeof db.close === 'function') db.close();
    }
}

// The automatic check is due unless ?noupdate is in the address (developer
// escape) or the last successful check is under UPDATE_CHECK_MS old. A clock set back
// also counts as due.
function updateCheckDue(now, lastChecked, search) {
    if (portableNoUpdate(search)) return false;
    return !(Number.isFinite(lastChecked) && now - lastChecked < UPDATE_CHECK_MS);
}

const PortableUI = {
    game: null,
    ready: false,
    checking: false,
    manifest: null,
    readyVersion: null,
    downloading: false,
    update: null,
    timer: null,
    retries: 0,
    chip: null,
    chipLink: null,
    status: null,
    checkBtn: null,
    restartBtn: null,

    // Idempotent; the platform guard keeps the web build out entirely.
    init(game) {
        if (this.ready || PLATFORM !== 'portable') return false;
        if (typeof document === 'undefined' || typeof document.createElement !== 'function') return false;
        this.ready = true;
        this.game = game || null;
        portableRemove(PORTABLE_OFF_KEY);
        // This build came up: tell the launch crash guard (see portable-loader.js).
        if (typeof PortableLoader !== 'undefined') PortableLoader.clearBooting();
        this.buildChip();
        this.buildSettings();
        this.scheduleCheck();
        return true;
    },

    runActive() {
        return !!(this.game && this.game.state && this.game.state.running);
    },

    // ------------------------------------------------------------ update chip
    buildChip() {
        const menu = document.getElementById('menu-layer');
        if (!menu) return;
        const chip = document.createElement('div');
        chip.className = 'portable-update';
        chip.hidden = true;

        const link = document.createElement('a');
        link.className = 'portable-update-link';
        link.href = PORTABLE_PAGE_URL;
        link.target = '_blank';
        link.rel = 'noopener';
        link.textContent = 'UPDATE';

        link.addEventListener('click', e => {
            if (!this.readyVersion) return;
            if (e && typeof e.preventDefault === 'function') e.preventDefault();
            portableReload();
        });

        const dismiss = document.createElement('button');
        dismiss.type = 'button';
        dismiss.className = 'portable-update-dismiss';
        dismiss.setAttribute('aria-label', 'Dismiss update notice');
        dismiss.textContent = '\u00d7';
        dismiss.addEventListener('click', () => this.dismiss());

        chip.appendChild(link);
        chip.appendChild(dismiss);
        menu.appendChild(chip);
        this.chip = chip;
        this.chipLink = link;
    },

    // Hides the chip for this exact version; the next version shows again.
    // A ready update is never remembered as seen: its restart chip returns.
    dismiss() {
        if (this.update && !this.updateReady()) portableStore(PORTABLE_SEEN_KEY, this.update.version);
        if (this.chip) this.chip.hidden = true;
    },

    updateReady() {
        return !!(this.update && this.readyVersion === this.update.version);
    },

    renderChip() {
        if (!this.chip || !this.chipLink) return;
        if (!this.update || (!this.updateReady() && portableRead(PORTABLE_SEEN_KEY) === this.update.version)) {
            this.chip.hidden = true;
            return;
        }
        if (this.updateReady()) {
            this.chipLink.textContent = 'UPDATE READY \u00b7 RESTART';
            this.chip.hidden = false;
            return;
        }
        this.chipLink.textContent = this.update.protocol !== NET_PROTOCOL
            ? 'UPDATE FOR CO-OP \u00b7 v' + this.update.version
            : 'UPDATE v' + this.update.version;
        this.chip.hidden = false;
    },

    // ---------------------------------------------------------------- settings
    buildSettings() {
        const close = document.getElementById('settings-close-btn');
        if (!close || !close.parentNode || typeof close.parentNode.insertBefore !== 'function') return;
        const box = close.parentNode;
        const insert = el => box.insertBefore(el, close);

        const checkRow = document.createElement('div');
        checkRow.className = 'portable-check-row';
        const checkBtn = document.createElement('button');
        checkBtn.type = 'button';
        checkBtn.className = 'btn overlay-btn';
        checkBtn.textContent = 'CHECK FOR UPDATES';
        const status = document.createElement('div');
        status.className = 'settings-status';
        status.setAttribute('role', 'status');
        status.setAttribute('aria-live', 'polite');
        checkBtn.addEventListener('click', () => this.check(true));
        const restartBtn = document.createElement('button');
        restartBtn.type = 'button';
        restartBtn.className = 'btn btn--primary overlay-btn';
        restartBtn.textContent = 'RESTART NOW';
        restartBtn.hidden = true;
        restartBtn.addEventListener('click', () => portableReload());
        checkRow.appendChild(checkBtn);
        checkRow.appendChild(status);
        checkRow.appendChild(restartBtn);
        insert(checkRow);
        this.restartBtn = restartBtn;
        this.checkBtn = checkBtn;
        this.status = status;

        insert(SaveBackupUI.build({
            note: 'Back up before you replace the file. The code carries your best height, gems, Pixels and records. It is locked to Pixel Jump: an edited or damaged code will not restore.',
            secureHint: 'OPEN THE FILE DIRECTLY',
            reload: portableReload
        }));
    },

    setStatus(state) {
        if (this.checkBtn) this.checkBtn.disabled = state === 'checking';
        if (this.restartBtn) this.restartBtn.hidden = state !== 'ready';
        if (!this.status) return;
        this.status.setAttribute('data-state', state);
        this.status.textContent = state === 'checking' ? 'CHECKING\u2026'
            : state === 'current' ? 'UP TO DATE'
            : state === 'ready' ? 'UPDATE READY \u2014 RESTART'
            : state === 'update' ? 'UPDATE v' + (this.update ? this.update.version : '')
            : state === 'error' ? "COULDN'T CHECK"
            : '';
    },

    // ------------------------------------------------------------ update check
    scheduleCheck() {
        if (typeof setTimeout !== 'function') return;
        const last = parseInt(portableRead(PORTABLE_CHECKED_KEY), 10) || 0;
        if (!updateCheckDue(Date.now(), last, portableSearch())) return;
        this.timer = setTimeout(() => {
            this.timer = null;
            if (this.runActive()) this.scheduleRetry();
            else this.check(false);
        }, 2000);
    },

    // Try again in PORTABLE_RETRY_MS (bounded). Used when a download failed or
    // was deferred by an active run; the callback re-defers while a run is on.
    scheduleRetry() {
        if (typeof setTimeout !== 'function' || this.timer || this.retries >= PORTABLE_RETRY_MAX) return;
        this.retries++;
        this.timer = setTimeout(() => {
            this.timer = null;
            if (this.runActive()) this.scheduleRetry();
            else this.check(false);
        }, PORTABLE_RETRY_MS);
    },

    // Downloads and verifies the build for a manifest, then caches it. Silent
    // on every failure: nothing is stored and play is untouched. Never stores a
    // version <= the embedded or already-cached one; the URLs come from the
    // version, never from the manifest. Resolves 'ready' (cached and verified),
    // 'retry' (failed or deferred: try again soon) or 'none' (nothing to fetch).
    async download(manifest) {
        if (PLATFORM !== 'portable') return 'none';
        if (this.downloading) return 'retry';
        if (portableNoUpdate(portableSearch())) return 'none';
        if (compareVersions(manifest.version, GAME_VERSION) !== 1) return 'none';
        // A version that failed to start is never fetched again.
        if (typeof PortableLoader !== 'undefined' && PortableLoader.isBad(manifest.version)) return 'none';
        if (!manifest.bytes || !manifest.sha256 || !manifest.sig) return 'none';
        const cached = portableRead(PORTABLE_READY_KEY);
        if (cached && compareVersions(manifest.version, cached) !== 1) {
            if (cached !== manifest.version) return 'none';
            // The pointer lives in localStorage and the build in IndexedDB; the
            // browser may have evicted one. Only a present record counts.
            const rec = await portableReadBuild();
            if (rec && rec.version === cached && typeof rec.html === 'string') {
                this.readyVersion = cached;
                return 'ready';
            }
            portableRemove(PORTABLE_READY_KEY);
        }
        if (this.runActive()) return 'retry';
        this.downloading = true;
        let controller = null;
        let timer = null;
        try {
            if (typeof fetch !== 'function') throw new Error('no fetch');
            if (typeof AbortController === 'function') {
                controller = new AbortController();
                timer = setTimeout(() => controller.abort(), PORTABLE_DOWNLOAD_TIMEOUT_MS);
            }
            const opts = { cache: 'no-store', signal: controller ? controller.signal : undefined };
            const url = portableBuildUrl(manifest.version);
            const [buildRes, sigRes] = await Promise.all([fetch(url, opts), fetch(url + '.sig', opts)]);
            if (!buildRes || !buildRes.ok || !sigRes || !sigRes.ok) throw new Error('HTTP error');
            const bytes = await buildRes.arrayBuffer();
            const sig = (await sigRes.text()).trim();
            // The manifest and the per-tag signature must be the same signature.
            if (sig !== manifest.sig) throw new Error('signature mismatch');
            const html = await portableVerifyBuild(manifest, bytes, sig);
            // A run may have started while the download was in flight: drop the
            // verified build quietly and try again later.
            if (this.runActive()) return 'retry';
            await portableStoreBuild({ version: manifest.version, protocol: manifest.protocol, html, sig });
            if (!portableStore(PORTABLE_READY_KEY, manifest.version)) return 'retry';
            this.readyVersion = manifest.version;
            return 'ready';
        } catch (e) {
            return 'retry';
        } finally {
            if (timer) clearTimeout(timer);
            this.downloading = false;
        }
    },

    async check(manual) {
        if (PLATFORM !== 'portable' || this.checking) return null;
        if (!manual) {
            const last = parseInt(portableRead(PORTABLE_CHECKED_KEY), 10) || 0;
            if (!updateCheckDue(Date.now(), last, portableSearch()) || this.runActive()) return null;
        }
        this.checking = true;
        this.setStatus('checking');
        let controller = null;
        let timer = null;
        try {
            if (typeof fetch !== 'function') throw new Error('no fetch');
            if (typeof AbortController === 'function') {
                controller = new AbortController();
                timer = setTimeout(() => controller.abort(), UPDATE_CHECK_TIMEOUT_MS);
            }
            const res = await fetch(PORTABLE_UPDATE_URL, {
                cache: 'no-store',
                signal: controller ? controller.signal : undefined
            });
            if (!res || !res.ok) throw new Error('HTTP ' + (res && res.status));
            const data = parsePortableManifest(await res.text());
            if (!data) throw new Error('bad manifest');
            this.manifest = data;
            const newer = compareVersions(data.version, GAME_VERSION) === 1;
            this.update = newer ? data : null;
            this.setStatus(newer ? 'update' : 'current');
            this.renderChip();
            // The throttle only moves once the check is finished: nothing newer,
            // or the newer build is cached. A failed or deferred download
            // leaves it alone so the next launch (or the retry) tries again.
            let outcome = 'none';
            if (newer) outcome = await this.download(data);
            if (outcome === 'ready') {
                this.setStatus('ready');
                this.renderChip();
            }
            if (outcome === 'retry') this.scheduleRetry();
            else portableStore(PORTABLE_CHECKED_KEY, String(Date.now()));
            return newer ? data : null;
        } catch (e) {
            // Offline, CORS, a challenge page, a timeout or blocked storage:
            // say nothing, offer nothing, and leave play untouched.
            this.setStatus('error');
            return null;
        } finally {
            if (timer) clearTimeout(timer);
            this.checking = false;
        }
    }
};

// bootGame is async and sets window.onload in app.js, which was evaluated just
// before this file. Wrap it so the UI is built once the Game exists.
if (typeof window !== 'undefined' && PLATFORM === 'portable') {
    const previous = window.onload;
    window.onload = async function () {
        // The loader (inlined first) may have a verified newer build: run that
        // instead of the embedded game. Any failure boots the embedded one.
        const build = typeof PortableLoader !== 'undefined' ? await PortableLoader.ready : null;
        if (build && PortableLoader.mount(build)) return null;
        const game = typeof previous === 'function' ? await previous.apply(this, arguments) : null;
        PortableUI.init(game);
        return game;
    };
}

</script>
