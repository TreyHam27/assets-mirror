    gap: 6px;
    margin: 4px 0 2px;
}
.heart-pip {
    width: 30px;
    height: 30px;
    color: rgba(255, 255, 255, 0.14);
}
.heart-pip.free,
.heart-pip.bought {
    color: var(--pixel);
    filter: drop-shadow(0 0 6px rgba(var(--pixel-rgb), 0.7));
}
.booster-extra {
    color: var(--gold);
    font: 700 12px var(--font-text);
    letter-spacing: 0.5px;
}
.booster-n {
    color: #fff;
    font: 900 40px var(--font-display);
}
.booster-n small {
    color: var(--muted);
    font-size: 18px;
}
.booster-label {
    color: var(--muted);
    font: 700 12px var(--font-text);
    letter-spacing: 1px;
}
.booster-desc {
    margin: 2px 0 8px;
    color: var(--muted);
    font: 500 13px var(--font-text);
}
.booster-slot .btn {
    margin-top: auto;
    min-height: 44px;
}

/* Soft accounts (js/account.js): the recovery code in SAVE DATA, the box to
   type another device's code into, and a replay-checked board row. */
