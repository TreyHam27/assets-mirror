    },
    "Deep Space": {
        sky: ['#020208', '#07061c', '#150b2e'], stars: 1.2,
        tiles: [
            { speed: 0.15, h: 2000, seed: 41, paint: paintBlobs(5, ['rgba(255, 80, 200, 0.10)', 'rgba(80, 140, 255, 0.11)', 'rgba(255, 190, 80, 0.07)'], 170, 320) },
            { speed: 0.3, h: 2200, seed: 42, column: true, paint: paintPlanets },
            { speed: 0.8, h: 1500, seed: 43, paint: paintAsteroids }
        ]
    },
    "The Rift": {
        sky: ['#10001c', '#2b0044', '#55126e'], stars: 0.6, fixed: FIXED_RIFT,
        tiles: [
            { speed: 0.2, h: 1600, seed: 51, paint: paintBlobs(6, ['rgba(255, 60, 220, 0.10)', 'rgba(120, 80, 255, 0.12)'], 150, 280) },
            { speed: 0.55, h: 1700, seed: 52, paint: paintRift }
        ]
    },
    "Neon Grid": {
        sky: ['#000d10', '#002a2c', '#00493f'], stars: 0.4, fixed: FIXED_SUN,
        tiles: [
            { speed: 0.5, h: 1600, seed: 61, paint: paintWireframes }
        ]
    },
    "Static Field": {
        sky: ['#08080a', '#15151a', '#24242c'], stars: 0.3, fixed: FIXED_STATIC,
        tiles: [
            { speed: 0.4, h: 1400, seed: 71, paint: paintDeadPixels }
        ]
    },
    "The Void": {
        sky: ['#000000', '#070006', '#17000b'], stars: 0.25, fixed: FIXED_EMBERS,
        tiles: [
            { speed: 0.25, h: 1600, seed: 81, paint: paintBlobs(6, ['rgba(255, 0, 60, 0.07)', 'rgba(120, 0, 80, 0.10)'], 160, 300) }
        ]
    }
};
// Metres over which one biome's scene fades into the next.
const SCENE_FADE_METERS = 80;
// How far below a biome its scene starts being built, a piece per frame, so
// nothing is painted at the moment you cross into it.
const SCENE_PREBUILD_METERS = 150;
const SCENE_WARM_METERS = 30;
// The star field repeats every STAR_H px. Its stars are split into groups
// that scroll at two speeds and twinkle out of step: `secs` and `phase` are
// each group's rhythm (see swing()).
const STAR_H = CONFIG.HEIGHT + VIEW_MAX_EXTRA;
const STAR_GROUPS = [
    { speed: 0.1, secs: 1.3, phase: 0 }, { speed: 0.22, secs: 1.9, phase: 0.42 },
    { speed: 0.1, secs: 2.3, phase: 0.65 }, { speed: 0.22, secs: 1.6, phase: 0.25 }
];
// Frames between the pictures of a scene that is being warmed up.
const SCENE_WARM_GAP = 6;
// Drawing a frame of scenery should take no time to speak of: a browser
// drawing on the graphics card only notes the calls down. One that takes
// this long (ms, averaged over SCENE_PACE_FRAMES) is drawing in software,
// where placing pictures between pixels is what costs.
const SCENE_SLOW_MS = 3, SCENE_PACE_FRAMES = 40;
const sceneNow = () => (typeof performance !== 'undefined' && performance.now ? performance.now() : 0);

class Background {
    constructor() {
        this.view = null;
        this.scenes = new Map();
        this.starSets = new Map();
        this.lite = false;
        // Whole-pixel positions for moving scenery (see pace()).
        this.snap = false;
        this.cost = 0;
        this.costFrames = 0;
    }

    // The star pictures, one per group. `boost` over 1 bakes them brighter,
    // for a scene whose stars are (Deep Space's 1.2).
    starTiles(boost) {
        let set = this.starSets.get(boost);
        if (set) return set;
        const rnd = sceneRng(5), count = Math.round(110 * STAR_H / 800);
        const tiles = STAR_GROUPS.map(() => {
            const canvas = sceneCanvas(TILE_W, STAR_H);
            return { canvas, g: paintContext(canvas) };
        });
        for (let i = 0; i < count; i++) {
            const x = rnd() * TILE_W, y = rnd() * STAR_H;
            const size = rnd() < 0.15 ? 2 : 1, fast = !(rnd() < 0.5);
            const glow = 0.3 + rnd() * 0.7;
            rnd(); rnd(); // (each star once had its own twinkle phase and rate)
            const g = tiles[(fast ? 1 : 0) + (i % 2) * 2].g;
            if (!g) continue;
            g.globalAlpha = Math.min(1, glow * boost);
            g.fillStyle = '#fff';
            // Drawn again past each edge it pokes over, so the picture wraps.
            for (const dx of [0, -TILE_W]) for (const dy of [0, -STAR_H]) g.fillRect(x + dx, y + dy, size, size);
        }
        set = tiles.map(tile => scenePicture(tile.canvas));
        this.starSets.set(boost, set);
        return set;
    }

    // A scene's pictures. Its tiles are painted by st.jobs, one each, which
    // frame() runs a frame apart ahead of time (or all at once if the scene
    // is needed now).
    create(name) {
        const def = SCENES[name];
        // (shown, alpha and fade record how the scene was last drawn: its
        // sky's opacity and its parts'.)
        const st = { name, def, layers: [], pictures: [], jobs: [], sky: null, shown: false, alpha: 0, fade: 0, warmed: 0 };
        def.tiles.forEach(t => {
            const layer = { pic: null, speed: t.speed, drift: t.drift || 0, column: !!t.column };
            st.layers.push(layer);
            // Painted in one job, or a job per step for a heavy tile.
            let c = null, g = null;
            const begin = () => {
                c = sceneCanvas(TILE_W, t.h);
                g = paintContext(c);
            };
            const finish = () => {
                layer.pic = scenePicture(c);
                st.pictures.push(layer.pic);
            };
            if (t.steps) {
                let steps = null;
                st.jobs.push(() => { begin(); steps = g ? t.steps(g, TILE_W, t.h, sceneRng(t.seed)) : []; });
                for (let i = 0; i < 4; i++) st.jobs.push(() => { if (steps[i]) steps[i](); });
                st.jobs.push(finish);
            } else {
                st.jobs.push(() => {
                    begin();
                    if (g) t.paint(g, TILE_W, t.h, sceneRng(t.seed));
                    finish();
                });
            }
        });
        if (def.fixed && def.fixed.build) def.fixed.build(st);
        if (this.view) this.layout(st);
        return st;
    }

    // The scene for a biome, created on first use. `now` finishes painting
    // it at once.
    scene(name, now = false) {
        let st = this.scenes.get(name);
        if (!st) {
            st = this.create(name);
            this.scenes.set(name, st);
        }
        if (now) while (st.jobs.length) st.jobs.shift()();
        return st;
    }

    drop(st) {
        this.scenes.delete(st.name);
        st.pictures.forEach(dropPicture);
        dropPicture(st.sky);
        if (st.def.fixed && st.def.fixed.drop) st.def.fixed.drop(st);
    }

    // Paints the pictures of a scene that depend on the view: its sky, which
    // runs from the top of the playfield's view to the foot of the frame.
    layout(st) {
        const v = this.view;
        const from = v.skyTop - v.ptop, span = CONFIG.HEIGHT - v.skyTop, n = st.def.sky.length - 1;
        dropPicture(st.sky);
        st.sky = gradientPicture(v.x1 - v.x0, v.bottom - v.top, st.def.sky.map((c, i) => [from + span * i / n, c]));
        if (st.def.fixed && st.def.fixed.layout) st.def.fixed.layout(st, v);
    }

    // The area the scenery covers, in game coordinates: { x0, x1, top,
    // bottom } (wider than the 600-wide column when it fills the window),
    // and skyTop, where the sky starts (the top of the playfield's own view).
    // (px0, ptop) is added to it: the scenery canvas's own corner, which the
    // Renderer puts on a whole pixel.
    setView(v) {
        v.px0 = -Math.round(-v.x0);
        v.ptop = -Math.round(-v.top);
        this.view = v;
        this.scenes.forEach(st => this.layout(st));
    }

    // Which scenes show at a camera height (px): the biome's, and for the
    // first SCENE_FADE_METERS of it the one below still showing through.
    mix(score) {
        const meters = score / 10, index = biomeIndexAt(meters);
        const blend = index > 0 ? Math.min(1, (meters - BIOMES[index].threshold) / SCENE_FADE_METERS) : 1;
        return { index, blend };
    }

    // One frame of scenery, drawn over the whole view. f is
    //   offset   the background scroll (Game.state.bgOffset)
    //   score    the camera height in px (0 on the menu)
    //   time     a clock in 60fps frames, for anything animated
    //   padY     screen y of the launch pad (or null): drawn across the
    //            whole view, so a wide window shows it running on past
    //            the column
    // ctx is the scenery canvas, already in game coordinates.
    frame(f, ctx) {
        const v = this.view;
        if (!v) return;
        const { index, blend } = this.mix(f.score);
        const cur = this.scene(BIOMES[index].name, true);
        const prev = blend < 1 ? this.scene(BIOMES[index - 1].name, true) : null;
        const up = BIOMES[index + 1];
        const next = up && up.threshold - f.score / 10 < SCENE_PREBUILD_METERS ? this.scene(up.name) : null;
        if (next && next.jobs.length) next.jobs.shift()();
        // Just under the boundary the next scene is drawn, all but invisibly
        // and a picture at a time, so the browser has its pictures ready
        // before the fade begins.
        const warm = next && !next.jobs.length && up.threshold - f.score / 10 < SCENE_WARM_METERS;
        this.scenes.forEach(st => {
            if (st === cur || st === prev) return;
            if (st === next) st.shown = false;
            else this.drop(st);
        });
        // A scene fades in over the one below: its sky over that sky, and
        // its parts in as the other's go out.
        const w = v.x1 - v.x0;
        if (prev) this.mark(prev, 1, 1 - blend);
        this.mark(cur, blend, blend);
        if (!ctx) return;
        const began = this.snap ? 0 : sceneNow();
        f.snap = this.snap;
        ctx.globalAlpha = 1;
        if (prev) ctx.drawImage(prev.sky.img, v.px0, v.ptop);
        ctx.globalAlpha = prev ? blend : 1;
        ctx.drawImage(cur.sky.img, v.px0, v.ptop);

        if (!this.lite) {
            // The stars: one set, shared by the scenes, at the brightness of
            // the one showing (or between two, mid-fade).
            const level = prev ? prev.def.stars + (cur.def.stars - prev.def.stars) * blend : cur.def.stars;
            const boost = Math.max(1, (prev && blend < 0.5 ? prev : cur).def.stars);
            const stars = this.starTiles(boost), bright = Math.min(1, level / boost);
            for (let i = 0; i < STAR_GROUPS.length; i++) {
                const group = STAR_GROUPS[i];
                ctx.globalAlpha = bright * (0.25 + 0.75 * swing(f.time, group.secs, group.phase));
                drawTiled(ctx, stars[i], v, 0, v.skyTop + f.offset * group.speed, false, f);
            }
        }

        if (prev) this.parts(ctx, prev, 1 - blend, f);
        this.parts(ctx, cur, prev ? blend : 1, f);
        if (warm) this.parts(ctx, next, 0.004, f, ++next.warmed);
        ctx.globalAlpha = 1;

        if (f.padY !== null && f.padY !== undefined && f.padY < v.bottom) {
            // The same pad the playfield draws, widened in whole repeats of
            // its stripes and lights (every 420px) so the two line up.
            const reach = Math.max(-v.x0, v.x1 - CONFIG.WIDTH);
            const extra = Math.ceil(Math.max(0, reach) / 420) * 420;
            const pad = this.pad || (this.pad = { x: 0, y: 0, w: 0, h: 40 });
            pad.x = -extra;
            pad.y = f.padY;
            pad.w = CONFIG.WIDTH + extra * 2;
            drawPlatform(ctx, pad, f.padY, BIOMES[index], index, f.time);
            // ...and solid ground below it, where a window shows any.
            if (f.padY + 40 < v.bottom) {
                ctx.fillStyle = platformLook(BIOMES[index]).under;
                ctx.fillRect(v.x0, f.padY + 40, w, v.bottom - f.padY - 40);
            }
        }
        if (!this.snap) this.pace(sceneNow() - began);
    }

    // Keeps an eye on what a frame of scenery costs (ms). Too much, and
    // the moving pictures go on whole pixels from then on: a touch less
    // smooth when they move slowly, and several times cheaper to draw.
    pace(ms) {
        this.cost += ms;
        if (++this.costFrames < SCENE_PACE_FRAMES) return;
        if (this.cost / this.costFrames > SCENE_SLOW_MS) this.snap = true;
        this.cost = this.costFrames = 0;
    }

    mark(st, alpha, fade) {
        st.shown = true;
        st.alpha = alpha;
        st.fade = fade;
    }

    // A scene's tiles and fixed part at opacity `a`. `warmed` (a scene being
    // warmed up) counts its frames so far: a picture more every few.
    parts(ctx, st, a, f, warmed = Infinity) {
        const v = this.view;
        // (Lite scenery leaves the tiles out: see FrameMeter.)
        if (!this.lite) {
            for (let i = 0; i < st.layers.length; i++) {
                const L = st.layers[i];
                if (!L.pic || warmed <= i * SCENE_WARM_GAP) continue;
                ctx.globalAlpha = a;
                drawTiled(ctx, L.pic, v, L.column ? 0 : L.drift * f.time, v.skyTop + f.offset * L.speed, L.column, f);
            }
        }
        if (st.def.fixed && warmed > st.layers.length * SCENE_WARM_GAP) st.def.fixed.draw(ctx, v, a, st, f);
    }
}

