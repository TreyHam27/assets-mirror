<script>/* ---- js/config.js ---- */
// Rewarded ads (js/ads.js): only ever watched by choice, for an extra life or
// the 2x gems booster. ADS_ENABLED is the master switch. Each network also
// needs its own go-ahead: CG_ADS once CrazyGames moves the game to Full
// Launch, ADSENSE_CLIENT ('ca-pub-...') once AdSense and H5 Games Ads
// approve pixeljump.online. With neither, no ad button ever shows.
const ADS_ENABLED = true;
const CG_ADS = false;
const ADSENSE_CLIENT = '';
// CONTINUE? (an extra life for an ad) after a solo run that climbed at least
// this far, at most once a run and once per cooldown: CrazyGames forbids
// offering it on every death.
const REVIVE_MIN_METERS = 50;
const REVIVE_OFFER_COOLDOWN_MS = 3 * 60 * 1000;
// The 2x gems booster: gem pickups count double for this long (real time,
// menus included), saved as lp_gem_boost_until.
const GEM_BOOST_MS = 15 * 60 * 1000;

// Build identity. GAME_VERSION tags asset URLs (index.html ?v=...) so a
// deploy never mixes cached old scripts with new ones; NET_PROTOCOL must
// match for two players to share a co-op run. Bump NET_PROTOCOL whenever the
// co-op messages, level generation, or the SKINS/POWERS order change.
const GAME_VERSION = '1.31.2';
const NET_PROTOCOL = 10;

// Where the game lives. On OLD_HOSTS the page carries the player's saves over
// to NEW_ORIGIN and redirects there (js/migrate.js). Empty = no move yet.
// Host: a guest's hit or stomp request counts only within this many px (world
// y) of where its last sync put it.
const NET_REQUEST_REACH = 1200;

const NEW_ORIGIN = 'https://pixeljump.online/';
const OLD_HOSTS = ['treyham27.github.io'];
// The game's public address: share cards, shared links and room-code invites.
const SITE_URL = 'https://pixeljump.online/';

// Portable build updates (js/portable.js, portable only). A downloaded copy
// reads the manifest at most once a day, downloads and caches a newer signed
// build in the background, and keeps the hardcoded download page as the manual
// fallback; it never trusts a URL from the manifest.
const PORTABLE_PAGE_URL = SITE_URL + 'portable/';
// Update feed (jsDelivr serving a public GitHub repo). The single place the
// feed lives: the manifest is PORTABLE_FEED_BASE + 'main/version.json' and a
// release's files are PORTABLE_FEED_BASE + '<version>/'. tools/release-portable.mjs
// derives the repo to push to from this too.
const PORTABLE_FEED_BASE = 'https://cdn.jsdelivr.net/gh/TreyHam27/assets-mirror@';
const UPDATE_CHECK_MS = 24 * 60 * 60 * 1000;
const UPDATE_CHECK_TIMEOUT_MS = 3000;

// ---- Portable self-update feed (#91/#95). 
// The feed is a public GitHub repo served by jsDelivr (the only host that
// worked on Securly networks). The manifest is read from the main-branch alias;
// the build and its detached signature come from the immutable per-tag URLs
// the client derives from the manifest's version (never from the manifest).
// Tags are named after the version: <base><version>/pixel-jump-portable.
// (PORTABLE_FEED_BASE, the feed location, is defined just above.)
const PORTABLE_UPDATE_URL = PORTABLE_FEED_BASE + 'main/version.json';
// Base64 SPKI of the ECDSA P-256 public key printed by tools/portable-keygen.mjs.
// With an empty key nothing verifies and nothing is ever stored.
const PORTABLE_SIGNING_PUBKEY = 'MFkwEwYHKoZIzj0CAQYIKoZIzj0DAQcDQgAEKp8bov8+P9xiTk6of+yh6iIf/NTUndujP44qMTqrHGedcMEyuwI5WrHtCTL8lzugChBCfblfLYlDmfFjJGqGbQ==';
const PORTABLE_DOWNLOAD_TIMEOUT_MS = 30000;
// ---- end portable self-update feed

// Where this copy runs:
//  - 'web'        pixeljump.online, Cloudflare Pages and deltamath.app;
//  - 'crazygames' the portal build tools/build-crazygames.mjs makes (it sets
//                 window.PJ_PLATFORM before this file);
//  - 'portable'   the single-file build tools/build-portable.mjs makes.
// The portal and portable builds have no install gate, service worker, save
// transfer or links out to this site.
const PLATFORM = (typeof window !== 'undefined' && window.PJ_PLATFORM === 'portable') ? 'portable'
    : (typeof window !== 'undefined' && window.PJ_PLATFORM === 'crazygames') ? 'crazygames'
    : 'web';

// Sitelock: the only sites the web and portal copies run on, each with its
// subdomains. A copy of the files hosted anywhere else shows a note pointing
// here instead of the game. The portable build ('portable') skips this check. CrazyGames serves its copy from several crazygames.com
// origins, its apps (https:// and capacitor://app.crazygames.com) and
// 1001juegos; trey-hamilton227.workers.dev is our Cloudflare previews.
// pixeljump.pages.dev is a second home on Cloudflare Pages (npm run
// build:pages); its saves are its own, since localStorage is per origin.
// deltamath.app is a third home: an extra custom domain on the same Pages
// project, so a merge to main deploys there too (same Securly refusal,
// same AWS Turnstile check).
const SITELOCK_HOSTS = ['pixeljump.online', 'pixeljump.pages.dev', 'deltamath.app',
    'crazygames.com', '1001juegos.com',
    'trey-hamilton227.workers.dev', 'localhost', '127.0.0.1'];
function siteAllowed(hostname) {
    // The portable build is meant to run from file:// and any static host.
    if (PLATFORM === 'portable') return true;
    const h = String(hostname || '').toLowerCase().replace(/\.$/, '');
    return SITELOCK_HOSTS.some(d => h === d || h.endsWith('.' + d));
}

const CONFIG = {
    WIDTH: 600,
    HEIGHT: 800,
    GRAVITY: 0.6,
    FRICTION: 0.85,
    SPEED: 0.9,
    JUMP_FORCE: -13.2,
    SUPER_JUMP_FORCE: -22,
    BOUNCE_FORCE: -25,
    // A spring platform's launch: about three platforms' worth of height.
    SPRING_FORCE: -21,
    // Vertical px between platforms. 110 since v1.9.2 (was 95), picked by
    // playtest. A plain jump rises about 138px, so keep it at 128 or less
    // (tests/test_platform_gap.js checks).
    // Changing it changes level generation: bump PLATFORM_GEN_VERSION and
    // NET_PROTOCOL too.
    PLATFORM_BASE_GAP: 110,
    SCROLL_THRESHOLD: 0.5,
    DRONE_BASE_VELOCITY: 2,
    DRONE_MAX_VELOCITY: 8,
    // Drones: one every DRONE_SPAWN_RATE frames at 0m, speeding up by a
    // frame per 50m down to DRONE_MIN_SPAWN_RATE. At most DRONE_CAP_BASE are
    // out at once, plus one more every DRONE_CAP_STEP metres up to
    // DRONE_CAP_MAX (drones circle back rather than leave, so without a cap
    // a slow climb piles them up). Laser drones have their own cap.
    DRONE_SPAWN_RATE: 180,
    DRONE_MIN_SPAWN_RATE: 90,
    DRONE_CAP_BASE: 2,
    DRONE_CAP_MAX: 6,
    DRONE_CAP_STEP: 1500,
    LASER_CAP: 2,
    PROJECTILE_SPEED: 6,
    BOSS_LOOP_DISTANCE: 3000
};

// Level generation version: bump when spawnPlatform() would build a different
// layout from the same seed (saved ghosts from other versions are dropped).
const PLATFORM_GEN_VERSION = 6;
// Platform types, rolled per platform from its height (see spawnPlatform):
//  - springs launch whoever lands on them (CONFIG.SPRING_FORCE);
//  - crumbling platforms break CRUMBLE_FRAMES after being landed on and
//    reform CRUMBLE_REFORM_FRAMES later, so the way up is never lost;
//  - moving platforms start gently at MOVING_START_METERS and reach their
//    full share and speed where they used to begin.
const SPRING_START_METERS = 30;
const SPRING_CHANCE = 0.08;
const CRUMBLE_START_METERS = 120;
const CRUMBLE_CHANCE = 0.09;
const CRUMBLE_FRAMES = 26;
const CRUMBLE_REFORM_FRAMES = 130;
const MOVING_START_METERS = 150;
// Ice (the `ice` hazard, see BIOMES): standing on a platform, the Pixel keeps
// ICE_FRICTION of its sideways speed each frame (CONFIG.FRICTION otherwise)
// and steers with ICE_GRIP of its usual push. The two are picked together so
// its top speed is the same as on dry ground: a full-speed landing slides
// about 108px instead of 29. The air and the launch pad are never slippery.
const ICE_FRICTION = 0.955;
const ICE_GRIP = 0.27;
// A trail of small gems (each worth a fifth of the biome's gem) arcing up
// from the platform below, on this share of platforms.
const GEM_TRAIL_CHANCE = 0.18;
const GEM_TRAIL_START_METERS = 15;
// No drones below this height.
const DRONE_START_METERS = 40;
// Heights called out as you pass them: these, then every MILESTONE_STEP.
const MILESTONES = [100, 250, 500];
const MILESTONE_STEP = 500;
function nextMilestone(meters) {
    for (const m of MILESTONES) if (m > meters) return m;
    return (Math.floor(meters / MILESTONE_STEP) + 1) * MILESTONE_STEP;
}

// Pickups rolled per platform. The power-up chance starts at START at 0m and
// eases out (falling fastest early) to END at POWERUP_PLATEAU_METERS, constant
// beyond (see powerUpChanceAt); hearts are rarer, and only exist for a player
// below their Pixel's heart cap (see Game.visiblePickups()); otherwise 40% of
// platforms carry a gem, worth its biome's `gem.value` (see BIOMES).
const POWERUP_CHANCE_START = 0.20;
const POWERUP_CHANCE_END = 0.07;
const POWERUP_PLATEAU_METERS = 5000;
function powerUpChanceAt(meters) {
    const t = Math.max(0, Math.min(1, meters / POWERUP_PLATEAU_METERS));
    return POWERUP_CHANCE_END + (POWERUP_CHANCE_START - POWERUP_CHANCE_END) * (1 - t) * (1 - t);
}
// Hearts thin out with height (HEART_CHANCE_START at 0m down to
// HEART_CHANCE_END at HEART_RAMP_METERS) and are always more than a screen
// apart, so at most one is ever in view.
const HEART_CHANCE_START = 0.04;
const HEART_CHANCE_END = 0.01;
const HEART_RAMP_METERS = 8000;
const HEART_MIN_GAP = 1000; // px of world height between hearts (> CONFIG.HEIGHT)
const RUN_CARD_TAP_GRACE_MS = 600; // backdrop taps right after the run card opens are ignored
const GEM_CHANCE = 0.4;
// Tall screens (portrait phones) see up to this much extra sky above the
// 600x800 playfield. It's view-only: the game itself (score, camera, death
// line, co-op ceiling) always runs in the 800-tall reference frame, and the
// extra rows are drawn above its top edge, at negative screen y.
const VIEW_MAX_EXTRA = 500;
// How far above the top of the screen platforms are generated in advance
// (enough to fill the tallest view).
const PLATFORM_LOOKAHEAD = CONFIG.HEIGHT + VIEW_MAX_EXTRA;
// CSS px each side of the 3:4 column needs before the HUD moves out beside
// it (the 'flank' layout) instead of sitting in its corners.
const FLANK_MIN_GUTTER = 170;
// Frames an enemy that first appears in a tall view's extra sky takes to fade in.
const SPAWN_FADE_FRAMES = 12;
// A run-ending death plays out before the run card: the Pixel shatters and
// the world runs at DEATH_SLOWMO speed for DEATH_ANIM_FRAMES (real frames;
// shorter with reduced motion).
const DEATH_ANIM_FRAMES = 60;
const DEATH_ANIM_FRAMES_REDUCED = 24;
const DEATH_SLOWMO = 0.3;
// Rounded corners (px, drawing only): the Pixels themselves (26px bodies; the
// share card and menu previews scale this up).
const PIXEL_CORNER_RADIUS = 2;
// In-run tips are drawn at least this tall on screen (CSS px), whatever the
// playfield's scale.
const TIP_MIN_SCREEN_PX = 13;
// Frames the co-op TEAM LIMIT line glows brighter after you bump into it.
const CEILING_FLASH_FRAMES = 20;
// Ghost recording: one sample every GHOST_STEP frames of game time, capped
// at GHOST_MAX_POINTS samples (about half an hour of climbing).
const GHOST_STEP = 6;
const GHOST_MAX_POINTS = 20000;

// Boss fight tuning, in 60fps frames of game time. The boss hovers above the
// player firing volleys, then telegraphs a dive (a warning column shows the
// lane), swoops down to the player's level and sits there exposed: land on
// top of it to deal damage. Below half health it rages (shorter windows,
// wider volleys).
const BOSS = {
    HOVER_OFFSET: 380,   // hover this far above the player it's tracking
    HOVER_MIN_Y: 30,     // ...but never higher than this on screen
    HOVER: 150, HOVER_RAGE: 90,           // time between dives
    VOLLEY: 80, VOLLEY_RAGE: 55,          // time between volleys while hovering
    TELEGRAPH: 50, TELEGRAPH_RAGE: 38,    // warning before the dive
