// Perks: the passive buff a Pixel grants, keyed by its SKINS[i].ability key.
// `label` is the short tag shown on the menu/shop, `describe(value)` the full
// stat text revealed on hover/tap, and `active(value)` whether a value does
// anything at all (a 1x multiplier doesn't). A perk may also declare
// `downside(value)`, returning null or { label, describe } for a red tag
// shown after the perk tags. `covers` names the POWERS entry
// the perk already gives for good, which that Pixel then never rolls. Tags
// render in this order.
const perkPct = (mult) => Math.round(Math.abs(mult - 1) * 100) + '%';
// Host: may a guest with `pixel` equipped set off an EMP now (frames of game
// time), given its last accepted one? A few frames of slack absorb timing
// jitter between clients; any faster is a modified client.
const EMP_SLACK_FRAMES = 10;
// Run perks (roadmap 4.2): after each boss kill the player picks one of two,
// kept until the run ends. RUN_PERKS is what each grants (on top of the
// Pixel's own: multipliers multiply, the rest replace); RUN_PERK_WEIGHTS is
// how often each comes up, the stronger the rarer (ROCKET is never offered).
// RUN_PERK_PICK_MS to choose, then one of the two is picked at random. Solo
// pauses meanwhile; co-op doesn't. Their keys go over the wire in the sync
// (`rp`), in RUN_PERK_KEYS order.
const RUN_PERKS = {
    speedMult: 1.25, jumpMult: 1.2, gravityMult: 0.85, powerDurationMult: 2, gemMagnetRadius: 150, gemMult: 2,
    heartCap: 5, smash: true, ninja: true, airJump: true, dronePulseSec: 6, biomeImmune: true
};
const RUN_PERK_WEIGHTS = {
    gemMagnetRadius: 10, powerDurationMult: 9, gravityMult: 8, speedMult: 8, jumpMult: 7, biomeImmune: 6,
    gemMult: 5, heartCap: 4, dronePulseSec: 4, ninja: 3, smash: 2, airJump: 1
};
const RUN_PERK_KEYS = Object.keys(RUN_PERKS);
const RUN_PERK_PICK_MS = 5000;
const RUN_PERK_MULTS = ['speedMult', 'jumpMult', 'gravityMult', 'powerDurationMult', 'gemMult'];

// A Pixel's abilities with run perks on top.
function withRunPerks(ability, runPerks) {
    const out = Object.assign({}, ability || {});
    for (const key of Object.keys(runPerks || {})) {
        const v = runPerks[key];
        out[key] = RUN_PERK_MULTS.includes(key) ? (out[key] || 1) * v
            : key === 'dronePulseSec' && out[key] ? Math.min(out[key], v)
            : key === 'gemMagnetRadius' ? Math.max(out[key] || 0, v) : v;
    }
    return out;
}

// Two different run perks to choose from, weighted by RUN_PERK_WEIGHTS,
// never one `ability` already has (by the PERKS table's own test) and never
// ROCKET. `rand` is Math.random unless a test passes its own.
function drawRunPerks(ability, rand = Math.random) {
    const has = key => { const perk = PERKS.find(p => p.key === key); return perk ? perk.active((ability || {})[key]) : false; };
    // (ROCKET isn't in RUN_PERKS at all; the filter keeps it out even if
    // someone adds it there.)
    let pool = RUN_PERK_KEYS.filter(k => k !== 'rocket' && !has(k));
    const picks = [];
    while (picks.length < 2 && pool.length) {
        const total = pool.reduce((t, k) => t + RUN_PERK_WEIGHTS[k], 0);
        let r = rand() * total;
        let pick = pool[pool.length - 1];
        for (const k of pool) { r -= RUN_PERK_WEIGHTS[k]; if (r < 0) { pick = k; break; } }
        picks.push(pick);
        pool = pool.filter(k => k !== pick);
    }
    return picks;
}

function empRequestAllowed(pixel, lastFrame, nowFrame) {
    const sec = pixel && pixel.ability && pixel.ability.dronePulseSec;
    if (!sec) return false;
    return lastFrame === undefined || nowFrame - lastFrame >= sec * 60 - EMP_SLACK_FRAMES;
}

