<script>/* ---- js/portable-loader.js ---- */
// Portable build only, and the very first script tools/build-portable.mjs
// inlines (before config.js). index.html never loads it, loadGameSource() and
// the service worker never list it: it is the second deliberate exception to
// the four-places rule, next to js/portable.js.
//
// Launch handoff. When an earlier run cached a newer, signed build in
// IndexedDB (js/portable.js stores it), this opens that build instead of the
// embedded one:
//  - it runs only in the top window, without ?noupdate, and when the
//    lp_update_ready pointer is newer than the embedded version and not on
//    the bad list;
//  - it re-verifies the cached record's ECDSA signature on every launch;
//  - the portable onload wrapper (js/portable.js) awaits `ready`, and on a
//    result calls mount(): a full-viewport srcdoc iframe. srcdoc inherits this
//    file's origin, so the lp_ saves are shared. (document.write was rejected:
//    re-evaluating top-level consts in one window throws.)
//  - crash guard: mount() sets lp_update_booting to 'version@time'; the child
//    clears it once its PortableUI initialises. A marker still set at the next
//    launch AND older than BOOT_WINDOW_MS means that version never came up: it
//    goes on the bad list, its cache is deleted and the embedded build boots.
//    A younger marker is a boot still in flight (a second tab opened during
//    it) or a tab closed early, so it is ignored: nothing is bad-listed or
//    deleted. mount() keeps the first timestamp of a young marker for the same
//    version, so a crash loop still goes stale and is caught.
// Every failure resolves null, which boots the embedded build, silently.
//
// The two double-underscore placeholders are replaced by the build. It cannot
// read config.js constants (it runs before them), so the key is injected. The
// literals below mirror js/portable.js; tests/test_portable_launch.js drives
// both ends against each other.

const PortableLoader = (() => {
    const EMBEDDED = '1.59.0';
    const PUBKEY = 'MFkwEwYHKoZIzj0CAQYIKoZIzj0DAQcDQgAEKp8bov8+P9xiTk6of+yh6iIf/NTUndujP44qMTqrHGedcMEyuwI5WrHtCTL8lzugChBCfblfLYlDmfFjJGqGbQ==';
    const READY_KEY = 'lp_update_ready';
    const UPDATES_OFF_KEY = 'lp_update_off';
    const BAD = 'lp_update_bad';
    const BOOTING = 'lp_update_booting';
    // A healthy child clears the marker within seconds of mount; two minutes
    // covers a slow device while still catching a real crash on a relaunch.
    const BOOT_WINDOW_MS = 120000;
    const DB = 'pixel-jump-portable';
    const STORE = 'builds';
    const RECORD = 'latest';

    const lsGet = k => { try { return localStorage.getItem(k); } catch (e) { return null; } };
    const lsSet = (k, v) => { try { localStorage.setItem(k, v); return true; } catch (e) { return false; } };
    const lsDel = k => { try { localStorage.removeItem(k); } catch (e) { /* blocked */ } };

    function parse(v) {
        const m = typeof v === 'string' ? v.match(/^(\d+)\.(\d+)\.(\d+)$/) : null;
        return m ? [Number(m[1]), Number(m[2]), Number(m[3])] : null;
    }
    // True when a is newer than b; false otherwise (including unparseable input).
    function newer(a, b) {
        const pa = parse(a), pb = parse(b);
        if (!pa || !pb) return false;
        for (let i = 0; i < 3; i++) if (pa[i] !== pb[i]) return pa[i] > pb[i];
        return false;
    }
    function badList() {
        try {
            const list = JSON.parse(lsGet(BAD) || '[]');
            return Array.isArray(list) ? list.filter(v => typeof v === 'string') : [];
        } catch (e) { return []; }
    }
    function isBad(version) { return badList().indexOf(version) >= 0; }
    function markBad(version) {
        const list = badList();
        if (list.indexOf(version) < 0) list.push(version);
        lsSet(BAD, JSON.stringify(list.slice(-20)));
    }

    function b64ToBytes(text) {
        const bin = atob(String(text).trim().replace(/-/g, '+').replace(/_/g, '/'));
        const out = new Uint8Array(bin.length);
        for (let i = 0; i < bin.length; i++) out[i] = bin.charCodeAt(i);
        return out;
    }

    function openDb() {
        return new Promise((resolve, reject) => {
            if (typeof indexedDB === 'undefined' || !indexedDB) { reject(new Error('no indexedDB')); return; }
            let req;
            try { req = indexedDB.open(DB, 1); } catch (e) { reject(e); return; }
            req.onupgradeneeded = () => {
                if (!req.result.objectStoreNames.contains(STORE)) req.result.createObjectStore(STORE);
            };
            req.onsuccess = () => resolve(req.result);
            req.onerror = () => reject(req.error || new Error('indexedDB blocked'));
            req.onblocked = () => reject(new Error('indexedDB blocked'));
        });
    }
    async function withStore(mode, fn) {
        const db = await openDb();
        try {
            return await new Promise((resolve, reject) => {
                const tx = db.transaction(STORE, mode);
                const req = fn(tx.objectStore(STORE));
                tx.oncomplete = () => resolve(req ? req.result : undefined);
                tx.onerror = () => reject(tx.error || new Error('indexedDB failed'));
                tx.onabort = () => reject(tx.error || new Error('indexedDB aborted'));
                if (mode === 'readonly' && req) req.onsuccess = () => resolve(req.result);
            });
        } finally {
            if (typeof db.close === 'function') db.close();
        }
    }
    const readRecord = () => withStore('readonly', s => s.get(RECORD));
    const dropRecord = () => withStore('readwrite', s => s.delete(RECORD)).catch(() => {});
    async function purge() {
        lsDel(READY_KEY);
        await dropRecord();
    }

    async function verify(rec) {
        const c = typeof crypto !== 'undefined' ? crypto : null;
        if (!c || !c.subtle || typeof rec.html !== 'string' || typeof rec.sig !== 'string') return false;
        try {
            const key = await c.subtle.importKey('spki', b64ToBytes(PUBKEY),
                { name: 'ECDSA', namedCurve: 'P-256' }, false, ['verify']);
            return await c.subtle.verify({ name: 'ECDSA', hash: 'SHA-256' }, key,
                b64ToBytes(rec.sig), new TextEncoder().encode(rec.html));
        } catch (e) { return false; }
    }
    function declaredVersion(html) {
        const m = /^const GAME_VERSION = '(\d+\.\d+\.\d+)';/m.exec(html);
        return m ? m[1] : null;
    }

    // 'version@epochMs' -> {version, at}. An unreadable or old-format value
    // counts as long stale (at 0): the safe reading is "that boot never finished".
    function parseBooting(raw) {
        if (!raw) return null;
        const i = raw.lastIndexOf('@');
        const at = i > 0 ? Number(raw.slice(i + 1)) : 0;
        return { version: i > 0 ? raw.slice(0, i) : raw, at: Number.isFinite(at) ? at : 0 };
    }

    async function run() {
        if (!parse(EMBEDDED)) return null;
        // Only the top window decides; the child must not trip its own guard.
        if (typeof window === 'undefined' || (window.parent && window.parent !== window)) return null;

        lsDel(UPDATES_OFF_KEY); // retired opt-out
        const marker = parseBooting(lsGet(BOOTING));
        if (marker && Date.now() - marker.at >= BOOT_WINDOW_MS) {
            markBad(marker.version);
            lsDel(BOOTING);
            await purge();
            return null;
        }
        if (typeof location !== 'undefined' && /(?:^\?|&)noupdate(?:&|=|$)/.test(String(location.search || ''))) return null;
        const version = lsGet(READY_KEY);
        if (!version || !newer(version, EMBEDDED) || isBad(version)) return null;

        let rec;
        try { rec = await readRecord(); } catch (e) { return null; }
        if (!rec || rec.version !== version || typeof rec.html !== 'string' ||
            declaredVersion(rec.html) !== version || !await verify(rec)) {
            await purge();
            return null;
        }
        return { version, html: rec.html };
    }

    const ready = run().catch(() => null);

    // Opens the verified build full-viewport. False means nothing was mounted
    // and the caller boots the embedded game.
    function mount(build) {
        let frame = null;
        try {
            if (!build) return false;
            const prior = parseBooting(lsGet(BOOTING));
            const young = prior && prior.version === build.version && Date.now() - prior.at < BOOT_WINDOW_MS;
            if (!young && !lsSet(BOOTING, build.version + '@' + Date.now())) return false;
            frame = document.createElement('iframe');
            frame.setAttribute('allow', 'fullscreen; autoplay; gamepad');
            frame.setAttribute('allowfullscreen', '');
            frame.setAttribute('title', 'Pixel Jump');
            frame.style.cssText = 'position:fixed;inset:0;width:100vw;height:100vh;height:100dvh;border:0;margin:0;padding:0;background:#050505;z-index:2147483647';
            frame.srcdoc = build.html;
            frame.addEventListener('load', () => { try { frame.focus(); } catch (e) { /* no focus */ } });
            document.body.appendChild(frame);
            try { frame.focus(); } catch (e) { /* no focus */ }
            return true;
        } catch (e) {
            lsDel(BOOTING);
            try { if (frame && frame.parentNode) frame.parentNode.removeChild(frame); } catch (e2) { /* gone */ }
            return false;
        }
    }

    return { ready, mount, isBad, clearBooting() { lsDel(BOOTING); } };
})();

