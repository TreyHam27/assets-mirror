const COOP_BOSS_BOUNTY = 2 * BOSS_GEM_BOUNTY;
// The most every gem multiplier together (a Pixel's or run perk's gemMult,
// the 2X GEMS booster, a mode's gemMult) may multiply a pickup or a bounty
// by. Without it they reached 12x, enough to buy Overclock in one run.
const GEM_MULT_MAX = 4;
const gemMultTotal = (...mults) => Math.min(GEM_MULT_MAX, mults.reduce((t, m) => t * (m || 1), 1));
const bossBountyFor = (perks, gemBoostActive) =>
    BOSS_GEM_BOUNTY * gemMultTotal((perks && perks.gemMult) || 1, gemBoostActive ? 2 : 1);

// Each biome's `hazards` (ADR-0008) maps a hazard or platform type to its
// dose: 1 is the biome's signature at full strength, 0.5 a lighter carry-over
// from an earlier biome, missing is none. Only The Void has everything (and
// brings the ice back, at a lighter dose). Read it with hazardDose(). Hazards: ice (slippery
// platforms, scaled by dose), meteor, blackHole and laser (spawned that much
// less often at a half dose). Platform types: moving, conveyor, blink, shock
// and shrinking (rolled that much more or less often by spawnPlatform, so
// changing them changes level generation: bump PLATFORM_GEN_VERSION and
// NET_PROTOCOL). The SHIELDED perk covers every one of them except lasers
// (they are drones) and a black hole's centre (touching it is still a hit).
// `note` is the line under the biome's name when you enter it (what's new).
// `gem` is what a gem found in that biome is worth, and its colour: higher
// biomes pay more, from 5 at the start up to 100 in The Void.
const BIOMES = [
    { threshold: 0, name: "Atmosphere", bg: "#050505", grid: "#1a1a1a", platform: "#00ffcc", hazards: {}, gem: { value: 5, color: "#00ffff" } },
    { threshold: 600, name: "Ionosphere", note: "Platforms are icy", bg: "#0a001a", grid: "#330066", platform: "#ff00ff", hazards: { ice: 1 }, gem: { value: 10, color: "#33ff66" } },
    { threshold: 1800, name: "Low Orbit", note: "More platforms on the move", bg: "#000a1a", grid: "#003366", platform: "#00ccff", hazards: { moving: 1 }, gem: { value: 15, color: "#3399ff" } },
    { threshold: 3200, name: "Deep Space", note: "Meteors fall: watch the red markers", bg: "#0a0a0a", grid: "#222", platform: "#ffd700", hazards: { meteor: 1, moving: 0.5 }, gem: { value: 25, color: "#b266ff" } },
    { threshold: 5000, name: "The Rift", note: "Black holes and conveyor belts", bg: "#1a0022", grid: "#4d0066", platform: "#cc00ff", hazards: { blackHole: 1, conveyor: 1, meteor: 0.5 }, gem: { value: 35, color: "#ff66cc" } },
    { threshold: 7200, name: "Neon Grid", note: "Laser drones and blinking platforms", bg: "#001010", grid: "#00ffaa", platform: "#00ff99", hazards: { laser: 1, blink: 1, blackHole: 0.5 }, gem: { value: 50, color: "#ff9900" } },
    { threshold: 10000, name: "Static Field", note: "Shock and shrinking platforms", bg: "#0a0a0a", grid: "#555555", platform: "#ffffff", hazards: { shock: 1, shrinking: 1, laser: 0.5 }, gem: { value: 75, color: "#ff3344" } },
    { threshold: 13500, name: "The Void", note: "Everything at once, and the ice is back", bg: "#000000", grid: "#220022", platform: "#ff0055",
      hazards: { ice: 0.5, moving: 1, meteor: 1, blackHole: 1, conveyor: 1, laser: 1, blink: 1, shock: 1, shrinking: 1 }, gem: { value: 100, color: "#ffffff" } }
];

// How strong a hazard or platform type is in a biome: 1, 0.5 or 0.
function hazardDose(biome, name) {
    return (biome && biome.hazards && biome.hazards[name]) || 0;
}

// How far up the climb is toward The Void, 0..1 (layouts tighten with it).
function climbProgress(meters) {
    return Math.max(0, Math.min(1, meters / BIOMES[BIOMES.length - 1].threshold));
}

// The vertical gap (whole px) above a platform at this height.
function platformGapAt(meters) {
    const t = climbProgress(meters);
    return Math.round(CONFIG.PLATFORM_BASE_GAP + (CONFIG.PLATFORM_TOP_GAP - CONFIG.PLATFORM_BASE_GAP) * t);
}

// [min, max] platform width at this height.
function platformWidthRange(meters) {
    const t = climbProgress(meters);
    return [0, 1].map(i => PLATFORM_W_START[i] + (PLATFORM_W_TOP[i] - PLATFORM_W_START[i]) * t);
}

// A Pixel's body is PIXEL_SIZE px square (Player, and a black hole's centre).
const PIXEL_SIZE = 26;
// The sideways gap between two platforms' facing edges, the shorter way
// round the wrap; 0 when they overlap.
function wrappedEdgeGap(ax, aw, bx, bw) {
    const direct = Math.max(0, bx - (ax + aw), ax - (bx + bw));
    if (!direct) return 0;
    const wrapped = Math.max(0, bx + CONFIG.WIDTH - (ax + aw), ax + CONFIG.WIDTH - (bx + bw));
    return Math.min(direct, wrapped);
}
// The widest sideways gap (edge to edge, px) a plain jump crosses up onto a
// platform `gap` px higher, taking off from a standstill at the very edge and
// steering all the way: the Player's own step order (steer, friction, move;
// then gravity, rise), at the slowest Pixel's sideways speed (the Rocket's
// 0.85; jump perks only help), so no Pixel is ever stranded. Its 26px body
// overlaps both edges, and REACH_MARGIN keeps the guard on the safe side.
// Cached per gap.
const REACH_MARGIN = 8;
const jumpReachCache = new Map();
function jumpReachPx(gap) {
    if (jumpReachCache.has(gap)) return jumpReachCache.get(gap);
    const speed = CONFIG.SPEED * Math.min(1, ...SKINS.map(s => (s.ability && s.ability.speedMult) || 1));
    let x = 0, vx = 0, y = 0, vy = CONFIG.JUMP_FORCE, reach = 0;
    for (let step = 0; step < 200; step++) {
        vx = (vx + speed) * CONFIG.FRICTION;
        x += vx;
        vy += CONFIG.GRAVITY;
        y += vy;
        if (vy > 0 && -y <= gap) { reach = x; break; }
    }
    const px = Math.max(0, Math.floor(reach + PIXEL_SIZE - 1 - REACH_MARGIN));
    jumpReachCache.set(gap, px);
    return px;
}

// The biome at a given height in meters (the single source of truth for both
// the renderer and level generation).
function biomeAt(meters) {
    for (let i = BIOMES.length - 1; i >= 0; i--) {
        if (meters >= BIOMES[i].threshold) return BIOMES[i];
    }
    return BIOMES[0];
}

// Index into BIOMES of the biome at `meters` (a gem's tier).
function biomeIndexAt(meters) {
    return BIOMES.indexOf(biomeAt(meters));
}

