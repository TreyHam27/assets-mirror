/* ---- tools/portable/portable.css ---- */
/* Portable-build-only UI (js/portable.js). tools/build-portable.mjs appends
   this file to the inlined <style>; the web build never sees it. Keep every
   value on the site's existing tokens and classes. */

/* The update chip sits at the bottom of the menu page. The portable menu has
   no site links under it, so nothing else competes for that space. */
.portable-update {
    position: absolute;
    left: 50%;
    bottom: calc(14px + var(--safe-bottom));
    z-index: 5;
    display: flex;
    align-items: center;
    gap: 4px;
    max-width: calc(100% - 24px);
    padding: 5px 6px 5px 14px;
    border: 1px solid rgba(var(--teal-rgb), 0.55);
    border-radius: var(--radius-pill);
    background: rgba(2, 8, 16, 0.94);
    box-shadow: 0 0 16px rgba(var(--teal-rgb), 0.22);
    transform: translateX(-50%);
}
.portable-update[hidden] {
    display: none;
}
.portable-update-link {
    color: var(--teal);
    font-family: var(--font-display);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 1px;
    text-decoration: none;
    white-space: nowrap;
}
.portable-update-link:hover,
.portable-update-link:focus-visible {
    color: #fff;
}
.portable-update-dismiss {
    flex: none;
    width: 26px;
    height: 26px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: transparent;
    color: var(--muted);
    font: inherit;
    font-size: 16px;
    line-height: 1;
    cursor: pointer;
}
.portable-update-dismiss:hover,
.portable-update-dismiss:focus-visible {
    background: rgba(255, 255, 255, 0.08);
    color: #fff;
}

/* Settings: the check row (VERSION and status styles live in style.css). */
.portable-check-row {
    display: flex;
    flex-direction: column;
    gap: 6px;
}

