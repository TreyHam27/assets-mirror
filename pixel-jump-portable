// Distinct Titan archetypes. Index goes over the wire in co-op snapshots:
// append, never reorder (NET_PROTOCOL).
const TITANS = ['dreadnought', 'crawler', 'prism', 'voidmaw'];
const TITAN_NAMES = {
    dreadnought: 'TITAN',
    crawler: 'CRAWLER',
    prism: 'PRISM',
