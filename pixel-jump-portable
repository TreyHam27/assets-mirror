      downside: v => (v && v < 1) ? { label: '-' + perkPct(v) + ' SPEED', describe: '-' + perkPct(v) + ' move speed' } : null },
    { key: 'jumpMult', label: 'JUMP', color: '#00ff66', active: v => !!v && v !== 1,
      describe: v => (v > 1 ? '+' : '-') + perkPct(v) + ' jump height' },
    { key: 'gravityMult', label: 'GRAVITY', color: '#b388ff', active: v => !!v && v !== 1,
      describe: v => (v < 1 ? '-' : '+') + perkPct(v) + ' gravity' + (v < 1 ? ' (floatier)' : '') },
    { key: 'powerDurationMult', label: 'POWER', color: '#ffaa00', active: v => !!v && v !== 1,
      describe: v => Number.isInteger(v) ? 'Power-ups last ' + v + 'x as long' : '+' + perkPct(v) + ' power-up duration' },
    { key: 'gemMagnetRadius', label: 'MAGNET', color: '#ffff00', active: v => !!v, covers: 'MAGNET',
      describe: () => 'Always pulls in nearby gems' },
    { key: 'heartCap', label: '5 HEARTS', color: '#ff3366', active: v => !!v,
      describe: v => 'Can hold up to ' + v + ' hearts in a run', short: v => 'Hold up to ' + v + ' hearts' },
    { key: 'smash', label: 'SMASH', color: '#ff6b35', active: v => !!v,
      describe: () => 'Drones and bots die when they touch you. Bullets, lasers, meteors and bosses still hurt',
      short: () => 'Drones you touch explode' },
    { key: 'ninja', label: 'NINJA', color: '#c9d1ff', active: v => !!v,
      describe: () => 'The screen edges are walls: jump off them, up to ' + NINJA_WALL_JUMPS + ' times between landings',
      short: () => 'Wall-jump off the screen edges',
      downside: v => v ? { label: 'NO WRAP', describe: 'No screen wrap: the edges are walls' } : null },
    { key: 'rocket', label: 'ROCKET', color: '#ff3300', active: v => !!v,
      describe: () => 'Every power-up you pick up is a JETPACK',
      downside: v => v ? { label: HEART_CAP_ROCKET + ' HEARTS MAX', describe: 'Holds at most ' + HEART_CAP_ROCKET + ' hearts in a run' } : null },
    { key: 'airJump', label: 'AIR JUMP', color: '#ff66ff', active: v => !!v, covers: 'DOUBLE',
