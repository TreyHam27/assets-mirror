    font-size: 11px;
    letter-spacing: 1px;
    text-align: left;
}
.save-account-code,
.save-move-input {
    box-sizing: border-box;
    width: 100%;
    padding: 10px 8px;
    border: 1px solid rgba(var(--teal-rgb), 0.45);
    border-radius: 8px;
    background: rgba(0, 0, 0, 0.45);
    color: #fff;
    font-family: ui-monospace, 'SFMono-Regular', Consolas, monospace;
