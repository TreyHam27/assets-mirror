// Saved as lp_streak { day: YYYYMMDD of the last counted day, count }.
// Anonymous stats and error reports (the score Worker's /stats and /error,
// no player id; Settings > SEND ANONYMOUS STATS). At most ERROR_REPORTS_MAX
// error reports a session, each message once. Frame rates are sent as the
// nearest of FPS_BUCKETS.
const ERROR_REPORTS_MAX = 5;
const FPS_BUCKETS = [15, 30, 45, 60, 75, 90, 120, 144, 165, 240];
// Vibration (where the device has it, and the Settings switch is on): a hit
// a shield or Jetpack took, a spent heart, and a run-ending death (ms, or an
// on/off pattern).
const VIBRATE_HIT = 30;
const VIBRATE_HEART = [40, 40, 40];
const VIBRATE_DEATH = 120;
const STREAK_REWARDS = [50, 200, 500, 1000, 2000, 5000];
const streakRewardFor = (count) => STREAK_REWARDS[Math.min(Math.max(1, count), STREAK_REWARDS.length) - 1];

// Limited-time modes (LTMs): rule twists on a normal climb, one on offer at a
// time, rotating every LTM_SLOT_HOURS on the local clock (like the Rental).
// Played from their own menu button; their climbs never touch the daily
// layout's records (best height, Ghost, Online board, Personal board): each
// mode keeps its own best (lp_ltm_best). LTM_ENABLED is the one switch: false
// hides every part of it and the game plays exactly as before.
// Rules: gravity (a multiplier on the Pixel's gravity), bossEvery (metres
// between bosses), ice (a floor for the ice dose), gemMult (gem pickups),
// oneHeart (one heart, no bought or found hearts).
const LTM_ENABLED = true;
const LTM_SLOT_HOURS = 3;
const LTMS = [
    { id: 'lowgrav', name: 'Low Gravity', note: 'Floaty jumps, long falls', rules: { gravity: 0.6 } },
    { id: 'bossrush', name: 'Boss Rush', note: 'A Titan every 600m', rules: { bossEvery: 600 } },
    { id: 'iceall', name: 'Ice Everywhere', note: 'Every platform is slippery', rules: { ice: 1 } },
    { id: 'frenzy', name: 'Gem Frenzy', note: 'Gems pay double', rules: { gemMult: 2 } },
    { id: 'oneheart', name: 'One Heart', note: 'No second chances', rules: { oneHeart: true } }
];
// The mode on offer at `now` (null with LTM_ENABLED off). Every mode comes
// round, in an order that shifts each day.
function ltmAt(now = Date.now()) {
    if (!LTM_ENABLED) return null;
    const d = new Date(now);
    const day = Math.floor(Date.UTC(d.getFullYear(), d.getMonth(), d.getDate()) / 86400000);
    const slotsPerDay = Math.floor(24 / LTM_SLOT_HOURS);
    return LTMS[(day * slotsPerDay + Math.floor(d.getHours() / LTM_SLOT_HOURS)) % LTMS.length];
}
// When it changes: the next slot boundary on the local clock.
function nextLtmAt(now = Date.now()) {
    const d = new Date(now);
    const h = (Math.floor(d.getHours() / LTM_SLOT_HOURS) + 1) * LTM_SLOT_HOURS;
    return new Date(d.getFullYear(), d.getMonth(), d.getDate(), h).getTime();
}
const ltmById = (id) => LTMS.find(m => m.id === id) || null;
// The local calendar day before a YYYYMMDD day, as YYYYMMDD.
function dayBefore(day) {
    const d = new Date(Math.floor(day / 10000), Math.floor(day / 100) % 100 - 1, day % 100 - 1);
    return d.getFullYear() * 10000 + (d.getMonth() + 1) * 100 + d.getDate();
}

// Shop consumables. Every run starts with one free heart plus the hearts
// bought for it (saved as lp_hearts, "bought for the next run"); leftovers are
// gone when the run ends. Each heart is spent automatically on a death that
// would otherwise end the run (see Game.useSpareLife()).
const HEART_COST = 150;
// A spent life (or revive) springs up a red rescue net for a second that
// bounces the player back in.
const RESCUE_NET_FRAMES = 60;
const RESCUE_NET_COLOR = '#ff3366';
// Hit immunity after a jetpack or HARD SHIELD absorbs a drone or bullet.
const ABSORB_INVULN_FRAMES = 30;
// After a spent heart or a revive (ad or co-op): this many steps (4s) in
// which nothing hurts the Pixel but falling off the screen. It blinks.
const REVIVE_INVULN_STEPS = 240;
// The default heart cap; heartCapFor() has the Pixel-specific one.
const MAX_HEARTS = 3;
const HEART_CAP_ROCKET = 2;
// NINJA: wall jumps allowed between landings, the sideways push each gives,
// and the frames after touching a wall in which one can still be fired.
const NINJA_WALL_JUMPS = 2;
const NINJA_WALL_PUSH = 9;
const NINJA_WALL_FRAMES = 6;
// How many hearts a run can hold with this Pixel: 3 by default, 5 with the
// 5 HEARTS perk, 2 with ROCKET.
function heartCapFor(pixel) {
    const a = (pixel && pixel.ability) || {};
    // (A 5 HEARTS run perk lifts even the Rocket's cap.)
    if (a.heartCap) return a.heartCap;
    if (a.rocket) return HEART_CAP_ROCKET;
    return MAX_HEARTS;
}

// Multiplayer: host + up to 3 guests (NetworkManager.maxGuests must match).
// Slot 0 is always the party leader; each slot's colour is used for that
// player's in-game name tag and their row in the party panel.
const MAX_PARTY_SIZE = 4;
// Co-op display names. 20 fits any CrazyGames username (6-20 characters);
// name tags over players shorten past MP_TAG_MAX.
const MP_NAME_MAX = 20;
const MP_TAG_MAX = 12;
// TURN relay for co-op on strict networks (school/office WiFi, some mobile
// carriers) where two browsers can't connect directly. Host and join fetch
// relay logins from this URL, which must return an iceServers array. It's
// the Cloudflare Worker in cloudflare/turn-worker/ (Realtime TURN, 1,000
// GB/month free), which keeps the secret token and only answers the game's
// own origins. If it fails, co-op falls back to direct links only.
// WebRTC still prefers a direct link, so only games that need it use the
