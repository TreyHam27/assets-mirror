    padding: 7px 10px;
    border: 1px solid rgba(var(--teal-rgb), 0.35);
    border-radius: var(--radius-row);
    background: rgba(var(--teal-rgb), 0.09);
    color: var(--teal);
    font-family: var(--font-display);
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.6px;
