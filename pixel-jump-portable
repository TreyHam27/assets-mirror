.run-card-missions[hidden] {
    display: none;
}
.run-card-missions.is-ready {
    border-color: var(--gold);
    background: rgba(var(--gold-rgb), 0.14);
    color: var(--gold);
}
.style-item--award .style-action {
    color: var(--gold);
    border-color: rgba(var(--gold-rgb), 0.45);
}


