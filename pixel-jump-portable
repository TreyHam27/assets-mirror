//  - shock: idle SHOCK_IDLE steps, crackles SHOCK_WARN, then shocks for
//    SHOCK_LIVE; standing on it then is a hit. Its phase is seeded.
// Each screen runs its own blink and shock clocks; landings are local.
const CONVEYOR_CHANCE = 0.14;
const CONVEYOR_PUSH = 1.4;
const BLINK_CHANCE = 0.14;
const BLINK_PERIOD = 120;
const BLINK_FADE_AT = 70;
const BLINK_GONE_AT = 85;
const BLINK_BACK_AT = 110;
const SHRINK_CHANCE = 0.14;
const SHRINK_FACTOR = 0.25;
const SHRINK_MIN_W = 40;
const SHOCK_CHANCE = 0.1;
const SHOCK_IDLE = 120;
const SHOCK_WARN = 60;
const SHOCK_LIVE = 30;
// The order spawnPlatform() rolls them in (part of level generation).
const PLATFORM_TYPE_ROLLS = [['conveyor', CONVEYOR_CHANCE], ['blink', BLINK_CHANCE], ['shrinking', SHRINK_CHANCE], ['shock', SHOCK_CHANCE]];
// Platform widths ease from PLATFORM_W_START to PLATFORM_W_TOP ([min, max]
// px) by The Void, along with the gap.
const PLATFORM_W_START = [100, 180];
const PLATFORM_W_TOP = [70, 130];
// Hazards (see BIOMES). Meteors: one every METEOR_EVERY steps at full dose,
// falling METEOR_VY px a step ([min, max]) and drifting up to METEOR_VX
// sideways, entering the screen METEOR_WARN steps after spawning while a red
// marker at the top edge shows where. Laser drones: one every LASER_EVERY
// steps, warning LASER_WARN steps before the beam. Black holes: one every
// BLACK_HOLE_EVERY steps (at most BLACK_HOLE_CAP out), drifting; within
// BLACK_HOLE_RADIUS they pull the Pixel (up to BLACK_HOLE_PULL px/step^2) and
// gems, and touching the centre is a hit. Beyond it, a Pixel in the air is
// still pulled from anywhere on screen (BLACK_HOLE_FAR_PULL at the radius,
// weaker in proportion to the distance). A half dose spawns half as often.
const METEOR_EVERY = 120;
const METEOR_VY = [2.5, 5];
const METEOR_VX = 1;
const METEOR_WARN = 60;
const LASER_EVERY = 240;
const LASER_WARN = 60;
const BLACK_HOLE_EVERY = 600;
const BLACK_HOLE_CAP = 1;
const BLACK_HOLE_RADIUS = 140;
const BLACK_HOLE_PULL = 0.35;
const BLACK_HOLE_FAR_PULL = 0.05;
// Ice (the `ice` hazard, see BIOMES): standing on a platform, the Pixel keeps
// ICE_FRICTION of its sideways speed each frame (CONFIG.FRICTION otherwise)
// and steers with ICE_GRIP of its usual push. The two are picked together so
// its top speed is the same as on dry ground: a full-speed landing slides
// about 108px instead of 29. The air and the launch pad are never slippery.
const ICE_FRICTION = 0.955;
const ICE_GRIP = 0.27;
// A trail of small gems (each worth a fifth of the biome's gem) arcing up
// from the platform below, on this share of platforms.
const GEM_TRAIL_CHANCE = 0.18;
const GEM_TRAIL_START_METERS = 15;
// No drones below this height.
const DRONE_START_METERS = 40;
// Heights called out as you pass them: these, then every MILESTONE_STEP.
const MILESTONES = [100, 250, 500];
const MILESTONE_STEP = 500;
function nextMilestone(meters) {
    for (const m of MILESTONES) if (m > meters) return m;
    return (Math.floor(meters / MILESTONE_STEP) + 1) * MILESTONE_STEP;
}

// Pickups rolled per platform. The power-up chance starts at START at 0m and
// eases out (falling fastest early) to END at POWERUP_PLATEAU_METERS, constant
// beyond (see powerUpChanceAt); hearts are rarer, and only exist for a player
// below their Pixel's heart cap (see Game.visiblePickups()); otherwise 40% of
// platforms carry a gem, worth its biome's `gem.value` (see BIOMES).
const POWERUP_CHANCE_START = 0.04;
const POWERUP_CHANCE_END = 0.01;
const POWERUP_PLATEAU_METERS = 15000;
function powerUpChanceAt(meters) {
    const t = Math.max(0, Math.min(1, meters / POWERUP_PLATEAU_METERS));
    return POWERUP_CHANCE_END + (POWERUP_CHANCE_START - POWERUP_CHANCE_END) * (1 - t) * (1 - t);
}
// Hearts thin out with height (HEART_CHANCE_START at 0m down to
// HEART_CHANCE_END at HEART_RAMP_METERS) and are always more than a screen
