// pauses meanwhile; co-op doesn't. Their keys go over the wire in the sync
// (`rp`), in RUN_PERK_KEYS order.
// Run-exclusive perk tuning (never on a shop Pixel).
const SPRING_BOOST_MULT = 1.16;     // ~+35% spring launch height
const SPRING_BOOST_INVULN = 45;     // upward hit protection after a boosted spring
const RECHARGE_METERS = 500;        // free Hard Shield every N metres climbed
const GLIDE_MAX_VY = 3.2;           // max fall speed while holding jump with GLIDE
const OVERDRIVE_WINDOW = 55;        // steps on a platform before combo resets
const OVERDRIVE_MAX_STACK = 5;      // up to +25% speed
const OVERDRIVE_STEP = 0.05;

const RUN_PERKS = {
    speedMult: 1.25, jumpMult: 1.2, gravityMult: 0.85, powerDurationMult: 2, gemMagnetRadius: 150, gemMult: 2,
    heartCap: 5, smash: true, ninja: true, airJump: true, dronePulseSec: 6, biomeImmune: true,
    heavyStomp: true, shieldEvery: RECHARGE_METERS, springBoost: true, glide: true, overdrive: true
};
const RUN_PERK_WEIGHTS = {
    gemMagnetRadius: 10, powerDurationMult: 9, gravityMult: 8, speedMult: 8, jumpMult: 7, biomeImmune: 6,
    gemMult: 5, heartCap: 4, dronePulseSec: 4, ninja: 3, smash: 2, airJump: 1,
    heavyStomp: 4, shieldEvery: 4, springBoost: 6, glide: 5, overdrive: 5
};
const RUN_PERK_KEYS = Object.keys(RUN_PERKS);
// Contrast buckets for post-Titan offers: pair an offense/speed/economy card
// against a defense/control/utility card so every pick is a real build choice.
const RUN_PERK_BUCKET = {
    heavyStomp: 'offense', overdrive: 'offense', gemMult: 'offense', speedMult: 'offense',
    dronePulseSec: 'offense', smash: 'offense', jumpMult: 'offense',
    shieldEvery: 'defense', glide: 'defense', heartCap: 'defense', biomeImmune: 'defense',
    airJump: 'defense', springBoost: 'defense', powerDurationMult: 'defense',
    gravityMult: 'defense', gemMagnetRadius: 'defense', ninja: 'defense'
};
const RUN_PERK_PICK_MS = 5000;
const RUN_PERK_MULTS = ['speedMult', 'jumpMult', 'gravityMult', 'powerDurationMult', 'gemMult'];

// A Pixel's abilities with run perks on top.
function withRunPerks(ability, runPerks) {
    const out = Object.assign({}, ability || {});
    for (const key of Object.keys(runPerks || {})) {
        const v = runPerks[key];
        out[key] = RUN_PERK_MULTS.includes(key) ? (out[key] || 1) * v
            : key === 'dronePulseSec' && out[key] ? Math.min(out[key], v)
            : key === 'gemMagnetRadius' ? Math.max(out[key] || 0, v) : v;
    }
    return out;
}

// Two different run perks to choose from, weighted by RUN_PERK_WEIGHTS,
// never one `ability` already has (by the PERKS table's own test) and never
// ROCKET. Pairs across contrast buckets (offense vs. defense) when available,
// and skips `lastSkipped` (the card rejected on the previous Titan) while the
// pool still has alternatives. `rand` is Math.random unless a test passes its own.
function drawRunPerks(ability, rand = Math.random, lastSkipped = null) {
    const has = key => { const perk = PERKS.find(p => p.key === key); return perk ? perk.active((ability || {})[key]) : false; };
    // (ROCKET isn't in RUN_PERKS at all; the filter keeps it out even if
    // someone adds it there.)
    let pool = RUN_PERK_KEYS.filter(k => k !== 'rocket' && !has(k));
    if (lastSkipped && pool.length > 2 && pool.includes(lastSkipped)) {
        pool = pool.filter(k => k !== lastSkipped);
    }
    const weightedPick = list => {
        const total = list.reduce((t, k) => t + RUN_PERK_WEIGHTS[k], 0);
        let r = rand() * total;
        let pick = list[list.length - 1];
        for (const k of list) { r -= RUN_PERK_WEIGHTS[k]; if (r < 0) { pick = k; break; } }
        return pick;
    };
    const picks = [];
    if (pool.length) {
        const first = weightedPick(pool);
        picks.push(first);
        const rest = pool.filter(k => k !== first);
        if (rest.length) {
            const firstBucket = RUN_PERK_BUCKET[first];
            const contrast = rest.filter(k => RUN_PERK_BUCKET[k] !== firstBucket);
            picks.push(weightedPick(contrast.length ? contrast : rest));
        }
    }
    return picks;
}

function empRequestAllowed(pixel, lastFrame, nowFrame) {
    const sec = pixel && pixel.ability && pixel.ability.dronePulseSec;
    if (!sec) return false;
    return lastFrame === undefined || nowFrame - lastFrame >= sec * 60 - EMP_SLACK_FRAMES;
}

