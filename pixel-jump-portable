// Which Titan spawns for the (runLoops + 1)-th boss of a run on `runSeed`.
// Multi-cycle no-repeat shuffle bag: Cycle 0 opens with Dreadnought (steady
// intro) followed by a seeded shuffle of Crawler, Prism and Void Maw; every
// subsequent cycle shuffles all four Titans and guarantees its opener never
// repeats the previous cycle's closer. Pure: never draws from this.rng.
function titanBagHash(seed, salt) {
    let h = ((Number(seed) || 0) ^ (Math.imul((salt | 0) + 1, 0x9e3779b9) >>> 0)) >>> 0;
    h = Math.imul(h ^ (h >>> 16), 0x85ebca6b) >>> 0;
    h = Math.imul(h ^ (h >>> 13), 0xc2b2ae35) >>> 0;
    return (h ^ (h >>> 16)) >>> 0;
}
function titanCycleBag(cycle, runSeed) {
    if (cycle <= 0) {
        const perms = [[0, 1, 2], [0, 2, 1], [1, 0, 2], [1, 2, 0], [2, 0, 1], [2, 1, 0]];
        const pool = ['crawler', 'prism', 'voidmaw'];
        const p = perms[titanBagHash(runSeed, 0) % 6];
        return ['dreadnought', pool[p[0]], pool[p[1]], pool[p[2]]];
    }
    const bag = TITANS.slice();
    let h = titanBagHash(runSeed, cycle);
    for (let i = bag.length - 1; i > 0; i--) {
        h = Math.imul(h ^ (h >>> 15), 0x2c1b3c6d) >>> 0;
        const j = h % (i + 1);
        const tmp = bag[i]; bag[i] = bag[j]; bag[j] = tmp;
    }
    const prevLast = titanCycleBag(cycle - 1, runSeed)[TITANS.length - 1];
    if (bag[0] === prevLast) {
        const swap = 1 + (h % (bag.length - 1));
        const tmp = bag[0]; bag[0] = bag[swap]; bag[swap] = tmp;
    }
    return bag;
}
function titanFor(runLoops, runSeed = 0) {
    const idx = Math.max(0, Math.floor(runLoops || 0));
    const cycle = Math.floor(idx / TITANS.length);
    return titanCycleBag(cycle, runSeed)[idx % TITANS.length];
}
// What the boss-th boss of a run does (BossDrone.startAttack): every boss
// dives, the 2nd adds a laser sweep, the 3rd summons drones, and from the 4th
// each dive also crumbles the platform under its target.
function bossAttacks(level) {
    const list = ['dive'];
    if (level >= 2) list.push('sweep');
    if (level >= 3) list.push('summon');
    return list;
}
