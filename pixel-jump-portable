  src: url(data:font/woff2;base64,) format('woff2');
}

@font-face {
  font-family: 'Chakra Petch';
  font-style: normal;
  font-weight: 600;
  font-display: swap;
  src: url(data:font/woff2;base64,) format('woff2');
}

@font-face {
  font-family: 'Chakra Petch';
  font-style: normal;
  font-weight: 700;
  font-display: swap;
  src: url(data:font/woff2;base64,) format('woff2');
}

:root {
    /* Shared corner radii (--radius-card is below) — panels and badges pick one
       instead of ad hoc per-element values. */
    --radius-pill: 999px;
    /* The menus' design language (see MENUS: ONE DESIGN LANGUAGE below).
       Each colour means one thing on every screen. */
    --night: #070b14;                 /* panel glass over the scenery */
    --glass: rgba(9, 13, 23, 0.86);
    --sheet: #0a0f1b;                 /* dialogs: solid, nothing shows through */
    --line: rgba(255, 255, 255, 0.09);
    --text: #e6ecf7;
    --text-rgb: 230, 236, 247;        /* ghost buttons: dismiss, back, cancel */
    --muted: #93a0b8;
    --teal: #00ffcc;                  /* every action, and the lit edges */
    --teal-rgb: 0, 255, 204;
    --teal-deep: #008f78;
    --ink: #02211b;                   /* text on a filled teal cap */
    --pixel: #ff3366;                 /* hearts, danger */
    --pixel-rgb: 255, 51, 102;
    --tier-uncommon: #7bd88f;           /* Pixel tiers: a rarity label, nothing else */
    --tier-rare: #4da3ff;
    --tier-epic: #c06bff;
    --tier-legendary: #ff9a2e;
    --tier-mythic: #ff2d55;
    --pixel-deep: #a31440;
    --gem: #33e0ff;                   /* gems and prices */
    --gem-rgb: 51, 224, 255;
    --gold: #ffd23f;                  /* records, achievements, the leader */
    --gold-rgb: 255, 210, 63;
    --warn: #ffab40;                  /* warnings: offline, relay down, not sent */
    --warn-rgb: 255, 171, 64;
    --font-display: 'Orbitron', 'Courier New', monospace;
    --font-text: 'Chakra Petch', 'Orbitron', system-ui, sans-serif;
    --panel-w: min(360px, 88vw);
    --radius-card: 16px;
    --shadow-card: inset 0 1px 0 rgba(255, 255, 255, 0.06), 0 18px 40px rgba(0, 0, 0, 0.5);
    /* Room for notches and home indicators (viewport-fit=cover). */
    --safe-top: env(safe-area-inset-top, 0px);
    --safe-right: env(safe-area-inset-right, 0px);
    --safe-bottom: env(safe-area-inset-bottom, 0px);
    --safe-left: env(safe-area-inset-left, 0px);
}

/* Buttons don't inherit the page font by default. */
button {
    font-family: inherit;
}

[hidden] {
    display: none !important;
}

/* The page itself never scrolls, zooms or rubber-bands: on iOS a stray double
   tap or swipe used to shift it and push the HUD strip off screen. Menus
   scroll inside their own panels (.menu-page), not the page. */
html {
    height: 100%;
    overflow: hidden;
    overscroll-behavior: none;
}

body {
    position: fixed;
    inset: 0;
    margin: 0;
    overflow: hidden;
    overscroll-behavior: none;
    background: #050505;
    font-family: 'Orbitron', 'Courier New', monospace;
    user-select: none;
    -webkit-user-select: none;
    -webkit-touch-callout: none;
    -webkit-tap-highlight-color: transparent;
    touch-action: none;
}

#game-container {
    position: relative;
    width: 100vw;
    height: 100vh;
    /* Mobile browsers' vh includes the area behind their toolbars. */
    height: 100dvh;
    display: flex;
    justify-content: center;
    align-items: center;
    background: #000;
    /* Where the HUD's corners are, as offsets in from the container's edges.
       Zero means the window corners. Renderer.resize() picks a data-layout
       and publishes the playfield's box (--pf-left/top/right/w/h), and the
       layouts below move the HUD onto it. */
    --hud-left: 0px;
    --hud-right: 0px;
    --hud-top: 0px;
    /* Height of the phone HUD strip, not counting the notch. */
    --hud-strip-h: 88px;
}

/* A 3:4 column too narrow to have the HUD beside it: the HUD sits in the
   column's own top corners. */
#game-container[data-layout="overlay"] {
    --hud-left: var(--pf-left, 0px);
    --hud-right: var(--pf-right, 0px);
    --hud-top: var(--pf-top, 0px);
}

/* Phones: the playfield runs from under the HUD strip to the bottom edge
   (under the home indicator too). */
#game-container[data-layout="strip"] {
    align-items: flex-end;
}

#gameCanvas {
    background: #080808;
    /* A frame that takes no layout space (a border would push the canvas
       past its fitted size). */
    box-shadow: 0 0 0 1px #2a2a2a, 0 0 60px #000;
    max-width: 100%;
    max-height: 100%;
}

#game-container[data-layout="strip"] #gameCanvas {
    box-shadow: none;
}

#hud-strip {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: calc(var(--hud-strip-h) + var(--safe-top));
    background: #000;
    pointer-events: none;
    /* Always laid out so the Renderer can measure it, only shown on phones. */
    visibility: hidden;
}

#game-container[data-layout="strip"] #hud-strip {
    visibility: visible;
}

/* ---------- Themed sides ----------
   Around the 3:4 column (flank and overlay layouts), the window takes on the
   current biome: its background colour, a soft glow in its platform colour,
   a still star field and a vignette, and a glowing edge on the column.
   Renderer.themeSides() sets the three colours when the biome changes;
   registering them lets the CSS cross-fade between biomes. */
@property --biome-bg {
    syntax: '<color>';
    inherits: true;
    initial-value: #050505;
}

@property --biome-glow {
    syntax: '<color>';
    inherits: true;
    initial-value: rgba(0, 255, 204, 0.09);
}

@property --biome-edge {
    syntax: '<color>';
    inherits: true;
    initial-value: rgba(0, 255, 204, 0.35);
}

#game-container:not([data-layout="strip"]) {
    /* A stacking context, so the star layer below can sit behind the canvas. */
    isolation: isolate;
    background:
        radial-gradient(ellipse 70% 90% at 50% 45%, var(--biome-glow), transparent 70%),
        var(--biome-bg);
    /* (No transition on the colours: they are inherited, so animating them
       restyled the whole page every frame for as long as it ran. The
       column's edge fades between biomes through its own box-shadow
       transition.) */
}

#game-container:not([data-layout="strip"])::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background:
        radial-gradient(ellipse at center, transparent 45%, rgba(0, 0, 0, 0.65) 100%),
        radial-gradient(1px 1px at 12% 18%, rgba(255, 255, 255, 0.45), transparent) 0 0 / 230px 230px,
        radial-gradient(1px 1px at 68% 42%, rgba(255, 255, 255, 0.3), transparent) 0 0 / 230px 230px,
        radial-gradient(1.5px 1.5px at 33% 77%, rgba(255, 255, 255, 0.35), transparent) 0 0 / 310px 310px,
        radial-gradient(1px 1px at 86% 64%, rgba(255, 255, 255, 0.25), transparent) 0 0 / 310px 310px,
        radial-gradient(1px 1px at 51% 9%, rgba(255, 255, 255, 0.3), transparent) 0 0 / 170px 170px;
}

#game-container:not([data-layout="strip"]) #gameCanvas {
    box-shadow: 0 0 0 1px var(--biome-edge), 0 0 50px var(--biome-glow), 0 0 90px #000;
}

/* The scenery (#bgCanvas, drawn by Background in js/background.js) sits
   behind the playfield, which is see-through while it is on (.scene-on).
   Beside a 3:4 column it fills the window (.wide-backdrop), dimmed outside
   the column by the borders below so the playfield stands out. The Renderer
   sets its box. */
#game-container {
    isolation: isolate;
}

#bgCanvas {
    display: none;
    position: absolute;
    z-index: -2;
    pointer-events: none;
}

#game-container.scene-on #bgCanvas {
    display: block;
}

#game-container.scene-on #gameCanvas {
    background: transparent;
}

#game-container:not([data-layout="strip"])::before {
    z-index: -3;
}

/* The borders: a dark panel each side of the column, and the column's
   glowing edge. With the menu open (.menu-open, see Game.setMenuOpen) they
   are away and the scenery fills the window; starting a run slides them in. */
#game-container.wide-backdrop::before,
#game-container.wide-backdrop::after {
    content: "";
    position: absolute;
    inset: 0 auto 0 auto;
    z-index: -1;
    pointer-events: none;
    transition: transform 0.7s cubic-bezier(0.2, 0.8, 0.2, 1), opacity 0.5s ease-out;
}

#game-container.wide-backdrop::before {
    left: 0;
    width: var(--pf-left, 0px);
    background: linear-gradient(to right, rgba(0, 0, 0, 0.82), rgba(0, 0, 0, 0.5));
}

#game-container.wide-backdrop::after {
    right: 0;
    width: var(--pf-right, 0px);
    background: linear-gradient(to left, rgba(0, 0, 0, 0.82), rgba(0, 0, 0, 0.5));
}

#game-container.wide-backdrop.menu-open::before {
    transform: translateX(-100%);
    opacity: 0;
}

#game-container.wide-backdrop.menu-open::after {
    transform: translateX(100%);
    opacity: 0;
}

/* Behind the menu the whole scene sits a little darker. Starting a run
   brings the playfield back up to full brightness as the sides darken in. */
#game-container.scene-on #gameCanvas,
#game-container.scene-on #bgCanvas {
    transition: box-shadow 0.7s ease-out, filter 0.7s ease-out;
}

#game-container.scene-on.menu-open #gameCanvas,
#game-container.scene-on.menu-open #bgCanvas {
    filter: brightness(0.72);
}

#game-container.scene-on.menu-open #gameCanvas {
    box-shadow: 0 0 0 1px transparent, 0 0 50px transparent, 0 0 90px transparent;
}

@media (prefers-reduced-motion: reduce) {
    #game-container {
        transition: none;
    }
}

/* UI LAYOUT - Absolute positioning relative to the container */
#ui-layer {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
}

/* HUD */
#hud {
    position: relative;
    width: 100%;
    height: 100px;
    box-sizing: border-box;
    opacity: 0;
    transition: opacity 0.5s;
    z-index: 10;
}

/* The right-hand stack (gems, hearts, pause, the 2X GEMS booster) is laid
   out from these: each counter is a pill --pill-h tall. */
#game-container {
    --count-size: clamp(16px, 4.6vw, 24px);
    --pill-h: calc(var(--count-size) + 14px);
    --stack-top: calc(var(--hud-top) + 14px + var(--safe-top));
    --stack-right: calc(var(--hud-right) + 14px + var(--safe-right));
}

#score-display {
    position: absolute;
    top: calc(var(--hud-top) + 14px + var(--safe-top));
    left: calc(var(--hud-left) + 18px + var(--safe-left));
    white-space: nowrap;
    font-size: clamp(26px, 8vw, 50px);
    font-weight: 900;
    line-height: 1.1;
    color: #fff;
    font-variant-numeric: tabular-nums;
    text-shadow: 0 2px 0 rgba(0, 0, 0, 0.45), 0 0 18px rgba(255, 255, 255, 0.35);
    letter-spacing: -1px;
}

#best-display-hud {
    position: absolute;
    top: calc(var(--hud-top) + 20px + var(--safe-top));
    left: 50%;
    transform: translateX(-50%);
    white-space: nowrap;
    font-size: clamp(13px, 3.6vw, 20px);
    color: var(--gold);
    text-shadow: 0 0 12px rgba(var(--gold-rgb), 0.45);
    font-weight: 900;
    letter-spacing: 1.5px;
    text-align: center;
}

/* Gems and hearts: glass pills, persistent on every screen (the menu's
   wallet and the run's counters). */
#gem-display,
#life-display {
    position: absolute;
    right: var(--stack-right);
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    box-sizing: border-box;
    height: var(--pill-h);
    padding: 0 0.55em 0 0.7em;
    border: 1px solid rgba(var(--pill-rgb), 0.35);
    border-radius: var(--radius-pill);
    background: rgba(6, 10, 18, 0.78);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.06), 0 6px 18px rgba(0, 0, 0, 0.35);
    white-space: nowrap;
    font-size: var(--count-size);
    line-height: 1;
    font-weight: 900;
    font-variant-numeric: tabular-nums;
    color: #fff;
    transform-origin: right center;
    /* Persistent across every screen (menu/shop/gameplay), so it must sit
       above #menus-wrapper (20) and #shop-menu-layer (25). */
    z-index: 40;
}

/* Counter digits in Chakra Petch: Orbitron's zero is slashed, which reads
   badly at this size. */
#gem-display .count,
#life-display .count {
    font-family: var(--font-text);
    font-weight: 700;
}

#gem-display .count + .ico,
#life-display .count + .ico {
    margin-left: 0;
}

#gem-display {
    --pill-rgb: var(--gem-rgb);
    top: var(--stack-top);
}

#gem-display .ico {
    filter: drop-shadow(0 0 6px rgba(var(--gem-rgb), 0.7));
}

@keyframes gem-collect-pop {
    0% { transform: scale(1); border-color: rgba(var(--gem-rgb), 0.35); }
    40% { transform: scale(1.18); border-color: rgba(var(--gem-rgb), 1); }
    100% { transform: scale(1); border-color: rgba(var(--gem-rgb), 0.35); }
}

#gem-display.gem-pop {
    animation: gem-collect-pop 0.35s ease-out;
}

/* Banked hearts, right under the gem counter (and just as persistent).
   Dimmed at zero. */
#life-display {
    --pill-rgb: var(--pixel-rgb);
    top: calc(var(--stack-top) + var(--pill-h) + 6px);
    transition: opacity 0.2s;
}

#life-display .ico {
    filter: drop-shadow(0 0 6px rgba(var(--pixel-rgb), 0.7));
}

/* A new player's first run: the pill says what the heart is ("1 LIFE"). */
#life-display[data-word]::after {
    content: attr(data-word);
    margin-left: 6px;
    font-family: var(--font-display);
    font-size: 0.5em;
    font-weight: 900;
    letter-spacing: 1px;
}

#life-display.empty {
    opacity: 0.45;
}

@keyframes life-pop {
    0% { transform: scale(1); }
    40% { transform: scale(1.18); }
    100% { transform: scale(1); }
}

#life-display.life-pop {
    animation: life-pop 0.35s ease-out;
}

/* Narrow screens: three numbers don't fit on one row, so BEST tucks under
   the score. */
@media (max-width: 480px) {
    #best-display-hud {
        top: calc(var(--hud-top) + 58px + var(--safe-top));
        left: calc(var(--hud-left) + 18px + var(--safe-left));
        transform: none;
        font-size: 12px;
        text-align: left;
    }

    #score-display {
        font-size: clamp(24px, 7.5vw, 34px);
    }

    #system-alert {
        padding: 8px 14px;
        gap: 8px;
        font-size: 12px;
        letter-spacing: 0.5px;
    }
}

/* Phones (the strip layout): the numbers live in the black HUD strip above
   the playfield. Score with BEST under it on the left, gems over hearts on
   the right, pause in the middle. On the playfield, top down: the target or
   spectating pill, the power-up bar, then notices, so none land on another. */
#game-container[data-layout="strip"] {
    --count-size: 16px;
    --pill-h: 32px;
    --stack-top: calc(9px + var(--safe-top));
    --stack-right: calc(14px + var(--safe-right));
}

#game-container[data-layout="strip"] #hud {
    height: calc(var(--hud-strip-h) + var(--safe-top));
}

#game-container[data-layout="strip"] #score-display {
    top: calc(10px + var(--safe-top));
    left: calc(16px + var(--safe-left));
    font-size: clamp(26px, 8.5vw, 38px);
}

#game-container[data-layout="strip"] #best-display-hud {
    top: calc(56px + var(--safe-top));
    left: calc(16px + var(--safe-left));
    transform: none;
    font-size: 12px;
    text-align: left;
}

#game-container[data-layout="strip"] #life-display {
    top: calc(var(--stack-top) + var(--pill-h) + 6px);
}

#game-container[data-layout="strip"] .hud-btn {
    top: calc((var(--hud-strip-h) - 44px) / 2 + var(--safe-top));
    right: auto;
    left: 50%;
    transform: translateX(-50%);
}

#game-container[data-layout="strip"] #challenge-hud,
#game-container[data-layout="strip"] #spectate-hud,
#game-container[data-layout="strip"] #versus-hud {
    top: calc(var(--pf-top, 0px) + 10px);
}

#game-container[data-layout="strip"] #power-hud {
    top: calc(var(--pf-top, 0px) + 40px);
}

#game-container[data-layout="strip"] #system-alert {
    margin-top: 92px;
}

/* Wide windows (the flank layout): the HUD sits beside the column instead of
   in the window corners. Score and BEST are against its left edge; gems,
   hearts and pause are against its right. Sizes follow the gutter, so the
   numbers fit however narrow it gets. This block is its own commit:
   reverting it puts the HUD back in the window corners. */
#game-container[data-layout="flank"] {
    --flank-gap: 24px;
    --flank-num: min(50px, calc(var(--pf-left, 350px) / 7));
    --count-size: min(26px, calc(var(--pf-left, 350px) / 10));
    --stack-top: calc(var(--pf-top, 0px) + 20px + var(--safe-top));
}

#game-container[data-layout="flank"] #score-display,
#game-container[data-layout="flank"] #best-display-hud {
    left: auto;
    right: calc(var(--pf-right, 0px) + var(--pf-w, 0px) + var(--flank-gap));
    transform: none;
    text-align: right;
}

#game-container[data-layout="flank"] #score-display {
    top: calc(var(--pf-top, 0px) + 14px + var(--safe-top));
    font-size: var(--flank-num);
}

#game-container[data-layout="flank"] #best-display-hud {
    top: calc(var(--pf-top, 0px) + 26px + 1.1 * var(--flank-num) + var(--safe-top));
    font-size: min(18px, calc(var(--pf-left, 350px) / 16));
}

/* The race line goes under BEST, out of the way of the alerts. */
#game-container[data-layout="flank"] #versus-hud {
    left: auto;
    right: calc(var(--pf-right, 0px) + var(--pf-w, 0px) + var(--flank-gap));
    top: calc(var(--pf-top, 0px) + 40px + 1.1 * var(--flank-num) + min(18px, calc(var(--pf-left, 350px) / 16)) + var(--safe-top));
    transform: none;
}

#game-container[data-layout="flank"] #gem-display,
#game-container[data-layout="flank"] #life-display,
#game-container[data-layout="flank"] .hud-btn {
    right: auto;
    left: calc(var(--pf-left, 0px) + var(--pf-w, 0px) + var(--flank-gap));
    transform-origin: left center;
}

/* The Titan's name plate: its name and health while one is up. Top centre
   of the playfield; in the flank layout, in the left column under BEST. */
.boss-plate {
    position: absolute;
    top: calc(var(--hud-top) + 14px + var(--safe-top));
    left: 50%;
    transform: translateX(-50%);
    z-index: 10;
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 6px 12px;
    border: 1px solid rgba(var(--pixel-rgb), 0.55);
    border-radius: 10px;
    background: rgba(6, 10, 18, 0.82);
    box-shadow: 0 0 14px rgba(var(--pixel-rgb), 0.25);
    pointer-events: none;
}

.boss-plate-name {
    color: var(--pixel);
    font-size: 13px;
    font-weight: 900;
    letter-spacing: 3px;
    white-space: nowrap;
}

.boss-plate-bar {
    width: 110px;
    height: 7px;
    border-radius: var(--radius-pill);
    background: rgba(255, 255, 255, 0.1);
    overflow: hidden;
}

.boss-plate-bar > span {
    display: block;
    height: 100%;
    background: var(--pixel);
    transform-origin: left center;
    transition: transform 0.2s;
}

#game-container[data-layout="strip"] .boss-plate {
    top: calc(var(--pf-top, 0px) + 10px);
}

/* Run perks taken: only where there's a side column for them (the pause
   menu lists them everywhere). */
.run-perks-hud {
    position: absolute;
    z-index: 10;
    display: none;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 6px;
    pointer-events: none;
}

/* Wide windows: the left column under BEST holds the Titan plate, the run
   perks and the running power-ups, off the playfield. */
#game-container[data-layout="flank"] {
    --flank-under: calc(var(--pf-top, 0px) + 44px + 1.1 * var(--flank-num) + min(18px, calc(var(--pf-left, 350px) / 16)) + var(--safe-top));
    --flank-right: calc(var(--pf-right, 0px) + var(--pf-w, 0px) + var(--flank-gap));
}

#game-container[data-layout="flank"] .boss-plate {
    top: var(--flank-under);
    left: auto;
    right: var(--flank-right);
    transform: none;
}

#game-container[data-layout="flank"] .run-perks-hud:not([hidden]) {
    display: flex;
    top: calc(var(--flank-under) + 46px);
    right: var(--flank-right);
    max-width: calc(var(--pf-left, 350px) - 2 * var(--flank-gap));
}

#game-container[data-layout="flank"] #power-hud {
    top: calc(var(--flank-under) + 84px);
    left: auto;
    right: var(--flank-right);
    transform: none;
}

/* POWER UP HUD: a row per running power, its name beside its timer, on a glass pill. */
#power-hud {
    position: absolute;
    top: calc(var(--hud-top) + 80px + var(--safe-top));
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 6px;
    padding: 8px 14px;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: rgba(6, 10, 18, 0.8);
    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.35);
    opacity: 0;
    transition: opacity 0.2s;
    z-index: 10;
}

.power-row {
    display: grid;
    grid-template-columns: 1fr 96px;
    align-items: center;
    gap: 10px;
}

.power-text {
    font-size: 12px;
    font-weight: 900;
    letter-spacing: 1.5px;
    line-height: 1;
    white-space: nowrap;
    text-align: right;
    color: #fff;
}

.power-bar-bg {
    width: 96px;
    height: 6px;
    background: rgba(255, 255, 255, 0.1);
    border-radius: var(--radius-pill);
    overflow: hidden;
}

.power-bar-fill {
    height: 100%;
    width: 100%;
    border-radius: inherit;
    background: #fff;
    transition: width 0.1s linear, background-color 0.2s;
}

/* ---------- Entering a biome ----------
   The biome's name across the playfield, between two lines that draw
   themselves out from the middle, in the biome's own colour, with what's
   new there underneath. Game.showBiomeBanner() paints the three pictures
   and adds .show; taking it off fades the banner out. Only their position
   and opacity are animated, so a frame of it is three ready-made pictures. */
#biome-banner {
    position: absolute;
    left: var(--pf-left, 0px);
    /* Clear of the notices above it, in short windows too. */
    top: calc(var(--pf-top, 0px) + max(var(--pf-h, 100vh) * 0.38, 250px));
    width: var(--pf-w, 100%);
    opacity: 0;
    pointer-events: none;
    z-index: 9;
    transition: opacity 0.5s ease;
}

#biome-banner.show {
    opacity: 1;
    transition: none;
}

#biome-banner canvas {
    position: absolute;
    left: 0;
    will-change: transform, opacity;
}

#biome-banner.show #biome-banner-band {
    animation: biome-name-in 0.7s cubic-bezier(0.2, 0.8, 0.2, 1) both;
}

#biome-banner.show #biome-banner-lines {
    animation: biome-line-in 0.6s cubic-bezier(0.2, 0.8, 0.2, 1) both;
}

#biome-banner.show #biome-banner-tag {
    animation: biome-note-in 0.5s ease 0.35s both;
}

@keyframes biome-name-in {
    from { opacity: 0; transform: scaleX(1.5); }
    to { opacity: 1; transform: none; }
}

@keyframes biome-line-in {
    from { transform: scaleX(0); }
    to { transform: scaleX(1); }
}

@keyframes biome-note-in {
    from { opacity: 0; transform: translateY(-6px); }
    to { opacity: 1; transform: none; }
}

/* Text for screen readers only. */
.sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
}

/* SYSTEM ALERT - centralized notification for status/revive/reward messages */
#system-alert {
    display: flex;
    align-items: center;
    gap: 10px;
    /* During a run: above the HUD, below the revive overlay and dialogs
       (50, 60). With the menu open it rises above the pages and dialogs
       (20, 25, 60), or a notice raised from the Shop shows faintly through
       them (see .menu-open below). */
    z-index: 30;
    /* Solid glass. (It used to blur what was behind it, which the browser
       had to redo on every frame of the game underneath.) */
    background: rgba(8, 12, 20, 0.95);
    border: 1px solid rgba(var(--gem-rgb), 0.3);
    border-left: 3px solid var(--gem);
    border-radius: 12px;
    padding: 9px 18px 9px 14px;
    /* Below the HUD row (and the notch), and never wide enough to reach the
       pause button in the top-right corner. */
    margin-top: calc(var(--hud-top) + 20px + var(--safe-top));
    font-weight: 900;
    font-size: 13px;
    line-height: 1.3;
    width: fit-content;
    max-width: min(500px, calc(100% - 2 * (60px + max(var(--safe-left), var(--safe-right)))));
    box-sizing: border-box;
    text-transform: uppercase;
    letter-spacing: 1px;
    text-align: left;
    color: var(--gem);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.4), 0 0 16px rgba(var(--gem-rgb), 0.15);
    opacity: 0;
    transform: translateY(-8px);
    transition: opacity 0.35s ease, transform 0.35s ease, border-color 0.3s, color 0.3s, box-shadow 0.3s;
}

#game-container.menu-open #system-alert {
    z-index: 70;
}

#system-alert.alert-visible {
    opacity: 1;
    transform: translateY(0);
}

#system-alert-icon {
    display: flex;
    font-size: 17px;
    line-height: 1;
    flex-shrink: 0;
}

/* The notice's own colour, not the icon's usual one. */
#system-alert-icon .ico {
    color: inherit;
}

/* Two eyes on a DOM-drawn Pixel (skin picker, gem shop, unlock notices),
   placed like drawPixel() places them on the canvas. */
.pixel-eye {
    position: absolute;
    top: 30%;
    width: 20%;
    height: 20%;
    background: white;
}

.pixel-eye-l {
    left: 20%;
}

.pixel-eye-r {
    right: 20%;
}

/* A tiny Pixel in place of the icon (unlock notices). The faint outline keeps
   near-black Pixels (The Void, The End) visible on the dark alert. */
.alert-pixel {
    display: block;
    position: relative;
    width: 18px;
    height: 18px;
    border-radius: 8%; /* PIXEL_CORNER_RADIUS / 26, like the in-game Pixel */
    outline: 1px solid rgba(255, 255, 255, 0.35);
}

#system-alert.alert-unlock .alert-pixel {
    box-shadow: 0 0 8px rgba(var(--gold-rgb), 0.5);
}

/* Type variants */
#system-alert.alert-success {
    border-color: rgba(var(--teal-rgb), 0.4);
    border-left-color: var(--teal);
    color: var(--teal);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.4), 0 0 16px rgba(var(--teal-rgb), 0.2);
}

#system-alert.alert-warning {
    border-color: rgba(var(--warn-rgb), 0.4);
    border-left-color: var(--warn);
    color: var(--warn);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.4), 0 0 16px rgba(var(--warn-rgb), 0.2);
}

#system-alert.alert-danger {
    border-color: rgba(255, 51, 102, 0.4);
    border-left-color: var(--pixel);
    color: #ff5c85;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.4), 0 0 16px rgba(255, 51, 102, 0.2);
}

#system-alert.alert-reward {
    border-color: rgba(var(--gold-rgb), 0.45);
    border-left-color: var(--gold);
    color: var(--gold);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.4), 0 0 18px rgba(var(--gold-rgb), 0.25);
}

/* A newly unlocked Pixel */
#system-alert.alert-unlock {
    border-color: rgba(var(--gold-rgb), 0.45);
    border-left-color: var(--gold);
    color: #ffe766;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.4), 0 0 18px rgba(var(--gold-rgb), 0.3);
}

/* A life was spent or a heart picked up */
#system-alert.alert-life,
#system-alert.alert-heart {
    border-color: rgba(255, 51, 102, 0.4);
    border-left-color: var(--pixel);
    color: #ff5c85;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.4), 0 0 16px rgba(255, 51, 102, 0.2);
}

/* Urgent, attention-grabbing pulse (co-op respawn countdown) */
#system-alert.alert-pulse {
    border-color: rgba(192, 77, 255, 0.5);
    border-left-color: #c04dff;
    color: #d896ff;
    font-size: 18px;
    text-shadow: 0 0 8px #c04dff, 0 0 18px #a020f0;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.4), 0 0 20px rgba(192, 77, 255, 0.3);
}

/* Only animate while actually shown, so hiding it doesn't get fought by the keyframe's own opacity */
#system-alert.alert-pulse.alert-visible {
    animation: alertPulse 0.9s ease-in-out infinite;
}

@keyframes alertPulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.6; }
}

/* ============================================================
   MENUS: ONE DESIGN LANGUAGE
   The menus borrow from the game. Every panel is a platform: a dark hull
   with a lit top edge and hover lights under each end. Every button is a
   key cap, like the ones the tutorial draws, with a lip that sinks when
   pressed. Colour means the same thing on every screen (see :root): teal
   acts, red is hearts and danger, cyan is gems, gold is records. Orbitron
   carries titles, buttons and numbers; Chakra Petch carries anything read
   as a sentence. Only the PIXEL JUMP title keeps its violet glow.
   ============================================================ */

/* Drawn icons (the sprite in index.html; icon() in app.js). */
.ico {
    flex: none;
    width: 1em;
    height: 1em;
    fill: currentColor;
    vertical-align: -0.12em;
}

.ico-gem { color: var(--gem); }
.ico-heart { color: var(--pixel); }
.ico-gold { color: var(--gold); }
.count + .ico { margin-left: 0.3em; }

/* Beside a button's label, an icon reads a touch larger than the text. */
.btn > .ico {
    width: 1.2em;
    height: 1.2em;
}

/* ---- Panel: a glass card ----
   A hairline-edged card with a lit accent line along its top, like a
   platform's lit edge. --edge is the accent (teal unless it says otherwise). */
.panel {
    --edge: var(--teal);
    --edge-rgb: var(--teal-rgb);
    position: relative;
    width: var(--panel-w);
    max-width: 100%;
    box-sizing: border-box;
    padding: 18px 16px 16px;
    border: 1px solid var(--line);
    border-radius: var(--radius-card);
    background:
        linear-gradient(rgba(var(--edge-rgb), 0.08), rgba(var(--edge-rgb), 0) 80px),
        var(--glass);
    box-shadow: var(--shadow-card);
}

.panel::before {
    content: "";
    position: absolute;
    top: -1px;
    left: 18px;
    right: 18px;
    height: 2px;
    border-radius: 2px;
    background: linear-gradient(90deg, transparent, var(--edge) 20%, var(--edge) 80%, transparent);
    box-shadow: 0 0 12px rgba(var(--edge-rgb), 0.6);
    pointer-events: none;
}

.panel--pixel {
    --edge: var(--pixel);
    --edge-rgb: var(--pixel-rgb);
}

.panel--gold {
    --edge: var(--gold);
    --edge-rgb: var(--gold-rgb);
}

.panel-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    margin-bottom: 10px;
}

.panel-title {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: #fff;
    font-size: 15px;
    font-weight: 900;
    letter-spacing: 1px;
}

.panel-head--stack {
    flex-direction: column;
    align-items: flex-start;
    gap: 2px;
}

.panel-sub {
    color: var(--muted);
    font-family: var(--font-text);
    font-size: 13px;
    font-weight: 600;
    padding-left: 26px;
}

.panel-count {
    color: var(--muted);
    font-family: var(--font-text);
    font-size: 14px;
    font-weight: 600;
}

/* ---- Button: a key cap ----
   --k is the cap's colour. :where() keeps this base at zero specificity, so
   any screen can adjust a button with a plain class. */
:where(.btn) {
    --k: var(--teal);
    --k-rgb: var(--teal-rgb);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    box-sizing: border-box;
    padding: 10px 16px;
    border: 1.5px solid rgba(var(--k-rgb), 0.75);
    border-radius: 12px;
    background: linear-gradient(rgba(var(--k-rgb), 0.12), rgba(var(--k-rgb), 0.06)), var(--glass);
    color: var(--k);
    font-family: var(--font-display);
    font-size: 14px;
    font-weight: 900;
    letter-spacing: 1.5px;
    line-height: 1.2;
    white-space: nowrap;
    cursor: pointer;
    pointer-events: auto;
    user-select: none;
    box-shadow: 0 4px 0 rgba(var(--k-rgb), 0.3);
    transition: transform 0.07s, box-shadow 0.07s, background 0.15s, color 0.15s, opacity 0.15s;
}

@media (hover: hover) {
    :where(.btn):hover:not(:disabled) {
        background: linear-gradient(rgba(var(--k-rgb), 0.26), rgba(var(--k-rgb), 0.26)), var(--glass);
    }
}

/* Pressed: the cap sinks onto its lip. A button that can't be pressed sits
   down already. */
:where(.btn):active:not(:disabled),
:where(.btn):disabled {
    transform: translateY(3px);
    box-shadow: 0 1px 0 rgba(var(--k-rgb), 0.4);
}

:where(.btn):disabled {
    opacity: 0.55;
    cursor: default;
}

:where(.btn):focus-visible {
    outline: 2px solid #fff;
    outline-offset: 3px;
}

/* The one filled cap on a screen: its main action. */
.btn--primary {
    border-color: transparent;
    background: linear-gradient(#7affe8, #00d6b0);
    color: var(--ink);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.55), 0 4px 0 var(--teal-deep), 0 8px 24px rgba(var(--teal-rgb), 0.28);
}

@media (hover: hover) {
    .btn--primary:hover:not(:disabled) {
        background: linear-gradient(#9dffee, #19e6c0);
    }
}

.btn--primary:active:not(:disabled) {
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.55), 0 1px 0 var(--teal-deep), 0 0 12px rgba(var(--teal-rgb), 0.3);
}

/* The button rule (one grammar on every screen):
   - the one thing you came to do: filled teal (.btn--primary), its price in a
     gem chip on the right (.btn-cost);
   - other actions: teal outline (.btn);
   - dismiss, back, cancel: ghost grey (.btn--ghost);
   - destructive only (QUIT RUN, LEAVE PARTY, DELETE): pink (.btn--danger);
   - gem outline only for a gem reward that is offered (.btn--gem);
   - gold never goes on a button: gold means records. */
.btn--ghost {
    --k: var(--text);
    --k-rgb: var(--text-rgb);
    border-color: rgba(var(--text-rgb), 0.3);
    color: rgba(var(--text-rgb), 0.92);
    box-shadow: 0 3px 0 rgba(var(--text-rgb), 0.1);
}

.btn--danger {
    --k: var(--pixel);
    --k-rgb: var(--pixel-rgb);
}

.btn--gem {
    --k: var(--gem);
    --k-rgb: var(--gem-rgb);
}

.btn--big {
    padding: 15px 20px;
    border-radius: 14px;
    font-size: 22px;
    letter-spacing: 5px;
}

/* A price inside a BUY cap: a gem chip on the right of the label. */
.btn-cost {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 2px 9px;
    border-radius: var(--radius-pill);
    background: rgba(0, 0, 0, 0.22);
    color: var(--gem);
}

.btn--primary .btn-cost {
    background: rgba(0, 40, 50, 0.82);
}

.btn--primary .btn-cost .ico-gem {
    color: var(--gem);
}

.btn-label + .btn-cost {
    margin-left: 2px;
}

/* The chip stays chip-sized inside a big cap. */
.btn--big .btn-cost {
    padding: 3px 12px;
    font-size: 0.72em;
    letter-spacing: 1px;
}

/* Can't afford it: never a filled cap, whatever it would be. */
.btn.cant-afford {
    --k: var(--muted);
    --k-rgb: 147, 160, 184;
    border-color: rgba(147, 160, 184, 0.5);
    background: var(--glass);
    color: var(--muted);
    box-shadow: 0 3px 0 rgba(147, 160, 184, 0.2);
}

.btn--primary .ico-gem {
    color: #00566a;
}

/* Can't afford it yet, or already yours: an outlined cap, not a filled one. */
.shop-card-btn.unaffordable,
.shop-card-btn.maxed {
    border-color: rgba(var(--teal-rgb), 0.55);
    background: var(--glass);
    color: var(--teal);
    box-shadow: 0 4px 0 rgba(var(--teal-rgb), 0.25);
}

.shop-card-btn.unaffordable {
    opacity: 0.7;
}

.shop-card-btn.unaffordable .ico-gem {
    color: var(--gem);
}

.shop-card-btn.maxed .btn-cost {
    display: none;
}

/* BACK, top-left of the Shop, Records and Co-op pages: a ghost cap. */
.back-btn {
    --k: var(--text);
    --k-rgb: var(--text-rgb);
    border-color: rgba(var(--text-rgb), 0.3);
    box-shadow: 0 3px 0 rgba(var(--text-rgb), 0.1);
    position: absolute;
    top: calc(16px + var(--safe-top));
    left: calc(16px + var(--safe-left));
    z-index: 1;
    min-height: 44px;
    padding: 9px 14px 9px 11px;
    font-size: 12px;
    letter-spacing: 2px;
}

/* Phones: BACK gets its own row instead of sitting on the title, at the same
   height on every page (Shop, Records, Multiplayer), below the HUD strip. */
@media (max-width: 520px) {
    .back-btn {
        position: static;
        align-self: flex-start;
        margin-bottom: 8px;
    }

    #records-menu-layer,
    #mp-menu-layer {
        padding-top: calc(58px + var(--safe-top));
    }

    /* No centring spacer above them: BACK is the first row, not mid-page. */
    #records-menu-layer::before,
    #mp-menu-layer::before {
        display: none;
    }
}

/* ---- Pages ---- */
#menus-wrapper {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
    z-index: 20;
    pointer-events: none;
}

.menu-page {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    box-sizing: border-box;
    padding: calc(14px + var(--safe-top)) calc(12px + var(--safe-right)) calc(14px + var(--safe-bottom)) calc(12px + var(--safe-left));
    display: flex;
    flex-direction: column;
    /* Centred when the content fits, scrollable (from the top) when it
       doesn't: the grow-able ::before/::after spacers do the centring and
       shrink to nothing on overflow, where justify-content: center would
       clip the top out of reach. */
    justify-content: flex-start;
    align-items: center;
    overflow-y: auto;
    overscroll-behavior: contain;
    touch-action: pan-y;
    /* The launch scene shows through, darker at the top where the title is. */
    background: linear-gradient(rgba(3, 6, 14, 0.8), rgba(3, 6, 14, 0.5) 55%, rgba(3, 6, 14, 0.3));
    transition: transform 0.4s ease-in-out, opacity 0.3s, visibility 0s;
    pointer-events: auto;
    /* Each page is its own stacking context, so nothing on one page can
       show through onto a sibling. */
    isolation: isolate;
}

/* A page that isn't the open one (Game.setMenuPanel makes it inert) goes
   once it has slid away, so it can't show through the page over it. */
.menu-page[inert] {
    visibility: hidden;
    transition: transform 0.4s ease-in-out, opacity 0.3s, visibility 0s 0.4s;
}

.menu-page::before,
.menu-page::after {
    content: "";
    flex: 1 0 0;
}

#mp-menu-layer {
    transform: translateX(100%);
}

/* Shop and Records slide up over the home page. */
#shop-menu-layer,
#records-menu-layer {
    transform: translateY(100%);
    z-index: 25;
    background: linear-gradient(rgba(3, 6, 14, 0.9), rgba(3, 6, 14, 0.7));
}

#shop-menu-layer > .panel,
#shop-menu-layer > .btn,
#records-menu-layer > .panel,
.records-stats {
    margin-bottom: 18px;
}

/* A page's name, behind a small Pixel in the page's colour. */
.page-title {
    --accent: var(--teal);
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 20px;
    color: #fff;
    font-size: clamp(22px, 5.5vw, 30px);
    font-weight: 900;
    letter-spacing: 4px;
    text-align: center;
    text-shadow: 0 0 22px rgba(255, 255, 255, 0.2);
}

.page-title::before {
    content: "";
    flex: none;
    width: 0.8em;
    height: 0.8em;
    border-radius: 8%;
    background:
        linear-gradient(var(--night), var(--night)) 20% 32% / 20% 20% no-repeat,
        linear-gradient(var(--night), var(--night)) 80% 32% / 20% 20% no-repeat,
        var(--accent);
    box-shadow: 0 0 16px var(--accent);
}

.page-title--mp { --accent: var(--teal); }

.page-title--records { --accent: var(--gold); }

/* The game's own name: white, with the one rainbow glow in the menus. The
   glow's hue drifts slowly (the white text doesn't change); it stands still
   under Reduced Motion and never runs during a run (menu-only). */
.page-title--brand {
    margin-bottom: 18px;
    color: #fff;
    font-size: clamp(22px, 7.4vw, 58px);
    letter-spacing: clamp(1px, 0.8vw, 4px);
    line-height: 1.05;
    text-shadow:
        0 2px 0 var(--tier-mythic),
        0 4px 0 #b31440,
        0 6px 0 #5a0a24,
        0 0 26px rgba(255, 45, 85, 0.55),
        0 0 60px rgba(255, 45, 85, 0.25);
    animation: title-hue 24s linear infinite;
}

@keyframes title-hue {
    to { filter: hue-rotate(360deg); }
}

#game-container:not(.menu-open) .page-title--brand {
    animation: none;
}

/* Phones: the gem and heart pills take the top-right corner, so the title
   keeps clear of them on both sides (it stays centred). */
@media (max-width: 520px) {
    .page-title--brand {
        padding-inline: 58px;
        font-size: clamp(22px, 7.2vw, 30px);
    }
}

@media (prefers-reduced-motion: reduce) {
    .page-title--brand { animation: none; }
}

body.reduce-motion .page-title--brand {
    animation: none;
}

.page-title--brand::before {
    display: none;
}

/* h1 defaults off: the title keeps the page-title look. */
h1.page-title {
    margin-top: 0;
    font-family: inherit;
}

/* Plain text, not flex: the J's span must not split the name into flex items. */
.page-title--brand {
    display: block;
    white-space: nowrap;
}

/* Identity: the equipped Pixel stands on the J of the name, in its own colour
   (--pixel-accent, set by updateSkinUI), and hops with the menu Pixel. */
.brand-j {
    position: relative;
    display: inline-block;
}

.brand-j::after {
    content: "";
    position: absolute;
    left: 50%;
    bottom: 100%;
    width: 0.36em;
    height: 0.36em;
    margin: 0 0 0.04em -0.18em;
    border-radius: 8%;
    background:
        linear-gradient(var(--night), var(--night)) 22% 34% / 22% 22% no-repeat,
        linear-gradient(var(--night), var(--night)) 78% 34% / 22% 22% no-repeat,
        var(--pixel-accent, var(--pixel));
    box-shadow: 0 0 14px var(--pixel-accent, var(--pixel));
    text-shadow: none;
    animation: pixel-idle 2.6s ease-in-out infinite;
    animation-delay: -1.3s;
}

#game-container:not(.menu-open) .brand-j::after,
body.reduce-motion .brand-j::after {
    animation: none;
}

@media (prefers-reduced-motion: reduce) {
    .brand-j::after { animation: none; }
}

/* ---- Home ---- */
/* The home column: 360px (wider on a very short screen, below), and in the
   flank layout never wider than the playfield plus its gaps, so the gem and
   heart pills and the Streak chip beside it never sit on the home. */
#menu-layer {
    --panel-w: min(var(--home-w, 360px), 88vw, var(--hud-room, 100vw));
}

#game-container[data-layout="flank"] #menu-layer {
    --hud-room: calc(var(--pf-w, 100vw) + 2 * var(--flank-gap) - 8px);
}

/* Outside the flank layout the gem and heart pills stack in the top corner:
   the home starts under them (--menu-band), and shrinks to the height left
   below them (--vh, 1% of it). */
#menu-layer {
    --vh: calc((100vh - var(--menu-band, 0px)) / 100);
}

#game-container[data-layout="overlay"] #menu-layer,
#game-container[data-layout="strip"] #menu-layer {
    --menu-band: calc(var(--hud-top, 0px) + 14px + 2 * var(--pill-h) + 6px);
    padding-top: calc(var(--menu-band) + var(--safe-top));
}

.home {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
    max-width: 100%;
}

.home-actions {
    display: flex;
    flex-direction: column;
    gap: 10px;
    width: var(--panel-w);
    max-width: 100%;
}

.home-actions > .btn {
    width: 100%;
}

/* The home card takes the equipped Pixel's colour on its lit edge. */
#skin-container::before {
    background: linear-gradient(90deg, transparent, var(--pixel-accent, var(--teal)) 20%, var(--pixel-accent, var(--teal)) 80%, transparent);
    box-shadow: 0 0 12px var(--pixel-accent, var(--teal));
}

#skin-container {
    background:
        linear-gradient(color-mix(in srgb, var(--pixel-accent, var(--teal)) 9%, transparent), transparent 90px),
        var(--glass);
}

/* One Pixel owned: no ‹ ›, and no room kept for stepping between Pixels. */
#skin-container.one-pixel .skin-step {
    visibility: hidden;
}

#skin-container.one-pixel #skin-ability {
    min-height: 0;
}

#skin-container.one-pixel #skin-status:empty {
    min-height: 0;
}

/* The Pixel picker: the equipped Pixel standing on a lit platform, with
   ‹ › either side and its name, tier and perks underneath. */
#skin-container {
    display: flex;
    align-items: center;
    padding: 14px 14px 16px;
    cursor: default;
}

#skin-display {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
}

.skin-picker {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    margin: 2px 0 6px;
}

/* The stand: room for the Pixel's hop, and its platform underneath. */
.skin-stand {
    position: relative;
    display: flex;
    justify-content: center;
    align-items: flex-end;
    width: 150px;
    height: 112px;
}

.skin-stand::after {
    content: "";
    position: absolute;
    bottom: 0;
    left: 50%;
    width: 120px;
    height: 7px;
    margin-left: -60px;
    border-radius: 3px;
    background: linear-gradient(#5fffe0, #00b896);
    box-shadow: 0 0 16px rgba(var(--teal-rgb), 0.55), 0 6px 18px rgba(var(--teal-rgb), 0.2);
}

#skin-preview-box {
    position: relative;
    width: 72px;
    height: 72px;
    margin-bottom: 9px;
    border-radius: 8%; /* PIXEL_CORNER_RADIUS / 26, like the in-game Pixel */
    color: var(--pixel); /* updateSkinUI sets the Pixel's colour: its glow */
    outline: 1px solid rgba(255, 255, 255, 0.14);
    box-shadow: 0 0 44px -6px currentColor;
    animation: pixel-idle 2.6s ease-in-out infinite;
}

/* A small idle hop on the menu (never during a run, never with reduced motion). */
@keyframes pixel-idle {
    0%, 62%, 100% { transform: translateY(0) scale(1, 1); }
    70% { transform: translateY(0) scale(1.08, 0.92); }
    80% { transform: translateY(-14px) scale(0.95, 1.06); }
    90% { transform: translateY(0) scale(1.05, 0.95); }
}

#game-container:not(.menu-open) #skin-preview-box,
body.reduce-motion #skin-preview-box {
    animation: none;
}

@media (prefers-reduced-motion: reduce) {
    #skin-preview-box { animation: none; }
}

#skin-name {
    max-width: 100%;
    margin-top: 6px;
    overflow: hidden;
    color: #fff;
    font-size: 20px;
    font-weight: 900;
    letter-spacing: 0.5px;
    text-overflow: ellipsis;
    white-space: nowrap;
}

#skin-status {
    min-height: 1.3em; /* kept when empty, so PLAY doesn't move */
    margin-top: 2px;
    color: var(--text);
    font-family: var(--font-text);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 1px;
}

#skin-ability {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-content: flex-start;
    gap: 6px;
    margin-top: 4px;
    /* The tier line plus two rows of tags (the most any Pixel needs), so
       stepping between Pixels never moves the picker or PLAY. */
    min-height: 74px;
}

/* Best and last run, in the card under the Pixel's name. BEST is a record: gold. */
.menu-scores {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 2px 14px;
    margin-top: 4px;
    font-size: 12px;
    font-weight: 900;
    letter-spacing: 1.5px;
}

#menu-highscore {
    color: var(--gold);
    text-shadow: 0 0 12px rgba(var(--gold-rgb), 0.35);
}
#menu-lastscore { color: var(--muted); }

/* PLAY breathes, so it reads as the thing to press. It is the only filled
   button on the home screen. */
#start-prompt {
    animation: play-glow 1.8s ease-in-out infinite;
}

@keyframes play-glow {
    0%, 100% { filter: brightness(1); }
    50% { filter: brightness(1.14); }
}

/* The limited mode and RACE #1 in one slim row under PLAY, across the full
   column (no label beside it). The row goes when both are hidden. */
.home-today {
    display: flex;
    align-items: stretch;
    gap: 8px;
}

.home-today:not(:has(> .btn:not([hidden]))) {
    display: none;
}

/* Its buttons wrap their words rather than spill: a long mode name or note
   takes a second line in a narrow column. */
.home-today .btn {
    flex: 1;
    min-width: 0;
    min-height: 44px;
    padding: 6px 8px;
    font-size: 12px;
    letter-spacing: 1px;
    text-align: center;
    white-space: normal;
    text-wrap: balance;
}

/* Four equal tiles: an icon over its label. Quiet outlines, so PLAY is the one
   filled cap on the screen. */
.menu-actions {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 8px;
}

.home-tile {
    --k: var(--muted);
    --k-rgb: 147, 160, 184;
    flex-direction: column;
    gap: 5px;
    min-width: 0;
    min-height: 60px;
    padding: 9px 2px 8px;
    border-color: rgba(255, 255, 255, 0.16);
    color: var(--text);
    box-shadow: 0 3px 0 rgba(255, 255, 255, 0.08);
}

.home-tile > .ico {
    width: 22px;
    height: 22px;
    color: var(--teal);
}

.home-tile > .ico-gem { color: var(--gem); }
.home-tile > .ico-gold { color: var(--gold); }

.home-tile-label {
    max-width: 100%;
    overflow: hidden;
    font-size: 9.5px;
    letter-spacing: 0.5px;
    text-overflow: ellipsis;
}

/* The shop is gem-cyan, and pulses with a BUY badge when something new is
   affordable. */
#shop-open-btn {
    position: relative;
}

#shop-open-btn.can-buy {
    --k: var(--gem);
    --k-rgb: var(--gem-rgb);
    border-color: rgba(var(--gem-rgb), 0.75);
}

@keyframes shop-pulse {
    0%, 100% { box-shadow: 0 4px 0 rgba(var(--k-rgb), 0.4), 0 0 0 rgba(var(--k-rgb), 0); }
    50% { box-shadow: 0 4px 0 rgba(var(--k-rgb), 0.4), 0 0 22px rgba(var(--k-rgb), 0.8); }
}

#shop-open-btn.can-buy {
    animation: shop-pulse 1.6s ease-in-out infinite;
}

/* A chip on SHOP's label line, so no tile width can push it into the icon
   or the row above. */
.shop-badge {
    display: inline-block;
    margin-left: 4px;
    padding: 1px 2px;
    border-radius: 3px;
    background: var(--gem);
    color: var(--night);
    font-size: 8px;
    letter-spacing: 0;
    line-height: 1.2;
    vertical-align: 1px;
    box-shadow: 0 0 6px rgba(var(--gem-rgb), 0.7);
}

.shop-badge[hidden] {
    display: none;
}

/* ABOUT and PRIVACY under the buttons: quiet, but there for anyone looking. */
.menu-links {
    display: flex;
    gap: 18px;
    margin-top: 14px;
}

.menu-links a {
    padding: 4px 2px;
    color: #9aa6bd;
    font-family: var(--font-text);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 1px;
    text-decoration: none;
}

.menu-links a:hover,
.menu-links a:focus-visible {
    color: #fff;
    text-decoration: underline;
}

/* Phones: the pickers (menu and shop) must fit inside the screen. */
@media (max-width: 400px) {
    #skin-container {
        padding-left: 8px;
        padding-right: 8px;
    }
}

/* Short screens (a 1280x720 or 1366x650 laptop, CrazyGames' 800x450 frame,
   a phone held sideways): the one column shrinks with the window's height
   (spacing, the Pixel card, PLAY, the tiles), so the whole home fits without
   scrolling. Never a second column: the home is one centred column at every
   size (layout-sweep.mjs checks it in CI). */
@media (max-height: 860px) {
    #menu-layer {
        padding-top: calc(clamp(4px, calc(1.4 * var(--vh)), 14px) + var(--safe-top));
        padding-bottom: calc(clamp(4px, calc(1.4 * var(--vh)), 14px) + var(--safe-bottom));
    }

    .page-title--brand {
        margin-bottom: clamp(4px, calc(1.6 * var(--vh)), 14px);
        font-size: clamp(22px, min(7.4vw, calc(7 * var(--vh))), 58px);
    }

    .home {
        gap: clamp(6px, calc(1.6 * var(--vh)), 14px);
    }

    .home-actions {
        gap: clamp(6px, calc(1.2 * var(--vh)), 10px);
    }

    #skin-container {
        padding-top: clamp(4px, calc(1.4 * var(--vh)), 12px);
        padding-bottom: clamp(4px, calc(1.4 * var(--vh)), 12px);
    }

    .skin-picker {
        margin: 0 0 clamp(0px, calc(0.6 * var(--vh)), 6px);
    }

    .skin-stand {
        height: clamp(44px, calc(12 * var(--vh)), 104px);
    }

    #skin-preview-box {
        width: clamp(34px, calc(8 * var(--vh)), 68px);
        height: clamp(34px, calc(8 * var(--vh)), 68px);
        margin-bottom: clamp(4px, calc(1 * var(--vh)), 9px);
    }

    .skin-step {
        min-height: 44px;
    }

    #skin-name {
        margin-top: 0;
        font-size: clamp(15px, calc(2.8 * var(--vh)), 20px);
    }

    /* The room kept for a second row of perk tags goes: on a short screen
       the space is worth more than PLAY never moving. */
    #skin-ability {
        min-height: 0;
    }

    .btn--big {
        padding-top: clamp(7px, calc(1.8 * var(--vh)), 15px);
        padding-bottom: clamp(7px, calc(1.8 * var(--vh)), 15px);
        font-size: clamp(17px, calc(3.4 * var(--vh)), 22px);
    }

    .home-tile {
        gap: clamp(2px, calc(0.6 * var(--vh)), 5px);
        min-height: clamp(38px, calc(8.5 * var(--vh)), 60px);
        padding-top: clamp(3px, calc(1 * var(--vh)), 9px);
        padding-bottom: clamp(3px, calc(1 * var(--vh)), 8px);
    }

    .home-tile > .ico {
        width: clamp(16px, calc(3.2 * var(--vh)), 22px);
        height: clamp(16px, calc(3.2 * var(--vh)), 22px);
    }

    .menu-links {
        margin-top: clamp(2px, calc(1.2 * var(--vh)), 14px);
    }

    .menu-links a {
        padding-top: 1px;
        padding-bottom: 1px;
    }
}

/* Very short (a phone on its side, CrazyGames' 800x450): the owned count
   goes (the ‹ › stay), the tier joins the perk row, and the column gets
   a little wider for it. */
@media (max-height: 520px) {
    #menu-layer {
        --home-w: 440px;
    }

    .skin-owned-count {
        display: none;
    }

    #skin-status {
        min-height: 0;
        margin-top: 0;
    }

    #skin-ability {
        margin-top: 2px;
    }

    #skin-ability .tier-line {
        flex-basis: auto;
    }

    #skin-ability {
        gap: 4px;
    }

    #skin-ability .perk-tag,
    #skin-ability .tier-badge {
        padding: 2px 5px;
        font-size: 9px;
        letter-spacing: 0.5px;
    }

    .home-today .btn {
        min-height: 40px;
        padding-top: 3px;
        padding-bottom: 3px;
    }
}

/* A phone on its side: the mode's note goes from the TODAY row (its name and
   time left stay). */
@media (max-height: 420px) {
    .ltm-btn .ltm-note {
        display: none;
    }
}

/* ---- Multiplayer: Co-op and Versus ---- */
.mp-box {
    text-align: left;
}

.mp-box label {
    display: block;
    margin-bottom: 8px;
    color: var(--muted);
    font-family: var(--font-text);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 1.5px;
    text-transform: uppercase;
}

/* The setup card: name, then JOIN, an OR rule, then HOST. */
.mp-card {
    padding: 20px 18px 18px;
}

.mp-section {
    margin-top: 18px;
}

.mp-or {
    display: flex;
    align-items: center;
    gap: 12px;
    margin: 16px 0 14px;
    color: var(--muted);
    font-size: 11px;
    font-weight: 900;
    letter-spacing: 3px;
}

.mp-or::before,
.mp-or::after {
    content: "";
    flex: 1;
    height: 1px;
    background: var(--line);
}

.mp-hint {
    margin: 8px 0 0;
    color: var(--muted);
    font-family: var(--font-text);
    font-size: 13px;
    font-weight: 500;
    text-align: center;
}

.mp-box input[type="text"] {
    width: 100%;
    box-sizing: border-box;
    padding: 11px 10px;
    border: 1.5px solid rgba(255, 255, 255, 0.14);
    border-radius: 12px;
    background: rgba(0, 0, 0, 0.4);
    color: #fff;
    font-family: inherit;
    font-size: 16px;
    font-weight: bold;
    letter-spacing: 2px;
    text-align: center;
    text-transform: uppercase;
    transition: border-color 0.2s, box-shadow 0.2s;
}

.mp-box input[type="text"]::placeholder {
    color: #6f7b92;
}

.mp-box input[type="text"]:focus {
    outline: none;
    border-color: var(--teal);
    box-shadow: 0 0 12px rgba(var(--teal-rgb), 0.3);
}

.mp-join-row {
    display: flex;
    gap: 8px;
}

.mp-join-row input[type="text"] {
    flex: 1;
    min-width: 0;
}

.mp-box--host .btn {
    width: 100%;
}

/* The two modes, explained before you host or join. */
.mp-modes {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 8px;
    margin-top: 16px;
}

.mp-mode-card {
    --k: var(--teal);
    padding: 10px 10px 11px;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.03);
}

.mp-mode-card--versus {
    --k: var(--teal);
}

.mp-mode-name {
    display: flex;
    align-items: center;
    gap: 6px;
    color: var(--k);
    font-size: 13px;
    font-weight: 900;
    letter-spacing: 1.5px;
}

.mp-mode-card p {
    margin: 6px 0 0;
    color: var(--text);
    font-family: var(--font-text);
    font-size: 13px;
    font-weight: 500;
    line-height: 1.3;
}

/* In the party: the leader's mode and goal pickers (shown to everyone). */
.mp-mode {
    margin-top: 12px;
    padding-top: 12px;
    border-top: 1px solid var(--line);
}

.mp-mode-row,
.mp-goal-row {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 8px;
}

.mp-goal-row {
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 6px;
    margin-top: 8px;
}

.mp-mode-btn,
.mp-goal-btn {
    width: 100%;
    color: var(--muted);
    --k-rgb: 147, 160, 184;
}

.mp-mode-btn {
    padding: 9px 6px;
    font-size: 13px;
}

.mp-goal-btn {
    padding: 7px 2px;
    font-size: 11px;
    letter-spacing: 0.5px;
}

.mp-mode-btn.is-on,
.mp-goal-btn.is-on {
    --k-rgb: var(--teal-rgb);
    color: var(--teal);
}

.mp-mode-btn[data-mode="versus"].is-on,
.mp-goal-btn.is-on {
    --k-rgb: var(--teal-rgb);
    color: var(--teal);
}

/* A guest sees the leader's choice; the buttons aren't theirs to press. */
.mp-mode-btn:disabled,
.mp-goal-btn:disabled {
    transform: none;
    opacity: 1;
}

.mp-mode-btn:disabled:not(.is-on),
.mp-goal-btn:disabled:not(.is-on) {
    opacity: 0.45;
}

.mp-mode-desc {
    margin: 10px 0 0;
    color: var(--text);
    font-family: var(--font-text);
    font-size: 13px;
    font-weight: 500;
    line-height: 1.35;
}

.mp-mode-who {
    color: var(--muted);
}

/* ---- Lobby setup <-> party view ----
   Hosting or joining adds .in-party to #mp-menu-layer: the setup panels
   evaporate (fade, blur, lift, collapse) and the party panel rises in. */
.mp-setup {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
    max-width: 100%;
    max-height: 600px;
    transition: opacity 0.45s ease, filter 0.45s ease, transform 0.45s ease,
        max-height 0.5s ease 0.15s;
}

#mp-menu-layer.in-party .mp-setup {
    opacity: 0;
    filter: blur(8px);
    transform: translateY(-16px) scale(0.94);
    max-height: 0;
    overflow: hidden;
    pointer-events: none;
}

.mp-party-view {
    display: none;
    flex-direction: column;
    align-items: center;
    max-width: 100%;
}

#mp-menu-layer.in-party .mp-party-view {
    display: flex;
    animation: mp-party-in 0.5s ease 0.2s both;
}

@keyframes mp-party-in {
    from {
        opacity: 0;
        filter: blur(4px);
        transform: translateY(14px) scale(0.97);
    }

    to {
        opacity: 1;
        filter: none;
        transform: none;
    }
}

/* Room code, so anyone in the party can keep sharing it. */
.mp-code-row {
    display: flex;
    align-items: stretch;
    gap: 8px;
    margin-bottom: 10px;
}

.mp-party-code {
    flex: 1;
    min-width: 0;
    /* letter-spacing trails the last glyph; the extra left padding evens it. */
    padding: 8px 0 8px 6px;
    border: 1.5px dashed rgba(var(--teal-rgb), 0.5);
    border-radius: 12px;
    background: rgba(var(--teal-rgb), 0.05);
    color: var(--teal);
    font-size: 22px;
    font-weight: 900;
    letter-spacing: 6px;
    text-align: center;
    user-select: text;
    -webkit-user-select: text;
}

.mp-code-btn {
    padding: 6px 10px;
    font-size: 11px;
    letter-spacing: 1px;
}

.mp-party-list {
    list-style: none;
    margin: 0;
    padding: 0;
}

/* Each row sets --slot to that player's in-game name-tag colour. */
.mp-party-row {
    --slot: #555;
    display: flex;
    align-items: center;
    gap: 10px;
    margin-top: 6px;
    padding: 9px 12px;
    border-radius: 10px;
    background: rgba(255, 255, 255, 0.04);
    color: #fff;
    font-size: 14px;
    font-weight: bold;
    letter-spacing: 1px;
    text-align: left;
}

.mp-party-row.is-leader {
    background: linear-gradient(90deg, rgba(var(--gold-rgb), 0.14), rgba(0, 0, 0, 0.3));
}

/* The player's colour, as a small Pixel. */
.mp-party-chip {
    flex: none;
    width: 16px;
    height: 16px;
    border-radius: 8%;
    background:
        linear-gradient(var(--night), var(--night)) 20% 32% / 20% 20% no-repeat,
        linear-gradient(var(--night), var(--night)) 80% 32% / 20% 20% no-repeat,
        var(--slot);
    box-shadow: 0 0 8px var(--slot);
}

.mp-party-name {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.mp-party-tags {
    flex: none;
    display: flex;
    gap: 8px;
}

.mp-party-tag {
    color: var(--muted);
    font-family: var(--font-text);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 1px;
}

.mp-party-row.is-leader .mp-party-tag {
    color: var(--gold);
}

.mp-party-row.is-empty {
    background: transparent;
    outline: 1px dashed rgba(255, 255, 255, 0.16);
    outline-offset: -1px;
    color: #7f8aa0;
    font-family: var(--font-text);
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.3px;
}

.mp-party-row.is-empty .mp-party-chip {
    background: transparent;
    outline: 1px dashed #556;
    box-shadow: none;
}

.mp-leave-btn {
    width: var(--panel-w);
    max-width: 100%;
    margin-top: 18px;
}

/* Connection status: a pill. app.js sets data-state; no state means idle. */
#mp-status {
    --status: var(--muted);
    margin-top: 16px;
    padding: 5px 16px;
    max-width: var(--panel-w);
    box-sizing: border-box;
    border: 1px solid color-mix(in srgb, var(--status) 45%, transparent);
    border-radius: var(--radius-pill);
    background: var(--glass);
    color: var(--status);
    font-family: var(--font-text);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 1px;
    text-align: center;
    transition: color 0.3s, border-color 0.3s;
}

#mp-status[data-state="pending"] { --status: var(--warn); }
#mp-status[data-state="success"] { --status: var(--teal); }
#mp-status[data-state="danger"] { --status: #ff5c85; }

/* Passive context, not an action: the relay logins could not be fetched, so
   strict networks may refuse the direct link. Hidden unless network.js says
   the relay is outright unavailable, and never replaces #mp-status. */
.mp-relay-note {
    max-width: var(--panel-w);
    box-sizing: border-box;
    margin-top: 8px;
    color: var(--warn);
    font-family: var(--font-text);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.5px;
    line-height: 1.35;
    text-align: center;
}

/* Unlike solo (click anywhere), co-op only starts from this button, which
   stays hidden until a partner has connected. */
#mp-start-prompt {
    display: none;
    width: var(--panel-w);
    max-width: 100%;
    margin-top: 14px;
}

/* Short viewports: tighten the panels so the leader's START RUN stays on
   screen. */
@media (max-height: 760px) {
    #mp-menu-layer .page-title {
        margin-bottom: 12px;
    }

    .mp-setup {
        gap: 12px;
    }

    .mp-box {
        padding: 15px 14px 14px;
    }

    .mp-section {
        margin-top: 12px;
    }

    .mp-or {
        margin: 10px 0;
    }

    .mp-box label {
        margin-bottom: 6px;
    }

    .mp-box input[type="text"] {
        padding: 8px;
        font-size: 14px;
    }

    .mp-party-code {
        padding: 5px 0 5px 6px;
        font-size: 20px;
    }

    .mp-party-row {
        padding: 6px 10px;
    }

    .mp-leave-btn,
    #mp-status,
    #mp-start-prompt {
        margin-top: 12px;
    }

    .mp-relay-note {
        margin-top: 6px;
    }
}

/* PERK TAGS — one short chip per perk in the perk's own colour (--perk, set
   inline from PERKS). The full stat text sits in .perk-tip, shown on hover or
   when a tap toggles .open (see Game.bindEvents). Shared by menu and shop. */
.perk-tag {
    position: relative;
    display: inline-block;
    padding: 3px 7px;
    border: 1px solid var(--perk);
    color: var(--perk);
    background: color-mix(in srgb, var(--perk) 12%, transparent);
    font-size: 10px;
    font-weight: bold;
    letter-spacing: 1px;
    line-height: 1.2;
    cursor: help;
    pointer-events: auto;
    user-select: none;
    outline: none;
}

.perk-tag:focus-visible,
.perk-tag.open {
    background: color-mix(in srgb, var(--perk) 25%, transparent);
    box-shadow: 0 0 10px color-mix(in srgb, var(--perk) 50%, transparent);
}

.perk-tip {
    display: none;
    position: absolute;
    bottom: calc(100% + 8px);
    left: 50%;
    transform: translateX(-50%);
    width: max-content;
    max-width: 180px;
    padding: 6px 9px;
    background: var(--night);
    border: 1px solid var(--perk);
    color: #fff;
    font-family: var(--font-text);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.3px;
    line-height: 1.35;
    text-align: center;
    white-space: normal;
    z-index: 50;
    pointer-events: none;
}

.perk-tip::after {
    content: "";
    position: absolute;
    top: 100%;
    left: 50%;
    transform: translateX(-50%);
    border: 5px solid transparent;
    border-top-color: var(--perk);
}

.perk-tag:focus-visible .perk-tip,
.perk-tag.open .perk-tip {
    display: block;
}

/* Touch has no hover, and a tapped element keeps a "sticky" :hover, so the
   hover tooltip is for real pointers only (taps toggle .open instead). */
@media (hover: hover) {
    .perk-tag:hover {
        background: color-mix(in srgb, var(--perk) 25%, transparent);
        box-shadow: 0 0 10px color-mix(in srgb, var(--perk) 50%, transparent);
    }

    .perk-tag:hover .perk-tip {
        display: block;
    }
}

.perk-none {
    color: var(--muted);
    font-family: var(--font-text);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.5px;
}

/* ---- Shop ---- */
.shop-card-btn {
    width: 100%;
}

/* The Pixel carousel: the same shape as the home screen's picker, so the
   two read as one component in two places. */
/* "Can't do that" feedback on whatever was pressed (see Game.shakeUI). */
.shake {
    animation: shake 0.4s ease-in-out;
}

@keyframes shake {

    0%,
    100% {
        transform: translateX(0);
    }

    25% {
        transform: translateX(-5px);
    }

    75% {
        transform: translateX(5px);
    }
}



/* ---------- The buy-confirm card's Pixel ---------- */
#hourly-preview,
.hourly-preview {
    display: flex;
    justify-content: center;
    margin: 2px 0;
}

.hourly-pixel {
    display: block;
    position: relative;
    width: 72px;
    height: 72px;
    border-radius: 8%; /* PIXEL_CORNER_RADIUS / 26, like the in-game Pixel */
    box-shadow: 0 0 24px rgba(255, 255, 255, 0.15);
}

.hourly-name {
    font-size: 18px;
    font-weight: 900;
    color: #fff;
}

.hourly-perks {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 6px;
}

/* The tier badge's own first line, above the perk chips (tierLine). */
.tier-line {
    flex-basis: 100%;
    text-align: center;
}

.overlay-btn.cant-afford {
    opacity: 0.45;
}


/* Below the HUD rows (score, BEST, power-up bar) and the system-message box,
   so a badge and a notice can show at the same time. */
/* Sits in the #ui-layer column right under #system-alert (which always
   keeps its space), so a badge never lands on top of a notice. */
#achievement-pop {
    position: relative;
    margin-top: 10px;
    background: linear-gradient(#ffe27a, var(--gold));
    color: #2a1d00;
    padding: 9px 18px;
    font-size: 13px;
    font-weight: 900;
    letter-spacing: 1px;
    border-radius: 12px;
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.6), 0 4px 0 #a8820a, 0 8px 24px rgba(var(--gold-rgb), 0.35);
    display: none;
    z-index: 100;
    animation: slideIn 0.5s forwards;
}

@keyframes slideIn {
    0% {
        opacity: 0;
        transform: translateY(-10px);
    }

    100% {
        opacity: 1;
        transform: translateY(0);
    }
}

/* Respect "reduce motion": no blinking, pulsing or sliding. */
@media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.01ms !important;
    }
}

/* ---------- In-run HUD button (pause) ---------- */
.hud-btn {
    position: absolute;
    /* Below the gem and heart counters in the top-right corner. */
    top: calc(var(--stack-top) + 2 * var(--pill-h) + 16px);
    right: var(--stack-right);
    width: 44px;
    height: 44px;
    padding: 0;
    background: rgba(6, 10, 18, 0.8);
    border: 1px solid rgba(255, 255, 255, 0.22);
    border-radius: 12px;
    color: var(--text);
    font-size: 14px;
    letter-spacing: -2px;
    cursor: pointer;
    pointer-events: auto;
    box-shadow: 0 3px 0 rgba(255, 255, 255, 0.12), 0 6px 18px rgba(0, 0, 0, 0.35);
}

/* The pause icon's two bars, drawn rather than a glyph (Orbitron has none). */
#pause-btn::before,
#pause-btn::after {
    content: "";
    position: absolute;
    top: 15px;
    width: 4px;
    height: 14px;
    border-radius: 1px;
    background: currentColor;
}

#pause-btn::before { left: 15px; }
#pause-btn::after { right: 15px; }

@media (hover: hover) {
    .hud-btn:hover {
        border-color: var(--teal);
        color: var(--teal);
    }
}

/* ---------- Shared modal overlays: pause, settings, run card, Pixel of
   the Hour ---------- */
.overlay {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: calc(16px + var(--safe-top)) 16px calc(16px + var(--safe-bottom));
    box-sizing: border-box;
    background: radial-gradient(ellipse at 50% 40%, rgba(2, 4, 10, 0.62), rgba(2, 4, 10, 0.86));
    pointer-events: auto;
    z-index: 60;
}

/* An open dialog takes the focus itself (openOverlay); Tab then reaches its
   controls, which keep their own focus rings. */
.overlay:focus,
.pack-reveal:focus {
    outline: none;
}

/* Dialogs opened from the menus rise in. (Not PAUSED: in co-op that one
   opens over a live run, where the page stays still.) */
.overlay:not(#pause-overlay) > .overlay-box {
    animation: sheet-in 0.24s cubic-bezier(0.2, 0.8, 0.2, 1) both;
}

@keyframes sheet-in {
    from { opacity: 0; transform: translateY(14px) scale(0.98); }
    to { opacity: 1; transform: none; }
}

#run-card {
    /* Above the menus it opens over, below the persistent gem counter. */
    z-index: 35;
}

.overlay-box {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 12px;
    width: min(340px, 100%);
    max-height: 100%;
    overflow-y: auto;
    padding: 26px 20px 20px;
    border-radius: 20px;
    /* Solid, unlike the menu's panels: whatever is under a dialog must not
       show through it. */
    background:
        linear-gradient(rgba(var(--edge-rgb), 0.1), rgba(var(--edge-rgb), 0) 90px),
        var(--sheet);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.06), 0 24px 60px rgba(0, 0, 0, 0.6);
    text-align: center;
}

/* Long labels wrap here rather than run out of the box. */
.overlay-btn {
    min-height: 46px;
    font-size: 13px;
    white-space: normal;
}

/* (A scrolling box can't hang its hover lights outside itself.) */
.overlay-box::after {
    display: none;
}

.overlay-title {
    margin-bottom: 4px;
    color: #fff;
    font-size: 20px;
    font-weight: 900;
    letter-spacing: 4px;
}

.overlay-note {
    color: var(--muted);
    font-family: var(--font-text);
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.5px;
}

/* Notes are quiet by default; a record opts into gold, a warning into amber. */
.overlay-note--plain {
    color: var(--text);
}

/* A neutral (ghost) cap unless it says otherwise (primary, danger, gem). */
.overlay-btn:not(.btn--primary):not(.btn--danger):not(.btn--gem) {
    --k: var(--text);
    --k-rgb: var(--text-rgb);
    border-color: rgba(var(--text-rgb), 0.3);
    box-shadow: 0 3px 0 rgba(var(--text-rgb), 0.1);
}

/* The caps sink 3px when pressed: leave the last one room to. */
.overlay-box > .btn:last-child,
.overlay-box > .run-card-actions:last-child {
    margin-bottom: 4px;
}

/* Settings: DONE stays in reach at the bottom of the sheet while a long
   category is open (the sheet scrolls under it, fading into the sheet). */
#settings-close-btn {
    position: sticky;
    bottom: 6px;
    z-index: 2;
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.55), 0 4px 0 var(--teal-deep), 0 -14px 16px 4px var(--sheet);
}

/* Settings categories (index.html .settings-group): a head that folds its
   rows open, one category at a time (toggleSettingsGroup() in js/menus.js). */
.settings-group {
    border: 1px solid var(--line);
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.03);
}

.settings-group-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    min-height: 48px;
    padding: 0 14px;
    border: 0;
    background: transparent;
    color: #fff;
    font-family: var(--font-display);
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 2px;
    text-align: left;
    cursor: pointer;
}

/* A chevron: down when shut, up when open. */
.settings-group-head::after {
    content: "";
    width: 8px;
    height: 8px;
    margin-top: -4px;
    border-right: 2px solid var(--muted);
    border-bottom: 2px solid var(--muted);
    transform: rotate(45deg);
    transition: transform 0.16s ease, margin 0.16s ease;
}

.settings-group-head[aria-expanded="true"] {
    color: var(--teal);
}

.settings-group-head[aria-expanded="true"]::after {
    margin-top: 4px;
    border-color: var(--teal);
    transform: rotate(-135deg);
}

.settings-group-head:focus-visible {
    outline: 2px solid var(--teal);
    outline-offset: -2px;
    border-radius: 12px;
}

.settings-group-body {
    padding: 0 12px 4px;
    border-top: 1px solid var(--line);
}

.settings-group-body > .setting-row:last-child {
    border-bottom: none;
}

/* Settings rows: label left, control right. */
.setting-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    min-height: 48px;
    padding: 6px 2px;
    box-sizing: border-box;
    border-bottom: 1px solid var(--line);
    color: var(--text);
    font-family: var(--font-text);
    font-size: 15px;
    font-weight: 700;
    letter-spacing: 0.5px;
    text-align: left;
    cursor: pointer;
}

/* The volume slider: a slim track and a teal Pixel-square thumb. */
.setting-row input[type="range"] {
    -webkit-appearance: none;
    appearance: none;
    width: 55%;
    height: 22px;
    margin: 0;
    background: transparent;
    cursor: pointer;
}

.setting-row input[type="range"]::-webkit-slider-runnable-track {
    height: 6px;
    border-radius: var(--radius-pill);
    background: rgba(255, 255, 255, 0.12);
}

.setting-row input[type="range"]::-moz-range-track {
    height: 6px;
    border-radius: var(--radius-pill);
    background: rgba(255, 255, 255, 0.12);
}

.setting-row input[type="range"]::-moz-range-progress {
    height: 6px;
    border-radius: var(--radius-pill);
    background: var(--teal);
}

.setting-row input[type="range"]::-webkit-slider-thumb {
    -webkit-appearance: none;
    width: 20px;
    height: 20px;
    margin-top: -7px;
    border: 0;
    border-radius: 4px;
    background: var(--teal);
    box-shadow: 0 0 12px rgba(var(--teal-rgb), 0.6);
}

.setting-row input[type="range"]::-moz-range-thumb {
    width: 20px;
    height: 20px;
    border: 0;
    border-radius: 4px;
    background: var(--teal);
    box-shadow: 0 0 12px rgba(var(--teal-rgb), 0.6);
}

/* A checkbox is a switch, and its knob is a little Pixel: grey and to the
   left when off, dark on a lit teal track when on. */
.setting-row input[type="checkbox"] {
    appearance: none;
    -webkit-appearance: none;
    flex: none;
    width: 48px;
    height: 28px;
    margin: 0;
    box-sizing: border-box;
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: var(--radius-pill);
    /* Two eyes, then the knob, then the track (positions in px from the
       padding box: the knob is 18px, 4px in). */
    background:
        linear-gradient(var(--sheet), var(--sheet)) 8px 9px / 4px 4px no-repeat,
        linear-gradient(var(--sheet), var(--sheet)) 14px 9px / 4px 4px no-repeat,
        linear-gradient(#8f9bb3, #8f9bb3) 4px 4px / 18px 18px no-repeat,
        rgba(255, 255, 255, 0.07);
    cursor: pointer;
    transition: background-position 0.16s ease, background-color 0.16s, border-color 0.16s;
}

.setting-row input[type="checkbox"]:checked {
    border-color: transparent;
    background:
        linear-gradient(var(--teal), var(--teal)) 28px 9px / 4px 4px no-repeat,
        linear-gradient(var(--teal), var(--teal)) 34px 9px / 4px 4px no-repeat,
        linear-gradient(var(--ink), var(--ink)) 24px 4px / 18px 18px no-repeat,
        var(--teal);
    box-shadow: 0 0 14px rgba(var(--teal-rgb), 0.45);
}

.setting-row input:focus-visible {
    outline: 2px solid #fff;
    outline-offset: 3px;
}

/* ---------- End-of-run card ---------- */
/* RUN OVER is a small label; the height is the headline. */
#run-card-title {
    margin: 0;
    color: var(--muted);
    font-size: 13px;
    letter-spacing: 5px;
}

.run-card-distance {
    margin: -4px 0 2px;
    color: #fff;
    font-size: clamp(44px, 14vw, 60px);
    font-weight: 900;
    line-height: 1.05;
    letter-spacing: -1px;
    font-variant-numeric: tabular-nums;
    text-shadow: 0 3px 0 rgba(0, 0, 0, 0.4), 0 0 28px rgba(255, 255, 255, 0.25);
}

.run-card-best {
    align-self: center;
    margin-top: -4px;
    padding: 5px 14px;
    border: 1px solid rgba(var(--gold-rgb), 0.6);
    border-radius: var(--radius-pill);
    background: rgba(var(--gold-rgb), 0.12);
    color: var(--gold);
    font-size: 12px;
    font-weight: 900;
    letter-spacing: 2px;
    box-shadow: 0 0 20px rgba(var(--gold-rgb), 0.25);
}

/* A new best lights the whole card gold, and the ribbon shines. */
.run-card-box:has(.run-card-best:not([hidden])) {
    --edge: var(--gold);
    --edge-rgb: var(--gold-rgb);
}

.run-card-best:not([hidden]) {
    animation: best-shine 1.4s ease-out 1;
}

@keyframes best-shine {
    0% { transform: scale(0.6); opacity: 0; }
    45% { transform: scale(1.12); opacity: 1; box-shadow: 0 0 34px rgba(var(--gold-rgb), 0.7); }
    100% { transform: scale(1); }
}

body.reduce-motion .run-card-best { animation: none; }
@media (prefers-reduced-motion: reduce) { .run-card-best { animation: none; } }

/* The next goal under the distance: "+40m over your old best" (gold, a
   record) or "BEST 812m · 312m to go" (quiet). */
.run-card-goal {
    margin: 2px 0 4px;
    color: var(--muted);
    font-family: var(--font-text);
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.5px;
}

.run-card-goal.is-best {
    color: var(--gold);
}

.run-card-stats,
.records-stats {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
}

/* The run card: one compact row of three (gems, time, biome). */
.run-card-stats {
    grid-template-columns: repeat(3, 1fr);
    gap: 6px;
    margin-top: 4px;
}

.run-card-stats .run-stat {
    padding: 8px 4px 7px;
}

.run-card-stats .run-stat-value {
    font-size: 14px;
}

.run-card-stats .run-stat-label {
    font-size: 10px;
    letter-spacing: 1px;
}

/* The rest of the run (power-ups, Titans, party rules), on one quiet line. */
.run-card-more {
    color: var(--muted);
    font-family: var(--font-text);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.5px;
}

.records-stats {
    width: var(--panel-w);
    max-width: 100%;
}

/* An odd tile out spans the row rather than leaving a hole (Records; the
   run card's row of three has none). */
.records-stats .run-stat:last-child:nth-child(odd),
.run-card-stats .run-stat:last-child:nth-child(3n+1) {
    grid-column: 1 / -1;
}

/* A stat tile: the number, and what it counts. */
.run-stat {
    padding: 11px 8px 10px;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.03);
    text-align: center;
}

.run-stat-value {
    display: block;
    overflow: hidden;
    color: #fff;
    font-size: 16px;
    font-weight: 900;
    font-variant-numeric: tabular-nums;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.run-stat-label {
    display: block;
    margin-top: 4px;
    color: var(--muted);
    font-family: var(--font-text);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1.2px;
}

.run-card-actions {
    display: flex;
    margin-top: 4px;
}

/* PLAY AGAIN: full width, the one filled cap on the card. */
.run-card-actions .btn {
    flex: 1;
    min-width: 0;
    min-height: 54px;
    font-size: 19px;
    letter-spacing: 3px;
}

/* MENU and SHARE: a quiet ghost pair, each a 44px touch target. */
.run-card-pair {
    display: flex;
    gap: 8px;
}

.run-card-pair .btn {
    flex: 1;
    min-width: 0;
    min-height: 44px;
    padding-left: 8px;
    padding-right: 8px;
}

/* The 2X ad: a small gem-outline row, last. */
#run-boost-btn {
    min-height: 40px;
    font-size: 11px;
    letter-spacing: 1px;
}

/* The board entry's rank ("#148 of 2,031", js/leaderboard.js). */
.run-card-lb-rank {
    color: var(--text);
    font-family: var(--font-text);
    font-size: 13px;
    font-weight: 700;
}

#share-toast {
    color: var(--teal);
    word-break: break-all;
}

/* The Online leaderboard (js/leaderboard.js): a climb that makes the board asks for
   a name. */
.run-card-lb {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 12px;
    border: 1px solid rgba(var(--gold-rgb), 0.4);
    border-radius: 14px;
    background: rgba(var(--gold-rgb), 0.07);
}

.run-card-lb-title {
    color: var(--gold);
    font-size: 13px;
    font-weight: 900;
    letter-spacing: 1px;
}

.run-card-lb-row {
    display: flex;
    gap: 8px;
}

.run-card-lb-row input[type="text"] {
    flex: 1;
    min-width: 0;
    box-sizing: border-box;
    padding: 9px 10px;
    border: 1.5px solid rgba(255, 255, 255, 0.14);
    border-radius: 12px;
    background: rgba(0, 0, 0, 0.4);
    color: #fff;
    font-family: var(--font-display);
    font-size: 16px;
    font-weight: bold;
    letter-spacing: 2px;
    text-align: center;
    text-transform: uppercase;
    transition: border-color 0.2s, box-shadow 0.2s;
}

.run-card-lb-row input[type="text"]::placeholder {
    color: #6f7b92;
}

.run-card-lb-row input[type="text"]:focus {
    outline: none;
    border-color: var(--gold);
    box-shadow: 0 0 12px rgba(var(--gold-rgb), 0.3);
}

.run-card-lb-row input[readonly] {
    color: #c3cde0;
}

.run-card-lb-row .btn {
    flex: none;
}

.lb-note--error {
    color: var(--pixel);
}

/* STYLE tab: a section per cosmetic slot, a card per cosmetic. */
#shop-panel-style {
    width: var(--panel-w);
    max-width: 100%;
    margin: 0 auto;
    padding: 4px 0 12px;
}

.style-slot {
    margin-bottom: 14px;
}

.style-slot-name {
    margin: 0 0 6px 2px;
    color: var(--muted);
    font-size: 12px;
    font-weight: 900;
    letter-spacing: 2px;
    text-align: left;
}

.style-items {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 8px;
}

.style-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    padding: 10px 6px;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.03);
    color: #fff;
    font: inherit;
    cursor: pointer;
}

.style-item--on {
    border-color: var(--teal);
    box-shadow: inset 0 0 0 1px var(--teal);
}

.style-item--short {
    opacity: 0.55;
}

.style-swatch {
    display: flex;
    gap: 3px;
    height: 14px;
}

.style-swatch span {
    width: 10px;
    height: 10px;
    margin-top: 2px;
    border-radius: 2px;
    box-shadow: 0 0 6px currentColor;
}

.style-swatch--dot span,
.style-swatch--ring span {
    border-radius: 50%;
}

.style-swatch--strip span {
    width: 6px;
    height: 12px;
    margin-top: 1px;
}

.style-swatch--streak span {
    width: 14px;
    height: 4px;
    margin-top: 5px;
    border-radius: 2px 5px 5px 2px;
}

.style-swatch--ghost span {
    border-radius: 50% 50% 2px 2px;
}

.style-name {
    font-family: var(--font-text);
    font-size: 13px;
    font-weight: 700;
}

.style-action {
    color: var(--gem);
    font-size: 12px;
    font-weight: 900;
}

.style-item--on .style-action,
.style-item--owned .style-action {
    color: var(--teal);
}

.style-note {
    margin: 4px 0 0;
    color: var(--muted);
    font-family: var(--font-text);
    font-size: 12px;
}

/* The run-perk pick: two cards in their perk tag's colour, and a bar that
   empties over RUN_PERK_PICK_MS (a CSS animation: no page writes per frame).
   In co-op the run goes on underneath, so it leaves the playfield visible. */
.perk-pick {
    background: rgba(0, 0, 0, 0.45);
    /* Only the cards take touches: in co-op the run (and its touch pads)
       carries on underneath. */
    pointer-events: none;
}

.perk-pick .overlay-box {
    pointer-events: auto;
}

.perk-pick-cards {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
    margin: 12px 0;
}

.perk-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 6px;
    min-height: 132px;
    padding: 14px 10px;
    border: 2px solid var(--perk, var(--teal));
    border-radius: 14px;
    background: rgba(255, 255, 255, 0.04);
    color: #fff;
    font: inherit;
    text-align: center;
    cursor: pointer;
}

.perk-card:focus-visible,
.perk-card:hover {
    box-shadow: 0 0 18px var(--perk, var(--teal));
}

.perk-card-key {
    color: var(--muted);
    font-size: 11px;
    font-weight: 900;
}

/* Each card's mark: a little Pixel in the perk's colour (the game's one
   glyph, as on the page titles). */
.perk-card::before {
    content: "";
    order: -1;
    width: 26px;
    height: 26px;
    border-radius: 8%;
    background:
        linear-gradient(var(--night), var(--night)) 22% 34% / 20% 22% no-repeat,
        linear-gradient(var(--night), var(--night)) 78% 34% / 20% 22% no-repeat,
        var(--perk, var(--teal));
    box-shadow: 0 0 14px var(--perk, var(--teal));
}

.perk-card-name {
    color: var(--perk, var(--teal));
    font-size: 16px;
    font-weight: 900;
    letter-spacing: 1px;
}

.perk-card-desc {
    color: #c3cde0;
    font-family: var(--font-text);
    font-size: 13px;
    font-weight: 600;
}

.perk-card-down {
    color: var(--pixel);
    font-size: 11px;
    font-weight: 900;
    letter-spacing: 1px;
}

/* PAUSED: the run perks taken so far. */
.pause-perks {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    margin: 4px 0 10px;
}

.pause-perks-label {
    color: var(--muted);
    font-size: 11px;
    font-weight: 900;
    letter-spacing: 1px;
}

.pause-perks-tags {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 6px;
}

.perk-pick-timer {
    height: 5px;
    border-radius: 3px;
    background: rgba(255, 255, 255, 0.1);
    overflow: hidden;
}

.perk-pick-timer span {
    display: block;
    height: 100%;
    background: var(--teal);
    transform-origin: left center;
}

.perk-pick-timer span.running {
    animation: perk-timer var(--perk-ms, 5000ms) linear forwards;
}

@keyframes perk-timer {
    from { transform: scaleX(1); }
    to { transform: scaleX(0); }
}

/* The first Pixel to buy, as a goal under a new player's Pixel. */
.first-goal {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 5px;
    margin-top: 8px;
}

.first-goal-text {
    color: #fff;
    font-family: var(--font-text);
    font-size: 13px;
    font-weight: 700;
}

.first-goal-bar {
    width: 150px;
    height: 6px;
    border-radius: 3px;
    background: rgba(255, 255, 255, 0.1);
    overflow: hidden;
}

.first-goal-bar span {
    display: block;
    height: 100%;
    background: var(--gem);
}

/* The Streak: a chip in the home's top-left corner, mirroring the gem and
   heart pills on the right (same top, same height). It opens the claim card. */
.menu-streak {
    position: absolute;
    top: var(--stack-top);
    left: calc(var(--hud-left) + 14px + var(--safe-left));
    z-index: 2;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    height: var(--pill-h);
    box-sizing: border-box;
    padding: 0 12px;
    border: 1.5px solid rgba(var(--gold-rgb), 0.45);
    border-radius: var(--radius-pill);
    background: var(--glass);
    color: var(--gold);
    font-family: var(--font-display);
    font-size: 12px;
    font-weight: 900;
    letter-spacing: 1px;
    white-space: nowrap;
    cursor: pointer;
}

#game-container[data-layout="flank"] .menu-streak {
    left: auto;
    right: calc(var(--pf-right, 0px) + var(--pf-w, 0px) + var(--flank-gap));
    /* Smaller in a narrow flank (a phone on its side), so it stays on screen. */
    gap: min(8px, calc((var(--pf-left, 400px) - 64px) / 18));
    padding: 0 min(12px, calc((var(--pf-left, 400px) - 64px) / 12));
    font-size: clamp(9px, calc((var(--pf-left, 400px) - 64px) / 11.6), 12px);
}

.menu-streak.claimable {
    border-color: var(--gold);
    animation: streak-nudge 1.6s ease-in-out infinite;
}

@keyframes streak-nudge {
    50% { box-shadow: 0 0 14px rgba(var(--gold-rgb), 0.55); }
}

.menu-streak .streak-next {
    display: inline-flex;
    align-items: center;
    color: var(--muted);
    font-family: var(--font-text);
    font-size: 1em; /* the chip's 12px, smaller with it in a narrow flank */
    font-weight: 700;
    letter-spacing: 0;
}

.menu-streak.claimable .streak-next {
    color: var(--text);
}

.menu-streak .ico {
    width: 1em;
    height: 1em;
    margin: 0 3px;
}

.streak-box {
    max-width: 380px;
}

.streak-day {
    color: var(--gold);
    font-size: 15px;
    font-weight: 900;
    letter-spacing: 1px;
    text-align: center;
}

.streak-road {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 6px;
    width: 100%;
    margin: 12px 0 8px;
    padding: 0;
    list-style: none;
}

.streak-step {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
    padding: 6px 4px;
    border: 1px solid var(--line, rgba(255, 255, 255, 0.18));
    border-radius: 8px;
    font-size: 12px;
    font-weight: 700;
}

.streak-step-day {
    color: var(--muted);
    font-family: var(--font-display);
    font-size: 10px;
    letter-spacing: 1px;
}

.streak-step-gems {
    color: var(--gem);
}

.streak-step--done {
    border-color: var(--gold);
    opacity: 0.7;
}

.streak-step--done .streak-step-day {
    color: var(--gold);
}

.streak-step--now {
    border-color: var(--teal);
    box-shadow: 0 0 10px rgba(0, 255, 255, 0.35);
}

.streak-bar {
    width: 100%;
    height: 6px;
    margin-bottom: 8px;
    border-radius: 3px;
    background: rgba(255, 255, 255, 0.12);
    overflow: hidden;
}

.streak-bar span {
    display: block;
    height: 100%;
    background: var(--gold);
}

.run-card-ltm {
    margin: 10px 0 2px;
    color: var(--teal);
    font-size: 14px;
    font-weight: 900;
    letter-spacing: 1px;
}

.run-card-ltm .ltm-best {
    color: var(--gold);
}

/* LIMITED MODE: this slot's rule twist, under PLAY. */
.ltm-btn {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
}

.ltm-btn .ltm-name {
    color: var(--teal);
}

.ltm-btn .ltm-sub {
    color: var(--muted);
    font-family: var(--font-text);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0;
}

/* An achievement's reward, hard right of its row. */
.achievement-reward {
    flex: none;
    margin-left: auto;
    color: var(--gem);
    font-size: 13px;
    font-weight: 900;
    white-space: nowrap;
}

/* ---------- Records ---------- */
/* Personal leaderboard: your three best climbs. */
#fame-list {
    display: flex;
    flex-direction: column;
    gap: 4px;
}

.fame-row {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px 10px;
    border-radius: 10px;
    text-align: left;
}

/* Rank chip: gold, silver and bronze on the podium. */
.fame-rank {
    flex: none;
    width: 22px;
    height: 22px;
    border-radius: 6px;
    background: #222a3a;
    color: var(--muted);
    font-size: 11px;
    font-weight: 900;
    line-height: 22px;
    text-align: center;
}

.fame-swatch {
    flex: none;
    width: 14px;
    height: 14px;
    border-radius: 8%;
    background: #555;
}

/* The Pixel's name takes the slack, so the score stays hard right and the
   digits line up down the column. */
.fame-skin {
    flex: 1 1 auto;
    min-width: 0;
    color: #c3cde0;
    font-family: var(--font-text);
    font-size: 14px;
    font-weight: 600;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.fame-date {
    flex: none;
    color: var(--muted);
    font-family: var(--font-text);
    font-size: 12px;
    font-weight: 500;
}

.fame-score {
    flex: none;
    color: #fff;
    font-size: 16px;
    font-weight: 900;
}

.fame-row--1 {
    background: linear-gradient(90deg, rgba(var(--gold-rgb), 0.16), rgba(var(--gold-rgb), 0.03));
}

.fame-row--1 .fame-rank {
    background: var(--gold);
    color: #000;
}

.fame-row--1 .fame-score {
    color: var(--gold);
}

.fame-row--2 .fame-rank {
    background: #c0c8d8;
    color: #000;
}

.fame-row--3 .fame-rank {
    background: #cd7f32;
    color: #000;
}

/* The Online leaderboard in Records: rows like the Personal one's, with
   the player's name after their Pixel's swatch, and your own row outlined. */
.lb-name {
    flex: 1 1 auto;
    min-width: 0;
    color: #fff;
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 1px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.lb-race-btn {
    width: 100%;
    margin-top: 10px;
}

.lb-row--me {
    box-shadow: inset 0 0 0 1px var(--teal);
}

#lb-list {
    display: flex;
    flex-direction: column;
    gap: 4px;
}

/* Your own rank under the board ("YOU #148 OF 2,031 TODAY"), when your
   climb isn't one of the rows above, or even when it is. */
.lb-you {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 6px 10px;
    border-radius: 10px;
    box-shadow: inset 0 0 0 1px var(--teal);
    color: #fff;
    font-family: var(--font-display);
    font-size: 11px;
    letter-spacing: 1px;
    text-align: left;
}

.lb-you-tag {
    color: var(--teal);
    font-weight: 900;
}

.fame-empty {
    padding: 4px 0 2px;
    color: var(--muted);
    font-family: var(--font-text);
    font-size: 15px;
    font-weight: 500;
    line-height: 1.4;
}

.records-list {
    display: flex;
    flex-direction: column;
}

.achievement-row {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 11px 2px;
    border-top: 1px solid var(--line);
    text-align: left;
}

.achievement-row:first-child {
    border-top: 0;
    padding-top: 4px;
}

/* A medal, or the Pixel the achievement unlocks: dim until it's earned. */
.achievement-icon {
    flex: none;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    border-radius: 10px;
    background: rgba(255, 255, 255, 0.04);
    color: #5d6880;
    font-size: 18px;
    opacity: 0.7;
}

.achievement-row.earned .achievement-icon {
    background: rgba(var(--gold-rgb), 0.12);
    color: var(--gold);
    opacity: 1;
    box-shadow: inset 0 0 0 1px rgba(var(--gold-rgb), 0.35);
}

.achievement-name {
    display: block;
    color: #c3cde0;
    font-size: 13px;
    font-weight: 900;
    letter-spacing: 0.5px;
}

.achievement-row.earned .achievement-name {
    color: var(--gold);
}

.achievement-desc {
    display: block;
    margin-top: 1px;
    color: var(--muted);
    font-family: var(--font-text);
    font-size: 14px;
    font-weight: 500;
}

/* Reduced motion chosen in Settings: same as the OS-level preference. */
body.reduce-motion *,
body.reduce-motion *::before,
body.reduce-motion *::after {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
}

/* ---------- On-screen touch bar (phones) ----------
   #touch-controls is laid over the canvas by Game.layoutTouchControls(). The
   bar runs along its bottom edge, split exactly like InputHandler.zoneAt():
   ◀ is the left quarter, ▶ the second quarter, ▲ (jump) the right half. */
#touch-controls {
    position: absolute;
    pointer-events: none;
    z-index: 11;
}

/* The touch bar's height, measured by Renderer.resize() (never shown). */
#touch-reserve {
    position: absolute;
    left: 0;
    bottom: 0;
    width: 1px;
    height: calc(clamp(56px, 9vh, 96px) + var(--safe-bottom));
    visibility: hidden;
    pointer-events: none;
}

.touch-bar {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    display: flex;
    /* About an inch, plus room for the home indicator. */
    height: calc(clamp(56px, 9vh, 96px) + var(--safe-bottom));
    padding-bottom: var(--safe-bottom);
    box-sizing: border-box;
    border-top: 2px solid rgba(255, 255, 255, 0.22);
    background: rgba(0, 0, 0, 0.28);
}

.touch-pad {
    display: flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 25%;
    box-sizing: border-box;
    color: rgba(255, 255, 255, 0.55);
    transition: background 0.08s, color 0.08s;
}

/* A thin line between ◀ and ▶ (the ⇆ badge sits on it); a firmer one
   between moving and jumping. */
.touch-pad--right { border-left: 1px solid rgba(255, 255, 255, 0.16); }

.touch-pad--jump {
    flex-basis: 50%;
    border-left: 2px solid rgba(255, 255, 255, 0.28);
}

.touch-pad.is-active {
    background: rgba(var(--teal-rgb), 0.18);
    color: #fff;
}

/* Arrows are CSS triangles, not ◀ ▶ ▲ glyphs: those come out at different
   sizes per font, and iOS can draw ▶ as an emoji. */
.touch-arrow {
    width: 20px;
    height: 22px;
    background: currentColor;
    clip-path: polygon(100% 0, 100% 100%, 0 50%);
}

.touch-pad--right .touch-arrow { clip-path: polygon(0 0, 100% 50%, 0 100%); }

.touch-pad--jump .touch-arrow {
    width: 26px;
    height: 22px;
    clip-path: polygon(50% 0, 100% 100%, 0 100%);
}

.touch-slide {
    position: absolute;
    left: 25%;
    top: calc(50% - var(--safe-bottom) / 2);
    transform: translate(-50%, -50%);
    padding: 1px 7px 3px;
    border: 1px solid rgba(255, 255, 255, 0.3);
    border-radius: var(--radius-pill);
    background: #0b0b12;
    color: rgba(255, 255, 255, 0.7);
    font-family: system-ui, -apple-system, sans-serif;
    font-size: 16px;
    line-height: 1.2;
}

/* ---------- Daily challenge target (from a shared link) ---------- */
#challenge-hud {
    position: absolute;
    top: calc(var(--hud-top) + 116px + var(--safe-top));
    left: 50%;
    transform: translateX(-50%);
    padding: 4px 12px;
    border: 1px solid rgba(var(--gold-rgb), 0.5);
    border-radius: var(--radius-pill);
    background: rgba(6, 10, 18, 0.8);
    color: var(--gold);
    font-size: 12px;
    font-weight: bold;
    letter-spacing: 1px;
    white-space: nowrap;
}

#challenge-hud.beaten {
    border-color: var(--teal);
    color: var(--teal);
}

/* Phones: BEST sits under the score, so the top centre is free (the old spot
   is where alerts and achievement pops appear). */
@media (max-width: 480px) {
    #challenge-hud {
        top: calc(var(--hud-top) + 26px + var(--safe-top));
        font-size: 11px;
    }
}

/* ---------- Co-op: spectating while dead, room code sharing ---------- */
#spectate-hud {
    position: absolute;
    top: calc(var(--hud-top) + 116px + var(--safe-top));
    left: 50%;
    transform: translateX(-50%);
    padding: 4px 12px;
    border: 1px solid rgba(192, 77, 255, 0.5);
    border-radius: var(--radius-pill);
    background: rgba(6, 10, 18, 0.8);
    color: #d896ff;
    font-size: 12px;
    font-weight: bold;
    letter-spacing: 1px;
    white-space: nowrap;
}

/* ---------- Versus: the race line under the score ---------- */
#versus-hud {
    position: absolute;
    top: calc(var(--hud-top) + 116px + var(--safe-top));
    left: 50%;
    transform: translateX(-50%);
    padding: 4px 12px;
    border: 1px solid rgba(var(--gold-rgb), 0.5);
    border-radius: var(--radius-pill);
    background: rgba(6, 10, 18, 0.8);
    color: var(--gold);
    font-size: 12px;
    font-weight: bold;
    letter-spacing: 1px;
    white-space: nowrap;
}

@media (max-width: 480px) {
    #versus-hud {
        top: calc(var(--hud-top) + 26px + var(--safe-top));
        font-size: 11px;
    }
}

/* The run card after a race: the standings, winner first. */
.run-card-race {
    width: 100%;
    margin: 4px 0 12px;
}

.race-goal {
    color: var(--muted);
    font-family: var(--font-text);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 1.5px;
    text-align: center;
}

.race-standings {
    list-style: none;
    margin: 6px 0 0;
    padding: 0;
}

.race-row {
    --slot: #555;
    display: flex;
    align-items: center;
    gap: 10px;
    margin-top: 5px;
    padding: 7px 12px;
    border-radius: 10px;
    background: rgba(255, 255, 255, 0.04);
    color: var(--text);
    font-size: 14px;
    font-weight: bold;
    letter-spacing: 1px;
    text-align: left;
}

.race-row.is-first {
    background: linear-gradient(90deg, rgba(var(--gold-rgb), 0.16), rgba(0, 0, 0, 0.3));
}

.race-row.is-me {
    outline: 1px solid rgba(var(--teal-rgb), 0.5);
    outline-offset: -1px;
}

.race-place {
    flex: none;
    width: 1.4em;
    color: var(--muted);
}

.race-row.is-first .race-place {
    color: var(--gold);
}

.race-name {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.race-meters {
    flex: none;
    color: var(--gold);
}


/* Settings > SAVE DATA (js/saves.js SaveBackupUI), site and portable: its own
   page inside the Settings panel, so DONE stays in view on the main page. */
.overlay-box[data-view="save"] > :not(.save-backup),
.overlay-box:not([data-view="save"]) > .save-backup {
    display: none;
}
.save-backup {
    display: flex;
    flex-direction: column;
    gap: 8px;
}
.save-backup-title {
    margin-bottom: 4px;
    color: #fff;
    font-family: var(--font-display);
    font-size: 20px;
    font-weight: 900;
    letter-spacing: 4px;
}
.save-backup > .btn:last-child {
    margin-top: 4px;
    margin-bottom: 4px;
}
.save-backup > .settings-status:empty {
    display: none;
}
/* One button per row: the labels are long, and two columns overlap inside the
   narrow settings panel on phones. */
.save-backup-actions {
    display: flex;
    flex-direction: column;
    gap: 8px;
}
.save-backup-actions .btn {
    width: 100%;
}
.save-backup-note {
    margin: 0;
    color: var(--muted);
    font-family: var(--font-text);
    font-size: 12px;
    line-height: 1.4;
    text-align: left;
}
/* VERSION row (index.html) and the status lines under the portable update
   check and the SAVE DATA buttons. */
.settings-version {
    border-bottom: none;
    color: var(--muted);
    font-size: 14px;
    cursor: default;
}
.settings-version strong {
    color: var(--teal);
    font-family: var(--font-display);
    font-weight: 700;
}
.settings-status {
    min-height: 1.2em;
    color: var(--muted);
    font-family: var(--font-text);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 1px;
}
.settings-status[data-state="update"] {
    color: var(--teal);
}
.settings-status[data-state="error"] {
    color: var(--pixel);
}

/* PIXEL TIERS — a label and border in the tier's colour (PIXEL_TIERS). */
.tier-badge {
    display: inline-block;
    padding: 3px 7px;
    border: 1px solid var(--tier);
    color: var(--tier);
    font-size: 10px;
    font-weight: bold;
    letter-spacing: 1px;
    line-height: 1.2;
    user-select: none;
}
.tier-uncommon { --tier: var(--tier-uncommon); }
.tier-rare { --tier: var(--tier-rare); }
.tier-epic { --tier: var(--tier-epic); }
.tier-legendary { --tier: var(--tier-legendary); }
.tier-mythic { --tier: var(--tier-mythic); }

/* Mythic shimmers in the menus and shop only: never during a run, when the
   page must stay still (#game-container loses .menu-open). */
@keyframes tier-shimmer { to { background-position: 200% 0; } }
.tier-badge.tier-mythic,
.tier-mythic .tier-badge,
.shop-list-tier.tier-mythic span {
    animation: tier-shimmer 2.4s linear infinite;
}
.tier-badge.tier-mythic,
.tier-mythic .tier-badge {
    border-color: transparent;
    background: linear-gradient(90deg, var(--tier-mythic), var(--gold), var(--tier-mythic), var(--tier-epic), var(--tier-mythic)) 0 0 / 200% 100%;
    color: #fff;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.6);
}
/* Mythic cards: their tier colour pulses (same rules as the tag). */
@keyframes tier-pulse { 50% { box-shadow: 0 0 22px rgba(255, 45, 85, 0.55), 0 0 0 1px rgba(255, 210, 63, 0.6); } }
.shop-row.tier-mythic,
.strip-pixel.tier-mythic,
.shop-stage.tier-mythic .stage-pixel {
    animation: tier-pulse 2.4s ease-in-out infinite;
}
#game-container:not(.menu-open) .tier-mythic .stage-pixel,
#game-container:not(.menu-open) .tier-mythic,
#game-container:not(.menu-open) .tier-mythic .tier-badge,
#game-container:not(.menu-open) .tier-mythic span { animation: none; }
@media (prefers-reduced-motion: reduce) {
    .tier-badge.tier-mythic,
    .tier-mythic .tier-badge,
    .shop-list-tier.tier-mythic span,
    .shop-row.tier-mythic,
    .strip-pixel.tier-mythic,
    .shop-stage.tier-mythic .stage-pixel { animation: none; }
}

/* Achievements fold away inside Records: the header is the toggle. */
.records-toggle {
    width: 100%;
    background: none;
    border: 0;
    color: inherit;
    font: inherit;
    cursor: pointer;
}

.records-toggle .panel-count::after {
    content: " +";
}

.records-toggle.open .panel-count::after {
    content: " \2212";
}

.achievement-bar {
    display: block;
    height: 5px;
    margin-top: 6px;
    border-radius: var(--radius-pill);
    overflow: hidden;
    background: rgba(255, 255, 255, 0.08);
}

.achievement-bar > span {
    display: block;
    height: 100%;
    background: var(--gold);
}

/* ---------- The menu's owned-Pixel picker: ‹ › and the count ---------- */
.skin-step {
    flex: none;
    width: 44px;
    min-height: 56px;
    padding: 0;
    border-color: var(--line);
    background: rgba(255, 255, 255, 0.03);
    box-shadow: none;
    color: var(--teal);
    font-size: 26px;
}

.skin-step:disabled {
    transform: none;
    box-shadow: none;
    opacity: 0.25;
}

.skin-owned-count {
    align-self: flex-end;
    padding: 2px 8px;
    border: 1px solid var(--line);
    border-radius: var(--radius-pill);
    color: var(--muted);
    font-family: var(--font-text);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1px;
}

/* ---------- The shop: RENT / PIXELS / BOOSTERS (js/shop.js) ----------
   A stage for one Pixel at a time, tabs pinned to the bottom for thumbs. */
.shop-page {
    justify-content: flex-start;
}
.shop-page::before,
.shop-page::after {
    display: none;
}
.shop-top,
.shop-main,
.shop-tabs {
    width: min(520px, 100%);
}
/* Room for BACK (in the corner on wide screens, its own row on phones). */
.shop-top {
    display: flex;
    align-items: center;
    min-height: 44px;
}
/* Phones: the HUD strip runs across the top, so the shop starts below it. */
@media (max-width: 520px) {
    .shop-page {
        padding-top: calc(58px + var(--safe-top));
    }
    .shop-top .back-btn {
        margin-bottom: 0;
    }
}
.shop-main {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 12px 0;
}
.shop-tabs {
    position: sticky;
    bottom: 0;
    display: grid;
    /* Padding and border inside its width (it was 14px wider than the
       page, and the shop scrolled sideways on phones); minmax(0, ...) so a
       long tab name can't widen it either. */
    box-sizing: border-box;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 4px;
    padding: 6px;
    border: 1px solid var(--line);
    border-radius: 16px;
    background: var(--night);
    box-shadow: 0 -10px 30px rgba(0, 0, 0, 0.5);
}
.shop-tab {
    min-height: 52px;
    padding: 0 2px;
    border: 0;
    border-radius: 11px;
    background: none;
    color: var(--muted);
    font: 900 14px var(--font-display);
    letter-spacing: 1.5px;
    cursor: pointer;
}
/* Five tabs: tighter as the screen narrows. */
@media (max-width: 520px) {
    .shop-tab {
        font-size: 11px;
        letter-spacing: 0.3px;
    }
}
@media (max-width: 350px) {
    .shop-tab {
        font-size: 9px;
        letter-spacing: 0;
    }
}
.shop-tab.active {
    background: linear-gradient(#6affe4, #00d6b0);
    color: var(--ink);
}
.shop-tab:focus-visible,
.shop-view-toggle button:focus-visible,
.stage-nav:focus-visible,
.strip-pixel:focus-visible {
    outline: 2px solid #fff;
    outline-offset: 2px;
}

/* SINGLE / LIST */
.shop-view-toggle {
    display: flex;
    justify-content: center;
    gap: 4px;
    margin: 0 auto 12px;
    padding: 3px;
    width: max-content;
    border: 1px solid var(--line);
    border-radius: var(--radius-pill);
    background: var(--night);
}
.shop-view-toggle button {
    min-height: 32px;
    padding: 4px 14px;
    border: 0;
    border-radius: var(--radius-pill);
    background: none;
    color: var(--muted);
    font: 900 11px var(--font-display);
    letter-spacing: 1.5px;
    cursor: pointer;
}
.shop-view-toggle button.active {
    background: rgba(var(--teal-rgb), 0.16);
    color: var(--teal);
}

/* The stage: one big Pixel, its perks spelled out, its button. */
.shop-stage {
    display: grid;
    grid-template-columns: 44px 1fr 44px;
    align-items: center;
    gap: 6px;
}
#rent-stage {
    grid-template-columns: 1fr;
}
.stage-center,
#rent-stage {
    text-align: center;
}
.stage-center .tier-badge,
#rent-tier {
    margin-bottom: 10px;
}
.stage-pixel {
    position: relative;
    display: block;
    width: 140px;
    height: 140px;
    margin: 6px auto 14px;
    border-radius: 8%;
    box-shadow: 0 0 56px color-mix(in srgb, var(--tier) 65%, transparent), 0 0 0 2px color-mix(in srgb, var(--tier) 55%, transparent);
}
.stage-pixel .pixel-eye {
    width: 18%;
    height: 22%;
}
.stage-name {
    color: #fff;
    font: 900 clamp(18px, 6vw, 26px) var(--font-display);
    margin-bottom: 4px;
    white-space: nowrap; /* one line, so a long name can't push things down */
    overflow: hidden;
    text-overflow: ellipsis;
}
/* SINGLE: BUY sits right under the perks; the room kept for the longest
   perk list in the shop (--perk-gap rows) goes under the button, so flipping
   between Pixels doesn't move the strip. */
.shop-stage .stage-center .stage-perks {
    display: block;
    width: fit-content;
    max-width: 100%;
    margin-left: auto;
    margin-right: auto;
}
.stage-room {
    height: calc(var(--perk-gap, 0) * 1.75 * 14px);
}
.need-bar.is-empty {
    visibility: hidden;
}

/* Short phones: a smaller Pixel and less room kept for long perk lists,
   so its button clears the tabs. */
@media (max-height: 700px) {
    .stage-pixel {
        width: 96px;
        height: 96px;
        margin: 4px auto 10px;
    }
}
.stage-perks {
    display: inline-block;
    margin: 10px 0 4px;
    padding: 0;
    list-style: none;
    color: #dfe6f3;
    font: 500 14px var(--font-text);
    text-align: left;
}
.stage-perks li {
    margin: 6px 0;
}
.stage-perks .perk-tag {
    margin-right: 6px;
}
.stage-cta {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
    margin-top: 10px;
}
.stage-cta .btn {
    min-width: 160px;
}
.shop-cta.cant-afford {
    --k: var(--muted);
    --k-rgb: 147, 160, 184;
}
.shop-cta.is-equipped {
    --k: var(--tier-uncommon);
    --k-rgb: 123, 216, 143;
}
.stage-note,
.stage-owned {
    margin-top: 8px;
    color: var(--muted);
    font: 600 13px var(--font-text);
    letter-spacing: 0.5px;
    text-align: center;
}
.stage-owned {
    color: var(--teal);
}
.stage-nav {
    height: 88px;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: var(--glass);
    color: var(--teal);
    font: 900 34px var(--font-display);
    cursor: pointer;
}
.stage-strip {
    display: flex;
    justify-content: safe center;
    gap: 7px;
    margin-top: 12px;
    /* Room for the owned check and the equipped ring (it scrolls, so it clips). */
    padding: 7px 7px 4px;
    overflow-x: auto;
}
.strip-pixel {
    position: relative;
    flex: none;
    padding: 4px;
    border: 2px solid transparent;
    border-bottom: 3px solid var(--tier);
    border-radius: 8px;
    background: var(--glass);
    cursor: pointer;
}
/* Can't afford it yet: dimmed. */
.strip-pixel.short {
    opacity: 0.45;
}
/* The one on the stage: a white frame. */
.strip-pixel.active {
    border-color: #fff;
    opacity: 1;
}
/* Equipped: a teal ring. */
.strip-pixel.equipped {
    box-shadow: 0 0 0 2px var(--teal), 0 0 10px rgba(var(--teal-rgb), 0.5);
}
/* Owned: a check badge in the corner. */
.strip-check {
    position: absolute;
    top: -6px;
    right: -6px;
    display: grid;
    place-items: center;
    width: 15px;
    height: 15px;
    border-radius: 50%;
    background: var(--teal);
    color: var(--ink);
}
.strip-check .ico {
    width: 10px;
    height: 10px;
}
/* RENT: what renting is, above the timer. */
.stage-what {
    margin-top: 10px;
    color: var(--text);
    font: 600 14px var(--font-text);
}
.strip-pixel-body {
    position: relative;
    display: block;
    width: 22px;
    height: 22px;
    border-radius: 8%;
}

/* Gems still to go for a Pixel you can't afford yet. */
.need-bar {
    position: relative;
    height: 16px;
    margin: 8px auto 0;
    max-width: 260px;
    border-radius: 4px;
    background: rgba(255, 255, 255, 0.07);
    overflow: hidden;
}
.need-bar > span {
    display: block;
    height: 100%;
    background: linear-gradient(90deg, rgba(var(--gem-rgb), 0.35), rgba(var(--gem-rgb), 0.7));
}
.need-bar > b {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #fff;
    font: 700 11px var(--font-text);
    letter-spacing: 0.5px;
}

/* A Pixel's level: LV n, a bar to the next one, the gems into it. Same
   size as the need bar it takes the place of. */
.lvl-bar {
    position: relative;
    display: flex;
    align-items: center;
    gap: 6px;
    height: 16px;
    margin: 8px auto 0;
    max-width: 260px;
    font: 700 11px var(--font-text);
    letter-spacing: 0.5px;
    color: #fff;
}
.lvl-bar > b {
    flex: none;
    font: 900 11px var(--font-display);
    letter-spacing: 1px;
}
.lvl-bar > em {
    flex: none;
    font-style: normal;
    color: var(--muted);
}
.lvl-track {
    flex: 1;
    height: 8px;
    border-radius: 4px;
    background: rgba(255, 255, 255, 0.09);
    overflow: hidden;
}
.lvl-track > i {
    display: block;
    height: 100%;
    background: linear-gradient(90deg, rgba(var(--gem-rgb), 0.45), rgb(var(--gem-rgb)));
}
/* Flair at levels 5 / 10 / 15: the badge glows, and the Pixel on the menu. */
.lvl-flair-1 > b { color: var(--tier-rare); text-shadow: 0 0 8px var(--tier-rare); }
.lvl-flair-2 > b { color: var(--tier-epic); text-shadow: 0 0 8px var(--tier-epic); }
.lvl-flair-3 > b { color: var(--gold); text-shadow: 0 0 10px var(--gold); }
#skin-preview-box.lvl-flair-1 { box-shadow: 0 0 0 2px var(--tier-rare), 0 0 14px var(--tier-rare); }
#skin-preview-box.lvl-flair-2 { box-shadow: 0 0 0 2px var(--tier-epic), 0 0 18px var(--tier-epic); }
#skin-preview-box.lvl-flair-3 { box-shadow: 0 0 0 2px var(--gold), 0 0 22px var(--gold); }

/* PACKS */
.pack-list {
    display: flex;
    flex-direction: column;
    gap: 10px;
}
.pack-card {
    --pack: var(--tier-rare);
    display: grid;
    grid-template-columns: 56px minmax(0, 1fr) auto;
    align-items: center;
    gap: 10px;
    padding: 10px;
    border: 1px solid var(--line);
    border-radius: 14px;
    background: rgba(255, 255, 255, 0.04);
}
.pack-card.pack-medium, .pack-stage.pack-medium { --pack: var(--tier-epic); }
.pack-card.pack-large, .pack-stage.pack-large { --pack: var(--gold); }
.pack-art, .pack-box {
    position: relative;
    width: 52px;
    height: 52px;
    border-radius: 12px;
    background: linear-gradient(135deg, var(--pack), rgba(0, 0, 0, 0.55));
    box-shadow: 0 0 14px var(--pack);
}
.pack-art > i, .pack-box > i {
    position: absolute;
    inset: 40% 12% auto;
    height: 4px;
    border-radius: 2px;
    background: rgba(255, 255, 255, 0.8);
}
.pack-name {
    font: 900 13px var(--font-display);
    letter-spacing: 1.5px;
    color: var(--pack);
}
.pack-line {
    margin: 4px 0 0;
    color: var(--text);
    font: 600 12px/1.35 var(--font-text);
}
.pack-odds {
    margin-top: 4px;
    color: var(--muted);
    font: 600 12px var(--font-text);
}
.pack-odds summary {
    display: inline-block;
    padding: 2px 0;
    color: var(--teal);
    font: 900 11px var(--font-display);
    letter-spacing: 1px;
    cursor: pointer;
    list-style: none;
}
.pack-odds summary::-webkit-details-marker { display: none; }
.pack-odds summary::after { content: " +"; }
.pack-odds[open] summary::after { content: " \2212"; }
.pack-odds table {
    width: 100%;
    margin-top: 4px;
    border-collapse: collapse;
}
.pack-odds td {
    padding: 2px 0;
    border-top: 1px solid var(--line);
    color: var(--text);
}
.pack-odds td + td {
    color: var(--muted);
    text-align: right;
    font-variant-numeric: tabular-nums;
}
.pack-open {
    min-height: 44px;
    white-space: nowrap;
}
.pack-note {
    margin: 10px 2px 0;
    color: var(--muted);
    font: 500 12px var(--font-text);
    text-align: center;
}
@media (max-width: 520px) {
    /* The button goes under the odds, so none of them is cut off. */
    .pack-card { grid-template-columns: 44px minmax(0, 1fr); gap: 8px 10px; padding: 10px; }
    .pack-art { width: 40px; height: 40px; }
    .pack-open { grid-column: 1 / -1; }
}

/* The opening. */
.pack-reveal {
    position: fixed;
    inset: 0;
    z-index: 60;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(2, 5, 12, 0.88);
    cursor: pointer;
}
.pack-reveal[hidden] { display: none; }
.pack-stage {
    --pack: var(--tier-rare);
    --rar: var(--tier-rare);
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: min(360px, 92vw);
    min-height: 320px;
}
.pack-stage.rar-uncommon { --rar: var(--tier-uncommon, #9aa7bd); }
.pack-stage.rar-rare { --rar: var(--tier-rare); }
.pack-stage.rar-epic { --rar: var(--tier-epic); }
.pack-stage.rar-legendary { --rar: var(--gold); }
.pack-stage.rar-mythic { --rar: var(--pixel); }
.pack-stage .pack-box { width: 120px; height: 120px; border-radius: 22px; position: absolute; }
.pack-stage .pack-box > i { height: 8px; border-radius: 4px; }
.pack-stage.is-waiting .pack-box { animation: pack-shake 0.5s ease-in-out infinite; }
.pack-stage.is-open .pack-box { animation: pack-burst var(--reveal, 600ms) ease-in forwards; }
.pack-rays {
    position: absolute;
    width: 340px;
    height: 340px;
    border-radius: 50%;
    background: repeating-conic-gradient(from 0deg, var(--rar) 0 6deg, transparent 6deg 18deg);
    -webkit-mask-image: radial-gradient(circle, #000 0 20%, transparent 70%);
    mask-image: radial-gradient(circle, #000 0 20%, transparent 70%);
    opacity: 0;
    animation: pack-rays 6s linear var(--reveal, 600ms) infinite, pack-fade 0.4s ease-out var(--reveal, 600ms) forwards;
}
.pack-stage.pack-small .pack-rays { display: none; }
.pack-prize {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    padding: 22px 26px;
    border: 2px solid var(--rar);
    border-radius: 18px;
    background: rgba(7, 11, 20, 0.94);
    box-shadow: 0 0 40px var(--rar);
    text-align: center;
    opacity: 0;
    animation: pack-prize var(--reveal, 600ms) cubic-bezier(0.2, 1.3, 0.4, 1) var(--reveal, 600ms) forwards;
}
.pack-prize-main { font: 900 22px var(--font-display); letter-spacing: 1.5px; color: #fff; }
.pack-prize-sub { font: 700 12px var(--font-text); letter-spacing: 1.5px; color: var(--muted); }
.pack-prize-pixel { position: relative; display: block; width: 72px; height: 72px; border-radius: 10px; }
.pack-prize-pixel .pixel-eye { width: 18%; height: 22%; }
.pack-dup { font: 700 12px var(--font-text); color: var(--gem); }
.pack-close { margin-top: 6px; font: 700 10px var(--font-text); letter-spacing: 2px; color: var(--muted); }
@keyframes pack-shake {
    0%, 100% { transform: translateX(0) rotate(0); }
    25% { transform: translateX(-6px) rotate(-4deg); }
    75% { transform: translateX(6px) rotate(4deg); }
}
@keyframes pack-burst {
    0% { transform: scale(1); opacity: 1; }
    60% { transform: scale(1.5) rotate(8deg); opacity: 1; filter: brightness(2); }
    100% { transform: scale(2.4); opacity: 0; filter: brightness(4); }
}
@keyframes pack-prize {
    from { opacity: 0; transform: scale(0.4); }
    to { opacity: 1; transform: scale(1); }
}
@keyframes pack-rays { to { transform: rotate(360deg); } }
@keyframes pack-fade { to { opacity: 0.35; } }
@media (prefers-reduced-motion: reduce) {
    .pack-stage.is-waiting .pack-box, .pack-rays { animation: none; }
    .pack-stage.is-open .pack-box { display: none; }
    .pack-prize { opacity: 1; animation: none; }
}

/* LIST: every shop Pixel, grouped by tier, cheapest first. */
.shop-list-tier {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 16px 2px 8px;
    color: var(--tier);
    font: 900 12px var(--font-display);
    letter-spacing: 2px;
}
.shop-list-tier::after {
    content: "";
    flex: 1;
    height: 1px;
    background: linear-gradient(90deg, var(--tier), transparent);
}
.shop-list-tier.tier-mythic span {
    background: linear-gradient(90deg, var(--tier-mythic), var(--gold), var(--tier-mythic)) 0 0 / 200% 100%;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
}
.shop-row {
    display: grid;
    grid-template-columns: 52px 1fr auto;
    align-items: center;
    gap: 12px;
    margin-bottom: 8px;
    padding: 10px 12px;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-left: 3px solid var(--tier);
    border-radius: 10px;
    background: var(--glass);
}
.shop-row.equipped {
    box-shadow: 0 0 0 1px var(--tier-uncommon);
}
.shop-row-pixel {
    position: relative;
    display: block;
    width: 52px;
    height: 52px;
    border-radius: 8%;
    box-shadow: 0 0 14px color-mix(in srgb, var(--tier) 50%, transparent);
}
.shop-row-name {
    margin-bottom: 4px;
    color: #fff;
    font: 900 15px var(--font-display);
}
.shop-row-perks {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
}
.shop-row-mid .need-bar {
    margin-left: 0;
}
.shop-row-cta .btn {
    min-width: 108px;
    min-height: 44px;
}

/* BOOSTERS */
.booster-slots {
    display: grid;
    /* Side by side where two fit their buttons; stacked on phones. */
    grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
    gap: 14px;
}
.booster-slot {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    padding: 22px 12px 16px;
    border: 1px solid var(--line);
    border-top: 3px solid var(--pixel);
    border-radius: 12px;
    background: var(--glass);
    text-align: center;
}
.booster-slot--gem {
    border-top-color: var(--gem);
}
.booster-ico {
    width: 44px;
    height: 44px;
}
.heart-pips {
    display: flex;
    gap: 6px;
    margin: 4px 0 2px;
}
.heart-pip {
    width: 30px;
    height: 30px;
    color: rgba(255, 255, 255, 0.14);
}
.heart-pip.free,
.heart-pip.bought {
    color: var(--pixel);
    filter: drop-shadow(0 0 6px rgba(var(--pixel-rgb), 0.7));
}
.booster-extra {
    color: var(--warn);
    font: 700 12px var(--font-text);
    letter-spacing: 0.5px;
}
.booster-n {
    color: #fff;
    font: 900 40px var(--font-display);
}
.booster-n small {
    color: var(--muted);
    font-size: 18px;
}
.booster-label {
    color: var(--muted);
    font: 700 12px var(--font-text);
    letter-spacing: 1px;
}
.booster-desc {
    margin: 2px 0 8px;
    color: var(--muted);
    font: 500 13px var(--font-text);
}
.booster-slot .btn {
    margin-top: auto;
    min-height: 44px;
}

/* Soft accounts (js/account.js): the recovery code in SAVE DATA, the box to
   type another device's code into, and a replay-checked board row. */
.save-account,
.save-delete {
    display: flex;
    flex-direction: column;
    gap: 8px;
}
/* DELETE SAVE DATA's question, set off from the account above it. */
.save-delete,
.save-backup-actions:has(> .btn--danger:only-child) {
    margin-top: 8px;
    padding-top: 12px;
    border-top: 1px solid var(--line);
}
.save-account[hidden],
.save-move[hidden],
.save-backup-note[hidden],
.save-backup-actions[hidden] {
    display: none;
}
.save-account-label {
    color: var(--muted);
    font-family: var(--font-display);
    font-size: 11px;
    letter-spacing: 1px;
    text-align: left;
}
.save-account-code,
.save-move-input {
    box-sizing: border-box;
    width: 100%;
    padding: 10px 8px;
    border: 1px solid rgba(var(--teal-rgb), 0.45);
    border-radius: 8px;
    background: rgba(0, 0, 0, 0.45);
    color: #fff;
    font-family: ui-monospace, 'SFMono-Regular', Consolas, monospace;
    font-size: 17px;
    letter-spacing: 2px;
    text-align: center;
    user-select: all;
}
.save-move-input {
    text-transform: uppercase;
}
.save-move {
    display: flex;
    flex-direction: column;
    gap: 8px;
}
.save-move .btn {
    width: 100%;
}
.lb-ok {
    color: var(--teal);
}
.lb-ok .ico {
    width: 11px;
    height: 11px;
    vertical-align: -1px;
}
.lb-review {
    margin-left: 4px;
    color: var(--muted);
    font-family: var(--font-display);
    font-size: 9px;
    letter-spacing: 1px;
    white-space: nowrap;
}
.lb-mode-title {
    margin-top: 8px;
    color: var(--gold);
    font-family: var(--font-display);
    font-size: 12px;
    letter-spacing: 1px;
    text-align: left;
}


/* ---- tools/portable/portable.css ---- */
/* Portable-build-only UI (js/portable.js). tools/build-portable.mjs appends
   this file to the inlined <style>; the web build never sees it. Keep every
   value on the site's existing tokens and classes. */

/* The update chip sits at the bottom of the menu page. The portable menu has
   no site links under it, so nothing else competes for that space. */
.portable-update {
    position: absolute;
    left: 50%;
    bottom: calc(14px + var(--safe-bottom));
    z-index: 5;
    display: flex;
    align-items: center;
    gap: 4px;
    max-width: calc(100% - 24px);
    padding: 5px 6px 5px 14px;
    border: 1px solid rgba(var(--teal-rgb), 0.55);
    border-radius: var(--radius-pill);
    background: rgba(2, 8, 16, 0.94);
    box-shadow: 0 0 16px rgba(var(--teal-rgb), 0.22);
    transform: translateX(-50%);
}
.portable-update[hidden] {
    display: none;
}
.portable-update-link {
    color: var(--teal);
    font-family: var(--font-display);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 1px;
    text-decoration: none;
    white-space: nowrap;
}
.portable-update-link:hover,
.portable-update-link:focus-visible {
    color: #fff;
}
.portable-update-dismiss {
    flex: none;
    width: 26px;
    height: 26px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: transparent;
    color: var(--muted);
    font: inherit;
    font-size: 16px;
    line-height: 1;
    cursor: pointer;
}
.portable-update-dismiss:hover,
.portable-update-dismiss:focus-visible {
    background: rgba(255, 255, 255, 0.08);
    color: #fff;
}

/* Settings: the check row (VERSION and status styles live in style.css). */
.portable-check-row {
    display: flex;
    flex-direction: column;
    gap: 6px;
}

