// for one-shot feats. Reaching a Pixel's unlock height is not an achievement:
// it is a NEW PIXEL moment (Game.checkPixelUnlocks()).
const ACHIEVEMENTS = [
    { id: '1km', name: 'Kilometer Club', desc: 'Reach 1,000m in one run',
      condition: (state, player) => state.score - (state.startMeters || 0) * 10 >= 10000,
      progress: (state) => state.bestHeight / 1000 },
    { id: '5km', name: 'Stratosphere', desc: 'Reach 5,000m in one run',
      condition: (state, player) => state.score - (state.startMeters || 0) * 10 >= 50000,
      progress: (state) => state.bestHeight / 5000 },
    { id: 'magnet', name: 'Attractive', desc: 'Pick up a MAGNET power-up',
      condition: (state, player) => player.activePower && player.activePower.name === "MAGNET" },
    { id: 'pacifist', name: 'Pacifist Pilot', desc: 'Reach 5,000m without collecting a power-up',
      condition: (state, player) => state.score - (state.startMeters || 0) * 10 >= 50000 && state.powersCollected === 0 },
    { id: 'boss', name: 'Titan Slayer', desc: 'Beat a boss',
      condition: (state, player) => state.loops >= 1 },
    { id: 'rich', name: 'Data Hoarder', desc: 'Hold 100 gems',
      condition: (state, player) => state.gems >= 100,
      progress: (state) => state.gems / 100 }
];

