.save-move-input {
    text-transform: uppercase;
}
.save-move {
    display: flex;
    flex-direction: column;
    gap: 8px;
}
.save-move .btn {
    width: 100%;
}
.lb-ok {
    color: var(--teal);
}
.lb-ok .ico {
    width: 11px;
    height: 11px;
    vertical-align: -1px;
}
.lb-review {
    margin-left: 4px;
    color: var(--muted);
    font-family: var(--font-display);
    font-size: 9px;
    letter-spacing: 1px;
    white-space: nowrap;
}
.lb-mode-title {
    margin-top: 8px;
    color: var(--gold);
    font-family: var(--font-display);
    font-size: 12px;
    letter-spacing: 1px;
    text-align: left;
}


