<script>/* ---- js/saves.js ---- */
// Save data shared by the site and the portable build: the backup code format
// (also used by the old-host save transfer) and the rules for what may be
// written back, plus the SAVE DATA section of Settings (SaveBackupUI, at the
// end; it touches the DOM only when mount()/build() run).
//
// The code is base64url JSON: { v: 1, d: { lp_key: "value", ... } }. The
// transfer hash (js/migrate.js) uses this format. The SAVE DATA backup codes
// (site and portable build) wrap the same string in an encrypted envelope, so
// they are not interchangeable with the site transfer hash.

// The daily ghost is large and only good for today; everything else moves.
const SAVE_TRANSFER_SKIP = ['lp_ghost'];
const SAVE_TRANSFER_MAX_VALUE = 64 * 1024;
const SAVE_TRANSFER_MAX_TOTAL = 256 * 1024;

function bytesToBase64Url(bytes) {
    let bin = '';
    // Chunked: one apply() for a 500 KB array can exceed the argument limit.
    for (let i = 0; i < bytes.length; i += 0x8000) {
        bin += String.fromCharCode.apply(null, bytes.subarray(i, i + 0x8000));
    }
    return btoa(bin).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
}

function base64UrlToBytes(text) {
    const bin = atob(text.replace(/-/g, '+').replace(/_/g, '/'));
    const out = new Uint8Array(bin.length);
    for (let i = 0; i < bin.length; i++) out[i] = bin.charCodeAt(i);
    return out;
}

function toBase64Url(text) {
    return bytesToBase64Url(new TextEncoder().encode(text));
}

function fromBase64Url(s) {
    return new TextDecoder().decode(base64UrlToBytes(s));
}

function exportSaves(storage) {
    const d = {};
    for (let i = 0; i < storage.length; i++) {
        const key = storage.key(i);
        if (key && key.startsWith('lp_') && !SAVE_TRANSFER_SKIP.includes(key)) d[key] = storage.getItem(key);
    }
    return Object.keys(d).length ? toBase64Url(JSON.stringify({ v: 1, d })) : '';
}

// A save that has actually been played. A fresh origin writes a few keys on
// its first load (achievements, flags), which don't count.
function hasProgress(storage) {
    return ['lp_best_height', 'lp_best', 'lp_gems'].some(k => (parseInt(storage.getItem(k)) || 0) > 0);
}

function progressOf(get) {
    return { height: parseInt(get('lp_best_height')) || 0, gems: parseInt(get('lp_gems')) || 0 };
}

// Returns true if saves were written. A device that already has progress is
// only replaced when the transferred save is ahead (higher best or more gems)
// and the player agrees through ask(message); a stale code can't roll anyone
// back without asking.
function importSaves(storage, payload, ask = null) {
    let data;
    try { data = JSON.parse(fromBase64Url(payload)); } catch (e) { return false; }
    if (!data || data.v !== 1 || !data.d || typeof data.d !== 'object' || Array.isArray(data.d)) return false;
    const entries = Object.entries(data.d);
    let total = 0;
    for (const [k, v] of entries) {
        // Save keys mix case (lp_boughtBoost).
        if (!/^lp_[A-Za-z0-9_]+$/.test(k) || SAVE_TRANSFER_SKIP.includes(k)) return false;
        if (typeof v !== 'string' || v.length > SAVE_TRANSFER_MAX_VALUE) return false;
        total += v.length;
    }
    if (!entries.length || total > SAVE_TRANSFER_MAX_TOTAL) return false;
    const replacing = hasProgress(storage);
    if (replacing) {
        const here = progressOf(k => storage.getItem(k));
        const old = progressOf(k => data.d[k]);
        if (old.height <= here.height && old.gems <= here.gems) return false;
        if (typeof ask !== 'function' || !ask(
            'Replace the progress on this device (best ' + here.height + 'm, ' + here.gems + ' gems) ' +
            'with your save from the old site (best ' + old.height + 'm, ' + old.gems + ' gems)?')) return false;
    }
    try {
        // A replace drops this device's own saves first so nothing mixes in.
        const stale = [];
        for (let i = 0; replacing && i < storage.length; i++) {
            const key = storage.key(i);
            if (key && key.startsWith('lp_') && !SAVE_TRANSFER_SKIP.includes(key) && !(key in data.d)) stale.push(key);
        }
        for (const key of stale) storage.removeItem(key);
        for (const [k, v] of entries) storage.setItem(k, v);
    } catch (e) { return false; }
    return true;
}

// Save-code envelope, used by the site and the portable build alike:
// 'PJSAVE1.' + base64url(IV || AES-256-GCM(exportSaves())).
//
// HARDENING BOOKMARK (2026-10-21): the key below ships inside this file, and the
// real save is plain localStorage. This only stops casual editing of a copied
// code; a determined player can recover the key or edit localStorage directly.
// If cheating becomes a real problem, validate scores server-side in
// cloudflare/score-worker/ and/or offer passphrase-derived codes
// (PBKDF2 + AES-GCM, with no stored key). Do not treat this as anti-cheat.
//
// Never change these fragments in place: bump the prefix and keep the old
// decrypt path if the key ever has to rotate.
const SAVE_CODE_PREFIX = 'PJSAVE1.';
const SAVE_CODE_KEY_PARTS = [
    'pixel-jump',
    '::portable-save::',
    'v1',
    '::backup'
];
const SAVE_CODE_IV_BYTES = 12;
const SAVE_CODE_TAG_BITS = 128;
const SAVE_CODE_MAX_CODE = 1024 * 1024;

function saveCodeCrypto() {
    return typeof crypto !== 'undefined' && crypto && crypto.subtle &&
        typeof crypto.getRandomValues === 'function' ? crypto : null;
}

let saveCodeKeyPromise = null;

function saveCodeKey() {
    if (!saveCodeKeyPromise) {
        const c = saveCodeCrypto();
        if (!c) return Promise.reject(new Error('no webcrypto'));
        const material = SAVE_CODE_KEY_PARTS.join('');
        saveCodeKeyPromise = c.subtle.digest('SHA-256', new TextEncoder().encode(material))
            .then(raw => c.subtle.importKey('raw', raw, { name: 'AES-GCM' }, false,
                ['encrypt', 'decrypt']))
            .catch(err => {
                saveCodeKeyPromise = null;
                throw err;
            });
    }
    return saveCodeKeyPromise;
}

async function encryptSaveCode(plain) {
    const c = saveCodeCrypto();
    if (!c) throw new Error('no webcrypto');
    const key = await saveCodeKey();
    const iv = c.getRandomValues(new Uint8Array(SAVE_CODE_IV_BYTES));
    const sealed = new Uint8Array(await c.subtle.encrypt(
        { name: 'AES-GCM', iv, tagLength: SAVE_CODE_TAG_BITS },
        key, new TextEncoder().encode(String(plain))));
    const out = new Uint8Array(iv.length + sealed.length);
    out.set(iv, 0);
    out.set(sealed, iv.length);
    return SAVE_CODE_PREFIX + bytesToBase64Url(out);
}

// Returns the plaintext save code, or null for anything that is not a valid
// envelope from this version. Never falls back to treating the input as plain
// base64: old codes are rejected by the UI on purpose.
async function decryptSaveCode(code) {
    if (typeof code !== 'string' || !code.startsWith(SAVE_CODE_PREFIX)) return null;
    if (code.length > SAVE_CODE_MAX_CODE) return null;
    const c = saveCodeCrypto();
    if (!c) return null;
    let bytes;
    try { bytes = base64UrlToBytes(code.slice(SAVE_CODE_PREFIX.length)); }
    catch (e) { return null; }
    if (bytes.length <= SAVE_CODE_IV_BYTES) return null;
    const iv = bytes.subarray(0, SAVE_CODE_IV_BYTES);
    const sealed = bytes.subarray(SAVE_CODE_IV_BYTES);
    try {
        const plain = await c.subtle.decrypt(
            { name: 'AES-GCM', iv, tagLength: SAVE_CODE_TAG_BITS },
            await saveCodeKey(), sealed);
        return new TextDecoder().decode(plain);
    } catch (e) {
        return null;
    }
}

// The SAVE DATA section of Settings, shared by the site and the portable build
// (never CrazyGames, which has its own cloud save backups). The portable build
// calls build() from js/portable.js; the site calls mount(). Codes move saves
// between the site's addresses and the portable copy in both directions. The
// caller supplies the note text, the "secure page" hint and how to reload.
const SaveBackupUI = {
    saveStatus: null,
    saveBusy: false,

    resetSection: null,

    reset() {
        if (this.resetSection) this.resetSection();
    },

    say(text) {
        if (this.saveStatus) this.saveStatus.textContent = text;
    },

    // Web: adds the section to Settings, once. The portable build calls build() itself.
    mount() {
        if (PLATFORM !== 'web' || this.saveStatus || typeof document === 'undefined') return false;
        const close = document.getElementById('settings-close-btn');
        if (!close || !close.parentNode || typeof close.parentNode.insertBefore !== 'function') return false;
        close.parentNode.insertBefore(this.build({
            note: 'The code carries your best height, gems, Pixels and records, and moves them between this site and the portable copy. It is locked to Pixel Jump: an edited or damaged code will not restore.',
            secureHint: 'OPEN THE SITE OVER HTTPS',
            reload: () => { try { location.reload(); } catch (e) { /* no reload */ } }
        }), close);
        return true;
    },

    build(opts) {
        const { note: noteText, secureHint, reload } = opts;
        const section = document.createElement('div');
        section.className = 'save-backup';

        const title = document.createElement('div');
        title.className = 'save-backup-title';
        title.textContent = 'SAVE DATA';

        const actions = document.createElement('div');
        actions.className = 'save-backup-actions';
        const backup = document.createElement('button');
        backup.type = 'button';
        backup.className = 'btn';
        backup.textContent = 'BACK UP SAVE';
        const restore = document.createElement('button');
        restore.type = 'button';
        restore.className = 'btn';
        restore.textContent = 'RESTORE SAVE';
        actions.appendChild(backup);
        actions.appendChild(restore);

        const code = document.createElement('textarea');
        code.className = 'save-backup-code';
        code.readOnly = true;
        code.spellcheck = false;
        code.hidden = true;
        code.setAttribute('aria-label', 'Save backup code');

        const tools = document.createElement('div');
        tools.className = 'save-backup-actions';
        tools.hidden = true;
        const copy = document.createElement('button');
        copy.type = 'button';
        copy.className = 'btn';
        copy.textContent = 'COPY';
        const download = document.createElement('button');
        download.type = 'button';
        download.className = 'btn';
        download.textContent = 'DOWNLOAD .TXT';
        tools.appendChild(copy);
        tools.appendChild(download);

        const restoreRow = document.createElement('div');
        restoreRow.className = 'save-backup-actions';
        restoreRow.hidden = true;
        const restoreNow = document.createElement('button');
        restoreNow.type = 'button';
        restoreNow.className = 'btn btn--primary';
        restoreNow.textContent = 'RESTORE THIS SAVE';
        restoreRow.appendChild(restoreNow);

        const note = document.createElement('p');
        note.className = 'save-backup-note';
        note.textContent = noteText;

        const noSecure = 'SAVE CODES NEED A SECURE PAGE \u2014 ' + secureHint;
        const saveStatus = document.createElement('div');
        saveStatus.className = 'settings-status';
        saveStatus.setAttribute('role', 'status');
        saveStatus.setAttribute('aria-live', 'polite');
        this.saveStatus = saveStatus;

        const setSaveMode = mode => {
            code.hidden = mode === 'none';
            tools.hidden = mode !== 'backup';
            restoreRow.hidden = mode !== 'restore';
            if (mode === 'none') code.value = '';
        };
        // Settings opens fresh: no old code on screen, no stale message.
        this.resetSection = () => {
            setSaveMode('none');
            saveStatus.textContent = '';
        };

        backup.addEventListener('click', async () => {
            if (this.saveBusy) return;
            if (!saveCodeCrypto()) {
                setSaveMode('none');
                this.say(noSecure);
                return;
            }
            let payload = '';
            try { payload = exportSaves(localStorage); } catch (e) { payload = ''; }
            if (!payload) {
                setSaveMode('none');
                this.say('NO SAVE DATA YET');
                return;
            }
            this.saveBusy = true;
            backup.disabled = true;
            restore.disabled = true;
            try {
                code.value = await encryptSaveCode(payload);
                code.readOnly = true;
                setSaveMode('backup');
                this.say('BACKUP READY \u2014 COPY OR DOWNLOAD IT');
            } catch (e) {
                setSaveMode('none');
                this.say("COULDN'T BUILD A BACKUP CODE");
            } finally {
                this.saveBusy = false;
                backup.disabled = false;
                restore.disabled = false;
            }
        });

        restore.addEventListener('click', () => {
            if (this.saveBusy) return;
            if (!saveCodeCrypto()) {
                this.say(noSecure);
                return;
            }
            code.value = '';
            code.readOnly = false;
            setSaveMode('restore');
            this.say('PASTE YOUR BACKUP CODE, THEN RESTORE');
            try { code.focus(); } catch (e) { /* no focus */ }
        });

        restoreNow.addEventListener('click', async () => {
            if (this.saveBusy) return;
            // Base64url never contains whitespace; stripping it tolerates wrapped pastes.
            const payload = String(code.value || '').replace(/\s+/g, '');
            if (!payload) {
                this.say('PASTE A BACKUP CODE FIRST');
                return;
            }
            if (!payload.startsWith(SAVE_CODE_PREFIX)) {
                this.say(/^PJSAVE\d+\./.test(payload)
                    ? 'THIS CODE IS FROM ANOTHER VERSION'
                    : 'THIS CODE IS FROM AN OLDER VERSION AND CANNOT BE RESTORED');
                return;
            }
            if (!saveCodeCrypto()) {
                this.say(noSecure);
                return;
            }
            this.saveBusy = true;
            restoreNow.disabled = true;
            try {
                const plain = await decryptSaveCode(payload);
                if (!plain) {
                    this.say("COULDN'T RESTORE THAT CODE");
                    return;
                }
                let ok = false;
                try {
                    ok = importSaves(localStorage, plain,
                        typeof confirm === 'function' ? m => confirm(m) : null);
                } catch (e) { ok = false; }
                if (!ok) {
                    this.say("COULDN'T RESTORE THAT CODE");
                    return;
                }
                this.say('SAVE RESTORED \u2014 RELOADING\u2026');
                reload();
            } finally {
                this.saveBusy = false;
                restoreNow.disabled = false;
            }
        });

        copy.addEventListener('click', () => {
            const text = String(code.value || '');
            const done = () => this.say('COPIED');
            const fallback = () => {
                try {
                    code.focus();
                    code.select();
                    if (document.execCommand && document.execCommand('copy')) { done(); return; }
                } catch (e) { /* no selection or clipboard */ }
                this.say('COPY FAILED \u2014 SELECT THE CODE');
            };
            if (typeof navigator !== 'undefined' && navigator.clipboard && navigator.clipboard.writeText) {
                navigator.clipboard.writeText(text).then(done, fallback);
            } else {
                fallback();
            }
        });

        download.addEventListener('click', () => {
            try {
                const blob = new Blob([String(code.value || '')], { type: 'text/plain' });
                const url = URL.createObjectURL(blob);
                const link = document.createElement('a');
                link.href = url;
                link.download = 'pixel-jump-save.txt';
                document.body.appendChild(link);
                link.click();
                document.body.removeChild(link);
                setTimeout(() => URL.revokeObjectURL(url), 1000);
                this.say('DOWNLOAD STARTED');
            } catch (e) {
                this.say("COULDN'T DOWNLOAD \u2014 COPY THE CODE");
            }
        });

        section.appendChild(title);
        section.appendChild(actions);
        section.appendChild(code);
        section.appendChild(tools);
        section.appendChild(restoreRow);
        section.appendChild(note);
        section.appendChild(saveStatus);
        return section;
    }
};

</script>
<script>/* ---- js/perf.js ---- */
// Frame pacing: notices when the game can't keep up, and (with ?perf in the
// address) shows it.
//
// FrameMeter.frame() is called once per animation frame with the time since
// the last one. Two jobs:
//  - Lite scenery. The scenery is a couple of dozen pictures stamped on a
//    canvas each frame. On a device that can't do that at speed, so that a
//    third of the frames over a few seconds come late, the scenery drops to
//    its sky and fixed parts for the rest of the session (onLite).
//  - The ?perf meter: frames per second, late frames (over LATE_MS) and what
//    was on screen for each, with a COPY button, for chasing a stutter on
//    the machine it happens on. It costs nothing unless ?perf is there.
const LATE_MS = 25;
// A gap this long isn't slowness: the tab was hidden or the page was busy
// loading.
const AWAY_MS = 250;

class FrameMeter {
    constructor() {
        this.on = typeof location !== 'undefined' && /[?&]perf\b/.test(location.search || '');
        this.lite = false;
        this.onLite = null;
        this.frames = 0;
        this.late = 0;
        this.slow = 0;      // a decaying count of late frames
        this.worst = 0;
        this.log = [];
        this.jsSum = 0;
        this.started = 0;
        this.box = null;
        this.shownAt = 0;
    }

    // interval: ms since the last frame. jsMs: ms this frame's update and
    // draw took (only measured with ?perf). what(): a few words on what was
    // on screen, asked for only when the frame was late.
    frame(interval, jsMs, what) {
        if (!(interval > 0) || interval > AWAY_MS) {
            this.slow = 0; // back from being hidden: start the count afresh
            return;
        }
        this.frames++;
        const isLate = interval > LATE_MS;
        this.slow = this.slow * 0.985 + (isLate ? 1 : 0);
        // Steady at 22 when one frame in three is late. Not in the first
        // frames, while pictures are still being decoded.
        if (!this.lite && this.frames > 90 && this.slow > 22) {
            this.lite = true;
            if (this.onLite) this.onLite();
        }
        if (!this.on) return;
        this.jsSum += jsMs;
        if (isLate) {
            this.late++;
            this.worst = Math.max(this.worst, interval);
            if (this.log.length < 200) {
                this.log.push(Math.round((performance.now() - this.started) / 1000) + 's ' + Math.round(interval) + 'ms js' + jsMs.toFixed(1) + ' ' + what());
            }
        }
        if (!this.started) this.started = performance.now();
        if (performance.now() - this.shownAt > 500) this.show();
    }

    summary() {
        const secs = (performance.now() - this.started) / 1000;
        return {
            version: GAME_VERSION,
            seconds: Math.round(secs),
            frames: this.frames,
            fps: +(this.frames / Math.max(1, secs)).toFixed(1),
            late: this.late,
            worstMs: Math.round(this.worst),
            jsAvgMs: +(this.jsSum / Math.max(1, this.frames)).toFixed(2),
            scenery: this.lite ? 'lite' : 'full',
            screen: window.innerWidth + 'x' + window.innerHeight + ' @' + (window.devicePixelRatio || 1),
            browser: navigator.userAgent,
            lateFrames: this.log
        };
    }

    show() {
        this.shownAt = performance.now();
        if (!this.box) {
            const box = this.box = document.createElement('div');
            box.style.cssText = 'position:fixed;left:6px;bottom:6px;z-index:99999;padding:6px 8px;border-radius:6px;' +
                'background:rgba(0,0,0,0.8);color:#0fc;font:12px/1.4 ui-monospace,Menlo,monospace;white-space:pre;';
            this.text = document.createElement('div');
            const copy = document.createElement('button');
            copy.textContent = 'COPY';
            copy.style.cssText = 'margin-top:4px;padding:2px 8px;background:#0fc;color:#000;border:0;border-radius:4px;font:bold 11px ui-monospace,Menlo,monospace;cursor:pointer;';
            copy.onclick = (e) => {
                e.stopPropagation();
                const text = JSON.stringify(this.summary(), null, 1);
                const done = () => { copy.textContent = 'COPIED'; setTimeout(() => { copy.textContent = 'COPY'; }, 1200); };
                if (navigator.clipboard && navigator.clipboard.writeText) navigator.clipboard.writeText(text).then(done, () => window.prompt('Copy this:', text));
                else window.prompt('Copy this:', text);
                copy.blur();
            };
            ['click', 'pointerdown', 'mousedown', 'touchstart', 'touchend'].forEach(evt => box.addEventListener(evt, e => e.stopPropagation()));
            box.appendChild(this.text);
            box.appendChild(copy);
            document.body.appendChild(box);
        }
        const s = this.summary();
        this.text.textContent = s.fps + ' fps   late ' + s.late + ' / ' + s.frames + '   worst ' + s.worstMs + 'ms\njs ' + s.jsAvgMs + 'ms   scenery ' + s.scenery;
    }
}

