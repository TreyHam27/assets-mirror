<script>/* ---- js/sounds.js ---- */
/**
 * 8-Bit Sound System using Web Audio API
 * Generates chiptune-style sounds without external assets.
 */
class SoundManager {
    constructor() {
        this.ctx = null;
        this.master = null;
        this.volume = 0.8;
        this.muted = false;

        // Browsers only let audio start from a user gesture. Keyboard players
        // never click, and iOS can suspend the context again later, so every
        // gesture gets a (cheap) chance to create or resume it.
        const unlock = () => this.unlock();
        ['pointerdown', 'keydown', 'touchend'].forEach(evt =>
            window.addEventListener(evt, unlock, { capture: true }));
    }

    unlock() {
        if (!this.ctx) {
            const AudioCtx = window.AudioContext || window.webkitAudioContext;
            if (!AudioCtx) return;
            this.ctx = new AudioCtx();
            this.master = this.ctx.createGain();
            this.master.connect(this.ctx.destination);
            this.applyVolume();
        }
        if (this.ctx.state === 'suspended') this.ctx.resume();
    }

    setVolume(v) {
        this.volume = Math.max(0, Math.min(1, v));
        this.applyVolume();
    }

    setMuted(muted) {
        this.muted = !!muted;
        this.applyVolume();
    }

    applyVolume() {
        if (this.master) this.master.gain.value = this.muted ? 0 : this.volume;
    }

    play(type) {
        if (!this.ctx || this.muted) return;
        if (this.ctx.state === 'suspended') this.ctx.resume();

        if (type === 'jump') return this.playJump();
        if (type === 'death') return this.playDeath();
        if (type === 'hit') return this.playHit();
        if (type === 'land') return this.playLand();
        if (type === 'spring') return this.playSpring();
        if (type === 'crumble') return this.playCrumble();
        // The one-oscillator sounds below. Anything else is a typo: don't
        // build nodes that never start.
        if (!['reward', 'heart', 'heart_lost', 'powerup'].includes(type)) return;

        const osc = this.ctx.createOscillator();
        const gain = this.ctx.createGain();

        osc.connect(gain);
        gain.connect(this.master);

        const now = this.ctx.currentTime;

        switch (type) {
            case 'reward':
                // The gem / reward chirp: gems, breaking a shield or rocket, EMP,
                // boss kills and achievements.
                osc.type = 'triangle';
                osc.frequency.setValueAtTime(400, now);
                osc.frequency.exponentialRampToValueAtTime(800, now + 0.1);
                osc.frequency.exponentialRampToValueAtTime(1200, now + 0.2);
                gain.gain.setValueAtTime(0.1, now);
                gain.gain.exponentialRampToValueAtTime(0.01, now + 0.2);
                osc.start(now);
                osc.stop(now + 0.2);
                break;
            case 'heart':
                // Two soft notes up a fifth: a warm "ding-ding".
                osc.type = 'sine';
                osc.frequency.setValueAtTime(660, now);
                osc.frequency.setValueAtTime(990, now + 0.12);
                gain.gain.setValueAtTime(0.18, now);
                gain.gain.setValueAtTime(0.18, now + 0.12);
                gain.gain.exponentialRampToValueAtTime(0.01, now + 0.4);
                osc.start(now);
                osc.stop(now + 0.4);
                break;
            case 'heart_lost':
                // The gain sound flipped: down a fifth, "de-do" instead of "do-de".
                osc.type = 'sine';
                osc.frequency.setValueAtTime(990, now);
                osc.frequency.setValueAtTime(660, now + 0.12);
                gain.gain.setValueAtTime(0.18, now);
                gain.gain.setValueAtTime(0.18, now + 0.12);
                gain.gain.exponentialRampToValueAtTime(0.01, now + 0.4);
                osc.start(now);
                osc.stop(now + 0.4);
                break;
            case 'powerup':
                // A quick rising arpeggio, distinct from the gem blip.
                osc.type = 'square';
                [330, 440, 554, 660, 880].forEach((f, i) => osc.frequency.setValueAtTime(f, now + i * 0.055));
                gain.gain.setValueAtTime(0.07, now);
                gain.gain.setValueAtTime(0.07, now + 0.22);
                gain.gain.exponentialRampToValueAtTime(0.01, now + 0.32);
                osc.start(now);
                osc.stop(now + 0.32);
                break;
        }
    }

    // "Mellow": the original 150 -> 600 Hz sweep on a pure triangle, so no
    // buzz, fading out instead of clicking off.
    playJump() {
        this.voice({ wave: 'triangle', dur: 0.12, peak: 0.15, attack: 0.004, freq: [[0, 150], [0.1, 600, 'exp']] });
    }

    // A soft low thud for touching down on a platform, quiet enough to hear
    // on every landing.
    playLand() {
        this.voice({ wave: 'sine', dur: 0.09, peak: 0.1, attack: 0.003, freq: [[0, 160], [0.08, 70, 'exp']] });
    }

    // A springy "boing": a quick rise with a wobble on the way.
    playSpring() {
        this.voice({ wave: 'triangle', dur: 0.26, peak: 0.16, attack: 0.004,
                     freq: [[0, 190], [0.09, 620, 'exp'], [0.24, 420, 'exp']],
                     vibrato: { rate: 26, cents: 70, at: 0.05 } });
    }

    // A platform breaking up: a short, dull rattle.
    playCrumble() {
        this.voice({ noise: true, dur: 0.22, peak: 0.16, attack: 0.002, lowpass: [1400, 300], q: 0.7 });
    }

    // "Tumble": a noise hit, a yelp up, a wobbling 8-bit staircase down, then
    // a low thud as the player drops off screen.
    playDeath() {
        this.voice({ noise: true, dur: 0.14, peak: 0.28, attack: 0.002, bandpass: 1800, q: 0.8 });
        this.voice({ duty: 0.5, dur: 0.95, peak: 0.09, hold: 0.5, lowpass: 3000,
                     freq: [[0, 520], [0.07, 780, 'exp'], ...this.steps(780, 98, 0.1, 0.8, 16)],
                     vibrato: { rate: 14, cents: 45, at: 0.1 } });
        this.voice({ wave: 'triangle', start: 0.78, dur: 0.32, peak: 0.24, attack: 0.005, freq: [[0, 110], [0.25, 40, 'exp']] });
    }

    // "Clang": bumping the exposed boss knocks you back unhurt, so two
    // clashing metallic tones over a noise hit, like striking its armor.
    playHit() {
        this.voice({ noise: true, dur: 0.05, peak: 0.2, attack: 0.001, bandpass: 4000, q: 0.9 });
        this.voice({ duty: 0.5, dur: 0.26, peak: 0.06, attack: 0.002, lowpass: 5000, freq: [[0, 880], [0.25, 860, 'exp']] });
        this.voice({ duty: 0.25, dur: 0.22, peak: 0.05, attack: 0.002, lowpass: 5000, freq: [[0, 1245], [0.2, 1220, 'exp']] });
    }

    // One enveloped voice routed to master. Options: wave | duty | noise,
    // start, dur, peak, attack, hold, freq: [[t, hz, 'set'|'exp'|'lin']],
    // lowpass | bandpass (hz, or [from, to] swept over dur), q,
    // vibrato: { rate, cents, at }.
    voice(o) {
        const ctx = this.ctx, t0 = ctx.currentTime + (o.start || 0);
        const src = o.noise ? ctx.createBufferSource() : ctx.createOscillator();
        if (o.noise) { src.buffer = this.noiseBuffer(); src.loop = true; }
        else if (o.duty) src.setPeriodicWave(this.pulseWave(o.duty));
        else src.type = o.wave || 'square';

        let node = src;
        const sweep = o.bandpass || o.lowpass;
        if (sweep) {
            const f = ctx.createBiquadFilter();
            f.type = o.bandpass ? 'bandpass' : 'lowpass';
            if (Array.isArray(sweep)) {
                f.frequency.setValueAtTime(sweep[0], t0);
                f.frequency.exponentialRampToValueAtTime(sweep[1], t0 + o.dur);
            } else f.frequency.value = sweep;
            if (o.q) f.Q.value = o.q;
            node.connect(f);
            node = f;
        }
        const gain = ctx.createGain();
        node.connect(gain);
        gain.connect(this.master);

        (o.freq || []).forEach(([t, hz, how]) => {
            if (how === 'exp') src.frequency.exponentialRampToValueAtTime(hz, t0 + t);
            else if (how === 'lin') src.frequency.linearRampToValueAtTime(hz, t0 + t);
            else src.frequency.setValueAtTime(hz, t0 + t);
        });
        if (o.vibrato && src.detune) {
            const lfo = ctx.createOscillator(), depth = ctx.createGain();
            lfo.frequency.value = o.vibrato.rate;
            depth.gain.setValueAtTime(0, t0);
            depth.gain.linearRampToValueAtTime(o.vibrato.cents, t0 + (o.vibrato.at || 0) + 0.05);
            lfo.connect(depth);
            depth.connect(src.detune);
            lfo.start(t0);
            lfo.stop(t0 + o.dur);
        }

        const g = gain.gain, attack = o.attack || 0.004;
        g.setValueAtTime(0.0001, t0);
        g.exponentialRampToValueAtTime(o.peak, t0 + attack);
        if (o.hold) g.setValueAtTime(o.peak, t0 + attack + o.hold);
        g.exponentialRampToValueAtTime(0.0001, t0 + o.dur);
        src.start(t0);
        src.stop(t0 + o.dur + 0.02);
    }

    // NES-style pulse wave with the given duty cycle (0.125, 0.25, 0.5).
    pulseWave(duty) {
        this.waves = this.waves || {};
        if (!this.waves[duty]) {
            const n = 64, real = new Float32Array(n), imag = new Float32Array(n);
            for (let k = 1; k < n; k++) real[k] = (2 / (k * Math.PI)) * Math.sin(k * Math.PI * duty);
            this.waves[duty] = this.ctx.createPeriodicWave(real, imag);
        }
        return this.waves[duty];
    }

    noiseBuffer() {
        if (!this.noiseBuf) {
            const len = this.ctx.sampleRate, buf = this.ctx.createBuffer(1, len, len), d = buf.getChannelData(0);
            for (let i = 0; i < len; i++) d[i] = Math.random() * 2 - 1;
            this.noiseBuf = buf;
        }
        return this.noiseBuf;
    }

    // A descending staircase of 'set' pitch points, for a stepped 8-bit fall.
    steps(from, to, t0, t1, n) {
        const out = [];
        for (let i = 0; i <= n; i++) out.push([t0 + (t1 - t0) * i / n, from * Math.pow(to / from, i / n), 'set']);
        return out;
    }
}

// Create global instance
const sounds = new SoundManager();

</script>
<script>/* ---- js/background.js ---- */
/**
 * The sky behind the level: a scene per biome, all painted in code.
 *
 * Each scene (SCENES, keyed by the biome's name) is a sky gradient, a star
 * brightness, parallax "tiles" (big pictures that wrap on every edge and
 * scroll at their own speed) and an optional `fixed` part for things that
 * hold their place on screen or move on their own: the skyline the run
 * launches from, a planet's limb, a sun, embers.
 *
 * Every picture is painted once and then stamped onto the scenery canvas
 * (#bgCanvas, one pixel per game pixel) each frame: see "scenery pictures"
 * below. Nothing is painted afresh per frame, and the page itself stays
 * still during a run. Both other ways were tried and were slow where it
 * can't be seen from script: painting the scene afresh each frame, and
 * building it from page layers for the browser to blend, which kept the
 * graphics card three-quarters busy filling a high-density window.
 *
 * Everything here is drawing only. It has its own random numbers (sceneRng),
 * never the level generator's.
 */

// A small seeded generator, so a scene looks the same on every visit.
function sceneRng(seed) {
    let s = seed >>> 0;
    return () => {
        s = (s + 0x6D2B79F5) | 0;
        let t = Math.imul(s ^ (s >>> 15), 1 | s);
        t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
        return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
    };
}

function sceneCanvas(w, h) {
    const c = document.createElement('canvas');
    c.width = w;
    c.height = h;
    return c;
}

// The context for a canvas that is painted once and then drawn from. Marked
// as read-back, which keeps it on the CPU: that is where it is painted
// fastest, and Firefox otherwise paints it in its GPU process, where copying
// it back out stalled a frame (130ms for the aurora).
function paintContext(canvas) {
    return canvas.getContext('2d', { willReadFrequently: true });
}

// Calls draw(x, y) for a shape of radius r at (x, y), and again for every
// copy that pokes over an edge of the w x h tile, so the tile wraps.
function wrapShape(w, h, x, y, r, draw) {
    for (const dx of [-w, 0, w]) {
        for (const dy of [-h, 0, h]) {
            const px = x + dx, py = y + dy;
            if (px + r < 0 || px - r > w || py + r < 0 || py - r > h) continue;
            draw(px, py);
        }
    }
}

// A soft round glow fading to nothing, squashed to `sy` of its height.
function softBlob(g, x, y, r, color, sy = 1) {
    g.save();
    g.translate(x, y);
    g.scale(1, sy);
    const grad = g.createRadialGradient(0, 0, 0, 0, 0, r);
    grad.addColorStop(0, color);
    grad.addColorStop(1, 'rgba(0, 0, 0, 0)');
    g.fillStyle = grad;
    g.fillRect(-r, -r, r * 2, r * 2);
    g.restore();
}

// ------------------------------------------------------------ tile painters
// Each returns paint(g, w, h, rnd) for one tile.

function paintClouds(count, rgb, alpha, size) {
    return (g, w, h, rnd) => {
        for (let i = 0; i < count; i++) {
            const cx = rnd() * w, cy = rnd() * h;
            const puffs = 4 + Math.floor(rnd() * 4);
            for (let k = 0; k < puffs; k++) {
                const x = cx + (rnd() - 0.5) * size * 2.6, y = cy + (rnd() - 0.5) * size * 0.5;
                const r = size * (0.6 + rnd() * 0.7);
                wrapShape(w, h, x, y, r, (px, py) => softBlob(g, px, py, r, `rgba(${rgb}, ${alpha})`, 0.42));
            }
        }
    };
}

function paintBlobs(count, colors, rMin, rMax) {
    return (g, w, h, rnd) => {
        for (let i = 0; i < count; i++) {
            const x = rnd() * w, y = rnd() * h, r = rMin + rnd() * (rMax - rMin);
            const color = colors[Math.floor(rnd() * colors.length)];
            wrapShape(w, h, x, y, r, (px, py) => softBlob(g, px, py, r, color, 0.6 + rnd() * 0.4));
        }
    };
}

// Aurora curtains: rays of uneven brightness rising from a wavy lower edge,
// with a short soft glow under it. It is the heaviest tile to paint, so it
// comes as steps (a curtain each) that are run a frame apart.
function auroraSteps(g, w, h, rnd) {
    const colors = ['61, 255, 180', '255, 77, 225', '110, 160, 255'];
    const wave = Math.PI * 2 / w;
    return [0, 1, 2, 3].map(c => () => {
        const base = h * (0.22 + c * 0.2) + rnd() * 40;
        const a1 = 30 + rnd() * 30, a2 = 12 + rnd() * 14;
        const p1 = rnd() * 6, p2 = rnd() * 6, p3 = rnd() * 6;
        const k1 = 1 + Math.floor(rnd() * 2), k2 = 3 + Math.floor(rnd() * 3);
        const rgb = colors[c % colors.length];
        let ray = 0.5;
        for (let x = 0; x < w; x += 2) {
            // Each ray's brightness wanders, with the odd bright streak, and
            // eases back to where it began so the tile wraps.
            ray = Math.max(0.12, Math.min(1, ray + (rnd() - 0.5) * 0.3));
            const streak = rnd() < 0.06 ? 1.5 : 1;
            const ends = Math.min(1, x / 60, (w - x) / 60);
            const bright = (0.5 + (ray - 0.5) * ends) * streak;
            const yb = base + a1 * Math.sin(x * wave * k1 + p1) + a2 * Math.sin(x * wave * k2 + p2);
            const tall = 170 + 80 * Math.sin(x * wave * 2 + p3) + 30 * Math.sin(x * wave * 9 + p1);
            const grad = g.createLinearGradient(0, yb + 16, 0, yb - tall);
            grad.addColorStop(0, `rgba(${rgb}, 0)`);
            grad.addColorStop(0.09, `rgba(${rgb}, ${(0.3 * bright).toFixed(3)})`);
            grad.addColorStop(0.4, `rgba(${rgb}, ${(0.1 * bright).toFixed(3)})`);
            grad.addColorStop(1, `rgba(${rgb}, 0)`);
            g.fillStyle = grad;
            g.fillRect(x, yb - tall, 2, tall + 16);
        }
    });
}

function paintAurora(g, w, h, rnd) {
    auroraSteps(g, w, h, rnd).forEach(step => step());
}

function paintSatellites(g, w, h, rnd) {
    for (let i = 0; i < 5; i++) {
        const x = 40 + rnd() * (w - 80), y = 60 + rnd() * (h - 120), s = 0.8 + rnd() * 0.8;
        g.save();
        g.translate(x, y);
        g.rotate((rnd() - 0.5) * 0.9);
        g.scale(s, s);
        g.globalAlpha = 0.55;
        g.fillStyle = '#1b4f8a';
        g.fillRect(-24, -4, 16, 8);
        g.fillRect(8, -4, 16, 8);
        g.fillStyle = 'rgba(120, 200, 255, 0.5)';
        for (const px of [-20, -16, -12, 12, 16, 20]) g.fillRect(px, -4, 1, 8);
        g.fillStyle = '#9fb4c8';
        g.fillRect(-8, -5, 16, 10);
        g.fillStyle = '#ffd166';
        g.fillRect(-2, -8, 4, 3);
        g.restore();
    }
}

function paintMoon(g, w, h, rnd) {
    const x = w * 0.72, y = h * 0.3, r = 44;
    softBlob(g, x, y, r * 2.4, 'rgba(120, 190, 255, 0.10)');
    const grad = g.createRadialGradient(x - 14, y - 14, 4, x, y, r);
    grad.addColorStop(0, '#b8c6d8');
    grad.addColorStop(1, '#3d4a63');
    g.fillStyle = grad;
    g.beginPath();
    g.arc(x, y, r, 0, Math.PI * 2);
    g.fill();
    g.fillStyle = 'rgba(30, 40, 60, 0.35)';
    for (let i = 0; i < 6; i++) {
        const a = rnd() * 6.28, d = rnd() * r * 0.7;
        g.beginPath();
        g.arc(x + Math.cos(a) * d, y + Math.sin(a) * d, 3 + rnd() * 7, 0, Math.PI * 2);
        g.fill();
    }
}

function paintPlanets(g, w, h, rnd) {
    const planet = (x, y, r, light, dark, ring) => {
        softBlob(g, x, y, r * 2.2, 'rgba(255, 255, 255, 0.05)');
        if (ring) {
            g.strokeStyle = ring;
            g.lineWidth = 5;
            g.beginPath();
            g.ellipse(x, y, r * 1.9, r * 0.45, -0.35, Math.PI, Math.PI * 2);
            g.stroke();
        }
        const grad = g.createRadialGradient(x - r * 0.4, y - r * 0.4, r * 0.1, x, y, r);
        grad.addColorStop(0, light);
        grad.addColorStop(1, dark);
        g.fillStyle = grad;
        g.beginPath();
        g.arc(x, y, r, 0, Math.PI * 2);
        g.fill();
        if (ring) {
            g.beginPath();
            g.ellipse(x, y, r * 1.9, r * 0.45, -0.35, 0, Math.PI);
            g.stroke();
        }
    };
    planet(w * 0.24, h * 0.2, 46, '#ffcf8a', '#5a2a4a', 'rgba(255, 215, 150, 0.45)');
    planet(w * 0.78, h * 0.55, 24, '#9ad8ff', '#1c2f6b', null);
    planet(w * 0.36, h * 0.84, 15, '#ff9ab0', '#4a1432', null);
    // A far galaxy.
    g.save();
    g.translate(w * 0.7, h * 0.12);
    g.rotate(-0.5);
    softBlob(g, 0, 0, 90, 'rgba(190, 160, 255, 0.22)', 0.3);
    softBlob(g, 0, 0, 26, 'rgba(255, 240, 220, 0.4)', 0.6);
    g.restore();
}

function paintAsteroids(g, w, h, rnd) {
    for (let i = 0; i < 9; i++) {
        const x = 30 + rnd() * (w - 60), y = 30 + rnd() * (h - 60), r = 7 + rnd() * 13;
        g.beginPath();
        const n = 7;
        for (let k = 0; k < n; k++) {
            const a = k / n * Math.PI * 2, d = r * (0.7 + rnd() * 0.45);
            if (k) g.lineTo(x + Math.cos(a) * d, y + Math.sin(a) * d);
            else g.moveTo(x + Math.cos(a) * d, y + Math.sin(a) * d);
        }
        g.closePath();
        g.fillStyle = 'rgba(46, 44, 60, 0.9)';
        g.fill();
        g.strokeStyle = 'rgba(255, 215, 0, 0.18)';
        g.lineWidth = 1.5;
        g.stroke();
    }
}

// Jagged glowing cracks and drifting shards.
function paintRift(g, w, h, rnd) {
    const colors = ['255, 92, 244', '125, 249, 255'];
    for (let i = 0; i < 7; i++) {
        let x = 60 + rnd() * (w - 120), y = 80 + rnd() * (h - 300);
        const pts = [[x, y]];
        const steps = 5 + Math.floor(rnd() * 5);
        for (let k = 0; k < steps; k++) {
            x = Math.max(20, Math.min(w - 20, x + (rnd() - 0.5) * 90));
            y += 18 + rnd() * 34;
            pts.push([x, y]);
        }
        const rgb = colors[i % 2];
        for (const [width, alpha] of [[9, 0.07], [4, 0.16], [1.5, 0.6]]) {
            g.strokeStyle = `rgba(${rgb}, ${alpha})`;
            g.lineWidth = width;
            g.beginPath();
            pts.forEach(([px, py], k) => (k ? g.lineTo(px, py) : g.moveTo(px, py)));
            g.stroke();
        }
    }
    for (let i = 0; i < 10; i++) {
        const x = 30 + rnd() * (w - 60), y = 30 + rnd() * (h - 60), r = 8 + rnd() * 18, a = rnd() * 6.28;
        g.beginPath();
        for (let k = 0; k < 3; k++) {
            const t = a + k * 2.1 + rnd() * 0.5;
            if (k) g.lineTo(x + Math.cos(t) * r, y + Math.sin(t) * r);
            else g.moveTo(x + Math.cos(t) * r, y + Math.sin(t) * r);
        }
        g.closePath();
        g.fillStyle = 'rgba(190, 110, 255, 0.13)';
        g.fill();
        g.strokeStyle = 'rgba(230, 170, 255, 0.3)';
        g.lineWidth = 1;
        g.stroke();
    }
}

function paintWireframes(g, w, h, rnd) {
    g.lineWidth = 1.5;
    for (let i = 0; i < 12; i++) {
        const x = 40 + rnd() * (w - 80), y = 40 + rnd() * (h - 80), r = 14 + rnd() * 30, sides = 3 + Math.floor(rnd() * 3);
        const a0 = rnd() * 6.28;
        g.strokeStyle = `rgba(0, 255, 170, ${0.12 + rnd() * 0.16})`;
        g.beginPath();
        for (let k = 0; k <= sides; k++) {
            const a = a0 + k / sides * Math.PI * 2;
            if (k) g.lineTo(x + Math.cos(a) * r, y + Math.sin(a) * r);
            else g.moveTo(x + Math.cos(a) * r, y + Math.sin(a) * r);
        }
        for (let k = 0; k < sides; k++) {
            const a = a0 + k / sides * Math.PI * 2;
            g.moveTo(x, y);
            g.lineTo(x + Math.cos(a) * r, y + Math.sin(a) * r);
        }
        g.stroke();
    }
}

function paintDeadPixels(g, w, h, rnd) {
    for (let i = 0; i < 26; i++) {
        const x = Math.floor(rnd() * w / 8) * 8, y = Math.floor(rnd() * h / 8) * 8;
        const n = 2 + Math.floor(rnd() * 7);
        for (let k = 0; k < n; k++) {
            const shade = 60 + Math.floor(rnd() * 120);
            g.fillStyle = `rgba(${shade}, ${shade}, ${shade + 10}, ${0.08 + rnd() * 0.14})`;
            const bx = x + Math.floor((rnd() - 0.5) * 6) * 8, by = y + Math.floor((rnd() - 0.5) * 4) * 8;
            if (bx < 0 || by < 0 || bx > w - 8 || by > h - 8) continue;
            g.fillRect(bx, by, 8, 8);
        }
    }
}

// ------------------------------------------------------- scenery pictures
// Every piece of scenery is a picture painted once (a tile, a strip of
// gradient, a skyline) and stamped onto the scenery canvas each frame. A
// frame is a couple of dozen drawImage calls on a canvas of one pixel per
// game pixel, which the page then stretches over the window.

const TILE_W = CONFIG.WIDTH;

// A painted canvas, ready to be drawn from every frame: { img, w, h }. Where
// the browser has ImageBitmaps the picture becomes one (the cheapest thing
// to draw from, and it frees the canvas); until then, and anywhere else,
// img is the canvas itself.
function scenePicture(canvas) {
    const pic = { img: canvas, w: canvas.width, h: canvas.height, dead: false };
    if (typeof createImageBitmap === 'function') {
        createImageBitmap(canvas).then(bitmap => {
            if (pic.dead) { if (bitmap.close) bitmap.close(); return; }
            pic.img = bitmap;
        }, () => {});
    }
    return pic;
}

function dropPicture(pic) {
    if (!pic) return;
    pic.dead = true;
    if (pic.img && pic.img.close) pic.img.close();
}

// A w x h picture of a top-to-bottom gradient: stops are [offset in px,
// colour] pairs.
function gradientPicture(w, h, stops) {
    w = Math.max(1, Math.ceil(w));
    h = Math.max(1, Math.ceil(h));
    const c = sceneCanvas(w, h), g = paintContext(c);
    if (g) {
        const grad = g.createLinearGradient(0, 0, 0, h);
        for (const [at, color] of stops) grad.addColorStop(Math.max(0, Math.min(1, at / h)), color);
        g.fillStyle = grad;
        g.fillRect(0, 0, w, h);
    }
    return scenePicture(c);
}

// Where moving scenery is drawn: to the fraction of a pixel, or on whole
// pixels once Background has found that too slow (see Background.pace).
function sceneAt(n, f) {
    return f.snap ? Math.round(n) : n;
}

// Stamps a picture over the view, repeating, with its corner at (ox, oy) in
// game px. A `column` picture holds one-off things, so it only repeats up
// and down the playfield's own column.
function drawTiled(ctx, pic, v, ox, oy, column, f) {
    const w = pic.w, h = pic.h;
    ox = sceneAt(ox, f);
    oy = sceneAt(oy, f);
    const y0 = oy - Math.ceil((oy - v.top) / h) * h;
    const x0 = column ? 0 : ox - Math.ceil((ox - v.x0) / w) * w;
    const x1 = column ? w : v.x1;
    for (let y = y0; y < v.bottom; y += h) {
        for (let x = x0; x < x1; x += w) ctx.drawImage(pic.img, x, y);
    }
}

// 0 to 1 and back, eased, once every 2 * `secs` seconds (t in frames): how a
// star group twinkles and the Rift pulses.
function swing(t, secs, phase = 0) {
    const u = ((t / 60 / secs + phase) % 2 + 2) % 2;
    const k = u > 1 ? 2 - u : u;
    return k * k * (3 - 2 * k);
}

// ------------------------------------------------------------- fixed parts
// What a scene has besides its sky, stars and tiles: things that hold their
// place on screen or move on their own. Each is
//   build(st)               paint its pictures (once)
//   layout(st, v)           paint the ones that depend on the view (on
//                           every resize)
//   draw(ctx, v, a, st, f)  draw it at opacity a
//   drop(st)                let go of what layout() painted
// v is the view and f the frame (see Background). Pictures as wide as the
// view are drawn at (v.px0, v.ptop), the scenery canvas's own corner, so
// they land on whole pixels.

// The city the run launches from: two rows of towers at the foot of the
// first screen, falling away as the climb starts.
const SKYLINE_H = 330;
function buildSkyline() {
    const rows = [
        { seed: 31, body: '#0d3344', edge: '#165a6a', lit: 0.2, minH: 90, maxH: 200, drop: 0.25 },
        { seed: 32, body: '#06202e', edge: '#0f4656', lit: 0.3, minH: 60, maxH: 300, drop: 0.5 }
    ];
    return rows.map(row => {
        const c = sceneCanvas(CONFIG.WIDTH, SKYLINE_H), g = paintContext(c), rnd = sceneRng(row.seed);
        const lights = [];
        let x = 0;
        while (x < CONFIG.WIDTH) {
            const bw = Math.min(CONFIG.WIDTH - x, 26 + Math.floor(rnd() * 44));
            const bh = row.minH + rnd() * (row.maxH - row.minH);
            const top = SKYLINE_H - bh;
            g.fillStyle = row.body;
            g.fillRect(x, top, bw, bh);
            g.fillStyle = row.edge;
            g.fillRect(x, top, bw, 2);
            g.fillRect(x, top, 1, bh);
            // Windows: a grid with most of them dark.
            for (let wy = top + 8; wy < SKYLINE_H - 6; wy += 9) {
                for (let wx = x + 5; wx < x + bw - 5; wx += 7) {
                    if (rnd() > row.lit) continue;
                    g.fillStyle = rnd() < 0.7 ? 'rgba(0, 255, 204, 0.55)' : 'rgba(255, 214, 102, 0.6)';
                    g.fillRect(wx, wy, 3, 4);
                }
            }
            if (bw > 30 && rnd() < 0.5) {
                const ax = x + Math.floor(bw / 2);
                g.fillStyle = row.edge;
                g.fillRect(ax, top - 22, 2, 22);
                lights.push({ x: ax + 1, y: top - 24, phase: rnd() * 6.28 });
            }
            x += bw + (rnd() < 0.3 ? 3 : 0);
        }
        return { canvas: c, drop: row.drop, body: row.body, lights };
    });
}

const FIXED_SKYLINE = {
    build(st) {
        st.rows = buildSkyline().map(row => ({ pic: scenePicture(row.canvas), drop: row.drop, body: row.body, lights: row.lights }));
        st.pictures.push(...st.rows.map(row => row.pic));
    },
    layout(st, v) {
        // The glow of the city on the horizon.
        dropPicture(st.glow);
        st.glow = gradientPicture(v.x1 - v.x0, 260, [[0, 'rgba(0, 255, 204, 0)'], [260, 'rgba(0, 255, 204, 0.16)']]);
    },
    draw(ctx, v, a, st, f) {
        if (f.score * 0.25 > SKYLINE_H + 60 || a <= 0) return;
        const w = v.x1 - v.x0, x0 = Math.floor(v.x0 / TILE_W) * TILE_W;
        ctx.globalAlpha = a;
        const glowY = sceneAt(CONFIG.HEIGHT - 260 + f.score * 0.25, f);
        ctx.drawImage(st.glow.img, v.px0, glowY);
        if (glowY + 260 < v.bottom) {
            ctx.fillStyle = 'rgba(0, 255, 204, 0.16)';
            ctx.fillRect(v.x0, glowY + 260, w, v.bottom - glowY - 260);
        }
        const base = CONFIG.HEIGHT - SKYLINE_H;
        for (const row of st.rows) {
            const y = sceneAt(base + f.score * row.drop, f);
            if (y > v.bottom) continue;
            for (let x = x0; x < v.x1; x += TILE_W) ctx.drawImage(row.pic.img, x, y);
            // A window taller than the frame shows more city below it.
            if (y + SKYLINE_H < v.bottom) {
                ctx.fillStyle = row.body;
                ctx.fillRect(v.x0, y + SKYLINE_H - 1, w, v.bottom - y - SKYLINE_H + 1);
            }
        }
        // The warning lights on the masts, each blinking in its own time.
        ctx.fillStyle = '#ff3355';
        for (const row of st.rows) {
            const y = sceneAt(base + f.score * row.drop, f);
            if (y > v.bottom) continue;
            for (let x = x0; x < v.x1; x += TILE_W) {
                for (const l of row.lights) {
                    ctx.globalAlpha = a * (0.35 + 0.65 * Math.max(0, Math.sin(f.time * 0.05 + l.phase)));
                    ctx.fillRect(x + l.x - 1.5, y + l.y, 3, 3);
                }
            }
        }
        ctx.globalAlpha = 1;
    },
    drop(st) {
        dropPicture(st.glow);
    }
};

// The planet below Low Orbit: its limb across the foot of the screen, with
// a glowing rim of atmosphere, sinking as the climb goes on. Painted once
// per window size.
const PLANET_R = 1500, PLANET_TOP = CONFIG.HEIGHT - 190;
const FIXED_PLANET = {
    layout(st, v) {
        dropPicture(st.planet);
        const top = PLANET_TOP - 130;
        const w = Math.max(1, Math.ceil(v.x1 - v.x0)), h = Math.max(1, Math.ceil(v.bottom - top));
        const c = sceneCanvas(w, h), g = paintContext(c);
        if (g) {
            const r = PLANET_R, cx = CONFIG.WIDTH / 2, cy = PLANET_TOP + r;
            g.translate(-v.px0, -top);
            const halo = g.createRadialGradient(cx, cy, r - 6, cx, cy, r + 120);
            halo.addColorStop(0, 'rgba(90, 200, 255, 0.5)');
            halo.addColorStop(0.25, 'rgba(60, 150, 255, 0.16)');
            halo.addColorStop(1, 'rgba(60, 150, 255, 0)');
            g.fillStyle = halo;
            g.fillRect(v.x0, top, w, h);
            const body = g.createRadialGradient(cx, cy, r - 240, cx, cy, r);
            body.addColorStop(0, '#04122a');
            body.addColorStop(1, '#0c3f78');
            g.fillStyle = body;
            g.beginPath();
            g.arc(cx, cy, r, 0, Math.PI * 2);
            g.fill();
        }
        st.planet = scenePicture(c);
    },
    draw(ctx, v, a, st, f) {
        const sink = Math.max(0, f.score / 10 - 1800) * 0.16;
        if (a <= 0 || !st.planet || PLANET_TOP + sink > v.bottom) return;
        ctx.globalAlpha = a;
        ctx.drawImage(st.planet.img, v.px0, sceneAt(PLANET_TOP - 130 + sink, f));
        ctx.globalAlpha = 1;
    },
    drop(st) {
        dropPicture(st.planet);
    }
};

// The Rift's slow violet pulse.
const FIXED_RIFT = {
    build(st) {
        const c = sceneCanvas(1040, 1248), g = paintContext(c);
        if (g) softBlob(g, 520, 624, 520, 'rgba(200, 60, 255, 0.12)', 1.2);
        st.pulse = scenePicture(c);
        st.pictures.push(st.pulse);
    },
    draw(ctx, v, a, st, f) {
        if (a <= 0) return;
        ctx.globalAlpha = a * (0.167 + 0.833 * swing(f.time, 1.745));
        ctx.drawImage(st.pulse.img, CONFIG.WIDTH / 2 - 520, Math.round((v.top + v.bottom) / 2 - 624));
        ctx.globalAlpha = 1;
    }
};

// A synthwave sun on the horizon, over a dark floor (painted once per window
// size) whose grid lines roll towards you.
const SUN_HORIZON = CONFIG.HEIGHT - 150, SUN_R = 150;
const FIXED_SUN = {
    layout(st, v) {
        dropPicture(st.sun);
        const top = SUN_HORIZON - SUN_R, horizon = SUN_HORIZON, r = SUN_R, cx = CONFIG.WIDTH / 2;
        const w = Math.max(1, Math.ceil(v.x1 - v.x0)), h = Math.max(1, Math.ceil(v.bottom - top));
        const c = sceneCanvas(w, h), g = paintContext(c);
        if (g) {
            g.translate(-v.px0, -top);
            g.globalAlpha = 0.42;
            const sun = g.createLinearGradient(0, horizon - r, 0, horizon);
            sun.addColorStop(0, '#fff275');
            sun.addColorStop(0.55, '#ff5c8a');
            sun.addColorStop(1, '#b3138c');
            g.save();
            g.beginPath();
            // Sliced by widening gaps towards the horizon.
            let y = horizon - r;
            for (let i = 0; i < 9; i++) {
                const band = 30 - i * 2.4;
                g.rect(cx - r, y, r * 2, Math.max(4, band));
                y += Math.max(4, band) + 2 + i * 1.3;
                if (y > horizon) break;
            }
            g.clip();
            g.fillStyle = sun;
            g.beginPath();
            g.arc(cx, horizon, r, Math.PI, Math.PI * 2);
            g.fill();
            g.restore();
            g.globalAlpha = 0.9;
            g.fillStyle = '#00140f';
            g.fillRect(v.x0, horizon, w, v.bottom - horizon);
        }
        st.sun = scenePicture(c);
    },
    draw(ctx, v, a, st, f) {
        if (a <= 0 || !st.sun) return;
        const cx = CONFIG.WIDTH / 2, horizon = SUN_HORIZON;
        ctx.globalAlpha = a;
        ctx.drawImage(st.sun.img, v.px0, SUN_HORIZON - SUN_R);
        // The floor's lines, converging on the horizon and rolling towards you.
        ctx.globalAlpha = a * 0.4;
        ctx.strokeStyle = '#00ffaa';
        ctx.lineWidth = 1;
        ctx.beginPath();
        const far = Math.max(cx - v.x0, v.x1 - cx) * 3;
        for (let i = -18; i <= 18; i++) {
            ctx.moveTo(cx + i * 14, horizon);
            ctx.lineTo(cx + i * (far / 6), v.bottom);
        }
        const roll = (f.time * 0.012) % 1;
        for (let i = 0; i < 9; i++) {
            const t = (i + roll) / 9, ly = horizon + (v.bottom - horizon) * t * t;
            ctx.moveTo(v.x0, ly);
            ctx.lineTo(v.x1, ly);
        }
        ctx.stroke();
        ctx.globalAlpha = 1;
    },
    drop(st) {
        dropPicture(st.sun);
    }
};

// Scanlines (painted once per window size), and blocks of static that jump
// about a few times a second.
const FIXED_STATIC = {
    layout(st, v) {
        dropPicture(st.scan);
        const w = Math.max(1, Math.ceil(v.x1 - v.x0)), h = Math.max(1, Math.ceil(v.bottom - v.top));
        const c = sceneCanvas(w, h), g = paintContext(c);
        if (g) {
            g.fillStyle = 'rgba(255, 255, 255, 0.045)';
            for (let y = Math.ceil(v.ptop / 4) * 4; y < v.bottom; y += 4) g.fillRect(0, y - v.ptop, w, 1);
        }
        st.scan = scenePicture(c);
    },
    draw(ctx, v, a, st, f) {
        if (a <= 0) return;
        if (st.scan) {
            ctx.globalAlpha = a;
            ctx.drawImage(st.scan.img, v.px0, v.ptop);
        }
        const rnd = sceneRng(Math.floor(f.time / 6) + 977);
        const span = v.x1 - v.x0, tall = v.bottom - v.top;
        for (let i = 0; i < 14; i++) {
            const shade = 110 + Math.floor(rnd() * 130);
            ctx.globalAlpha = a * (0.05 + rnd() * 0.1);
            ctx.fillStyle = STATIC_SHADES[shade] || (STATIC_SHADES[shade] = 'rgb(' + shade + ', ' + shade + ', ' + shade + ')');
            ctx.fillRect(v.x0 + rnd() * span, v.top + rnd() * tall, 20 + rnd() * 130, 2 + rnd() * 9);
        }
        ctx.globalAlpha = 1;
    },
    drop(st) {
        dropPicture(st.scan);
    }
};
const STATIC_SHADES = {};

// A red glow from far below, and embers rising out of it.
const FIXED_EMBERS = {
    layout(st, v) {
        dropPicture(st.glow);
        st.glow = gradientPicture(v.x1 - v.x0, 360, [[0, 'rgba(255, 0, 60, 0)'], [360, 'rgba(255, 0, 60, 0.22)']]);
    },
    draw(ctx, v, a, st, f) {
        if (a <= 0) return;
        ctx.globalAlpha = a;
        ctx.drawImage(st.glow.img, v.px0, Math.round(v.bottom - 360));
        const tall = v.bottom - v.top + 40;
        for (let x = Math.floor(v.x0 / TILE_W) * TILE_W; x < v.x1; x += TILE_W) {
            for (let i = 0; i < 34; i++) {
                const speed = 0.5 + (i % 7) * 0.22;
                const y = v.bottom - ((i * 173.3 + f.time * speed) % tall);
                const ex = x + ((i * 97.7) % TILE_W) + Math.sin(f.time * 0.02 + i) * 18;
                const fade = (v.bottom - y) / tall;
                ctx.globalAlpha = a * (1 - fade) * 0.8;
                ctx.fillStyle = i % 3 ? '#ff3355' : '#ff9a3d';
                const size = 2 + (i % 3);
                ctx.fillRect(ex, y, size, size);
            }
        }
        ctx.globalAlpha = 1;
    },
    drop(st) {
        dropPicture(st.glow);
    }
};

// ------------------------------------------------------------------ scenes
// Tile `speed` is a share of the background scroll (which is itself half the
