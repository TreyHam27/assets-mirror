    SWEEP_WARN: 50, SWEEP: 110, SWEEP_REACH: 260,
    // Boss 3 on: SUMMON steps of warning, then SUMMON_COUNT drones (never
    // more than SUMMON_CAP drones out at once).
    SUMMON: 45, SUMMON_COUNT: 2, SUMMON_CAP: 4
};
// What the boss-th boss of a run does (BossDrone.startAttack): every boss
// dives, the 2nd adds a laser sweep, the 3rd summons drones, and from the 4th
// each dive also crumbles the platform under its target.
function bossAttacks(level) {
    const list = ['dive'];
    if (level >= 2) list.push('sweep');
    if (level >= 3) list.push('summon');
    return list;
}
// Beating the boss pays gems only (score is height, ADR-0006): a bounty
