// The perks a Pixel actually grants, in PERKS order, each with its value.
function skinPerks(ability) {
    if (!ability) return [];
    return PERKS
        .filter(p => p.active(ability[p.key]))
        .map(p => ({ perk: p, value: ability[p.key] }));
}

// The downsides a Pixel's abilities carry, in PERKS order.
function skinDownsides(ability) {
    if (!ability) return [];
    return PERKS
        .filter(p => p.downside)
        .map(p => p.downside(ability[p.key]))
        .filter(Boolean);
}

