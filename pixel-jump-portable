const REVIVE_INVULN_STEPS = 240;
// The default heart cap; heartCapFor() has the Pixel-specific one.
const MAX_HEARTS = 3;
const HEART_CAP_ROCKET = 2;
// NINJA: wall jumps allowed between landings, the sideways push each gives,
// and the frames after touching a wall in which one can still be fired.
const NINJA_WALL_JUMPS = 2;
const NINJA_WALL_PUSH = 9;
