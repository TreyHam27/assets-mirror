// multiplied by the player's own GEMS x2 perk and 2X GEMS booster, which
// stack up to GEM_MULT_MAX. The next boss is BOSS_LOOP_DISTANCE metres further on.
// Hits to kill the boss: the first one of a run takes 3, then 5, 7 and 10,
// and every boss after that stays at 10.
// The first boss of a run, BOSS_FIRST_METERS in (a mode whose bosses come
// closer than that has its first one at its own `every`).
const firstBossMeters = (every = CONFIG.BOSS_LOOP_DISTANCE) => Math.min(CONFIG.BOSS_FIRST_METERS, every);
const BOSS_HP_STEPS = [3, 5, 7, 10];
const bossHpFor = (beaten) => BOSS_HP_STEPS[Math.min(beaten || 0, BOSS_HP_STEPS.length - 1)];
const BOSS_GEM_BOUNTY = 300;
// A co-op or Versus run pays gems only for bosses beaten (docs/specs/verified-economy.md):
// each boss this player was alive for pays this flat bounty (no multipliers),
// and pickups count only towards Pixel levels.
const COOP_BOSS_BOUNTY = 2 * BOSS_GEM_BOUNTY;
// The most every gem multiplier together (a Pixel's or run perk's gemMult,
// the 2X GEMS booster, a mode's gemMult) may multiply a pickup or a bounty
// by. Without it they reached 12x, enough to buy Overclock in one run.
const GEM_MULT_MAX = 4;
const gemMultTotal = (...mults) => Math.min(GEM_MULT_MAX, mults.reduce((t, m) => t * (m || 1), 1));
