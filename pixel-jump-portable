   this file to the inlined <style>; the web build never sees it. Keep every
   value on the site's existing tokens and classes. */

/* The update chip sits at the bottom of the menu page. The portable menu has
   no site links under it, so nothing else competes for that space. */
.portable-update {
    position: absolute;
    left: 50%;
    bottom: calc(14px + var(--safe-bottom));
    z-index: 5;
    display: flex;
    align-items: center;
    gap: 4px;
    max-width: calc(100% - 24px);
    padding: 5px 6px 5px 14px;
    border: 1px solid rgba(var(--teal-rgb), 0.55);
    border-radius: var(--radius-pill);
    background: rgba(2, 8, 16, 0.94);
    box-shadow: 0 0 16px rgba(var(--teal-rgb), 0.22);
    transform: translateX(-50%);
}
