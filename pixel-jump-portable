const TURN_CREDENTIALS_URL = 'https://turn.pixeljump.online/';
const TURN_FETCH_TIMEOUT_MS = 4000;       // host/join never wait longer
const TURN_CACHE_MS = 30 * 60 * 1000;     // reuse fetched logins this long
// The Online leaderboard, today's top 3 (js/leaderboard.js): the Cloudflare Worker in
// cloudflare/score-worker/ keeps each day's three best solo climbs. If it
