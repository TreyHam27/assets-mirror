      progress: (state, game) => ownedOf(state, game) / 5 },
    { id: 'pacifist', name: 'Pure Skill', desc: 'Reach 5,000m with no power-ups',
      rewardType: 'cos', cos: 'death_ascend', reward: 0,
      condition: (state) => runMetersOf(state) >= 5000 && state.powersCollected === 0 },
    { id: '10km', name: 'Ten Thousand', desc: 'Reach 10,000m in one solo run',
      rewardType: 'cos', cos: 'hat_apex', reward: 0,
      condition: (state) => runMetersOf(state) >= 10000,
      progress: (state) => state.bestHeight / 10000 },
    { id: 'b_void', name: 'Into The Void', biome: 'The Void', desc: 'Reach The Void (13,500m)',
      rewardType: 'cos', cos: 'trail_void', reward: 0,
      condition: (state) => state.bestHeight >= BIOMES[BIOMES.length - 1].threshold,
      progress: (state) => state.bestHeight / BIOMES[BIOMES.length - 1].threshold },
    { id: 'boss25', name: 'Titan Breaker', desc: 'Beat 25 Titans in total',
      rewardType: 'cos', cos: 'boss_eclipse', reward: 0,
      condition: (state) => (state.loops || 0) >= 25,
      progress: (state) => (state.loops || 0) / 25 },
    { id: 'climb100k', name: 'Long Haul', desc: 'Climb 100,000m in total',
