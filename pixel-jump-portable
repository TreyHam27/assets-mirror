<script>/* ---- js/coop.js ---- */
// Game's co-op half: the party menu and handshake, the host's trust boundary
// and relay, enemy snapshots and their mirrors on guests, spectating, and
// co-op deaths and respawns. See "Co-op" in CLAUDE.md.
//
// GameCoop is never instantiated: app.js copies these methods onto
// Game.prototype, so `this` is always the Game.
class GameCoop {
    // The co-op menu, and the network callbacks that drive the party.
    bindCoopEvents() {
        if (!this.ui.toMpBtn) return;

        this.ui.toMpBtn.onclick = (e) => {
            if (e && e.stopPropagation) e.stopPropagation();
            this.setMenuPanel('mp');
            // Warm the relay logins so HOST/JOIN don't wait on them.
            if (window.network && window.network.prefetchRelay) window.network.prefetchRelay();
            let savedName = storageGet('lp_mp_name');
            if (savedName && !this.portalName) this.ui.mpNameInput.value = savedName.toUpperCase();
        };
        this.ui.toSpBtn.onclick = (e) => {
            if (e && e.stopPropagation) e.stopPropagation();
            this.setMenuPanel('sp');
        };

        // Names show in capitals everywhere (party list, name tags), so
        // store them that way too.
        this.ui.mpNameInput.addEventListener('input', (e) => {
            const upper = e.target.value.toUpperCase();
            if (upper !== e.target.value) e.target.value = upper;
            saveItem('lp_mp_name', upper.trim());
        });

        this.ui.mpHostBtn.onclick = async () => {
            this.setMpSetupBusy(true);
            this.setMpStatus("GENERATING CODE...", 'pending');

            try {
                let code = await window.network.host();
                this.state.isHost = true;
                this.party = [{ pid: window.network.myId, name: this.getMpName(), slot: 0, isHost: true }];
                this.ui.mpStartBtn.innerText = "START RUN";
                this.enterPartyView(code);
                this.setMpStatus("WAITING FOR PLAYERS...", 'success');
            } catch (err) {
                this.showSetupError(err, "HOST FAILED — TRY AGAIN");
            }
        };

        this.ui.mpJoinBtn.onclick = async () => {
            // Codes never contain 0/O, 1/I or L, so a typo is caught here
            // instead of after a minute of connection attempts.
            if (!normalizeRoomCode(this.ui.mpJoinInput.value)) {
                this.setMpStatus("INVALID CODE", 'danger');
                return;
            }
            this.setMpSetupBusy(true);
            this.setMpStatus("CONNECTING...", 'pending');
            try {
                await window.network.join(this.ui.mpJoinInput.value);
            } catch (err) {
                this.showSetupError(err, "CONNECTION FAILED — TRY AGAIN");
            }
        };
        this.ui.mpJoinInput.addEventListener('keydown', (e) => {
            // Not while a host/join is already under way (the button is
            // disabled then, but calling onclick directly bypasses that).
            if (e.key === 'Enter' && !this.ui.mpJoinBtn.disabled) this.ui.mpJoinBtn.onclick();
        });

        this.ui.mpStartBtn.onclick = () => {
            if (this.state.isHost && this.party.length >= 2 && !this.state.running) {
                let mpSeed = this.getDailySeed() + Math.floor(Math.random() * 10000);
                window.network.send({ type: 'start', seed: mpSeed, party: this.party });
                this.enterFullscreen();
                this.startMultiplayerGame(mpSeed);
            }
        };

        this.ui.mpLeaveBtn.onclick = () => {
            this.leaveParty("LEFT THE PARTY");
        };

        if (this.ui.mpCodeCopyBtn) {
            this.ui.mpCodeCopyBtn.onclick = (e) => {
                if (e && e.stopPropagation) e.stopPropagation();
                this.shareRoomCode();
            };
        }

        // Guest: data channel to the host is open — introduce ourselves.
        window.network.onConnected = () => {
            this.state.isHost = false;
            this.setMpStatus("SYNCHRONIZING...", 'pending');

            // Resend the introduction every second until the host acks it,
            // giving up after 10 tries (the host drops silent joiners too).
            let tries = 0;
            const sendHandshake = () => {
                if (++tries > 10) {
                    this.leaveParty("COULDN'T JOIN — TRY AGAIN", 'danger');
                    return;
                }
                window.network.send({ type: 'handshake', name: this.getMpName(), v: NET_PROTOCOL, build: GAME_VERSION });
            };
            if (this.handshakeInterval) clearInterval(this.handshakeInterval);
            this.handshakeInterval = setInterval(sendHandshake, 1000);
            sendHandshake();
        };

        window.network.onData = (data, fromId) => {
            if (!data || data.type === 'ping') return; // Silence internal heartbeats
            this.handleNetworkData(data, fromId);
        };

        // Host: a guest dropped or left.
        window.network.onPeerLeft = (pid) => {
            this.removePartyMember(pid);
        };

        // Guest: lost the host — the party (and any run) is over.
        window.network.onDisconnected = () => {
            this.endPartyRun();
            this.leaveParty("LOST CONNECTION TO HOST", 'danger');
        };

        // Errors in a live session (host/join failures come back through
        // their own promises, see showSetupError).
        window.network.onError = (err) => {
            this.setMpStatus(this.netErrorMessage(err, "CONNECTION FAILED"), 'danger');
            if (!this.inParty()) this.setMpSetupBusy(false);
        };

        window.network.onStatus = (msg) => {
            this.setMpStatus(msg, 'pending');
        };

        // Relay logins are fetched when the menu opens; reflect a failure as
        // persistent context (the action pill still reports real failures).
        window.network.onRelayChange = () => this.renderRelayNote();

        // Two-finger swipe gesture for menu transition
        if (this.ui.menusWrapper) {
            let touchStartX = 0;
            this.ui.menusWrapper.addEventListener('touchstart', (e) => {
                if (e.touches.length === 2) {
                    touchStartX = e.touches[0].clientX;
                }
            }, { passive: true });

            this.ui.menusWrapper.addEventListener('touchend', (e) => {
                // Not while the shop/records cover the menu, or mid-run.
                if (this.activeMenuPanel === 'shop' || this.activeMenuPanel === 'records' || this.state.running) { touchStartX = 0; return; }
                if (e.changedTouches.length > 0 && touchStartX !== 0) {
                    let touchEndX = e.changedTouches[0].clientX;
                    let diffX = touchEndX - touchStartX;

                    if (diffX < -50) { // Swipe left (Go to MP)
                        this.ui.toMpBtn.onclick();
                    } else if (diffX > 50) { // Swipe right (Go to Single Player)
                        this.ui.toSpBtn.onclick();
                    }
                    touchStartX = 0;
                }
            }, { passive: true });
        }
    }

    // Co-op menu status pill. `state` is one of 'pending' | 'success' | 'danger'
    // (or omitted for idle); the colors live in style.css under #mp-status.
    setMpStatus(text, state) {
        this.ui.mpStatus.innerText = text;
        if (state) this.ui.mpStatus.dataset.state = state;
        else delete this.ui.mpStatus.dataset.state;
    }

    // Persistent, passive note: only a definite relay failure shows it. A
    // pending fetch stays quiet (no flash during the normal 4s fetch), and
    // 'ready'/'disabled'/'idle' hide it. Never touches #mp-status.
    renderRelayNote() {
        const note = this.ui.mpRelayNote;
        if (!note) return;
        const state = window.network && window.network.relayState;
        note.hidden = state !== 'unavailable';
    }

    netErrorMessage(err, fallback) {
        const type = err && err.type;
        if (type === 'invalid-code') return "INVALID CODE";
        // A wrong code comes back quickly as peer-unavailable, so a timeout
        // means the host was found but no direct connection could be made:
        // usually a school or office firewall.
        if (type === 'connection-timeout') return "COULDN'T CONNECT — THIS NETWORK MAY BLOCK CO-OP";
        if (type === 'peer-unavailable') return "CODE NOT FOUND — CHECK & RETRY";
        if (type === 'signaling-timeout') return "CAN'T REACH CO-OP SERVER — NETWORK MAY BLOCK IT";
        if (['network', 'server-error', 'socket-error', 'socket-closed'].includes(type)) return "NETWORK ERROR — CHECK CONNECTION";
        return fallback;
    }

    // A host/join attempt failed. One that was cancelled (the player left or
    // started another attempt) says nothing: the newer action owns the UI.
    showSetupError(err, fallback) {
        if (err && err.type === 'cancelled') return;
        this.setMpStatus(this.netErrorMessage(err, fallback), 'danger');
        if (!this.inParty()) this.setMpSetupBusy(false);
    }

    // COPY CODE: the share sheet on phones, the clipboard elsewhere.
    async shareRoomCode() {
        const code = (window.network && window.network.code) || this.ui.mpPartyCode.innerText;
        const nav = typeof navigator !== 'undefined' ? navigator : {};
        try {
            // On CrazyGames the invite is their link, which opens the game
            // straight into this party (and never links out of the portal).
            const portalLink = portal.inviteLink({ room: code });
            if (portalLink) {
                if (nav.clipboard && nav.clipboard.writeText) {
                    await nav.clipboard.writeText(portalLink);
                    this.setMpStatus("INVITE LINK COPIED — SEND IT TO A FRIEND", 'success');
                    return;
                }
            } else if (this.coarsePointer && nav.share) {
                // Opening the link joins the party (see joinRoomFromInvite).
                const url = PLATFORM === 'web' ? SITE_URL + '?room=' + encodeURIComponent(code) : undefined;
                await nav.share({ title: 'Pixel Jump', text: `Join my Pixel Jump party! Room code: ${code}`, url });
                return;
            }
            if (nav.clipboard && nav.clipboard.writeText) {
                await nav.clipboard.writeText(code);
                this.setMpStatus("CODE COPIED — SEND IT TO A FRIEND", 'success');
                return;
            }
        } catch (e) {
            if (e && e.name === 'AbortError') return;
        }
        this.setMpStatus("ROOM CODE: " + code, 'success');
    }

    // ------------------------------------------------ portal invites/rooms
    // CrazyGames needs to know which party the player is in and whether a
    // friend could join it right now (in a party with a free seat and no
    // run under way: the host turns late joiners away). Their invite button
    // follows that. Only changes are passed on; a no-op on the web.
    syncPortalRoom() {
        if (!portal.active) return;
        const code = window.network && window.network.code;
        const key = this.inParty() && code
            ? code + (!this.state.running && this.party.length < MAX_PARTY_SIZE ? ':open' : ':shut')
            : null;
        if (key === this.portalRoomKey) return;
        const wasInRoom = !!this.portalRoomKey;
        this.portalRoomKey = key;
        if (key) portal.updateRoom(code, key.endsWith(':open'), { room: code });
        else if (wasInRoom) portal.leftRoom();
    }

    // Arrival: a CrazyGames invite link (or a ?room=CODE link on this site)
    // joins that party; CrazyGames' "play with friends" launch hosts one
    // straight away. The player's CrazyGames name is fetched first so the
    // party sees it from the start.
    async startFromPortal() {
        if (portal.active) {
            if (this.ui.mpCodeCopyBtn) this.ui.mpCodeCopyBtn.innerText = "COPY INVITE";
            this.setPortalName(await portal.username());
            portal.onAuthChange(name => this.setPortalName(name));
            portal.onJoinRoom(params => this.joinRoomFromInvite(params && params.room));
        }
        let room = (portal.inviteParams || {}).room;
        if (!room && PLATFORM === 'web' && typeof location !== 'undefined') {
            try { room = new URLSearchParams(location.search || '').get('room'); } catch (e) { room = null; }
            // A reload shouldn't join again.
            if (room && typeof history !== 'undefined' && history.replaceState) {
                history.replaceState(null, '', location.pathname + (location.search || '').replace(/([?&])room=[^&]*&?/, '$1').replace(/[?&]$/, ''));
            }
        }
        if (room) this.joinRoomFromInvite(room);
        else if (portal.isInstantMultiplayer) this.hostFromPortal();
    }

    // Logged in on CrazyGames: that username is the co-op name, so friends
    // recognise each other. Guests (null) type their own.
    setPortalName(name) {
        this.portalName = name || null;
        const input = this.ui.mpNameInput;
        input.readOnly = !!this.portalName;
        input.title = this.portalName ? 'Your CrazyGames username' : '';
        if (this.portalName) input.value = this.portalName.toUpperCase().slice(0, MP_NAME_MAX);
    }

    // Open co-op and join `code`, leaving whatever the player was doing.
    joinRoomFromInvite(code) {
        code = normalizeRoomCode(code || '');
        if (!code || this.installGated) return;
        if (this.inParty() && window.network && window.network.code === code) return;
        if (this.state.running) {
            if (this.state.multiplayer) {
                this.endPartyRun();
            } else {
                // A solo run just stops; its card would only be in the way.
                this.closePauseUI();
                this.state.running = false;
                this.gameOver();
            }
            this.closeRunCard();
        }
        if (this.inParty()) this.leaveParty("LEFT THE PARTY");
        this.ui.toMpBtn.onclick();
        this.ui.mpJoinInput.value = code;
        this.ui.mpJoinBtn.onclick();
    }

    // Host a party at once, joinable from the first moment.
    hostFromPortal() {
        if (this.inParty() || this.state.running || this.installGated) return;
        this.ui.toMpBtn.onclick();
        this.ui.mpHostBtn.onclick();
    }

    // Disables both setup actions while a host/join attempt is in flight.
    setMpSetupBusy(busy) {
        this.ui.mpHostBtn.disabled = busy;
        this.ui.mpJoinBtn.disabled = busy;
    }

    getMpName() {
        return (this.portalName || this.ui.mpNameInput.value.trim() || 'PLAYER').toUpperCase().slice(0, MP_NAME_MAX);
    }

    inParty() {
        return this.party.length > 0;
    }

    // Evaporates the name/join/host cards and reveals the party panel
    // (the animation itself lives in style.css under .in-party).
    enterPartyView(code) {
        this.ui.mpPartyCode.innerText = code || '------';
        this.ui.menuLayer2.classList.add('in-party');
        this.renderParty();
    }

    // Leaves (or, for the host, closes) the party and brings the setup
    // cards back. Safe to call when not in a party.
    leaveParty(message, state) {
        if (this.handshakeInterval) clearInterval(this.handshakeInterval);
        this.handshakeInterval = null;
        window.network.leave();
        this.party = [];
        this.state.isHost = false;
        this.syncPortalRoom();
        this.ui.menuLayer2.classList.remove('in-party');
        this.setMpSetupBusy(false);
        this.updateMpStartBtn();
        this.setMpStatus(message || "READY", state);
        this.partyEndNote = message || "LEFT THE PARTY";
        if (this.runCardOpen) this.updateRunCardActions();
    }

    renderParty() {
        const myId = window.network.myId;
        // Leader on top, everyone else under them in join order.
        const members = [...this.party].sort((a, b) => (b.isHost - a.isHost) || (a.slot - b.slot));

        const rows = members.map(m => {
            const tags = [];
            if (m.isHost) tags.push('LEADER');
            if (m.pid === myId) tags.push('YOU');
            return `<li class="mp-party-row${m.isHost ? ' is-leader' : ''}" style="--slot:${PARTY_COLORS[m.slot] || '#555'}">
                <span class="mp-party-chip"></span>
                <span class="mp-party-name">${this.escapeHtml(m.name)}</span>
                <span class="mp-party-tags">${tags.map(t => `<span class="mp-party-tag">${t}</span>`).join('')}</span>
            </li>`;
        });
        for (let i = members.length; i < MAX_PARTY_SIZE; i++) {
            rows.push(`<li class="mp-party-row is-empty">
                <span class="mp-party-chip"></span>
                <span class="mp-party-name">Open seat</span>
            </li>`);
        }

        this.ui.mpPartyList.innerHTML = rows.join('');
        this.ui.mpPartyCount.innerText = `${members.length}/${MAX_PARTY_SIZE}`;
        this.updateMpStartBtn();
        this.syncPortalRoom();
        if (this.runCardOpen) this.updateRunCardActions();
    }

    // Only the leader can start, and only with at least one other player.
    updateMpStartBtn() {
        const canStart = this.state.isHost && this.party.length >= 2 && !this.state.running;
        this.ui.mpStartBtn.style.display = canStart ? 'block' : 'none';
    }

    // Host: push the authoritative party list to every guest.
    broadcastParty() {
        window.network.send({ type: 'party', party: this.party });
        this.renderParty();
        if (!this.state.running) {
            if (this.party.length >= 2) this.setMpStatus("READY TO START", 'success');
            else this.setMpStatus("WAITING FOR PLAYERS...", 'success');
        }
    }

    // Guest: adopt the host's party list (sanitised — it's remote input).
    applyParty(list) {
        if (!Array.isArray(list)) return;
        this.party = list.slice(0, MAX_PARTY_SIZE).map(m => ({
            pid: String(m.pid),
            name: String(m.name || 'Player').slice(0, MP_NAME_MAX),
            slot: Math.max(0, Math.min(MAX_PARTY_SIZE - 1, parseInt(m.slot) || 0)),
            isHost: !!m.isHost
        }));
        for (const pid of [...this.remotePlayers.keys()]) {
            const member = this.party.find(m => m.pid === pid);
            if (!member) this.dropRemotePlayer(pid);
        }
        this.renderParty();
    }

    // Host: someone left the party (or their connection died).
    removePartyMember(pid) {
        this.party = this.party.filter(m => m.pid !== pid);
        this.dropRemotePlayer(pid);
        if (this.inParty()) this.broadcastParty();
    }

    dropRemotePlayer(pid) {
        const rp = this.remotePlayers.get(pid);
        if (!rp) return;
        this.remotePlayers.delete(pid);
        if (this.state.running && this.state.multiplayer) {
            this.notify(`${rp.name || 'A PLAYER'} LEFT`, 'warning');
            // They may have been the last one standing.
            this.checkAllDead();
        }
    }

    addRemotePlayer(member, skinIndex = 0) {
        if (!SKINS[skinIndex]) skinIndex = 0;
        const rp = new Player(CONFIG.WIDTH / 2, CONFIG.HEIGHT - 150, skinIndex);
        rp.name = member.name;
        rp.slot = member.slot;
        rp.skinIndex = skinIndex;
        rp.lastSeenT = this.state.time;
        // World heights (wy) of the pickups they've taken, so a spectator
        // sees the level the way they do.
        rp.picked = new Set();
        this.remotePlayers.set(member.pid, rp);
        return rp;
    }

    // Remote input is untrusted: keep only known fields, as finite numbers
    // in sane ranges. Returns null for a packet that's unusable.
    sanitizeSync(d) {
        const num = (v, lo, hi) => (typeof v === 'number' && Number.isFinite(v)) ? Math.max(lo, Math.min(hi, v)) : null;
        const x = num(d.x, -100, CONFIG.WIDTH + 100);
        const y = num(d.y, -1e8, 1e5);
        if (x === null || y === null) return null;
        const skinIndex = Number.isInteger(d.skinIndex) && SKINS[d.skinIndex] ? d.skinIndex : 0;
        const power = Object.values(POWERS).find(p => p.id === d.activePowerId);
        return {
            type: 'sync', x, y,
            vx: num(d.vx, -50, 50) || 0,
            vy: num(d.vy, -50, 50) || 0,
            skinIndex,
            activePowerId: power ? power.id : null,
            // Share of the power-up's time left (0-1), for the spectate HUD.
            pf: power ? (num(d.pf, 0, 1) || 0) : 0,
            // Hearts banked (decides whether hearts show in their view).
            hl: Number.isInteger(d.hl) ? Math.max(0, Math.min(heartCapFor(SKINS[skinIndex]), d.hl)) : 0
        };
    }

    // Host: a guest introduced themselves — seat them in the lowest free slot.
    handleHandshake(data, fromId) {
        if (!this.state.isHost) return;
        const net = window.network;

        // Different builds generate different levels (and may disagree on
        // the Pixel list), so they can't share a run.
        if (data.v !== NET_PROTOCOL) {
            net.sendTo(fromId, { type: 'version_mismatch', v: NET_PROTOCOL, build: GAME_VERSION });
            setTimeout(() => net.closePeer(fromId), 300);
            return;
        }

        if (this.state.running) {
            net.sendTo(fromId, { type: 'party_busy' });
            setTimeout(() => net.closePeer(fromId), 300);
            return;
        }

        let name = String(data.name || 'PLAYER').toUpperCase().slice(0, MP_NAME_MAX);
        // Two players called PLAYER become PLAYER and PLAYER 2.
        const taken = new Set(this.party.filter(m => m.pid !== fromId).map(m => m.name));
        for (let n = 2; taken.has(name); n++) {
            const suffix = ' ' + n;
            name = String(data.name || 'PLAYER').toUpperCase().slice(0, MP_NAME_MAX - suffix.length) + suffix;
        }
        let member = this.party.find(m => m.pid === fromId);
        if (!member) {
            if (this.party.length >= MAX_PARTY_SIZE) {
                net.sendTo(fromId, { type: 'party_full' });
                setTimeout(() => net.closePeer(fromId), 300);
                return;
            }
            const used = new Set(this.party.map(m => m.slot));
            let slot = 1;
            while (used.has(slot)) slot++;
            member = { pid: fromId, name, slot, isHost: false };
            this.party.push(member);
        } else {
            // Handshake retry — just refresh the name and re-ack.
            member.name = name;
        }

        net.sendTo(fromId, { type: 'handshake_ack', party: this.party, v: NET_PROTOCOL, build: GAME_VERSION });
        this.broadcastParty();
    }

    handleNetworkData(data, fromId) {
        const net = window.network;
        if (!data || typeof data.type !== 'string') return;

        // Trust boundaries: a host only takes introductions and gameplay
        // traffic from guests (never party control messages), and a guest
        // only listens to its host.
        if (this.state.isHost) {
            if (!['handshake', 'sync', 'die', 'revive', 'hit', 'stomp', 'pick'].includes(data.type)) return;
            // Gameplay only from seated players, not a joiner still being
            // introduced or one being turned away.
            if (data.type !== 'handshake' && !this.party.some(m => m.pid === fromId)) return;
        } else if (net.friendId && fromId !== net.friendId) {
            return;
        }

        if (data.type === 'sync') {
            const clean = this.sanitizeSync(data);
            if (!clean) return;
            clean.pid = this.state.isHost ? fromId : String(data.pid);
            data = clean;
        } else if (data.type === 'die' || data.type === 'revive') {
            data = { type: data.type, pid: this.state.isHost ? fromId : String(data.pid) };
        } else if (data.type === 'pick') {
            if (!Number.isInteger(data.wy) || Math.abs(data.wy) > 1e8) return;
            data = { type: 'pick', pid: this.state.isHost ? fromId : String(data.pid), wy: data.wy };
        }

        // The host is the hub: relay every guest's gameplay traffic to the
        // rest of the party (a clean copy, stamped with the sender's ID so it
        // can't be spoofed).
        if (this.state.isHost && ['sync', 'die', 'revive', 'pick'].includes(data.type)) {
            net.broadcastExcept(fromId, data);
        }

        if (data.type === 'handshake') {
            this.handleHandshake(data, fromId);
        } else if (data.type === 'handshake_ack') {
            if (this.state.isHost) return;
            if (this.handshakeInterval) clearInterval(this.handshakeInterval);
            this.handshakeInterval = null;
            if (data.v !== NET_PROTOCOL) {
                this.leaveParty(`HOST IS ON AN OLDER VERSION (${data.build || 'OLD'}, YOU ${GAME_VERSION}) — BOTH REFRESH`, 'danger');
                return;
            }
            this.applyParty(data.party);
            this.enterPartyView(net.code || net.friendId);
            this.setMpStatus("WAITING FOR LEADER TO START...", 'success');
        } else if (data.type === 'party') {
            if (!this.state.isHost) this.applyParty(data.party);
        } else if (data.type === 'party_full') {
            this.leaveParty(`PARTY IS FULL (${MAX_PARTY_SIZE}/${MAX_PARTY_SIZE})`, 'danger');
        } else if (data.type === 'version_mismatch') {
            if (!this.state.isHost) this.leaveParty(`VERSION MISMATCH (HOST ${data.build || '?'}, YOU ${GAME_VERSION}) — REFRESH THE PAGE`, 'danger');
        } else if (data.type === 'party_busy') {
            this.leaveParty("RUN IN PROGRESS — TRY AGAIN SOON", 'danger');
        } else if (data.type === 'party_closed') {
            this.endPartyRun();
            this.leaveParty("LEADER CLOSED THE PARTY", 'danger');
        } else if (data.type === 'start') {
            if (this.state.isHost || !this.inParty()) return;
            // A guest the leader counted as gone may still be climbing: close
            // that run properly (stats, run card) before the new one begins.
            this.endPartyRun();
            this.applyParty(data.party);
            this.startMultiplayerGame(data.seed);
        } else if (data.type === 'sync') {
            // Ignore stragglers from a previous run or before 'start' lands.
            if (!this.state.running || !this.state.multiplayer) return;
            let rp = this.remotePlayers.get(data.pid);
            if (!rp) {
                const member = this.party.find(m => m.pid === data.pid);
                if (!member) return;
                rp = this.addRemotePlayer(member, data.skinIndex);
            }
            if (rp.skinIndex !== data.skinIndex) {
                rp.setSkin(data.skinIndex);
                rp.skinIndex = data.skinIndex;
            }
            // Remote players glide toward their latest reported position
            // (see followRemote) instead of jumping 30 times a second; the
            // first update after spawning or reviving places them at once.
            rp.net = { x: data.x, wy: data.y, vx: data.vx, vy: data.vy, t: this.state.time };
            if (rp.snapNext !== false) {
                rp.x = data.x;
                rp.y = data.y + this.state.score;
                rp.snapNext = false;
            }
            rp.vx = data.vx;
            rp.vy = data.vy;
            rp.lastSeenT = this.state.time;
            rp.activePower = data.activePowerId ? Object.values(POWERS).find(p => p.id === data.activePowerId) : null;
            rp.powerFrac = data.pf || 0;
            rp.hearts = data.hl || 0;
        } else if (data.type === 'pick') {
            this.applyRemotePick(data);
        } else if (data.type === 'die') {
            const rp = this.remotePlayers.get(data.pid);
            if (rp && !rp.isDead) {
                rp.isDead = true;
                this.shatterPixel(rp); // everyone sees them go
            }
            this.checkAllDead();
        } else if (data.type === 'revive') {
            const rp = this.remotePlayers.get(data.pid);
            if (rp) {
                rp.isDead = false;
                rp.y = this.player.y - 100; // spawn above
                rp.snapNext = true;
                this.particles.spawn(rp.x, rp.y, PARTY_COLORS[rp.slot] || "#00ffcc", 40, "blast");
            }
        } else if (data.type === 'snap') {
            if (!this.state.isHost) this.applySnapshot(data);
        } else if (data.type === 'ps') {
            if (!this.state.isHost) this.applyProjectileSpawn(data);
        } else if (data.type === 'hit') {
            if (this.state.isHost) this.applyHitRequest(data, fromId);
        } else if (data.type === 'stomp') {
            if (this.state.isHost) this.applyStompRequest(data, fromId);
        } else if (data.type === 'boss_down') {
            if (!this.state.isHost && this.state.running && this.state.multiplayer) this.onBossDefeated();
        }
    }

    // ------------------------------------------------------ co-op enemies
    // Solo, or the co-op host: this client runs the enemies. Guests mirror
    // the host's (drawn and collided with locally, but spawned, moved and
    // killed only by the host), so the whole party faces the same drones.
    isAuthority() {
        return !this.state.multiplayer || this.state.isHost;
    }

    // Every living player (this one and the others), for enemy targeting.
    livingPlayers() {
        const list = [];
        if (!this.player.isDead) list.push({ p: this.player, slot: this.mySlot() });
        this.remotePlayers.forEach(rp => {
            if (!rp.isDead && !this.remoteAway(rp)) list.push({ p: rp, slot: rp.slot || 0 });
        });
        return list;
    }

    mySlot() {
        const me = this.party.find(m => window.network && m.pid === window.network.myId);
        return me ? me.slot : 0;
    }

    // Shooter drones aim at the closest living player.
    nearestPlayer(e) {
        let best = this.player, bestD = Infinity;
        for (const { p } of this.livingPlayers()) {
            const d = Math.hypot(p.x - e.x, p.y - e.y);
            if (d < bestD) { bestD = d; best = p; }
        }
        return best;
    }

    // The boss takes turns diving at each living player, by party slot.
    nextDiveTarget() {
        const list = this.livingPlayers().sort((a, b) => a.slot - b.slot);
        if (!list.length) return this.player;
        const pick = list[this.state.diveTurn % list.length].p;
        this.state.diveTurn++;
        return pick;
    }

    // TIME WARP slows every enemy for the whole party while anyone has it.
    partyTimeWarp() {
        const warped = p => p && !p.isDead && p.activePower === POWERS.TIME_WARP;
        if (warped(this.player)) return true;
        if (!this.state.multiplayer) return false;
        for (const rp of this.remotePlayers.values()) if (warped(rp)) return true;
        return false;
    }

    // Host: number anything new, announce new projectiles (guests fly them
    // on their own), and send an enemy snapshot 15 times a second.
    broadcastEnemies(dt) {
        const net = window.network;
        for (const e of this.enemies) if (e.nid === undefined) e.nid = ++this.nextNid;
        this.announceProjectiles();
        if (this.tick('snap', dt, NET_SNAPSHOT_FRAMES)) net.send(this.buildSnapshot());
    }

    // Host: number and announce every new bullet/meteor. Called before the
    // projectile loop too, so one that's gone in its first frame (off screen,
    // or absorbed by the host's shield) still reached the guests.
    announceProjectiles() {
        const r1 = v => Math.round(v * 10) / 10;
        for (const q of this.projectiles) {
            if (q.nid !== undefined) continue;
            q.nid = ++this.nextNid;
            window.network.send({ type: 'ps', nid: q.nid, k: q instanceof Meteor ? 1 : 0, x: r1(q.x), wy: r1(q.y - this.state.score), vx: r1(q.vx), vy: r1(q.vy) });
        }
    }

    // Enemy rows are positional arrays to keep packets small:
    //   drone/shooter [nid, 0|1, x, wy, v, hidden, warning]
    //   laser         [nid, 2, x, wy, phase, w, h]
    //   boss          [nid, 3, x, wy, state, hp, invuln, laneX, anchorWy, warning]
    // plus the ids of every live projectile (anything missing is gone).
    buildSnapshot() {
        const score = this.state.score;
        const r1 = v => Math.round(v * 10) / 10;
        const e = [];
        for (const en of this.enemies) {
            if (en.markedForDeletion || en.nid === undefined) continue;
            const wy = Math.round(en.y - score);
            if (en instanceof BossDrone) {
                e.push([en.nid, 3, r1(en.x), wy, BOSS_STATES.indexOf(en.state), en.hp, en.invuln > 0 ? 1 : 0, r1(en.laneX), Math.round(en.anchorY - score),
                    en.shootTimer < 20 ? 1 : 0]);
            } else if (en instanceof LaserDrone) {
                e.push([en.nid, 2, r1(en.x), wy, LASER_PHASES.indexOf(en.phase), en.w, en.h]);
            } else {
                e.push([en.nid, en instanceof ShooterDrone ? 1 : 0, r1(en.x), wy, r1(en.v), en.hidden ? 1 : 0,
                    en.shootTimer !== undefined && en.shootTimer < 20 ? 1 : 0]);
            }
        }
        const p = this.projectiles.filter(q => q.nid !== undefined && !q.markedForDeletion).map(q => q.nid);
        return { type: 'snap', e, p };
    }

    // Guest: bring the mirrored enemies in line with a host snapshot.
    applySnapshot(d) {
        if (!this.state.running || !this.state.multiplayer || !Array.isArray(d.e) || !Array.isArray(d.p)) return;
        const now = this.state.time;
        for (const [nid, until] of this.tombstones) if (until < now) this.tombstones.delete(nid);

        const seen = new Set();
        for (const row of d.e) {
            if (!Array.isArray(row) || !Number.isInteger(row[0]) || !row.slice(2, 4).every(Number.isFinite)) continue;
            const [nid, kind] = row;
            if (this.tombstones.has(nid)) continue;
            seen.add(nid);
            let en = this.netEnemies.get(nid);
            if (!en) {
                en = kind === 3 ? new BossDrone(row[3] + this.state.score, Number.isFinite(row[5]) ? row[5] : bossHpFor(this.state.runLoops))
                    : kind === 2 ? new LaserDrone(row[3] + this.state.score)
                    : kind === 1 ? new ShooterDrone(row[3] + this.state.score)
                    : new Drone(row[3] + this.state.score);
                en.nid = nid;
                en.x = row[2];
                this.netEnemies.set(nid, en);
                this.enemies.push(en);
                if (en instanceof BossDrone) this.state.bossActive = true;
            }
            en.net = { x: row[2], wy: row[3], v: 0, t: now };
            if (en instanceof BossDrone) {
                en.state = BOSS_STATES[row[4]] || 'hover';
                en.hp = Number.isFinite(row[5]) ? row[5] : en.hp;
                en.invuln = row[6] ? Math.max(en.invuln, 1) : 0;
                en.laneX = Number.isFinite(row[7]) ? row[7] : en.laneX;
                en.anchorY = (Number.isFinite(row[8]) ? row[8] : row[3]) + this.state.score;
                en.shootTimer = row[9] ? 10 : BOSS.VOLLEY; // the volley warning light
            } else if (en instanceof LaserDrone) {
                en.phase = LASER_PHASES[row[4]] || 'cooldown';
                en.w = Number.isFinite(row[5]) ? row[5] : en.bodyW;
                en.h = Number.isFinite(row[6]) ? row[6] : en.bodyH;
            } else {
                en.net.v = Number.isFinite(row[4]) ? row[4] : 0;
                en.v = en.net.v || en.v;
                en.hidden = !!row[5];
                if (en instanceof ShooterDrone) en.shootTimer = row[6] ? 10 : 60;
            }
        }
        for (const [nid, en] of this.netEnemies) {
            if (!seen.has(nid)) { en.markedForDeletion = true; this.netEnemies.delete(nid); }
        }
        const live = new Set(d.p);
        for (const q of this.projectiles) if (q.nid !== undefined && !live.has(q.nid)) q.markedForDeletion = true;
    }

    // Guest: a bullet or meteor the host just fired; it flies straight, so
    // the guest simulates it from here.
    applyProjectileSpawn(d) {
        if (!this.state.running || !this.state.multiplayer) return;
        if (!Number.isInteger(d.nid) || this.tombstones.has(d.nid)) return;
        if (![d.x, d.wy, d.vx, d.vy].every(Number.isFinite)) return;
        const clamp = (v, lo, hi) => Math.max(lo, Math.min(hi, v));
        const Kind = d.k === 1 ? Meteor : Projectile;
        const q = new Kind(clamp(d.x, -100, CONFIG.WIDTH + 100), d.wy + this.state.score, clamp(d.vx, -20, 20), clamp(d.vy, -20, 20));
        q.nid = d.nid;
        this.projectiles.push(q);
    }

    // Guest: ease a mirrored enemy toward where the host last had it (drones
    // are carried forward along their flight line between snapshots).
    followNetEnemy(e, dt) {
        const n = e.net;
        if (e.t !== undefined) e.t += dt;
        if (e.localInvuln > 0) e.localInvuln -= dt;
        if (!n) return;
        const ahead = Math.min(this.state.time - n.t, 8);
        const tx = n.x + (n.v || 0) * ahead;
        const ty = n.wy + this.state.score;
        if (Math.abs(tx - e.x) > 80 || Math.abs(ty - e.y) > 80) {
            e.x = tx;
            e.y = ty;
        } else {
            const k = 1 - Math.pow(0.7, dt);
            e.x += (tx - e.x) * k;
            e.y += (ty - e.y) * k;
        }
    }

    // Guest: ease a teammate toward their last reported position, carried a
    // few frames forward by their velocity.
    followRemote(rp, dt) {
        const n = rp.net;
        if (!n || rp.isDead) return;
        const ahead = Math.min(this.state.time - n.t, 6);
        const tx = n.x + n.vx * ahead;
        const ty = n.wy + this.state.score + n.vy * ahead;
        if (Math.abs(tx - rp.x) > 120 || Math.abs(ty - rp.y) > 120) {
            rp.x = tx; // screen wraps and big corrections snap
            rp.y = ty;
        } else {
            const k = 1 - Math.pow(0.6, dt);
            rp.x += (tx - rp.x) * k;
            rp.y += (ty - rp.y) * k;
        }
    }

    // A jetpack or shield took something out. On a guest the host decides:
    // hide it now (with a tombstone) and ask the host to remove it.
    destroyHostile(obj) {
        obj.markedForDeletion = true;
        if (this.isAuthority() || obj.nid === undefined) return;
        this.tombstones.set(obj.nid, this.state.time + NET_TOMBSTONE_FRAMES);
        this.netEnemies.delete(obj.nid);
        window.network.send({ type: 'hit', nid: obj.nid });
    }

    // Host: a guest's jetpack/shield kill (never the boss).
    applyHitRequest(d, fromId) {
        if (!this.state.running || !Number.isInteger(d.nid)) return;
        const target = this.enemies.find(e => e.nid === d.nid && !(e instanceof BossDrone))
            || this.projectiles.find(q => q.nid === d.nid);
        if (target && this.guestNear(fromId, target)) target.markedForDeletion = true;
    }

    // Host: is this guest, by its last sync, within reach of the target? A
    // modified client could otherwise stomp the boss from the other end of
    // the level.
    guestNear(pid, target) {
        const rp = this.remotePlayers.get(pid);
        if (!rp || !rp.net) return false;
        return Math.abs((target.y - this.state.score) - rp.net.wy) <= NET_REQUEST_REACH;
    }

    // Host: a guest landed on the boss. Its own invulnerability window
    // de-duplicates stomps from several players at once.
    applyStompRequest(d, fromId) {
        if (!this.state.running || !Number.isInteger(d.nid)) return;
        const boss = this.enemies.find(e => e instanceof BossDrone && e.nid === d.nid);
        if (boss && this.guestNear(fromId, boss)) boss.takeDamage(this.particles);
    }

    // Dead in co-op: the camera follows whoever is lowest; say who (and
    // keep them, so the power-up HUD can show theirs).
    updateSpectateHud() {
        const hud = this.ui.spectateHud;
        if (!hud) return;
        let name = null;
        let lowest = null;
        if (this.state.multiplayer && this.player.isDead) {
            this.remotePlayers.forEach(rp => {
                if (!rp.isDead && !this.remoteAway(rp) && (!lowest || rp.y > lowest.y)) lowest = rp;
            });
            if (lowest) name = lowest.name || 'PLAYER';
        }
        this.spectatingPlayer = lowest;
        if (name === this.spectating) return;
        this.spectating = name;
        hud.hidden = !name;
        if (name) hud.innerText = 'SPECTATING ' + name;
    }

    startMultiplayerGame(seed) {
        this.ui.mpStartBtn.style.display = 'none';
        this.startGame(true, seed);
        this.syncPortalRoom();
        // Every other party member starts at the spawn point; their first
        // sync packet moves them to wherever they really are.
        const myId = window.network.myId;
        this.party.forEach(m => {
            if (m.pid !== myId) this.addRemotePlayer(m);
        });
    }

    // While you're down: the level as the teammate you're watching sees it,
    // without what they've taken, and hearts only while they can bank one.
    spectatePickups(rp) {
        const hearts = (rp.hearts || 0) < heartCapFor(SKINS[rp.skinIndex] || SKINS[0]);
        return this.powerups.filter(p => !(rp.picked && rp.picked.has(p.wy)) && (hearts || !p.isHeart));
    }

    // While you're down, the teammate you're watching pulls pickups in with
    // their MAGNET (or a gem-magnet Pixel) just as on their own screen.
    pullForSpectated(rp, dt) {
        const ability = (rp.skin && rp.skin.ability) || {};
        const magnet = rp.activePower === POWERS.MAGNET;
        if (!magnet && !ability.gemMagnetRadius) return;
        this.spectatePickups(rp).forEach(p => {
            if (magnet) rp.pullPickup(p, 200, dt);
            if (p.isGem && ability.gemMagnetRadius) rp.pullPickup(p, ability.gemMagnetRadius, dt);
        });
    }

    // A teammate took a pickup. If we're watching them, show it go.
    applyRemotePick(d) {
        const rp = this.remotePlayers.get(d.pid);
        if (!rp || !rp.picked) return;
        rp.picked.add(d.wy);
        if (!this.player.isDead || this.spectatingPlayer !== rp) return;
        const p = this.powerups.find(q => q.wy === d.wy);
        if (!p) return;
        const color = p.isGem ? BIOMES[p.tier || 0].gem.color : p.isHeart ? "#ff3366" : (rp.activePower ? rp.activePower.color : "#ffffff");
        this.particles.spawn(p.x + p.w / 2, p.y + p.h / 2, color, p.isGem ? 10 : 20);
    }

    // Knocked out in co-op (no hearts left): down until the respawn timer
    // runs out, while the rest of the party plays on.
    handleMultiplayerDeath() {
        this.player.isDead = true;

        if (window.network) {
            window.network.send({ type: 'die', pid: window.network.myId });
        }

        this.checkAllDead();

        if (this.state.running) {
            this.state.deathCount = (this.state.deathCount || 0) + 1;
            this.startRespawnTimer();
        }
    }

    // A teammate whose updates stopped (tab in the background, frozen
    // browser) is "away": after REMOTE_AWAY_FRAMES they no longer steer the
    // camera or the invisible ceiling, and after REMOTE_GONE_FRAMES they count
    // as down, so a frozen avatar can't hold everyone else in place or keep a
    // finished run alive forever.
    remoteAway(rp) {
        return this.state.time - (rp.lastSeenT || 0) > REMOTE_AWAY_FRAMES;
    }

    remoteDown(rp) {
        return rp.isDead || this.state.time - (rp.lastSeenT || 0) > REMOTE_GONE_FRAMES;
    }

    // Anyone else still in the run (alive, and not gone quiet).
    anyRemoteAlive() {
        for (const rp of this.remotePlayers.values()) {
            if (!this.remoteDown(rp)) return true;
        }
        return false;
    }

    // Anyone else actively playing right now (for the camera and ceiling).
    anyRemoteActive() {
        for (const rp of this.remotePlayers.values()) {
            if (!rp.isDead && !this.remoteAway(rp)) return true;
        }
        return false;
    }

    // The run keeps going while anyone in the party is alive; it ends for
    // everybody the moment the last player falls (or leaves).
    checkAllDead() {
        if (!this.state.running || !this.state.multiplayer) return;
        if (!this.player.isDead || this.anyRemoteAlive()) return;
        this.state.running = false;
        this.stopRespawnTimer();
        // A revive prompt still open from a countdown is moot now.
        if (this.ads.reviveOverlay) this.ads.reviveOverlay.style.display = 'none';
        this.gameOver();
    }

    // Ends an in-progress multiplayer run immediately (host gone / party
    // closed), going through the normal everyone-is-dead path.
    endPartyRun() {
        if (!this.state.running || !this.state.multiplayer) return;
        this.player.isDead = true;
        this.remotePlayers.forEach(rp => { rp.isDead = true; });
        this.checkAllDead();
    }

    // Each player's respawn countdown runs on their own client, independent of
    // everyone else's, and lengthens with their own death count. It keeps
    // ticking only while the run is alive (i.e. someone is still standing).
    startRespawnTimer() {
        let baseTime = 15;
        let time = baseTime + ((this.state.deathCount - 1) * 10);

        this.showAlert(`RESPAWN IN ${time}s`, 'pulse');

        this.stopRespawnTimer();
        this.respawnInterval = setInterval(() => {
            if (!this.state.running || !this.player.isDead) {
                this.stopRespawnTimer();
                return;
            }
            time--;
            this.showAlert(`RESPAWN IN ${time}s`, 'pulse');

            if (time <= 0) {
                this.stopRespawnTimer();
                // Always free: an ad here would hold up the whole party.
                this.mpRevive();
            }
        }, 1000);
    }

    stopRespawnTimer() {
        if (this.respawnInterval) clearInterval(this.respawnInterval);
        this.respawnInterval = null;
    }

    mpRevive() {
        // The run may have ended while the revive ad was playing.
        if (!this.state.running) return;
        // Keys pressed while waiting (mashing through the prompt) must not
        // fire the moment play resumes.
        this.input.resetInput();
        this.player.isDead = false;
        const anchor = [...this.remotePlayers.values()].find(rp => !rp.isDead && !this.remoteAway(rp));
        if (anchor) {
            this.player.y = anchor.y - 100;
            this.player.x = anchor.x;
        } else {
            this.player.y = CONFIG.HEIGHT - 200;
        }
        this.player.launch(0);
        this.player.grantPower(POWERS.SHIELD);

        if (window.network) window.network.send({ type: 'revive', pid: window.network.myId });
        this.showAlert("LIFE RESTORED", 'success');
    }
}

</script>
<script>/* ---- js/shop.js ---- */
// Game's progress screens: the Pixel picker and gem shop (owning, buying and
// equipping Pixels), hearts in the shop, the Records screen, the Hall of Fame
// and achievements.
//
// GameShop is never instantiated: app.js copies these methods onto
// Game.prototype, so `this` is always the Game.
class GameShop {
    // --------------------------------------------------------------- records
    renderRecords() {
        const st = this.stats;
        const rows = [
            [fmtNum(st.runs), 'RUNS'],
            [fmtNum(this.state.bestHeight) + 'm', 'BEST HEIGHT'],
            [fmtNum(Math.round(st.meters)) + 'm', 'TOTAL CLIMBED'],
            [counted(fmtNum(st.gems), 'gem'), 'GEMS EARNED', true],
            [fmtNum(this.state.loops || 0), 'BOSSES BEATEN'],
            [fmtNum(st.powerups), 'POWER-UPS'],
            [fmtNum(st.livesLost), 'LIVES LOST'],
            [fmtDuration(st.seconds), 'TIME PLAYED']
        ];
        this.ui.recordsStats.innerHTML = this.statTilesHTML(rows);

        const earned = ACHIEVEMENTS.filter(a => this.achievements.includes(a.id)).length;
        this.ui.recordsCount.innerText = `${earned}/${ACHIEVEMENTS.length}`;
        this.ui.recordsList.innerHTML = ACHIEVEMENTS.map(a => {
            const got = this.achievements.includes(a.id);
            const frac = (!got && a.progress) ? Math.max(0, Math.min(1, a.progress(this.state))) : null;
            const bar = frac === null ? '' :
                `<span class="achievement-bar" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="${Math.floor(frac * 100)}"><span style="width:${Math.floor(frac * 100)}%"></span></span>`;
            return `<div class="achievement-row${got ? ' earned' : ''}">
                <span class="achievement-icon">${icon('medal')}</span>
                <div><span class="achievement-name">${this.escapeHtml(a.name)}</span>
                <span class="achievement-desc">${this.escapeHtml(a.desc || '')}</span>${bar}</div>
            </div>`;
        }).join('');
        this.applyAchievementsOpen();
    }

    // The Achievements section of Records: closed until the player opens it,
    // and remembered per device (lp_achievements_open).
    applyAchievementsOpen() {
        const open = !!this.achievementsOpen;
        if (this.ui.recordsList) this.ui.recordsList.hidden = !open;
        if (this.ui.recordsToggle) {
            if (this.ui.recordsToggle.setAttribute) this.ui.recordsToggle.setAttribute('aria-expanded', open ? 'true' : 'false');
            if (this.ui.recordsToggle.classList) this.ui.recordsToggle.classList.toggle('open', open);
        }
    }

    toggleAchievements() {
        this.achievementsOpen = !this.achievementsOpen;
        saveItem('lp_achievements_open', this.achievementsOpen ? '1' : '0');
        this.applyAchievementsOpen();
    }

    // Saves used to store Pixels by SKINS position; they now store SKINS ids so
    // the roster can change shape. Converts old saves once, via the order the
    // list had back then (numbers are only ever written by the old format).
    migrateSkinSaves() {
        const LEGACY_SKIN_IDS = [
            'unit734', 'ghost', 'matrix', 'deepvoid', 'golden', 'glitch', 'theend',
            'nebula', 'chrome', 'solarflare', 'obsidian', 'prism',
            'riftdiver', 'neonghost', 'staticking', 'thevoid'
        ];
        const owned = loadJSON('lp_owned_skins', null, Array.isArray);
        if (Array.isArray(owned) && owned.some(v => typeof v === 'number')) {
            const ids = owned.map(v => typeof v === 'number' ? LEGACY_SKIN_IDS[v] : v).filter(Boolean);
            saveItem('lp_owned_skins', JSON.stringify([...new Set(ids)]));
        }
        const equipped = storageGet('lp_skin');
        if (equipped !== null && /^\d+$/.test(equipped)) {
            saveItem('lp_skin', LEGACY_SKIN_IDS[parseInt(equipped, 10)] || SKINS[0].id);
        }
    }

    isSkinLocked(index = this.viewParams.skinIndex) {
        const s = SKINS[index];
        if (!s) return true;
        if (s.hourly) return !this.hourlyUnlocked(s);
        if (s.cost !== undefined) return !this.ownedSkins.includes(s.id);
        return this.state.bestHeight < s.unlock;
    }

    // The menu picker only ever offers Pixels the player can actually use:
    // locked gem Pixels live in the shop, and locked distance/secret ones stay
    // a surprise until they're earned.
    unlockedSkinIndexes() {
        return SKINS.map((s, i) => i).filter(i => !this.isSkinLocked(i));
    }

    // Selecting a Pixel equips it straight away (and survives a reload even
    // if no run is started with it).
    equipSkin(index) {
        // Putting on a Pixel of the Hour remembers what to go back to.
        const from = SKINS[this.viewParams.skinIndex];
        if (SKINS[index].hourly && from && !from.hourly) saveItem('lp_skin_prev', from.id);
        this.viewParams.skinIndex = index;
        saveItem('lp_skin', SKINS[index].id);
        this.updateSkinUI();
    }

    updateSkinUI() {
        // A saved Pixel can go missing (e.g. a cleared shop save, or a Pixel
        // of the Hour whose hour is up); never show or start a run with one
        // the player doesn't have. One worn into a run stays for that run.
        const worn = SKINS[this.viewParams.skinIndex];
        if (this.isSkinLocked() && !(this.state.running && worn && worn.hourly)) {
            this.viewParams.skinIndex = this.fallbackSkinIndex();
            saveItem('lp_skin', SKINS[this.viewParams.skinIndex].id);
            if (worn && worn.hourly) this.notify(worn.name.toUpperCase() + "'S HOUR IS UP", 'info');
        }

        const s = SKINS[this.viewParams.skinIndex];
        // Pixels of the Hour are borrowed, not collected.
        const unlockedCount = this.unlockedSkinIndexes().filter(i => !SKINS[i].hourly).length;
        const totalCount = SKINS.filter(sk => !sk.hourly).length;

        // The pattern (a Pixel of the Hour), over the body colour.
        this.ui.preview.style.background = pixelBodyCSS(s);
        this.ui.preview.style.backgroundColor = s.color;
        this.ui.eyesL.style.backgroundColor = s.eye;
        this.ui.eyesR.style.backgroundColor = s.eye;
        this.ui.skinName.innerText = s.name;
        this.ui.skinStatus.innerText = s.hourly ? "PIXEL OF THE HOUR" : "PIXELS " + unlockedCount + " / " + totalCount;

        if (this.ui.gemDisplay) this.ui.gemDisplay.innerHTML = counted(fmtNum(this.state.gems), 'gem');
        this.updateShopBadge();
        if (this.ui.skinAbility) this.ui.skinAbility.innerHTML = this.tierBadge(s) + this.renderPerkTags(s.ability);
        this.renderPixelGrid();
    }

    // The tier label: a chip in the tier's own colour (--tier-*).
    tierBadge(skin) {
        const t = pixelTier(skin);
        return `<span class="tier-badge tier-${t}">${PIXEL_TIERS[t].label}</span>`;
    }

    // Short, colour-coded perk chips shared by the menu picker and the shop.
    // The full stat text sits in a tooltip that opens on hover (CSS) or on tap
    // (the delegated handler in bindEvents), since the game runs on touch too.
    renderPerkTags(ability) {
        const perks = skinPerks(ability);
        const downs = skinDownsides(ability);
        if (!perks.length && !downs.length) return '<span class="perk-none">NO PERK</span>';
        const tag = (color, label, text) =>
            `<span class="perk-tag" style="--perk:${color};" tabindex="0">${label}` +
            `<span class="perk-tip">${text}</span></span>`;
        // Downsides are red, in the danger token.
        return perks.map(({ perk, value }) => tag(perk.color, perk.label, perk.describe(value))).join('') +
            downs.map(d => tag('var(--pixel)', d.label, d.describe)).join('');
    }

    // Every gems-purchasable skin (anything in SKINS with a `cost`), paired
    // with its SKINS index so the carousel can address it, cheapest first so
    // the carousel reads as a tier ladder.
    gemShopSkins() {
        return SKINS.map((s, i) => ({ s, i }))
            .filter(({ s }) => s.cost !== undefined)
            .sort((a, b) => a.s.cost - b.s.cost);
    }

    // ------------------------------------------------------- Pixel picker
    // One grid of every Pixel the player can see, in ALL / OWNED / SHOP / HOUR
    // tabs. Secret Pixels stay hidden until bestHeight reaches them (never
    // highScore, ADR 0004); only this hour's Pixel of the Hour is listed.
    pixelPickerRows(tab = this.pixelTab) {
        const hourNow = hourlySkinAt();
        const visible = SKINS.map((s, i) => ({ s, i })).filter(({ s }) => {
            if (s.hourly) return s === hourNow;
            if (s.secret) return this.state.bestHeight >= s.unlock;
            return true;
        });
        if (tab === 'owned') return visible.filter(({ i }) => !this.isSkinLocked(i));
        if (tab === 'shop') return visible.filter(({ s }) => s.cost !== undefined).sort((a, b) => a.s.cost - b.s.cost);
        if (tab === 'hour') return visible.filter(({ s }) => s.hourly);
        return visible;
    }

    setPixelTab(tab) {
        this.pixelTab = ['all', 'owned', 'shop', 'hour'].includes(tab) ? tab : 'all';
        this.renderPixelGrid();
    }

    openPixels(tab = 'all') {
        this.pixelTab = tab;
        this.renderPixelGrid();
        this.setMenuPanel('pixels');
    }

    // The line under a card: what it costs, where it unlocks, how long the
    // hour has left, or that it is yours.
    pixelCardStatus(s, i, now = Date.now()) {
        if (this.viewParams.skinIndex === i && !this.isSkinLocked(i)) return { text: 'EQUIPPED' };
        if (!this.isSkinLocked(i)) {
            return { text: s.hourly ? 'YOURS UNTIL ' + fmtHour(nextHourAt(now)) : 'OWNED' };
        }
        if (s.hourly) {
            const price = counted(fmtNum(hourlyPixelCost(s)), 'gem');
            return { html: price + ' <span class="js-hour-left">' + fmtClock(nextHourAt(now) - now) + '</span> LEFT', poor: this.state.gems < hourlyPixelCost(s) };
        }
        if (s.cost !== undefined) return { html: counted(fmtNum(s.cost), 'gem'), poor: this.state.gems < s.cost };
        return { text: 'UNLOCKS AT ' + fmtNum(s.unlock) + 'm' };
    }

    renderPixelGrid() {
        const grid = this.ui.pixelGrid;
        if (!grid || this.state.running) return; // the page stays still during a run (drawn again at game over)
        const tab = this.pixelTab || (this.pixelTab = 'all');
        if (this.ui.pixelTabs && this.ui.pixelTabs.querySelectorAll) {
            this.ui.pixelTabs.querySelectorAll('.pixel-tab').forEach(b => {
                b.classList.toggle('active', b.dataset.tab === tab);
            });
        }
        const rows = this.pixelPickerRows(tab);
        if (!rows.length) {
            grid.innerHTML = '<div class="pixel-empty">' + (tab === 'owned' ? 'NO PIXELS YET' : 'NOTHING HERE') + '</div>';
            return;
        }
        grid.innerHTML = rows.map(({ s, i }) => {
            const t = pixelTier(s);
            const st = this.pixelCardStatus(s, i);
            const equipped = this.viewParams.skinIndex === i && !this.isSkinLocked(i);
            return `<div class="pixel-card tier-${t}${equipped ? ' equipped' : ''}${this.isSkinLocked(i) ? ' locked' : ''}" data-index="${i}" role="button" tabindex="0">` +
                this.pixelPreviewHTML(s, 'pixel-card-pixel') +
                `<div class="pixel-card-name">${this.escapeHtml(s.name)}</div>` +
                `<span class="tier-badge">${PIXEL_TIERS[t].label}</span>` +
                `<div class="pixel-card-perks">${this.renderPerkTags(s.ability)}</div>` +
                `<div class="pixel-card-status${st.poor ? ' cant-afford' : ''}">${st.html || st.text}</div></div>`;
        }).join('');
    }

    // Once a second: the hour's time left on its card (no re-render, so an
    // open tooltip stays put).
    tickPixelGrid() {
        const grid = this.ui.pixelGrid;
        if (!grid || !grid.querySelectorAll || this.state.running) return;
        const left = fmtClock(nextHourAt() - Date.now());
        grid.querySelectorAll('.js-hour-left').forEach(el => { el.innerText = left; });
    }

    // A tap on a card: equip it if it's yours, buy it if you can, otherwise
    // say how to get it.
    pickPixel(index, card) {
        const s = SKINS[index];
        if (!s || this.state.running) return;
        if (!this.isSkinLocked(index)) {
            this.equipSkin(index);
        } else if (s.hourly) {
            this.openHourly();
        } else if (s.cost !== undefined) {
            if (this.state.gems >= s.cost) this.openBuyConfirm(index);
            else {
                this.shakeUI(card);
                this.notify('NEED ' + fmtNum(s.cost) + ' GEMS FOR ' + s.name.toUpperCase(), 'warning');
            }
        } else {
            this.shakeUI(card);
            this.notify(s.name.toUpperCase() + ' UNLOCKS AT ' + fmtNum(s.unlock) + 'm', 'info');
        }
    }

    // "Are you sure?" before gems are spent on a Pixel. BUY goes through
    // buyGemSkin(); CANCEL (or a tap beside the box) spends nothing.
    openBuyConfirm(index) {
        const s = SKINS[index];
        const ui = this.ui;
        if (!s || s.cost === undefined || !ui.buyConfirm) return;
        this.buyConfirmIndex = index;
        this.buyConfirmOpen = true;
        ui.buyConfirmPreview.innerHTML = this.pixelPreviewHTML(s, 'hourly-pixel');
        ui.buyConfirmName.innerText = s.name;
        ui.buyConfirmPerks.innerHTML = this.tierBadge(s) + this.renderPerkTags(s.ability);
        ui.buyConfirmNote.innerText = fmtNum(s.cost) + ' gems. You\'ll have ' + fmtNum(Math.max(0, this.state.gems - s.cost)) + ' left.';
        setHTML(ui.buyConfirmYes, counted(fmtNum(s.cost), 'gem') + ' BUY ' + this.escapeHtml(s.name.toUpperCase()));
        ui.buyConfirm.hidden = false;
    }

    closeBuyConfirm() {
        this.buyConfirmOpen = false;
        this.buyConfirmIndex = null;
        if (this.ui.buyConfirm) this.ui.buyConfirm.hidden = true;
    }

    confirmBuyPixel() {
        const index = this.buyConfirmIndex;
        this.closeBuyConfirm();
        if (index === null || index === undefined || this.state.running) return;
        this.buyGemSkin(index);
    }

    // Re-draws the picker after a purchase or equip (the old gem-shop name).
    renderGemShop() {
        this.renderPixelGrid();
    }

    // Something in the shop you could buy right now: a Pixel you don't own
    // yet, or a heart with room in the stock.
    shopHasAffordable() {
        const gems = this.state.gems;
        if (!this.heartStockFull() && gems >= HEART_COST) return true;
        return this.gemShopSkins().some(({ s }) => !this.ownedSkins.includes(s.id) && gems >= s.cost);
    }

    updateShopBadge() {
        const btn = this.ui.shopOpenBtn;
        if (!btn || !btn.classList) return;
        const can = this.shopHasAffordable();
        btn.classList.toggle('can-buy', can);
        const badge = btn.querySelector && btn.querySelector('.shop-badge');
        if (badge) badge.hidden = !can;
    }

    // The free run-start heart plus the bought ones fill the Pixel's cap.
    heartStockFull() {
        return this.state.hearts + 1 >= this.heartCap();
    }

    // Hearts bought here are added to the next run: the card shows how many
    // are waiting, and the button locks once they fill the Pixel's cap.
    updateHeartUI() {
        if (this.ui.shopLifeCount) this.ui.shopLifeCount.innerText = this.state.hearts;
        if (this.ui.shopLifeMax) this.ui.shopLifeMax.innerText = this.heartCap() - 1;
        const hearts = this.ui.lifeDisplay;
        if (hearts) {
            const html = counted(this.state.hearts, 'heart');
            if (hearts.innerHTML !== html && hearts.classList) {
                hearts.classList.remove('life-pop');
                void hearts.offsetWidth; // restart the animation
                hearts.classList.add('life-pop');
            }
            hearts.innerHTML = html;
            if (hearts.classList) hearts.classList.toggle('empty', this.state.hearts <= 0);
        }
        if (!this.ui.shopLifeBtn) return;

        const full = this.heartStockFull();
        const affordable = this.state.gems >= HEART_COST;
        const label = this.ui.shopLifeBtn.querySelector('.btn-label');
        const cost = this.ui.shopLifeBtn.querySelector('.btn-cost');

        if (label) label.innerText = full ? "STOCK FULL" : "BUY HEART";
        if (cost) cost.innerHTML = counted(HEART_COST, 'gem');
        this.ui.shopLifeBtn.classList.toggle('maxed', full);
        this.ui.shopLifeBtn.classList.toggle('unaffordable', !full && !affordable);
        this.ui.shopLifeBtn.disabled = full;
        this.updateShopBadge();
    }

    buyHeart() {
        if (this.heartStockFull() || this.state.gems < HEART_COST) {
            this.shakeUI(this.ui.shopLifeBtn);
            return false;
        }
        this.state.gems -= HEART_COST;
        this.state.hearts++;
        saveItem('lp_gems', this.state.gems);
        saveItem('lp_hearts', this.state.hearts);
        this.updateHeartUI();
        this.renderGemShop();
        this.updateSkinUI();
        return true;
    }

    // Buying a Pixel also equips it — that's why you bought it.
    // ------------------------------------------- 2x gems booster (ads)
    // Watching an ad makes gem pickups count double for GEM_BOOST_MS of real
    // time. It's offered only between runs, never with a party (an ad there
    // could hold everyone up), and only while no booster is running.

    loadGemBoost() {
        const until = parseInt(storageGet('lp_gem_boost_until')) || 0;
        // A clock set back can't stretch it past one booster.
        return Math.min(until, Date.now() + GEM_BOOST_MS);
    }

    gemBoostLeft(now = Date.now()) {
        return Math.max(0, (this.gemBoostUntil || 0) - now);
    }

    // A gem pickup's worth: its biome value, times a GEMS x2 perk, times the
    // booster (so Crystal Hoarder with a booster collects 4x).
    gemPickupValue(value, perks) {
        return (value || 1) * (perks.gemMult || 1) * (this.gemBoostLeft() > 0 ? 2 : 1);
    }

    canWatchGemBoost() {
        const reviveUp = this.ads.reviveOverlay && this.ads.reviveOverlay.style.display === 'flex';
        return !this.state.running && !reviveUp && !this.inParty() && !this.installGated &&
            this.gemBoostLeft() === 0 && this.ads.rewardedAvailable();
    }

    watchGemBoost() {
        if (!this.canWatchGemBoost()) return;
        this.ads.showRewarded('gem_boost', () => {
            this.gemBoostUntil = Date.now() + GEM_BOOST_MS;
            saveItem('lp_gem_boost_until', this.gemBoostUntil);
            this.notify("2x GEMS FOR 15 MINUTES", 'reward');
            sounds.play('reward');
            this.updateAdButtons();
        }, (why) => {
            if (why !== 'skipped') this.notify("NO AD RIGHT NOW", 'warning');
        });
    }

    // The booster chip under the hearts (an offer between runs, a countdown
    // while it runs) and the run card's offer. Refreshed every second.
    updateAdButtons() {
        const left = this.gemBoostLeft();
        const chip = this.ui.gemBoost;
        const canWatch = this.canWatchGemBoost();
        if (chip) {
            if (left > 0) {
                chip.hidden = false;
                chip.disabled = true;
                chip.classList.add('is-active');
                setHTML(chip, icon('gem') + 'x2 ' + fmtClock(left));
            } else if (canWatch && !this.runCardOpen) {
                chip.hidden = false;
                chip.disabled = false;
                chip.classList.remove('is-active');
                setHTML(chip, icon('play') + ' 2x ' + icon('gem'));
            } else {
                chip.hidden = true;
            }
        }
        if (this.ui.runBoostBtn) this.ui.runBoostBtn.hidden = !(canWatch && this.runCardOpen && !this.state.multiplayer);
    }

    buyGemSkin(index, button) {
        const s = SKINS[index];
        if (!s || this.ownedSkins.includes(s.id)) return false;
        if (s.cost === undefined || this.state.gems < s.cost) {
            this.shakeUI(button);
            return false;
        }
        this.state.gems -= s.cost;
        this.ownedSkins.push(s.id);
        saveItem('lp_gems', this.state.gems);
        saveItem('lp_owned_skins', JSON.stringify(this.ownedSkins));
        this.equipSkin(index);
        this.renderGemShop();
        this.updateHeartUI();
        return true;
    }

    // A Pixel drawn in DOM squares, its colour plus two eyes, for the gem
    // shop and unlock notices. `cls` sizes it; `style` adds inline CSS.
    pixelPreviewHTML(skin, cls, style = '') {
        const body = skin.pattern ? 'background:' + pixelBodyCSS(skin) : 'background-color:' + skin.color;
        return `<span class="${cls}" style="${body};${style}">
            <span class="pixel-eye pixel-eye-l" style="background-color:${skin.eye};"></span>
            <span class="pixel-eye pixel-eye-r" style="background-color:${skin.eye};"></span>
        </span>`;
    }

    loadFame() {
        return loadJSON('lp_fame', [], v => Array.isArray(v))
            .filter(f => f && typeof f === 'object' && Number.isFinite(f.score));
    }

    updateFame(score) {
        let fame = this.loadFame();
        const skin = SKINS[this.viewParams.skinIndex];
        fame.push({ score, skin: skin.name, skinId: skin.id, date: new Date().toLocaleDateString() });
        fame.sort((a, b) => b.score - a.score);
        fame = fame.slice(0, 5);
        saveItem('lp_fame', JSON.stringify(fame));
    }

    updateFameUI() {
        let fame = this.loadFame();

        if (!fame.length) {
            this.ui.fame.innerHTML = `<div class="fame-empty">No runs yet. Your three best climbs will show here.</div>`;
            return;
        }

        this.ui.fame.innerHTML = fame.map((f, i) => {
            // Newer entries store the skin id; older ones only its name. A
            // renamed or removed skin falls back to the neutral swatch colour.
            const skin = SKINS.find(s => s.id === f.skinId) || SKINS.find(s => s.name === f.skin);
            const swatch = skin ? ` style="background:${skin.color}"` : '';
            const name = skin ? skin.name : String(f.skin || '???');
            return `<div class="fame-row fame-row--${i + 1}">
                <div class="fame-rank">${i + 1}</div>
                <div class="fame-swatch"${swatch}></div>
                <div class="fame-skin">${this.escapeHtml(name)}</div>
                <div class="fame-date">${this.escapeHtml(f.date || '')}</div>
                <div class="fame-score">${fmtNum(Math.floor(f.score))}m</div>
            </div>`;
        }).join('');
    }

    checkAchievements() {
        ACHIEVEMENTS.forEach(g => {
            if (!this.achievements.includes(g.id) && g.condition(this.state, this.player)) {
                this.achievements.push(g.id);
                saveItem('lp_achievements', JSON.stringify(this.achievements));
                this.showAchievement(g.name);
            }
        });
        this.checkPixelUnlocks();
    }

    // Passing a Pixel's unlock height (bestHeight, never highScore) is a NEW
    // PIXEL moment, not an achievement: a notice with the Pixel itself mid-run,
    // and a row on the run card. Each is announced once per device
    // (lp_pixel_unlocks); secret Pixels reveal through the same moment.
    checkPixelUnlocks() {
        for (const s of SKINS) {
            if (s.hourly || s.cost !== undefined || !(s.unlock > 0)) continue;
            if (this.state.bestHeight < s.unlock || this.pixelUnlocksSeen.includes(s.id)) continue;
            this.pixelUnlocksSeen.push(s.id);
            saveItem('lp_pixel_unlocks', JSON.stringify(this.pixelUnlocksSeen));
            const label = "NEW PIXEL: " + s.name;
            if (this.state.running && this.state.runUnlocks) this.state.runUnlocks.push(label);
            this.notify(label, 'unlock', { icon: this.pixelPreviewHTML(s, 'alert-pixel') });
            if (!this.state.running) this.renderPixelGrid();
        }
    }

    // A returning player has already passed some heights: record those once,
    // silently, so only genuinely new unlocks announce themselves. (Older
    // saves tracked them as 'skin:*' achievements, which are ignored now.)
    loadPixelUnlocks() {
        const seen = loadJSON('lp_pixel_unlocks', null, isStringArray);
        if (seen) return seen;
        const ids = SKINS.filter(s => !s.hourly && s.cost === undefined && s.unlock > 0 && this.state.bestHeight >= s.unlock).map(s => s.id);
        saveItem('lp_pixel_unlocks', JSON.stringify(ids));
        return ids;
    }

    showAchievement(name) {
        this.achievementQueue.push(name);
        if (!this.achievementShowing) this.showNextAchievement();
    }

    showNextAchievement() {
        const text = this.achievementQueue.shift();
        if (text === undefined) {
            this.achievementShowing = false;
            return;
        }

        this.achievementShowing = true;
        this.ui.achievement.innerHTML = icon('medal') + ' ' + this.escapeHtml(text);
        this.ui.achievement.style.display = 'block';
        sounds.play('reward');
        setTimeout(() => {
            this.ui.achievement.style.display = 'none';
            // A beat of clear air so back-to-back badges read as two separate
            // pops (and replay the slide-in) rather than one flickering line.
            setTimeout(() => this.showNextAchievement(), 250);
        }, 3000);
    }
}

</script>
<script>/* ---- js/share.js ---- */
// A challenge link (?beat=1234&d=20260923) sets a target on that day's
// layout. Every solo run on a given day uses the same daily seed, so the
// target is fair; on any other day the link is ignored.
function parseChallenge(search, todaySeed) {
    let params;
    try { params = new URLSearchParams(search || ''); } catch (e) { return null; }
    const meters = parseInt(params.get('beat'), 10);
    const day = parseInt(params.get('d'), 10);
    if (!(meters > 0) || meters > 1e7 || day !== todaySeed) return null;
    return { meters };
}

// Game's challenge links (a TARGET line on today's layout) and the end-of-run
// SHARE RUN card.
//
// GameShare is never instantiated: app.js copies these methods onto
// Game.prototype, so `this` is always the Game.
class GameShare {
    // ---------------------------------------------------- challenge links
    startChallenge() {
        const ch = this.challenge;
        const active = this.challengeActive();
        this.state.challengeBeaten = false;
        if (!this.ui.challengeHud) return;
        this.ui.challengeHud.hidden = !active;
        if (active) {
            this.ui.challengeHud.classList.remove('beaten');
            this.ui.challengeHud.innerText = 'TARGET ' + fmtNum(ch.meters) + 'm';
        }
    }

    // Only a normal solo start on today's layout: a checkpoint start (The
    // Void begins at 5000m) is a different climb and would pass most targets
    // before the first jump.
    challengeActive() {
        return !!this.challenge && !this.state.multiplayer && this.state.runSeed === this.getDailySeed()
            && !this.state.startMeters;
    }

    drawChallengeLine() {
        if (!this.challengeActive() || this.state.challengeBeaten) return;
        const ctx = this.renderer.ctx;
        const y = this.scoreLineY(this.challenge.meters);
        if (y < this.renderer.viewTop - 20 || y > CONFIG.HEIGHT + 20) return;
        ctx.save();
        ctx.strokeStyle = '#ffd700';
        ctx.lineWidth = 2;
        if (ctx.setLineDash) ctx.setLineDash([10, 8]);
        ctx.beginPath();
        ctx.moveTo(0, y);
        ctx.lineTo(CONFIG.WIDTH, y);
        ctx.stroke();
        ctx.restore();
        this.renderer.drawText('TARGET ' + fmtNum(this.challenge.meters) + 'm', CONFIG.WIDTH - 8, y - 6, 'bold 12px Orbitron, sans-serif', '#ffd700', 'right');
    }

    // ---------------------------------------------------------------- share
    // The link a shared run points at: today's challenge for a solo daily
    // run, the plain game otherwise.
    shareUrl(run) {
        const base = (typeof location !== 'undefined' && /^https?:$/.test(location.protocol || ''))
            ? location.origin + location.pathname
            : SITE_URL;
        if (!run.multiplayer && !run.start && run.seed === this.getDailySeed() && run.score > 0) {
            return base + '?beat=' + run.score + '&d=' + run.seed;
        }
        return base;
    }

    // Web Share with a score-card image where the platform supports files,
    // then plain Web Share, then copying the link.
    async shareRun() {
        const run = this.lastRun;
        if (!run) return;
        const url = this.shareUrl(run);
        const text = run.multiplayer
            ? `Our party climbed ${fmtNum(run.score)}m in Pixel Jump co-op!`
            : `I climbed ${fmtNum(run.score)}m in today's Pixel Jump. Can you beat it?`;
        const nav = typeof navigator !== 'undefined' ? navigator : {};
        try {
            if (nav.share && nav.canShare && typeof File !== 'undefined') {
                const blob = await this.renderShareImage(run);
                const file = blob && new File([blob], 'pixel-jump-run.png', { type: 'image/png' });
                if (file && nav.canShare({ files: [file] })) {
                    await nav.share({ files: [file], text: text + ' ' + url });
                    return;
                }
            }
            if (nav.share) {
                await nav.share({ title: 'Pixel Jump', text, url });
                return;
            }
            if (nav.clipboard && nav.clipboard.writeText) {
                await nav.clipboard.writeText(text + ' ' + url);
                this.showShareToast('LINK COPIED!');
                return;
            }
        } catch (e) {
            if (e && e.name === 'AbortError') return; // closed the share sheet
        }
        this.showShareToast(url);
    }

    showShareToast(text) {
        const t = this.ui.shareToast;
        if (!t) return;
        t.innerText = text;
        t.hidden = false;
        clearTimeout(this.shareToastTimer);
        this.shareToastTimer = setTimeout(() => { t.hidden = true; }, 4000);
    }

    // A 1080x1080 score card for sharing: title, distance, the Pixel, biome
    // and date. Resolves to a PNG blob (or null where canvases can't export).
    renderShareImage(run) {
        return new Promise(resolve => {
            const S = 1080;
            const c = document.createElement('canvas');
            c.width = S; c.height = S;
            const ctx = c.getContext && c.getContext('2d');
            if (!ctx || !c.toBlob) { resolve(null); return; }

            ctx.fillStyle = '#050505';
            ctx.fillRect(0, 0, S, S);
            ctx.strokeStyle = '#1a1a1a';
            ctx.lineWidth = 2;
            ctx.beginPath();
            for (let i = 0; i <= S; i += 60) {
                ctx.moveTo(i, 0); ctx.lineTo(i, S);
                ctx.moveTo(0, i); ctx.lineTo(S, i);
            }
            ctx.stroke();

            ctx.textAlign = 'center';
            ctx.textBaseline = 'alphabetic';
            ctx.shadowColor = '#c04dff';
            ctx.shadowBlur = 30;
            ctx.fillStyle = '#ffffff';
            ctx.font = '900 96px Orbitron, sans-serif';
            ctx.fillText('PIXEL JUMP', S / 2, 170);

            ctx.shadowColor = 'rgba(255,255,255,0.6)';
            ctx.shadowBlur = 24;
            ctx.font = '900 170px Orbitron, sans-serif';
            ctx.fillText(fmtNum(run.score) + 'm', S / 2, 430);
            ctx.shadowBlur = 0;

            ctx.font = '700 40px Orbitron, sans-serif';
            ctx.fillStyle = run.newBest ? '#ffd700' : '#8c8c8c';
            ctx.fillText(run.newBest ? '★ NEW BEST ★' : (run.multiplayer ? 'CO-OP RUN' : "TODAY'S DAILY RUN"), S / 2, 510);

            // The Pixel, at the in-game proportions (26px body, 5px eyes).
            const k = 8, px = S / 2 - 13 * k, py = 590;
            ctx.shadowColor = run.color;
            ctx.shadowBlur = 40;
            ctx.fillStyle = run.color;
            ctx.beginPath();
            addRoundRect(ctx, px, py, 26 * k, 26 * k, PIXEL_CORNER_RADIUS * k);
            ctx.fill();
            ctx.shadowBlur = 0;
            paintPixelPattern(ctx, px, py, 26 * k, run);
            ctx.fillStyle = run.eye;
            ctx.fillRect(px + 5 * k, py + 7 * k, 5 * k, 5 * k);
            ctx.fillRect(px + 16 * k, py + 7 * k, 5 * k, 5 * k);

            ctx.fillStyle = '#ffffff';
            ctx.font = '700 44px Orbitron, sans-serif';
            ctx.fillText(run.skinName.toUpperCase(), S / 2, 870);
            ctx.fillStyle = '#00ffff';
            ctx.font = '700 34px Orbitron, sans-serif';
            ctx.fillText(run.biome.toUpperCase() + ' · ' + run.date, S / 2, 930);
            ctx.fillStyle = '#8c8c8c';
            ctx.font = '700 30px Orbitron, sans-serif';
            ctx.fillText(SITE_URL.replace(/^https:\/\//, '').replace(/\/$/, ''), S / 2, 1030);

            c.toBlob(blob => resolve(blob), 'image/png');
        });
    }
}

</script>
<script>/* ---- js/hourly.js ---- */
// The Pixel of the Hour. Each hour one of the hourly Pixels (the SKINS
// entries marked `hourly`) is on offer. Watching a rewarded ad, or paying
// its tier's gem price (hourlyPixelCost), lets the player wear it until the next :00 on
// their own clock. If the hour turns mid-run the Pixel stays on until that
// run ends; then the Pixel they wore before comes back.
//
// Saves: lp_hourly_unlock = { key, id } (the hour it was unlocked for, see
// hourKey()) and lp_skin_prev (the Pixel to go back to).

const HOURLY_SKINS = SKINS.filter(s => s.hourly);

// The local hour as a key: 'YYYY-MM-DD-HH'.
function hourKey(now = Date.now()) {
    const d = new Date(now);
    const p = n => String(n).padStart(2, '0');
    return `${d.getFullYear()}-${p(d.getMonth() + 1)}-${p(d.getDate())}-${p(d.getHours())}`;
}

// This hour's Pixel. Every one of them comes round each day, in an order
// that moves five places a day, so 3pm isn't always the same Pixel.
function hourlySkinAt(now = Date.now()) {
    const d = new Date(now);
    const day = Math.floor(Date.UTC(d.getFullYear(), d.getMonth(), d.getDate()) / 86400000);
    return HOURLY_SKINS[(day * 5 + d.getHours()) % HOURLY_SKINS.length];
}

// When this hour's Pixel goes: the next :00 on the local clock (the Date
// constructor handles daylight-saving days).
function nextHourAt(now = Date.now()) {
    const d = new Date(now);
    return new Date(d.getFullYear(), d.getMonth(), d.getDate(), d.getHours() + 1).getTime();
}

// "4:00 PM" (or "16:00"), in the player's own format.
function fmtHour(ms) {
    return new Date(ms).toLocaleTimeString([], { hour: 'numeric', minute: '2-digit' });
}

// Game's Pixel of the Hour methods (copied onto Game.prototype in app.js).
class GameHourly {
    loadHourlyUnlock() {
        return loadJSON('lp_hourly_unlock', null,
            v => isPlainObject(v) && typeof v.key === 'string' && typeof v.id === 'string');
    }

    // Is this hourly Pixel the player's to wear right now?
    hourlyUnlocked(skin, now = Date.now()) {
        const rec = this.hourlyRecord;
        return !!rec && rec.id === skin.id && rec.key === hourKey(now) && hourlySkinAt(now).id === skin.id;
    }

    // Ads only between runs and never with a party (an ad there could hold
    // everyone up). Gems work any time the menu is open.
    canWatchHourlyAd() {
        return !this.state.running && !this.inParty() && !this.installGated && this.ads.rewardedAvailable();
    }

    watchHourlyAd() {
        if (!this.canWatchHourlyAd() || this.hourlyUnlocked(hourlySkinAt())) return;
        this.ads.showRewarded('hourly_pixel', () => this.unlockHourly(), (why) => {
            if (why !== 'skipped') this.notify("NO AD RIGHT NOW", 'warning');
        });
    }

    buyHourly() {
        if (this.state.running || this.hourlyUnlocked(hourlySkinAt())) return;
        const cost = hourlyPixelCost(hourlySkinAt());
        if (this.state.gems < cost) {
            this.shakeUI(this.ui.hourlyGemBtn);
            return;
        }
        this.state.gems -= cost;
        saveItem('lp_gems', this.state.gems);
        this.unlockHourly();
    }

    // Unlocks whichever Pixel is on offer now (an hour that turned while the
    // ad played gives the new one, for its whole hour) and puts it on.
    unlockHourly() {
        const now = Date.now();
        const skin = hourlySkinAt(now);
        this.hourlyRecord = { key: hourKey(now), id: skin.id };
        saveItem('lp_hourly_unlock', JSON.stringify(this.hourlyRecord));
        this.equipSkin(skinIndexById(skin.id));
        this.notify(skin.name.toUpperCase() + ": YOURS UNTIL " + fmtHour(nextHourAt(now)), 'unlock',
            { icon: this.pixelPreviewHTML(skin, 'alert-pixel') });
        sounds.play('reward');
        this.updateHourlyUI();
    }

    // Where an expired Pixel of the Hour hands back to: the Pixel worn
    // before it, if the player still has it.
    fallbackSkinIndex() {
        const prev = skinIndexById(storageGet('lp_skin_prev'));
        return prev >= 0 && !this.isSkinLocked(prev) ? prev : 0;
    }

    // Once a second: when the hour turns, a Pixel whose hour is up comes off
    // (unless a run is on; gameOver() takes care of it then), and the card
    // moves on to the new Pixel.
    tickHourly() {
        const key = hourKey();
        if (key !== this.hourlyShownKey) {
            this.hourlyShownKey = key;
            if (!this.state.running) this.updateSkinUI();
        }
        this.updateHourlyUI();
    }

    openHourly() {
        this.hourlyOpen = true;
        this.ui.hourlyOverlay.hidden = false;
        this.updateHourlyUI();
    }

    closeHourly() {
        this.hourlyOpen = false;
        this.ui.hourlyOverlay.hidden = true;
    }

    // The menu button under the Pixel picker, and the card it opens.
    updateHourlyUI() {
        const ui = this.ui;
        const now = Date.now();
        const skin = hourlySkinAt(now);
        const until = fmtHour(nextHourAt(now));
        const owned = this.hourlyUnlocked(skin, now);
        const left = fmtClock(nextHourAt(now) - now);
        if (ui.hourlyOpenBtn) setHTML(ui.hourlyOpenBtn, icon('clock') + (owned ? ' YOURS UNTIL ' + until : ' HOURLY PIXEL ' + left));
        if (!this.hourlyOpen || !ui.hourlyTimer) return;

        if (this.hourlyShownSkin !== skin.id) {
            this.hourlyShownSkin = skin.id;
            ui.hourlyPreview.innerHTML = this.pixelPreviewHTML(skin, 'hourly-pixel');
            ui.hourlyName.innerText = skin.name;
            ui.hourlyPerks.innerHTML = this.tierBadge(skin) + this.renderPerkTags(skin.ability);
        }
        ui.hourlyTimer.innerText = 'NEXT PIXEL IN ' + left;
        const wearing = SKINS[this.viewParams.skinIndex] === skin;
        // A portable build has no ad button at all (the marker removes it).
        if (ui.hourlyAdBtn) {
            ui.hourlyAdBtn.hidden = owned || !this.canWatchHourlyAd();
            setHTML(ui.hourlyAdBtn, icon('play') + ' WATCH AD: WEAR IT UNTIL ' + until);
        }
        ui.hourlyGemBtn.hidden = owned;
        const cost = hourlyPixelCost(skin);
        setHTML(ui.hourlyGemBtn, counted(fmtNum(cost), 'gem') + ' WEAR IT UNTIL ' + until);
        ui.hourlyGemBtn.classList.toggle('cant-afford', this.state.gems < cost);
        ui.hourlyOwned.hidden = !owned;
        ui.hourlyOwned.innerText = wearing ? 'YOU\'RE WEARING IT UNTIL ' + until : 'YOURS UNTIL ' + until;
        ui.hourlyWearBtn.hidden = !owned || wearing;
    }

    bindHourlyEvents() {
        const on = (el, fn) => { if (el) el.onclick = (e) => { if (e && e.stopPropagation) e.stopPropagation(); fn(); }; };
        on(this.ui.hourlyCloseBtn, () => this.closeHourly());
        on(this.ui.hourlyAdBtn, () => this.watchHourlyAd());
        on(this.ui.hourlyGemBtn, () => this.buyHourly());
        on(this.ui.hourlyWearBtn, () => { this.equipSkin(skinIndexById(hourlySkinAt().id)); this.updateHourlyUI(); });
        // A tap beside the card closes it.
        if (this.ui.hourlyOverlay) this.ui.hourlyOverlay.onclick = (e) => { if (e.target === this.ui.hourlyOverlay) this.closeHourly(); };
    }
}

</script>
<script>/* ---- js/leaderboard.js ---- */
// Today's top 10: the ten highest solo climbs on the day's layout, from
// everyone who plays, kept by the score Worker at SCORES_URL
// (cloudflare/score-worker/). A solo run that would make the board offers a
// name box on the run card, and Records shows the board. Climbs are ranked by
// metres actually climbed (from the run's start, without SCORE x2 or boss
// bonuses), so every Pixel competes on the same footing.
//
// With no network, or the Worker down, there's simply no board: the panel
// stays hidden and the run card never asks.
//
// Saves: lp_player_id (a random id, so the board keeps one entry per player
// a day) and lp_lb_name (the name last put on the board).

// The board as the Worker sent it, checked: at most LEADERBOARD_SIZE rows of
// { name, meters, me }. null when it isn't a board at all.
function cleanLeaderboard(top) {
    if (!Array.isArray(top)) return null;
    return top.slice(0, LEADERBOARD_SIZE)
        .filter(r => r && typeof r.name === 'string' && Number.isFinite(r.meters))
        .map(r => ({ name: r.name.slice(0, MP_NAME_MAX), meters: Math.max(0, Math.floor(r.meters)), me: r.me === true }));
}

// The characters the board accepts in a name (the Worker checks the same).
const LEADERBOARD_NAME_RE = /^[A-Z0-9 _.\-]+$/;

// GameLeaderboard is never instantiated: app.js copies these methods onto
// Game.prototype, so `this` is always the Game.
class GameLeaderboard {
    leaderboardPlayerId() {
        let id = null;
        try { id = localStorage.getItem('lp_player_id'); } catch (e) { /* storage blocked */ }
        if (id && /^[0-9a-f]{16,32}$/.test(id)) return id;
        const bytes = new Uint8Array(12);
        if (typeof crypto !== 'undefined' && crypto.getRandomValues) crypto.getRandomValues(bytes);
        else for (let i = 0; i < bytes.length; i++) bytes[i] = Math.floor(Math.random() * 256);
        id = Array.from(bytes, b => b.toString(16).padStart(2, '0')).join('');
        saveItem('lp_player_id', id);
        return id;
    }

    // A call to the score Worker. Resolves { ok, status, body }, or null when
    // it couldn't be reached in SCORES_FETCH_TIMEOUT_MS. Never rejects.
    scoresRequest(path, init) {
        if (!SCORES_URL || typeof fetch !== 'function') return Promise.resolve(null);
        const ctrl = typeof AbortController === 'function' ? new AbortController() : null;
        let timer = null;
        const timeout = new Promise(resolve => {
            timer = setTimeout(() => {
                if (ctrl) ctrl.abort();
                resolve(null);
            }, SCORES_FETCH_TIMEOUT_MS);
        });
        let request;
        try {
            request = fetch(SCORES_URL.replace(/\/$/, '') + path, Object.assign({}, init, ctrl ? { signal: ctrl.signal } : {}))
                .then(res => res.json().catch(() => ({})).then(body => ({ ok: !!res.ok, status: res.status, body: body || {} })))
                .catch(() => null);
        } catch (e) {
            request = Promise.resolve(null);
        }
        return Promise.race([request, timeout]).then(r => {
            clearTimeout(timer);
            return r;
        });
    }

    // Fetches a day's board (today's by default). Resolves its rows, or null.
    // Today's is kept in this.leaderboard for the Records panel.
    fetchLeaderboard(day = String(this.getDailySeed())) {
        // A file:// page is an opaque origin: the Worker refuses it, and the
        // browser logs the CORS failure even though we catch it. Skip the
        // request; there is no board to show offline.
        if (typeof location !== 'undefined' && location.protocol === 'file:') return Promise.resolve(null);
        const q = '/top?day=' + encodeURIComponent(day) + '&me=' + this.leaderboardPlayerId();
        return this.scoresRequest(q).then(r => {
            const top = r && r.ok ? cleanLeaderboard(r.body.top) : null;
            if (top) this.keepLeaderboard(day, top);
            return top;
        });
    }

    keepLeaderboard(day, top) {
        if (day !== String(this.getDailySeed())) return;
        this.leaderboard = { day, top, at: Date.now() };
        this.renderLeaderboard();
    }

    // Opening Records shows the board we have and fetches a fresh one if
    // it's more than LEADERBOARD_REFRESH_MS old.
    refreshLeaderboard() {
        this.renderLeaderboard();
        const lb = this.leaderboard;
        if (lb && lb.day === String(this.getDailySeed()) && Date.now() - lb.at < LEADERBOARD_REFRESH_MS) return;
        if (this.leaderboardPending) return;
        this.leaderboardPending = this.fetchLeaderboard().then(() => { this.leaderboardPending = null; });
    }

    renderLeaderboard() {
        const ui = this.ui;
        if (!ui.lbPanel) return;
        const lb = this.leaderboard;
        const shown = !!lb && lb.day === String(this.getDailySeed());
        ui.lbPanel.hidden = !shown;
        if (!shown) return;
        ui.lbList.innerHTML = lb.top.length
            ? lb.top.map((r, i) => `<div class="fame-row fame-row--${i + 1}${r.me ? ' lb-row--me' : ''}">
                <div class="fame-rank">${i + 1}</div>
                <div class="lb-name">${this.escapeHtml(r.name)}</div>
                <div class="fame-score">${fmtNum(r.meters)}m</div>
            </div>`).join('')
            : `<div class="fame-empty">Nobody's on today's board yet. Climb and yours could be the first name.</div>`;
    }

    // ----------------------------------------------------------- run card
    // After a solo run: if the climb would make the day's board (and beats
    // the player's own entry), the run card asks for a name.
    offerLeaderboard() {
        this.lbOffer = null;
        if (this.ui.lbPrompt) this.ui.lbPrompt.hidden = true;
        const s = this.state;
        const day = String(s.runSeed);
        // A solo run's seed is the day it was played; co-op seeds aren't days.
        if (s.multiplayer || !/^\d{8}$/.test(day)) return;
        const meters = Math.max(0, Math.floor(s.score / 10) - (s.startMeters || 0));
        if (meters < 1) return;
        const offer = { day, meters, secs: Math.round(this.runSeconds() * 10) / 10 };
        this.lbOffer = offer;
        this.fetchLeaderboard(day).then(top => {
            if (this.lbOffer !== offer || !this.runCardOpen || !top) return;
            const mine = top.find(r => r.me);
            if (mine && mine.meters >= meters) return;
            // Ties go to whoever was there first.
            const rank = top.filter(r => !r.me && r.meters >= meters).length + 1;
            if (rank > LEADERBOARD_SIZE) return;
            offer.rank = rank;
            this.showLeaderboardPrompt(offer);
        });
    }

    showLeaderboardPrompt(offer) {
        const ui = this.ui;
        if (!ui.lbPrompt) return;
        ui.lbTitle.innerText = '#' + offer.rank + ' ON TODAY\'S TOP ' + LEADERBOARD_SIZE + ': ' + fmtNum(offer.meters) + 'm CLIMBED';
        // Logged in on CrazyGames: the board uses that username, like co-op.
        const locked = !!this.portalName;
        let name = '';
        try { name = localStorage.getItem('lp_lb_name') || localStorage.getItem('lp_mp_name') || ''; } catch (e) { /* storage blocked */ }
        ui.lbNameInput.value = (locked ? this.portalName : name).toUpperCase().slice(0, MP_NAME_MAX);
        ui.lbNameInput.readOnly = locked;
        ui.lbNameInput.title = locked ? 'Your CrazyGames username' : '';
        ui.lbRow.hidden = false;
        ui.lbSubmitBtn.disabled = false;
        this.leaderboardNote('', false);
        ui.lbPrompt.hidden = false;
    }

    leaderboardNote(text, error) {
        const note = this.ui.lbNote;
        if (!note) return;
        note.innerText = text;
        note.hidden = !text;
        note.classList.toggle('lb-note--error', !!error);
    }

    submitLeaderboard() {
        const offer = this.lbOffer;
        const ui = this.ui;
        if (!offer || !offer.rank || offer.sending || offer.done) return;
        const name = ui.lbNameInput.value.toUpperCase().replace(/\s+/g, ' ').trim().slice(0, MP_NAME_MAX);
        if (!name) { this.leaderboardNote('TYPE A NAME FIRST', true); return; }
        if (!LEADERBOARD_NAME_RE.test(name)) { this.leaderboardNote('LETTERS, NUMBERS, SPACES AND _ . - ONLY', true); return; }

        offer.sending = true;
        ui.lbSubmitBtn.disabled = true;
        this.leaderboardNote('SENDING...', false);
        const body = { day: offer.day, id: this.leaderboardPlayerId(), name, meters: offer.meters, secs: offer.secs };
        // text/plain keeps it a simple request (no CORS preflight).
        this.scoresRequest('/submit', { method: 'POST', headers: { 'Content-Type': 'text/plain' }, body: JSON.stringify(body) }).then(r => {
            offer.sending = false;
            ui.lbSubmitBtn.disabled = false;
            if (!r || !r.ok) {
                const error = r && r.body && r.body.error;
                this.leaderboardNote(
                    error === 'name' ? 'THAT NAME ISN\'T ALLOWED. TRY ANOTHER' :
                    r && r.status === 429 ? 'TOO MANY TRIES. WAIT A WHILE' :
                    error === 'implausible' ? 'THE BOARD COULDN\'T ACCEPT THIS RUN' :
                    'COULDN\'T REACH THE BOARD. TRY AGAIN', true);
                return;
            }
            offer.done = true;
            if (!this.portalName) saveItem('lp_lb_name', name);
            const top = cleanLeaderboard(r.body.top);
            if (top) this.keepLeaderboard(offer.day, top);
            ui.lbRow.hidden = true;
            const rank = Number.isInteger(r.body.rank) ? r.body.rank : null;
            ui.lbTitle.innerText = rank ? 'YOU\'RE #' + rank + ' ON TODAY\'S TOP ' + LEADERBOARD_SIZE : 'OTHERS CLIMBED PAST YOU FIRST';
            this.leaderboardNote('', false);
        });
    }

    bindLeaderboardEvents() {
        const ui = this.ui;
        if (ui.lbSubmitBtn) ui.lbSubmitBtn.onclick = (e) => {
            if (e && e.stopPropagation) e.stopPropagation();
            this.submitLeaderboard();
        };
        const input = ui.lbNameInput;
        if (!input || !input.addEventListener) return;
        input.addEventListener('keydown', (e) => {
            if (e.code !== 'Enter' && e.code !== 'NumpadEnter') return;
            e.preventDefault();
            this.submitLeaderboard();
        });
        input.addEventListener('input', () => {
            if (input.readOnly) return;
            const upper = input.value.toUpperCase();
            if (upper !== input.value) input.value = upper;
        });
    }
}

</script>
<script>/* ---- app.js ---- */
// Reads a JSON save. A missing, corrupt or wrong-shaped value falls back
// instead of throwing, so one bad localStorage entry can't stop the game from
// starting.
function loadJSON(key, fallback, isValid = () => true) {
    try {
        const raw = storageGet(key);
        if (raw === null || raw === undefined) return fallback;
        const value = JSON.parse(raw);
        return isValid(value) ? value : fallback;
    } catch (e) {
        return fallback;
    }
}

// localStorage can throw just by being touched (Safari on file://, storage
// disabled, a full quota). Saves are best-effort everywhere: these wrappers
// keep a direct read or remove from escaping into the game constructor.
function storageGet(key) {
    try { return localStorage.getItem(key); } catch (e) { return null; }
}

function storageRemove(key) {
    try { localStorage.removeItem(key); } catch (e) { /* storage blocked */ }
}

// Writes a save. Storage can be full or blocked, and a throw here would
// escape into the game loop mid-run, so a failed write is dropped instead.
// Returns false when it didn't stick.
function saveItem(key, value) {
    try {
        localStorage.setItem(key, value);
        return true;
    } catch (e) {
        return false;
    }
}

// One of the drawn icons in index.html's sprite (gem, heart, trophy, medal,
// gear, clock, play, back, coop, check, alert), as markup for innerHTML.
function icon(name) {
    return '<svg class="ico ico-' + name + '" aria-hidden="true"><use href="#i-' + name + '"/></svg>';
}

// A count with its icon after it ("120 [gem]"), for the HUD counters,
// prices and stat tiles.
function counted(n, name) {
    return '<span class="count">' + n + '</span>' + icon(name);
}

// Writes an element's markup or text only when it has changed: the browser
// re-lays-out for every write, changed or not. Only for elements nothing
// else writes to.
function setHTML(el, html) {
    if (el && el._html !== html) {
        el._html = html;
        el.innerHTML = html;
    }
}

function setText(el, text) {
    if (el && el._text !== text) {
        el._text = text;
        el.innerText = text;
    }
}

const isStringArray = v => Array.isArray(v) && v.every(x => typeof x === 'string');

// 12345 -> "12,345" for the HUD and menus.
const fmtNum = n => Number(n).toLocaleString('en-US');

// A local date as "2026-09-27" (the same calendar day getDailySeed() uses).
function fmtDate(d) {
    const pad = n => String(n).padStart(2, '0');
    return `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}`;
}

// 3725 -> "1h 2m", 95 -> "1m 35s".
// A countdown as m:ss (ms rounded up, so it never shows 0:00 while running).
function fmtClock(ms) {
    const t = Math.max(0, Math.ceil(ms / 1000));
    return Math.floor(t / 60) + ':' + String(t % 60).padStart(2, '0');
}

function fmtDuration(totalSeconds) {
    const t = Math.max(0, Math.floor(totalSeconds));
    const h = Math.floor(t / 3600), m = Math.floor((t % 3600) / 60), s = t % 60;
    return h > 0 ? `${h}h ${m}m` : `${m}m ${s}s`;
}

const isPlainObject = v => !!v && typeof v === 'object' && !Array.isArray(v);

// A teammate's name over their Pixel: long names (CrazyGames usernames run
// to 20 characters) are shortened so tags don't sprawl across the screen.
function nameTag(name) {
    const n = String(name || 'PLAYER');
    return n.length > MP_TAG_MAX ? n.slice(0, MP_TAG_MAX - 1) + '…' : n;
}

// On iPhone and iPad the game only runs as an installed app (full screen, no
// browser bars). On Android installing is a suggestion: the same card, with
// a PLAY IN BROWSER button. installPlatform() says which install steps to show:
// 'ios' (iPhone, iPad, iPod; iPadOS Safari poses as a Mac, but Macs have no touch),
// 'android' (phones and tablets), or null for desktops.
function installPlatform(nav) {
    const ua = (nav && nav.userAgent) || '';
    if (/iPhone|iPod|iPad/.test(ua) || (/Macintosh/.test(ua) && nav.maxTouchPoints > 0)) return 'ios';
    if (/Android/.test(ua)) return 'android';
    return null;
}

// True for a phone or tablet browser tab; false once running as the app.
// Never on a game portal, which forbids install prompts.
function needsHomeScreenInstall(nav, win) {
    if (PLATFORM !== 'web' || !installPlatform(nav) || nav.standalone) return false;
    try {
        if (win && typeof win.matchMedia === 'function' &&
            (win.matchMedia('(display-mode: standalone)').matches || win.matchMedia('(display-mode: fullscreen)').matches)) return false;
    } catch (e) { /* no matchMedia: treat as a tab */ }
    return true;
}

// Android players may close the install card and play in the tab. Closing it
// is remembered (lp_install_later, a timestamp) for INSTALL_SNOOZE_MS.
const INSTALL_SNOOZE_MS = 7 * 24 * 60 * 60 * 1000;
function installIsOptional(nav) {
    return installPlatform(nav) === 'android';
}

// Only Safari offers Add to Home Screen reliably; Chrome, Firefox and the
// browsers inside other apps (no "Safari/" token) are sent to Safari first.
function isIOSNonSafari(ua) {
    return /CriOS|FxiOS|EdgiOS|OPiOS/.test(ua || '') || !/Safari\//.test(ua || '');
}

// Browsers inside other apps (Instagram, Facebook, TikTok, Snapchat, other
// WebViews) can't install anything, so Android players are sent to Chrome.
function isAndroidInAppBrowser(ua) {
    return /; wv\)|FBAN|FBAV|Instagram|musical_ly|Bytedance|Snapchat|Line\/|Twitter/.test(ua || '');
}

// Chrome, Edge and Samsung Internet offer a one-tap install through
// beforeinstallprompt. It can fire before the game exists, so it's caught
// here and handed over. Desktop browsers keep their own install UI.
const installPrompt = { event: null, onReady: null, onInstalled: null };
if (typeof window !== 'undefined' && typeof window.addEventListener === 'function') {
    window.addEventListener('beforeinstallprompt', (e) => {
        // Not needsHomeScreenInstall(): an Android tab playing full screen
        // reads as display-mode fullscreen, and can still be installed.
        if (PLATFORM !== 'web' || !installPlatform(typeof navigator !== 'undefined' ? navigator : null)) return;
        e.preventDefault();
        installPrompt.event = e;
        if (installPrompt.onReady) installPrompt.onReady();
    });
    window.addEventListener('appinstalled', () => {
        installPrompt.event = null;
        if (installPrompt.onInstalled) installPrompt.onInstalled();
    });
}

