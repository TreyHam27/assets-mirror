    { id: 'h_midnight', name: "Midnight Oil", tier: 'epic', color: "#1b1464", color2: "#6c5ce7", eye: "#ffe66d", pattern: 'split', hourly: true, ability: { gravityMult: 0.75, powerDurationMult: 2 } },
    { id: 'h_keylime', name: "Key Lime", tier: 'rare', color: "#c6ff00", color2: "#1f7a1f", eye: "#1f3d00", pattern: 'ring', hourly: true, ability: { speedMult: 1.25, gemMagnetRadius: 150 } },

    // Granted Pixels: not in the shop, not a Rental, not in a Pack. The score
    // Worker adds one to a single account (POST /admin/grant,
