// Hearts that can be bought for the next run: as many as the roomiest
// Pixel holds, less the free one. A save keeps up to this many; a run takes
// what fits the equipped Pixel and refunds the rest (Game.startGame).
const MAX_BOUGHT_HEARTS = Math.max(...SKINS.map(heartCapFor)) - 1;

// Tiers are a label only (how strong a Pixel is at a glance); how you get
// one (height, gems, the hour) is unchanged. Colours are the --tier-* tokens.
const PIXEL_TIERS = {
    uncommon: { label: 'UNCOMMON', order: 0 },
    rare: { label: 'RARE', order: 1 },
    epic: { label: 'EPIC', order: 2 },
    legendary: { label: 'LEGENDARY', order: 3 },
