    { id: 'h_midnight', name: "Midnight Oil", tier: 'epic', color: "#1b1464", color2: "#6c5ce7", eye: "#ffe66d", pattern: 'split', hourly: true, ability: { gravityMult: 0.75, powerDurationMult: 2 } },
